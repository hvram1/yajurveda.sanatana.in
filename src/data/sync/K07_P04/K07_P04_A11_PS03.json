    {
      "text": "षड॒हेन॒ यन्ति॑ देवच॒क्रमे॒व स॒मारो॑ह॒न्त्यरि॑ष्ट्यै॒",
      "start": 56.96,
      "end": 64.96
    },
    {
      "text": "ते स्व॒स्ति सम॑श्नुवते षड॒हेन॑",
      "start": 64.96,
      "end": 71.56
    },
    {
      "text": "यन्ति॒ षड्वा ऋ॒तव॑ ऋ॒तुष्वे॒व",
      "start": 71.56,
      "end": 71.56
    },
    {
      "text": "प्रति॑ तिष्ठन्त्युभ॒यतो᳚ ज्योतिषा यन्त्युभ॒यत॑",
      "start": 71.56,
      "end": 71.56
    },
    {
      "text": "ए॒व सु॑व॒र्गे लो॒के प्र॑ति॒तिष्ठ॑न्तो",
      "start": 71.56,
      "end": 75.92
    },
    {
      "text": "यन्ति॒ द्वौ ष॑ड॒हौ भ॑वत॒स्तानि॒",
      "start": 75.92,
      "end": 80.92
    },
    {
      "text": "द्वाद॒शाहा॑नि॒ सं प॑द्यन्ते द्वाद॒शो",
      "start": 80.92,
      "end": 86.56
    },
    {
      "text": "वै पुरु॑षो॒ द्वे स॒क्थ्यौ᳚",
      "start": 86.56,
      "end": 89.92
    },
    {
      "text": "द्वौ बा॒हू आ॒त्मा च॒",
      "start": 89.92,
      "end": 92.28
    },
    {
      "text": "शिर॑श्च च॒त्वार्यङ्गा॑नि॒ स्तनौ᳚ द्वाद॒शौ",
