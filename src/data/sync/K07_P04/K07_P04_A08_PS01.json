    {
      "text": "सं॒ॅव॒थ्स॒राय॑ दीक्षि॒ष्यमा॑णा एकाष्ट॒कायां᳚ दीक्षेरन्ने॒षा",
      "start": 0.0,
      "end": 9.28
    },
    {
      "text": "वै सं॑ॅवथ्स॒रस्य॒ पत्नी॒ यदे॑काष्ट॒कैतस्यां॒",
      "start": 9.28,
      "end": 20.64
    },
    {
      "text": "ॅवा ए॒ष ए॒ताꣳ रात्रिं॑",
      "start": 20.64,
      "end": 24.24
    },
    {
      "text": "ॅवसति सा॒क्षादे॒व सं॑ॅवथ्स॒रमा॒रभ्य॑ दीक्षन्त॒",
      "start": 24.24,
      "end": 31.36
    },
    {
      "text": "आर्तं॒ ॅवा ए॒ते सं॑ॅवथ्स॒रस्या॒भि",
      "start": 31.36,
