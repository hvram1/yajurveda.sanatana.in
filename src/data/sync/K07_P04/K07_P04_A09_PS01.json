    {
      "text": "सु॒व॒र्गं ॅवा ए॒ते लो॒कं",
      "start": 0.0,
      "end": 3.84
    },
    {
      "text": "ॅय॑न्ति॒ ये स॒त्रमु॑प॒यन्त्य॒भीन्ध॑त ए॒व",
      "start": 3.84,
      "end": 10.56
    },
    {
      "text": "दी॒क्षाभि॑रा॒त्मानꣳ॑ श्रपयन्त उप॒सद्भि॒-र्द्वाभ्यां॒ ॅलोमाव॑",
      "start": 10.56,
      "end": 11.4
    },
    {
      "text": "द्यन्ति॒ द्वाभ्यां॒ त्वचं॒ द्वाभ्या॒मसृ॒द्",
      "start": 11.4,
      "end": 17.88
    },
    {
      "text": "द्वाभ्यां᳚ माꣳ॒॒सं द्वाभ्या॒मस्थि॒ द्वाभ्यां᳚",
      "start": 17.88,
      "end": 20.0
    },
    {
      "text": "म॒ज्जान॑मा॒त्मद॑क्षिणं॒ ॅवै स॒त्रमा॒त्मान॑मे॒व दक्षि॑णां",
      "start": 20.0,
      "end": 29.2
    },
    {
      "text": "नी॒त्वा सु॑व॒र्गं ॅलो॒कं ॅय॑न्ति॒",
      "start": 29.2,
      "end": 32.92
    },
    {
      "text": "शिखा॒मनु॒ प्र व॑पन्त॒ ऋद्ध्या॒",
      "start": 32.92,
      "end": 34.84
    },
    {
      "text": "अथो॒ रघी॑याꣳसः सुव॒र्गं ॅलो॒कम॑या॒मेति॑",
      "start": 34.84,
      "end": 40.36
