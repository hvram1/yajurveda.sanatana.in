  "phrases": [
    {
      "text": "सु॑व॒र्गं ॅलो॒कं ॅय॑न्ति॒ परा᳚ञ्चो॒",
      "start": 164.48,
      "end": 164.48
    },
    {
      "text": "वा ए॒ते सु॑व॒र्गं ॅलो॒कम॒भ्यारो॑हन्ति॒",
      "start": 164.48,
      "end": 164.48
    },
    {
      "text": "ये प॑रा॒चीना॑नि पृ॒ष्ठान्यु॑प॒यन्ति॑ प्र॒त्यङ्",
      "start": 164.48,
      "end": 164.48
    },
    {
      "text": "ष॑ड॒हो भ॑वति प्र॒त्यव॑रूढ्या॒ अथो॒",
      "start": 164.48,
      "end": 164.48
    },
    {
      "text": "प्रति॑ष्ठित्या उ॒भयो᳚र्लो॒कयोर॑ ऋ॒द्ध्वोत् ति॑ष्ठन्ति",
      "start": 164.48,
      "end": 169.44
    },
    {
      "text": "त्रि॒वृतोऽधि॑ त्रि॒वृत॒मुप॑ यन्ति॒ स्तोमा॑नाꣳ॒॒",
      "start": 169.44,
      "end": 173.32
    },
    {
      "text": "संप॑त्त्यै प्रभ॒वाय॒ ज्योति॑रग्निष्टो॒मो भ॑वत्य॒यं",
      "start": 173.32,
      "end": 180.52
    },
    {
      "text": "ॅवाव स क्षयो॒ऽस्मादे॒व तेन॒",
      "start": 180.52,
      "end": 183.36
    },
    {
      "text": "क्षया॒न्न य॑न्ति चतुर्विꣳशतिरा॒त्रो भ॑वति॒",
      "start": 183.36,
      "end": 190.04
    },
    {
      "text": "चतु॑र्विꣳशतिरर्द्धमा॒साः सं॑ॅवथ्स॒रः ( )",
      "start": 190.04,
      "end": 198.08
    },
    {
      "text": "सं॑ॅवथ्स॒रः सु॑व॒र्गो लो॒कः सं॑ॅवथ्स॒र",
      "start": 198.08,
      "end": 205.96
    },
    {
      "text": "ए॒व सु॑व॒र्गे लो॒के प्रति॑",
      "start": 205.96,
      "end": 210.0
    },
    {
      "text": "तिष्ठ॒न्त्यथो॒ चतु॑र्विꣳशत्यक्षरा गाय॒त्री गा॑य॒त्री",
      "start": 210.0,
      "end": 215.64
    },
    {
      "text": "ब्र॑ह्मवर्च॒सं गा॑यत्रि॒यैव ब्र॑ह्मवर्च॒समव॑ रुन्धते",
      "start": 215.64,
      "end": 219.52
    },
    {
      "text": "ऽतिरा॒त्राव॒भितो॑ भवतो ब्रह्मवर्च॒सस्य॒ परि॑गृहीत्यै",
      "start": 219.52,
      "end": 226.32
    }
  ],
  "total_phrases": 15
}