    {
      "text": "य॒न्त्यथो॑ अ॒नयो॑रे॒व प्रति॑ तिष्ठन्त्ये॒ते",
      "start": 56.2,
      "end": 60.64
    },
    {
      "text": "वै य॒ज्ञ्स्या᳚ञ्ज॒साय॑नी स्रु॒ती ताभ्या॑मे॒व",
      "start": 60.64,
      "end": 68.68
    },
    {
      "text": "सु॑व॒र्गं ॅलो॒कं ॅय॑न्ति चतुर्विꣳशतिरा॒त्रो",
      "start": 68.68,
      "end": 69.72
    },
    {
      "text": "भ॑वति॒ चतु॑र्विꣳशतिरर्द्धमा॒साः सं॑ॅवथ्स॒रः सं॑ॅवथ्स॒रः",
      "start": 69.72,
      "end": 77.88
    },
    {
      "text": "सु॑व॒र्गो लो॒कः सं॑ॅवथ्स॒र ए॒व",
      "start": 77.88,
      "end": 83.28
    },
    {
      "text": "सु॑व॒र्गे लो॒के प्रति॑ तिष्ठ॒न्त्यथो॒",
      "start": 83.28,
      "end": 89.0
    },
    {
      "text": "चतु॑र्विꣳशत्यक्षरा गाय॒त्री गा॑य॒त्री ब्र॑ह्मवर्च॒सं",
      "start": 89.0,
      "end": 98.08
    },
    {
      "text": "गा॑यत्रि॒यैव ब्र॑ह्मवर्च॒समव॑ रुन्धते ऽतिरा॒त्राव॒भितो॑",
      "start": 98.08,
      "end": 107.56
    },
    {
      "text": "भवतो ब्रह्मवर्च॒सस्य॒ परि॑गृहीत्यै",
      "start": 107.56,
      "end": 113.84
    }
  ],
