  "phrases": [
    {
      "text": "सं॑ॅवथ्स॒रस्य॒ यत् फ॑ल्गुनी पूर्णमा॒सो",
      "start": 43.16,
      "end": 51.72
    },
    {
      "text": "मु॑ख॒त ए॒व सं॑ॅवथ्स॒रमा॒रभ्य॑ दीक्षन्ते॒",
      "start": 51.72,
      "end": 59.08
    },
    {
      "text": "तस्यैकै॒व नि॒र्या यथ् साम्मे᳚घ्ये",
      "start": 59.08,
      "end": 63.6
    },
    {
      "text": "विषू॒वान्थ् स॒पंद्य॑ते चित्रापूर्णमा॒से दी᳚क्षेर॒न्",
      "start": 63.6,
      "end": 74.64
    },
    {
      "text": "मुखं॒ ॅवा ए॒तथ् सं॑ॅवथ्स॒रस्य॒",
      "start": 74.64,
      "end": 80.4
    },
    {
      "text": "यच्चि॑त्रापूर्णमा॒सो मु॑ख॒त ए॒व सं॑ॅवथ्स॒रमा॒रभ्य॑",
      "start": 80.4,
      "end": 92.68
    },
    {
      "text": "दीक्षन्ते॒ तस्य॒ न का",
      "start": 92.68,
      "end": 98.2
    },
    {
      "text": "च॒न नि॒र्या भ॑वति चतुर॒हे",
      "start": 98.2,
      "end": 104.12
    },
    {
      "text": "पु॒रस्ता᳚त् पौर्णमा॒स्यै दी᳚क्षेर॒न् तेषा॑मेकाष्ट॒कायां᳚",
      "start": 104.12,
      "end": 108.08
    },
    {
      "text": "क्र॒यः सं प॑द्यते॒ तेनै॑काष्ट॒कां",
      "start": 108.08,
      "end": 108.08
    },
    {
      "text": "न छ॒म्बट् कु॑र्वन्ति॒ तेषां᳚",
      "start": 108.08,
      "end": 108.08
    },
