  "panchasat": 3,
  "phrases": [
    {
      "text": "-यं ॅवाव र॑थन्त॒रम॒सौ बृ॒हदा॒भ्यामे॒व",
      "start": 98.48,
      "end": 102.16
    },
    {
      "text": "य॒न्त्यथो॑ अ॒नयो॑रे॒व प्रति॑ तिष्ठन्त्ये॒ते",
      "start": 102.16,
      "end": 106.44
    },
    {
      "text": "वै य॒ज्ञ्स्या᳚ञ्ज॒साय॑नी स्रु॒ती ताभ्या॑मे॒व",
      "start": 106.44,
      "end": 111.28
    },
    {
      "text": "सु॑व॒र्गं ॅलो॒कं ॅय॑न्ति॒ परा᳚ञ्चो॒",
      "start": 111.28,
      "end": 115.6
    },
    {
      "text": "वा ए॒ते सु॑व॒र्गं ॅलो॒कम॒भ्यारो॑हन्ति॒",
      "start": 115.6,
      "end": 115.6
    },
    {
      "text": "ये परा॑चस्त्र्य॒हानु॑प॒यन्ति॑ प्र॒त्यङ् त्र्य॒हो",
      "start": 115.6,
      "end": 115.6
    },
    {
      "text": "भ॑वति प्र॒त्यव॑रूढ्या॒ अथो॒ प्रति॑ष्ठित्या",
      "start": 115.6,
      "end": 115.6
    },
    {
      "text": "उ॒भयो᳚र्लो॒कयोर्॑. ऋ॒द्ध्वोत् ति॑ष्ठन्ति॒ द्वात्रिꣳ॑शदे॒तास्तासां॒",
      "start": 115.6,
      "end": 115.6
    },
    {
      "text": "ॅया स्त्रिꣳ॒॒शत् त्रिꣳ॒॒शद॑क्षरा (",
      "start": 115.6,
      "end": 115.6
    },
    {
      "text": ") वि॒राडन्नं॑ ॅवि॒राड् वि॒राजै॒वाऽन्नाद्य॒मव॑",
      "start": 115.6,
      "end": 119.52
    },
    {
      "text": "रुन्धते॒ ये द्वे अ॑होरा॒त्रे",
      "start": 119.52,
      "end": 122.68
    },
    {
      "text": "ए॒व ते उ॒भाभ्याꣳ॑ रू॒पाभ्याꣳ॑",
      "start": 122.68,
      "end": 127.56
    },
    {
      "text": "सुव॒र्गं ॅलो॒कं ॅय॑न्त्यतिरा॒त्राव॒भितो॑ भवतः॒",
      "start": 127.56,
      "end": 137.96
    },
    {
      "text": "परि॑गृहीत्यै",
      "start": 137.96,
      "end": 140.28
    }
  ],
  "total_phrases": 14
}