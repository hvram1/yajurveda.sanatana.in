  "phrases": [
    {
      "text": "ॅवै द॑शरा॒त्रेण॑ प्र॒जाप॑तिः प्र॒जा",
      "start": 112.36,
      "end": 114.68
    },
    {
      "text": "अ॑सृजत॒ यद्-द॑शरा॒त्रो भव॑ति प्र॒जा",
      "start": 114.68,
      "end": 119.88
    },
    {
      "text": "ए॒व तद् यज॑मानाः सृजन्त",
      "start": 119.88,
      "end": 121.72
    },
    {
      "text": "ए॒ताꣳ ह॒ वा उ॑द॒ङ्कः",
      "start": 121.72,
      "end": 125.88
    },
    {
      "text": "शौ᳚ल्बाय॒नः स॒त्रस्यर्द्धि॑मुवाच॒ यद् द॑शरा॒त्रो",
      "start": 125.88,
      "end": 133.16
    },
    {
      "text": "यद् द॑शरा॒त्रो भव॑ति स॒त्रस्यर्द्ध्या॒",
      "start": 133.16,
      "end": 133.16
    },
    {
      "text": "अथो॒ यदे॒व पूर्वे॒ष्वह॑स्सु॒ विलो॑म",
      "start": 133.16,
      "end": 137.8
    },
    {
      "text": "क्रि॒यते॒ तस्यै॒वैषा शान्ति॑द्र्व्यनी॒का वा",
      "start": 137.8,
      "end": 143.72
    },
    {
      "text": "ए॒ता रात्र॑यो॒ यज॑माना विश्व॒जिथ्",
      "start": 143.72,
      "end": 150.12
    },
    {
      "text": "स॒हाति॑रा॒त्रेण॒ पूर्वाः॒ षोड॑श स॒हा",
      "start": 150.12,
      "end": 156.24
    },
    {
      "text": "( ) ति॑रा॒त्रेणोत्त॑राः॒ षोड॑श॒",
      "start": 156.24,
      "end": 163.28
    },
    {
      "text": "य ए॒वं ॅवि॒द्वाꣳस॑स्त्रयस्त्रिꣳशद॒हमास॑त॒ ऐषां᳚",
      "start": 163.28,
      "end": 169.52
    },
    {
      "text": "द्व्यनी॒का प्र॒जा जा॑यते ऽतिरा॒त्राव॒भितो॑",
      "start": 169.52,
      "end": 174.88
    },
    {
      "text": "भवतः॒ परि॑गृहीत्यै",
      "start": 174.88,
      "end": 176.88
    }
  ],
  "total_phrases": 14
}