  "phrases": [
    {
      "text": "तत् पुरु॑ष॒मनु॑ प॒र्याव॑र्तन्ते॒ त्रयः॑",
      "start": 98.48,
      "end": 105.36
    },
    {
      "text": "षड॒हा भ॑वन्ति॒ तान्य॒ष्टाद॒शाहा॑नि॒ सं",
      "start": 105.36,
      "end": 112.8
    },
    {
      "text": "प॑द्यन्ते॒ नवा॒न्यानि॒ नवा॒न्यानि॒ नव॒",
      "start": 112.8,
      "end": 116.6
    },
    {
      "text": "वै पुरु॑षे प्रा॒णास्तत् प्रा॒णाननु॑",
      "start": 116.6,
      "end": 123.88
    },
    {
      "text": "प॒र्याव॑र्तन्ते च॒त्वारः॑ षड॒हा भ॑वन्ति॒",
      "start": 123.88,
      "end": 129.52
    },
    {
      "text": "तानि॒ चतु॑र्विꣳशति॒रहा॑नि॒ सं प॑द्यन्ते॒",
      "start": 129.52,
      "end": 136.6
    },
    {
      "text": "चतु॑र्विꣳशतिरर्द्धमा॒साः सं॑ॅवथ्स॒रस्तथ् सं॑ॅवथ्स॒रमनु॑ प॒र्याव॑र्त॒न्ते",
      "start": 136.6,
      "end": 151.76
    },
    {
      "text": "ऽप्र॑तिष्ठितः संॅवथ्स॒र इति॒ खलु॒",
      "start": 151.76,
      "end": 151.76
    },
    {
      "text": "वा आ॑हु॒र्वर्.षी॑यान् प्रति॒ष्ठाया॒ इत्ये॒ताव॒द्वै",
      "start": 151.76,
      "end": 151.76
    },
    {
      "text": "( ) सं॑ॅवथ्स॒रस्य॒ ब्राह्म॑णं॒",
      "start": 151.76,
      "end": 151.76
    },
    {
      "text": "ॅयाव॑न्मा॒सो मा॒सिमा᳚स्ये॒व प्र॑ति॒तिष्ठ॑न्तो यन्ति",
      "start": 151.76,
      "end": 152.24
    }
  ],
  "total_phrases": 11
