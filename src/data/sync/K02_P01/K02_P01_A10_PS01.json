    {
      "text": "आ॒श्वि॒नं धू॒म्रल॑लाम॒मा ल॑भेत॒ यो",
      "start": 0.0,
      "end": 4.28
    },
    {
      "text": "दुर्ब्रा᳚ह्मणः॒ सोमं॒ पिपा॑सेद॒श्विनौ॒ वै",
      "start": 4.28,
      "end": 9.2
    },
    {
      "text": "दे॒वाना॒-मसो॑मपावास्तां॒ तौ प॒श्चा सो॑मपी॒थं",
      "start": 9.2,
      "end": 17.0
    },
    {
      "text": "प्राप्नु॑ता-म॒श्विना॑वे॒तस्य॑ दे॒वता॒ यो दुर्ब्रा᳚ह्मणः॒",
      "start": 17.0,
      "end": 17.0
    },
    {
      "text": "सोमं॒ पिपा॑सत्य॒श्विना॑वे॒व स्वेन॑ भाग॒धेये॒नोप॑",
      "start": 17.0,
      "end": 17.08
    },
    {
      "text": "धावति॒तावे॒वास्मै॑ सोमपी॒थं प्र य॑च्छत॒",
      "start": 17.08,
      "end": 17.08
    },
    {
      "text": "उपै॑नꣳ सोमपी॒थो न॑मति॒ यद्-धू॒म्रो",
      "start": 17.08,
      "end": 17.08
    },
    {
