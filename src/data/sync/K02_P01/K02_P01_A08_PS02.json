      "end": 55.32
    },
    {
      "text": "भ॑वत्ये॒तद्वै ब्रह्म॑णो रू॒पꣳ समृ॑द्ध्‌यै॒",
      "start": 55.32,
      "end": 55.32
    },
    {
      "text": "स्फ्यो यूपो॑ भवति॒ वज्रो॒",
      "start": 55.32,
      "end": 55.32
    },
    {
      "text": "वै स्फ्यो वज्र॑मे॒वास्मै॒ प्र",
