      "start": 95.76,
      "end": 100.64
    },
    {
      "text": "य॒ज्ञो दे॒वाना॒म् प्रत्ये॑ति सु॒म्नमादि॑त्यासो॒",
      "start": 100.64,
      "end": 109.12
    },
    {
      "text": "भव॑ता मृड॒यन्तः॑",
      "start": 109.12,
      "end": 113.8
    },
    {
      "text": "आ वो॒ऽर्वाची॑ सुम॒तिर्व॑वृत्यादꣳ॒॒ होश्चि॒द्या व॑रिवो॒वित्त॒राऽस॑त्",
      "start": 113.8,
      "end": 124.2
    },
    {
      "text": "शुचि॑र॒पः सू॒यव॑सा अद॑ब्ध॒ उप॑",
      "start": 124.2,
      "end": 130.6
