  "phrases": [
    {
      "text": "रू॒पेणै॒वाव॑ रुन्धे सोमापौ॒ष्णं त्रै॒तमा",
      "start": 183.32,
      "end": 189.48
    },
    {
      "text": "ल॑भेत प॒शुका॑मो॒द्वौ वा अ॒जायै॒",
      "start": 189.48,
      "end": 196.12
    },
    {
      "text": "स्तनौ॒ नानै॒व द्वाव॒भि जाये॑ते॒",
      "start": 196.12,
      "end": 197.16
    },
    {
      "text": "ऊर्जं॒ पुष्टिं॑ तृ॒तीयः॑सोमापू॒षणा॑वे॒व स्वेन॑",
      "start": 197.16,
      "end": 197.16
    },
    {
      "text": "भाग॒धेये॒नोप॑ धावति॒ तावे॒वास्मै॑ प॒शून्",
      "start": 197.16,
      "end": 197.16
    },
    {
      "text": "प्रज॑नयतः॒ सोमो॒ वै रे॑तो॒धाः",
      "start": 197.16,
      "end": 197.16
    },
    {
      "text": "पू॒षा प॑शू॒नां प्र॑जनयि॒ता सोम॑",
      "start": 197.16,
      "end": 197.16
    },
    {
      "text": "ए॒वास्मै॒ रेतो॒ दधा॑ति पू॒षा",
      "start": 197.16,
      "end": 200.68
    },
    {
      "text": "प॒शून् प्र ज॑नय॒त्यौदु॑म्बरो॒ यूपो॑",
      "start": 200.68,
      "end": 206.36
    },
    {
      "text": "( ) भव॒त्यूर्ग्वा उ॑दु॒म्बर॒",
      "start": 206.36,
      "end": 208.12
    },
    {
      "text": "ऊर्क् प॒शव॑ ऊ॒र्जैवास्मा॒ ऊर्जं॑",
      "start": 208.12,
      "end": 211.28
    },
    {
      "text": "प॒शूनव॑ रुन्धे",
      "start": 211.28,
      "end": 213.96
    }
  ],
  "total_phrases": 12
