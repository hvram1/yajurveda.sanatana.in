  "phrases": [
    {
      "text": "रुच॑मे॒वास्मि॑न् दधाति ब॒भ्रुः सौ॒म्यो",
      "start": 269.84,
      "end": 275.08
    },
    {
      "text": "भ॑वति ब्रह्मवर्च॒समे॒वास्मि॒न् त्विषिं॑ दधात्या-ग्ने॒यं",
      "start": 275.08,
      "end": 283.52
    },
    {
      "text": "कृ॒ष्णग्री॑व॒मा ल॑भेत सौ॒म्यं ब॒भ्रुमा᳚ग्ने॒यं",
      "start": 283.52,
      "end": 291.48
    },
    {
      "text": "कृ॒ष्णग्री॑वं पुरो॒धायाꣳ॒॒ स्पर्द्ध॑मान आग्ने॒यो",
      "start": 291.48,
      "end": 297.72
    },
    {
      "text": "वै ब्रा᳚ह्म॒णः सौ॒म्यो रा॑ज॒न्यो॑ऽभितः॑",
      "start": 297.72,
      "end": 299.56
    },
    {
      "text": "सौ॒म्यमा᳚ग्ने॒यौ भ॑वत॒-स्तेज॑सै॒व ब्रह्म॑णोभ॒यतो॑ रा॒ष्ट्रं",
      "start": 299.56,
      "end": 310.16
    },
    {
      "text": "परि॑ गृह्णात्येक॒धा स॒मा वृ॑ङ्क्ते",
      "start": 310.16,
      "end": 315.08
    },
    {
      "text": "पु॒र ए॑नं दधते",
      "start": 315.08,
      "end": 317.6
    }
  ],
  "total_phrases": 8
}