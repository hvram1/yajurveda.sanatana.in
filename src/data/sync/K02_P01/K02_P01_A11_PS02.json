    {
      "text": "हुवे तु॒राणां᳚",
      "start": 52.12,
      "end": 53.6
    },
    {
      "text": "आ यत् तृ॒पन्म॑रुतो वावशा॒नाः",
      "start": 53.6,
      "end": 57.36
    },
    {
      "text": "श्रि॒यसे॒ कं भा॒नुभिः॒ सं",
      "start": 57.36,
      "end": 58.36
    },
    {
      "text": "मि॑मिक्षिरे॒ ते र॒श्मिभि॒स्त ऋक्व॑भिः",
      "start": 58.36,
      "end": 58.36
    },
    {
      "text": "सुखा॒दयः॑",
      "start": 58.36,
      "end": 58.36
    },
    {
      "text": "ते वाशी॑मन्त इ॒ष्मिणो॒ अभी॑रवो",
      "start": 58.36,
      "end": 58.36
    },
    {
      "text": "वि॒द्रे प्रि॒यस्य॒ मारु॑तस्य॒ धाम्नः॑",
      "start": 58.36,
      "end": 64.12
    },
    {
      "text": "अ॒ग्निः प्र॑थ॒मो वसु॑भिर्नो अव्या॒थ्",
      "start": 64.12,
      "end": 71.84
    },
    {
      "text": "सोमो॑ रु॒द्रेभि॑र॒भि र॑क्षत॒ त्मना᳚",
      "start": 71.84,
      "end": 76.88
    },
    {
      "text": "इन्द्रो॑ म॒रुद्भि॑र् ऋतु॒धा कृ॑णोत्वादि॒त्यैर्नो॒",
      "start": 76.88,
      "end": 76.88
    },
    {
      "text": "वरु॑णः॒ सꣳ शि॑शातु",
      "start": 76.88,
      "end": 76.88
    },
    {
      "text": "सं नो॑ दे॒वो वसु॑भिर॒ग्निः",
      "start": 76.88,
      "end": 76.88
    },
