  "phrases": [
    {
      "text": "ए॒व भ॑वति कृ॒ष्णा भ॑वति",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "वारु॒णी ह्ये॑षा दे॒वत॑या॒ समृ॑द्ध्यै",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "मै॒त्रꣳ श्वे॒तमा ल॑भेत वारु॒णं",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "कृ॒ष्णम॒पां चौष॑धीनां च स॒धांवन्न॑कामो",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "मै॒त्रीर्वा ओष॑धयो वारु॒णीरापो॒ऽपां च॒",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "खलु॒ वा ओष॑धीनां च॒",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "रस॒मुप॑ जीवामो मि॒त्रावरु॑णावे॒व स्वेन॑",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "भाग॒धेये॒नोप॑ धावति॒ तावे॒वास्मा॒ अन्नं॒",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "प्रय॑च्छतोऽन्ना॒द ए॒व भ॑व -",
      "start": 47.56,
      "end": 47.56
    },
    {
      "text": "[ ]",
      "start": 47.56,
      "end": 47.56
    }
  ],
  "total_phrases": 10
