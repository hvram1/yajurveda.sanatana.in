  "phrases": [
    {
      "text": "वै रे॑तो॒धा अ॒ग्निः प्र॒जानां᳚",
      "start": 238.56,
      "end": 238.56
    },
    {
      "text": "प्रजनयि॒ता सोम॑ ए॒वास्मै॒ रेतो॒",
      "start": 238.56,
      "end": 238.64
    },
    {
      "text": "दधा᳚त्य॒ग्निः प्र॒जां प्रज॑नयति वि॒न्दते᳚",
      "start": 238.64,
      "end": 244.0
    },
    {
      "text": "प्र॒जामा᳚ग्ने॒यं कृ॒ष्णग्री॑व॒मा ल॑भेत सौ॒म्यं",
      "start": 244.0,
      "end": 254.72
    },
    {
      "text": "ब॒भ्रुं ॅयो ब्रा᳚ह्म॒णो वि॒द्याम॒नूच्य॒",
      "start": 254.72,
      "end": 260.88
    },
    {
      "text": "न वि॒रोचे॑त॒ यदा᳚ग्ने॒यो भव॑ति॒",
      "start": 260.88,
      "end": 263.4
    },
    {
      "text": "तेज॑ ए॒वास्मि॒न् तेन॑ दधाति॒",
      "start": 263.4,
      "end": 263.4
    },
    {
      "text": "यथ् सौ॒म्यो ब्र॑ह्मवर्च॒सं तेन॑",
      "start": 263.4,
      "end": 263.4
    },
    {
      "text": "कृ॒ष्णग्री॑व आग्ने॒यो भ॑वति॒ तम॑",
      "start": 263.4,
      "end": 263.44
    },
    {
      "text": "ए॒वास्मा॒दप॑ हन्ति श्वे॒तो भ॑वति॒",
      "start": 263.44,
      "end": 269.84
    },
