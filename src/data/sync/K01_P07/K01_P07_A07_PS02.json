  "phrases": [
    {
      "text": "न्तर॒मृत॑म॒फ्सु भे॑ष॒जम॒पामु॒त प्रश॑स्ति॒ष्वश्वा॑ भवथ वाजिनः",
      "start": 3.28,
      "end": 3.28
    },
    {
      "text": "वा॒युर् वा᳚ त्वा॒ मनु॑र्",
      "start": 3.28,
      "end": 3.28
    },
    {
      "text": "वा त्वा गन्ध॒र्वाः स॒प्तविꣳ॑शतिः",
      "start": 3.28,
      "end": 3.28
    },
    {
      "text": "ते अग्रे॒ अश्व॑मायुञ्ज॒न्ते अ॑स्मिञ्ज॒वमाऽद॑धुः",
      "start": 3.28,
      "end": 3.28
    },
    {
      "text": "अपां᳚ नपादाशुहेम॒न्॒. य ऊ॒र्मिः",
      "start": 3.28,
      "end": 3.72
    },
    {
      "text": "क॒कुद्मा॒न् प्रतू᳚र्तिर् वाज॒सात॑म॒स्तेना॒यं ॅवाजꣳ॑",
      "start": 3.72,
      "end": 5.28
    },
    {
      "text": "सेत्",
      "start": 5.28,
      "end": 5.28
    },
    {
      "text": "विष्णोः॒ क्रमो॑ऽसि॒ विष्णोः᳚ क्रा॒न्तम॑सि॒",
      "start": 5.28,
      "end": 5.8
    },
    {
      "text": "विष्णो॒र् विक्रा᳚न्तमस्य॒ङ्कौ न्य॒ङ्का (",
      "start": 5.8,
      "end": 5.84
    },
    {
      "text": ") व॒भितो॒ रथं॒ ॅयौ",
      "start": 5.84,
      "end": 5.84
    },
    {
      "text": "ध्वा॒न्तं ॅवा॑ता॒ग्रमनु॑ स॒ञ्चर॑न्तौ दू॒रेहे॑ति-रिन्द्रि॒यावा᳚न्",
      "start": 5.84,
      "end": 5.84
    },
    {
      "text": "पत॒त्री ते नो॒ऽग्नयः॒ पप्र॑यः",
      "start": 5.84,
      "end": 7.12
    },
    {
      "text": "पारयन्तु",
      "start": 7.12,
      "end": 7.16
    }
  ],
