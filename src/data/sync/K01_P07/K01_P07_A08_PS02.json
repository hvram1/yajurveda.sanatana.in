  "phrases": [
    {
      "text": "काष्ठां᳚ गच्छत॒ वाजे॑वाजेऽवत वाजिनो",
      "start": 12.32,
      "end": 14.2
    },
    {
      "text": "नो॒ धने॑षु विप्रा अमृता",
      "start": 14.2,
      "end": 14.24
    },
    {
      "text": "ऋतज्ञाः",
      "start": 14.24,
      "end": 14.4
    },
    {
      "text": "अ॒स्य मद्ध्वः॑ पिबत मा॒दय॑द्ध्वं",
      "start": 14.4,
      "end": 16.88
    },
    {
      "text": "तृ॒प्ता या॑त प॒थिभि॑र् देव॒यानैः᳚",
      "start": 16.88,
      "end": 22.0
    },
    {
      "text": "ते नो॒ अर्व॑न्तो हवन॒श्रुतो॒",
      "start": 22.0,
      "end": 22.0
    },
    {
      "text": "हवं॒ ॅविश्वे॑ शृण्वन्तु वा॒जिनः॑",
      "start": 22.0,
      "end": 23.28
    },
    {
      "text": "मि॒तद्र॑वः सहस्र॒सा मे॒धसा॑ता सनि॒ष्यवः॑",
      "start": 23.28,
      "end": 29.12
    },
    {
      "text": "म॒हो ये रत्नꣳ॑ समि॒थेषु॑",
      "start": 29.12,
      "end": 30.8
    },
    {
      "text": "जभ्रि॒रे शन्नो॑ भवन्तु वा॒जिनो॒",
      "start": 30.8,
      "end": 30.88
    },
    {
      "text": "हवे॑षु",
      "start": 30.88,
      "end": 30.88
    },
    {
      "text": "दे॒वता॑ता मि॒तद्र॑वः स्व॒र्काः",
      "start": 30.88,
      "end": 30.88
    },
    {
      "text": "जं॒भय॒न्तोऽहिं॒ ॅवृकꣳ॒॒ रक्षाꣳ॑सि॒ सने᳚म्य॒स्मद्यु॑यव॒",
