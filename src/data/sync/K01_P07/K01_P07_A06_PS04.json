    {
      "text": "मे॒वैतामा शा᳚स्ते॒ समि॑द्धो अग्ने",
      "start": 104.8,
      "end": 108.2
    },
    {
      "text": "मे दीदिहि समे॒द्धा ते॑",
      "start": 108.2,
      "end": 112.2
    },
    {
      "text": "अग्ने दीद्यास॒मित्या॑ह यथाय॒जु-रे॒वैतद्वसु॑मान्. य॒ज्ञो",
      "start": 112.2,
      "end": 114.56
    },
    {
      "text": "वसी॑यान् भूयास॒-मित्या॑हा॒-ऽऽशिष॑मे॒वेतामा शा᳚स्ते ब॒हु",
      "start": 114.56,
      "end": 118.24
    },
    {
      "text": "वै गार्.ह॑पत्य॒स्यान्ते॑ मि॒श्रमि॑व चर्यत",
      "start": 118.24,
      "end": 118.24
    },
    {
      "text": "आग्निपावमा॒नीभ्यां॒ गार्.ह॑पत्य॒मुप॑ तिष्ठते पु॒नात्ये॒वाग्निं",
      "start": 118.24,
      "end": 118.24
    },
    {
      "text": "पु॑नी॒त आ॒त्मानं॒ द्वाभ्यां॒ प्रति॑ष्ठित्या॒",
      "start": 118.24,
      "end": 118.24
    },
    {
      "text": "अग्ने॑ गृहपत॒ इत्या॑ह -",
      "start": 118.24,
      "end": 118.24
    },
