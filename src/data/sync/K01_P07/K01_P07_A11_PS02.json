    {
      "text": "वरु॑णो॒ दशा᳚क्षरेण वि॒राज॒-मुद॑जय॒दिन्द्र॒ एका॑दशाक्षरेण",
      "start": 68.28,
      "end": 76.6
    },
    {
      "text": "त्रि॒ष्टुभ॒-मुद॑जय॒द् विश्वे॑ दे॒वा द्वाद॑शाक्षरेण॒",
      "start": 76.6,
      "end": 84.04
    },
    {
      "text": "जग॑ती॒मुद॑जय॒न् वस॑व॒स्त्रयो॑ दशाक्षरेण त्रयोद॒शꣳ",
      "start": 84.04,
      "end": 93.8
    },
    {
      "text": "स्तोम॒मुद॑जयन् रु॒द्राश्चतु॑र्दशाक्षरेण चतुर्द॒शꣳ स्तोम॒मुद॑जयन्नादि॒त्याः",
      "start": 93.8,
      "end": 100.68
    },
    {
      "text": "पञ्च॑दशाक्षरेण पञ्चद॒शꣳ स्तोम॒मुद॑जय॒न्नदि॑तिः॒ षोड॑शाक्षरेण",
      "start": 100.68,
      "end": 105.44
    },
    {
      "text": "षोड॒शꣳ स्तोम॒मुद॑जयत् प्र॒जाप॑तिः स॒प्तद॑शाक्षरेण",
      "start": 105.44,
      "end": 107.6
    },
    {
      "text": "सप्तद॒शꣳ स्तोम॒मुद॑जयत्",
      "start": 107.6,
      "end": 112.88
    }
  ],
  "total_phrases": 7
