  "phrases": [
    {
      "text": "समु॑ब्जितः",
      "start": 47.12,
      "end": 48.8
    },
    {
      "text": "तेषां॒ ॅविशि॑प्रियाणा॒-मिष॒मूर्जꣳ॒॒ सम॑ग्रभी-मे॒ष ते॒",
      "start": 48.8,
      "end": 54.76
    },
    {
      "text": "योनि॒रिन्द्रा॑य त्वा",
      "start": 54.76,
      "end": 56.88
    },
    {
      "text": "अ॒पाꣳ रस॒मुद्व॑यसꣳ॒॒ सूर्य॑रश्मिꣳ स॒माभृ॑तं",
      "start": 56.88,
      "end": 62.2
    },
    {
      "text": "अ॒पाꣳ रस॑स्य॒ यो रस॒स्तं",
      "start": 62.2,
      "end": 62.28
    },
    {
      "text": "ॅवो॑ गृह्णाम्युत्त॒ममे॒ष ते॒ योनि॒रिन्द्रा॑य",
      "start": 62.28,
      "end": 62.28
    },
    {
      "text": "त्वा",
      "start": 62.28,
      "end": 62.28
    },
    {
      "text": "अ॒या वि॒ष्ठा ज॒नय॒न् कर्व॑राणि॒",
      "start": 62.28,
      "end": 62.28
    },
    {
      "text": "स हि घृणि॑रु॒रुर् वरा॑य",
      "start": 62.28,
      "end": 62.28
    },
    {
      "text": "गा॒तुः",
      "start": 62.28,
      "end": 62.28
    },
    {
      "text": "स प्रत्युदै᳚द् ध॒रुणो मद्ध्वो॒",
      "start": 62.28,
      "end": 62.28
    },
    {
      "text": "अग्रꣳ॒॒ स्वायां॒ ॅयत् त॒नुवां᳚",
      "start": 62.28,
      "end": 62.28
    },
    {
      "text": "( ) त॒नूमैर॑यत",
      "start": 62.28,
      "end": 62.28
    },
    {
      "text": "उ॒प॒या॒मगृ॑हीतोऽसि प्र॒जाप॑तये त्वा॒ जुष्टं॑",
      "start": 62.28,
      "end": 69.6
    },
    {
      "text": "गृह्णाम्ये॒ष ते॒ योनिः॑ प्र॒जाप॑तये",
      "start": 69.6,
      "end": 76.52
    },
    {
      "text": "त्वा",
      "start": 76.52,
      "end": 77.16
    }
  ],
