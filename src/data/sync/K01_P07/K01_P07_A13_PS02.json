    {
      "text": "मर॑ते॒ पतिः॑",
      "start": 51.32,
      "end": 54.24
    },
    {
      "text": "नाहमि॑न्द्राणि रारण॒ सख्यु॑र् वृ॒षाक॑पेर्. ऋ॒ते",
      "start": 54.24,
      "end": 61.52
    },
    {
      "text": "यस्ये॒दमप्यꣳ॑ ह॒विः प्रि॒यं दे॒वेषु॒ गच्छ॑ति",
      "start": 61.52,
      "end": 72.4
    },
    {
      "text": "यो जा॒त ए॒व प्र॑थ॒मो",
      "start": 72.4,
      "end": 75.32
    },
    {
      "text": "मन॑स्वान् दे॒वो दे॒वान् क्रतु॑ना",
      "start": 75.32,
      "end": 78.84
    },
    {
      "text": "प॒र्यभू॑षत्",
      "start": 78.84,
      "end": 81.36
    },
    {
      "text": "यस्य॒ शुष्मा॒द्रोद॑सी॒ अभ्य॑सेतां नृं॒णस्य॑",
      "start": 81.36,
      "end": 91.32
    },
    {
      "text": "म॒ह्ना स ज॑नास॒ इन्द्रः॑",
      "start": 91.32,
      "end": 96.96
    },
    {
      "text": "आ ते॑ म॒ह इ॑न्द्रो॒त्यु॑ग्र॒",
      "start": 96.96,
      "end": 105.96
    },
    {
      "text": "सम॑न्यवो॒ यथ् स॒मर॑न्त॒ सेनाः᳚",
      "start": 105.96,
      "end": 112.8
    },
    {
      "text": "पता॑ति दि॒द्युन्नर्य॑स्य बाहु॒वोर् मा",
      "start": 112.8,
      "end": 117.84
