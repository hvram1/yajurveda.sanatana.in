      "start": 191.96,
      "end": 191.96
    },
    {
      "text": "यज॑ते॒ तम॒भि नि व॑र्तते",
      "start": 191.96,
      "end": 191.96
    },
    {
      "text": "य॒ज्ञो ब॑भूव॒ स आ",
      "start": 191.96,
      "end": 191.96
    },
    {
      "text": "ब॑भू॒वेत्या॑है॒ष वै य॒ज्ञ्स्य॑ पुनरालं॒भ-स्तेनै॒वैनं॒",
      "start": 191.96,
      "end": 191.96
    },
    {
      "text": "पुन॒रा ल॑भ॒तेऽन॑वरुद्धा॒ वा ए॒तस्य॑",
      "start": 191.96,
      "end": 195.16
    },
    {
      "text": "वि॒राड् य आहि॑ताग्निः॒ सन्न॑स॒भः",
