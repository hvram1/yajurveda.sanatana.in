    {
      "text": "सा॒मि मा᳚र्जयन्त ए॒तत् प्रति॒",
      "start": 132.56,
      "end": 132.56
    },
    {
      "text": "वा असु॑राणां ॅय॒ज्ञो व्य॑च्छिद्यत॒",
      "start": 132.56,
      "end": 132.56
    },
    {
      "text": "ब्रह्म॑णा दे॒वाः सम॑दधु॒र् बृह॒स्पति॑",
      "start": 132.56,
      "end": 132.56
    },
    {
      "text": "-स्तनुतामि॒मं न॒ इत्या॑ह॒ ब्रह्म॒",
      "start": 132.56,
      "end": 132.56
