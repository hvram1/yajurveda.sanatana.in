  "phrases": [
    {
      "text": "य॒ज्ञे दक्षि॑णां॒ ददा॑ति॒ ताम॑स्य",
      "start": 171.92,
      "end": 177.96
    },
    {
      "text": "प॒शवोऽनु॒ सं क्रा॑मन्ति॒ स",
      "start": 177.96,
      "end": 183.84
    },
    {
      "text": "ए॒ष ई॑जा॒नो॑ऽप॒शुर् भावु॑को॒ यज॑मानेन॒",
      "start": 183.84,
      "end": 192.0
    },
    {
      "text": "खलु॒ वै तत्का॒र्य॑-मित्या॑हु॒र् यथा॑",
      "start": 192.0,
      "end": 199.84
    },
    {
      "text": "देव॒त्रा द॒त्तं कु॑र्वी॒तात्मन् प॒शून्",
      "start": 199.84,
      "end": 209.6
    },
    {
      "text": "र॒मये॒तेति॒ ब्रद्ध्न॒ पिन्व॒स्वेत्या॑ह य॒ज्ञो",
      "start": 209.6,
      "end": 209.6
    },
    {
      "text": "वै ब्र॒द्ध्नो य॒ज्ञ्मे॒व तन्म॑हय॒त्यथो॑",
      "start": 209.6,
      "end": 209.6
    },
    {
      "text": "देव॒त्रैव द॒त्तं कु॑रुत आ॒त्मन्",
      "start": 209.6,
      "end": 209.6
    },
    {
      "text": "प॒शून् र॑मयते॒ दद॑तो मे॒",
      "start": 209.6,
      "end": 209.6
    },
    {
      "text": "( ) मा क्षा॒यीत्या॒हाक्षि॑ति-मे॒वोपै॑ति",
      "start": 209.6,
      "end": 209.6
    },
    {
      "text": "कुर्व॒तो मे॒ मोप॑ दस॒दित्या॑ह",
      "start": 209.6,
      "end": 209.6
    },
    {
      "text": "भू॒मान॑मे॒वोपै॑ति",
      "start": 209.6,
      "end": 211.04
    }
  ],
