  "phrases": [
    {
      "text": "वाज॑स्ये॒मं प्र॑स॒वः सु॑षुवे॒ अग्रे॒",
      "start": 0.0,
      "end": 9.84
    },
    {
      "text": "सोमꣳ॒॒ राजा॑न॒मोष॑धीष्व॒फ्सु",
      "start": 9.84,
      "end": 15.0
    },
    {
      "text": "ता अ॒स्मभ्यं॒ मधु॑मतीर् भवन्तु",
      "start": 15.0,
      "end": 17.64
    },
    {
      "text": "व॒यꣳ रा॒ष्ट्रे जा᳚ग्रियाम पु॒रोहि॑ताः",
      "start": 17.64,
      "end": 17.64
    },
    {
      "text": "वाज॑स्ये॒दं प्र॑स॒व आ ब॑भूवे॒मा",
      "start": 17.64,
      "end": 23.32
    },
    {
      "text": "च॒ विश्वा॒ भुव॑नानि स॒र्वतः॑",
      "start": 23.32,
      "end": 25.0
    },
    {
      "text": "स वि॒राजं॒ पर्ये॑ति प्रजा॒नन्",
      "start": 25.0,
      "end": 25.0
    },
    {
      "text": "प्र॒जां पुष्टिं॑ ॅव॒र्द्धय॑मानो अ॒स्मे",
      "start": 25.0,
      "end": 25.0
    },
    {
      "text": "वाज॑स्ये॒मां प्र॑स॒वः शि॑श्रिये॒ दिव॑मि॒मा",
      "start": 25.0,
      "end": 25.0
    },
    {
      "text": "च॒ विश्वा॒ भुव॑नानि स॒म्राट्",
      "start": 25.0,
      "end": 25.0
    },
    {
      "text": "अदि॑थ्सन्तं दापयतु प्रजा॒नन् र॒यिं",
      "start": 25.0,
      "end": 25.0
    },
    {
