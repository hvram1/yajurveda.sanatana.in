    {
      "text": "पा॒क॒य॒ज्ञ्ं ॅवा अन्वाहि॑ताग्नेः प॒शव॒",
      "start": 0.0,
      "end": 8.36
    },
    {
      "text": "उप॑ तिष्ठन्त॒ इडा॒ खलु॒",
      "start": 8.36,
      "end": 14.16
    },
    {
      "text": "वै पा॑कय॒ज्ञ्ः सैषाऽन्त॒रा प्र॑याजानूया॒जान्.",
      "start": 14.16,
      "end": 24.44
    },
    {
      "text": "यज॑मानस्य लो॒केऽव॑हिता॒ तामा᳚ह्रि॒यमा॑णाम॒भि म॑न्त्रयेत॒",
      "start": 24.44,
      "end": 32.72
    },
    {
      "text": "सुरू॑पवर्.षवर्ण॒ एहीति॑ प॒शवो॒ वा",
      "start": 32.72,
      "end": 32.72
    },
    {
      "text": "इडा॑ प॒शूने॒वोप॑ ह्वयते य॒ज्ञ्ं",
      "start": 32.72,
      "end": 32.72
    },
    {
      "text": "ॅवै दे॒वा अदु॑ह्रन्. य॒ज्ञोऽसु॑राꣳ",
      "start": 32.72,
      "end": 32.76
    },
    {
      "text": "अदुह॒त् तेऽसु॑रा ॒ज्ञ्दु॑ग्धाः॒ परा॑ऽभव॒न्॒.",
      "start": 32.76,
      "end": 32.76
    },
    {
      "text": "यो वै य॒ज्ञ्स्य॒ दोहं॑",
      "start": 32.76,
      "end": 32.76
