  "phrases": [
    {
      "text": "यान्ये॒वैनं॑ भू॒तानि॑ व्र॒तमु॑प॒यन्त॑-मनूप॒यन्ति॒ तैरे॒व",
      "start": 97.84,
      "end": 100.28
    },
    {
      "text": "स॒हाव॑भृ॒थमवै॑ति॒ विष्णु॑मुखा॒ वै दे॒वा",
      "start": 100.28,
      "end": 105.28
    },
    {
      "text": "श्छन्दो॑भिरि॒मान् ॅलो॒का-न॑नपज॒य्यम॒भ्य॑जय॒न्॒. यद्-वि॑ष्णुक्र॒मान् क्रम॑ते॒",
      "start": 105.28,
      "end": 108.56
    },
    {
      "text": "विष्णु॑रे॒व भू॒त्वा यज॑मान॒श्छन्दो॑भिरि॒मान् ॅलो॒का-न॑नपज॒य्यम॒भि",
      "start": 108.56,
      "end": 116.24
    },
    {
      "text": "ज॑यति॒ विष्णोः॒ क्रमो᳚ऽस्यभिमाति॒हेत्या॑ह गाय॒त्री",
      "start": 116.24,
      "end": 121.28
    },
    {
      "text": "वै पृ॑थि॒वी त्रैष्टु॑भम॒न्तरि॑क्षं॒ जाग॑ती॒",
      "start": 121.28,
      "end": 132.0
    },
    {
      "text": "द्यौरानु॑ष्टुभी॒र् दिश॒ श्छन्दो॑भिरे॒वेमान् ॅलो॒कान्.",
      "start": 132.0,
      "end": 139.4
    },
    {
      "text": "य॑थापू॒र्वम॒भि ज॑यति",
      "start": 139.4,
      "end": 141.44
    }
