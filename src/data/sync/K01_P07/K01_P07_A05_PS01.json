  "phrases": [
    {
      "text": "ध्रु॒वां ॅवै रिच्य॑मानां ॅय॒ज्ञोऽनु॑",
      "start": 0.0,
      "end": 4.92
    },
    {
      "text": "रिच्यते य॒ज्ञ्ं ॅयज॑मानो॒ यज॑मानं",
      "start": 4.92,
      "end": 7.12
    },
    {
      "text": "प्र॒जा ध्रु॒वामा॒प्याय॑मानां ॅय॒ज्ञोऽन्वा प्या॑यते",
      "start": 7.12,
      "end": 14.88
    },
    {
      "text": "य॒ज्ञ्ं ॅयज॑मानो॒ यज॑मानं प्र॒जा",
      "start": 14.88,
      "end": 19.6
    },
    {
      "text": "आ प्या॑यतां ध्रु॒वा घृ॒तेनेत्या॑ह",
      "start": 19.6,
      "end": 19.6
    },
    {
      "text": "ध्रु॒वामे॒वा ऽऽ प्या॑ययति॒ तामा॒प्याय॑मानां",
      "start": 19.6,
      "end": 19.6
    },
    {
      "text": "ॅय॒ज्ञोऽन्वा प्या॑यते य॒ज्ञ्ं ॅयज॑मानो॒",
      "start": 19.6,
      "end": 26.4
    },
    {
      "text": "यज॑मानं प्र॒जाः प्र॒जाप॑तेर् वि॒भान्नाम॑",
      "start": 26.4,
      "end": 32.88
    },
    {
      "text": "लो॒कस्तस्मिꣳ॑स्त्वा दधामि स॒ह यज॑माने॒नेत्या॑",
      "start": 32.88,
      "end": 42.28
    },
