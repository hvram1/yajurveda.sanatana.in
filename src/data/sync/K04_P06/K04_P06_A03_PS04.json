      "start": 145.68,
      "end": 150.24
    },
    {
      "text": "अथा॑ स॒पत्नाꣳ॒॒ इन्द्रो॑ मे",
      "start": 150.24,
      "end": 155.68
    },
    {
      "text": "निग्रा॒भेणाध॑राꣳ अकः",
      "start": 155.68,
      "end": 158.72
    },
    {
      "text": "उ॒द्ग्रा॒भं च॑ निग्रा॒भं च॒",
      "start": 158.72,
      "end": 165.88
    },
    {
