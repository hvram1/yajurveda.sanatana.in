  "phrases": [
    {
      "text": "च॑ष्टे घृ॒ताची॑रन्त॒रा पूर्व॒मप॑रं च के॒तुं",
      "start": 103.6,
      "end": 112.48
    },
    {
      "text": "उ॒क्षा स॑मु॒द्रो अ॑रु॒णः सु॑प॒र्णः",
      "start": 112.48,
      "end": 118.2
    },
    {
      "text": "पूर्व॑स्य॒ योनिं॑ पि॒तुरा वि॑वेश",
      "start": 118.2,
      "end": 124.32
    },
    {
      "text": "मद्ध्ये॑ दि॒वो निहि॑तः॒ पृश्नि॒रश्मा॒",
      "start": 124.32,
      "end": 127.44
    },
    {
      "text": "वि च॑क्रमे॒ रज॑सः पा॒त्यन्तौ᳚",
      "start": 127.44,
      "end": 130.8
    },
    {
      "text": "इन्द्रं॒ ॅविश्वा॑ अवीवृधन्थ् समु॒द्रव्य॑चसं॒ गिरः॑",
      "start": 130.8,
      "end": 133.04
    },
    {
      "text": "र॒थीत॑मꣳ रथी॒नां ॅवाजा॑नाꣳ॒॒ सत्प॑तिं॒ पतिं᳚",
      "start": 133.04,
      "end": 137.84
    },
    {
      "text": "सु॒म्न॒हूर्य॒ज्ञो दे॒वाꣳ आ च॑",
      "start": 137.84,
      "end": 141.72
    },
    {
      "text": "वक्ष॒द्यक्ष॑द॒ग्निर्दे॒वो दे॒वाꣳ आ च॑",
      "start": 141.72,
      "end": 145.04
    },
    {
      "text": "वक्षत्",
      "start": 145.04,
      "end": 145.68
    },
