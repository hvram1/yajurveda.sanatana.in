  "phrases": [
    {
      "text": "-दे॑नꣳ सौश्रव॒साय॑ जिन्वति",
      "start": 49.72,
      "end": 52.56
    },
    {
      "text": "यद्ध॒विष्य॑मृतु॒शो दे॑व॒यानं॒ त्रिर्मानु॑षाः॒ पर्यश्वं॒ नय॑न्ति",
      "start": 52.56,
      "end": 61.48
    },
    {
      "text": "अत्रा॑ पू॒ष्णः प्र॑थ॒मो भा॒ग",
      "start": 61.48,
      "end": 66.48
    },
    {
      "text": "ए॑ति य॒ज्ञ्ं दे॒वेभ्यः॑ प्रतिवे॒दय॑न्न॒जः",
      "start": 66.48,
      "end": 66.52
    },
    {
      "text": "होता᳚ऽद्ध्व॒र्युराव॑या अग्निमि॒न्धो ग्रा॑वग्रा॒भ उ॒त",
      "start": 66.52,
      "end": 71.4
    },
    {
      "text": "शꣳस्ता॒ सुवि॑प्रः",
      "start": 71.4,
      "end": 74.96
    },
    {
      "text": "तेन॑ य॒ज्ञेन॒ स्व॑रंकृतेन॒ स्वि॑ष्टेन",
      "start": 74.96,
      "end": 80.8
    },
    {
      "text": "व॒क्षणा॒ आ पृ॑णद्ध्वं",
      "start": 80.8,
      "end": 84.88
    },
    {
      "text": "यू॒प॒व्र॒स्का उ॒त ये यू॑पवा॒हाश्च॒षालं॒",
      "start": 84.88,
      "end": 92.64
    },
    {
      "text": "ॅये अ॑श्वयू॒पाय॒ तक्ष॑ति",
