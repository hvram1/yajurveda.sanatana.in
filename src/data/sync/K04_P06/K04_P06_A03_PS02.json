    {
      "text": "अग्ने॒ भर॑न्तु॒ चित्ति॑भिः",
      "start": 43.6,
      "end": 50.72
    },
    {
      "text": "स नो॑ भव शि॒वत॑मः",
      "start": 50.72,
      "end": 55.64
    },
    {
      "text": "सु॒प्रती॑को वि॒भाव॑सुः",
      "start": 55.64,
      "end": 57.4
    },
    {
      "text": "पञ्च॒ दिशो॒ दैवी᳚र्य॒ज्ञ्म॑वन्तु दे॒वीरपाम॑तिं",
      "start": 57.4,
      "end": 57.4
    },
    {
      "text": "दुर्म॒तिं बाध॑मानाः",
      "start": 57.4,
      "end": 57.4
    },
    {
      "text": "रा॒यस्पोषे॑ य॒ज्ञ्प॑ति-मा॒भज॑न्तीः",
      "start": 57.4,
      "end": 57.4
    },
    {
      "text": "रा॒यस्पोषे॒ अधि॑ य॒ज्ञो अ॑स्था॒थ्",
      "start": 57.4,
      "end": 57.4
    },
    {
      "text": "समि॑द्धे अ॒ग्नावधि॑ मामहा॒नः",
      "start": 57.4,
      "end": 57.4
    },
    {
      "text": "उ॒क्थप॑त्र॒ ईड्यो॑ गृभी॒तस्त॒प्तं घ॒र्मं प॑रि॒गृह्या॑यजन्त",
      "start": 57.4,
      "end": 57.4
    },
    {
      "text": "ऊ॒र्जा यद्-य॒ज्ञ्मश॑मन्त दे॒वा दैव्या॑य",
      "start": 57.4,
      "end": 57.4
    },
    {
      "text": "ध॒र्त्रे जोष्ट्रे᳚",
      "start": 57.4,
      "end": 57.4
    },
    {
      "text": "दे॒व॒श्रीः श्रीम॑णाः श॒तप॑याः -",
