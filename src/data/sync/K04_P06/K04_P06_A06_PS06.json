      "start": 224.64,
      "end": 227.88
    },
    {
      "text": "इन्द्र॑स्य॒ वज्रो॑ म॒रुता॒मनी॑कं मि॒त्रस्य॒",
      "start": 227.88,
      "end": 236.44
    },
    {
      "text": "गर्भो॒ वरु॑णस्य॒ नाभिः॑",
      "start": 236.44,
      "end": 239.76
