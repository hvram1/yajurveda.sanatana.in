      "end": 239.76
    },
    {
      "text": "गृ॑भाय",
      "start": 239.76,
      "end": 239.76
    },
    {
      "text": "उप॑ श्वासय पृथि॒वीमु॒त द्यां",
      "start": 239.76,
      "end": 239.76
    },
    {
      "text": "पु॑रु॒त्रा ते॑ मनुतां॒ ॅविष्ठि॑तं॒",
