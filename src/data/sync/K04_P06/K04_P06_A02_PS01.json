    {
      "text": "य इ॒मा विश्वा॒ भुव॑नानि॒",
      "start": 0.0,
      "end": 3.4
    },
    {
      "text": "जुह्व॒दृषि॒र्॒.होता॑ निष॒सादा॑ पि॒ता नः॑",
      "start": 3.4,
      "end": 11.04
    },
    {
      "text": "स आ॒शिषा॒ द्रवि॑णमि॒च्छमा॑नः परम॒च्छदो॒",
      "start": 11.04,
      "end": 20.56
    },
    {
      "text": "वर॒ आ वि॑वेश",
      "start": 20.56,
      "end": 22.56
    },
    {
      "text": "वि॒श्वक॑र्मा॒ मन॑सा॒ यद्विहा॑या धा॒ता",
      "start": 22.56,
      "end": 23.52
    },
    {
      "text": "वि॑धा॒ता प॑र॒मोत स॒न्दृक्",
      "start": 23.52,
      "end": 29.16
    },
    {
      "text": "तेषा॑मि॒ष्टानि॒ समि॒षा म॑दन्ति॒ यत्र॑",
      "start": 29.16,
      "end": 35.36
    },
    {
      "text": "सप्त॒र्॒.षीन् प॒र एक॑मा॒हुः",
      "start": 35.36,
      "end": 40.92
    },
    {
      "text": "यो नः॑ पि॒ता ज॑नि॒ता",
      "start": 40.92,
      "end": 45.28
    },
    {
      "text": "यो वि॑धा॒ता यो नः॑",
      "start": 45.28,
      "end": 45.6
    },
    {
      "text": "स॒तो अ॒भ्या सज्ज॒जान॑",
      "start": 45.6,
      "end": 49.24
    }
  ],
