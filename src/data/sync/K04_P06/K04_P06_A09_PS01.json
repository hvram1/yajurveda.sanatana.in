    {
      "text": "ये वा॒जिनं॑ परि॒पश्य॑न्ति प॒क्वं",
      "start": 0.0,
      "end": 5.76
    },
    {
      "text": "ॅय ई॑मा॒हुः सु॑र॒भिर्निर्.ह॒रेति॑",
      "start": 5.76,
      "end": 10.72
    },
    {
      "text": "ये चार्व॑तो माꣳसभि॒क्षामु॒पास॑त उ॒तो",
      "start": 10.72,
      "end": 17.04
    },
    {
      "text": "तेषा॑म॒भिगू᳚र्तिर्न इन्वतु",
      "start": 17.04,
      "end": 19.2
