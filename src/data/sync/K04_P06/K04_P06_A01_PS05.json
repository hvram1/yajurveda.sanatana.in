      "end": 153.24
    },
    {
      "text": "भ॑व",
      "start": 153.24,
      "end": 153.84
    },
    {
      "text": "अ॒ग्निस्ति॒ग्मेन॑ शो॒चिषा॒ यꣳस॒द्विश्वं॒ न्य॑त्रिणं᳚",
      "start": 153.84,
      "end": 154.16
    },
    {
      "text": "अ॒ग्निर्नो॑ वꣳसते र॒यिं",
      "start": 154.16,
      "end": 158.2
    },
    {
      "text": "सैनाऽनी॑केन सुवि॒दत्रो॑ अ॒स्मे यष्टा॑",
      "start": 158.2,
      "end": 166.32
    },
    {
      "text": "दे॒वाꣳ आय॑जिष्ठः स्व॒स्ति",
      "start": 166.32,
      "end": 171.84
    },
    {
      "text": "अद॑ब्धो गो॒पा उ॒त नः॑",
      "start": 171.84,
      "end": 176.48
    },
    {
      "text": "पर॒स्पा अग्ने᳚ द्यु॒मदु॒त रे॒वद्-दि॑दीहि",
