  "phrases": [
    {
      "text": "अ॑पान॒दा व्या॑न॒दाश्च॑क्षु॒र्दा व॑र्चो॒दा व॑रिवो॒दाः",
      "start": 148.4,
      "end": 148.4
    },
    {
      "text": "अ॒न्यं ते॑ अ॒स्मत् त॑पन्तु",
      "start": 148.4,
      "end": 148.4
    },
    {
      "text": "हे॒तयः॑ पाव॒को अ॒स्मभ्यꣳ॑ शि॒वो",
