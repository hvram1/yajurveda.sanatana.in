    },
    {
      "text": "यु॒द्ध्मो घ॑नाघ॒नः क्षोभ॑ण-श्चर्.षणी॒नां",
      "start": 3.16,
      "end": 10.72
    },
    {
      "text": "सं॒क्रन्द॑नोऽनिमि॒ष ए॑क वी॒रः श॒तꣳ",
      "start": 10.72,
      "end": 14.52
    },
    {
      "text": "सेना॑ अजयथ् सा॒कमिन्द्रः॑",
      "start": 14.52,
      "end": 18.4
    },
    {
      "text": "सं॒क्रन्द॑नेना निमि॒षेण॑ जि॒ष्णुना॑ युत्का॒रेण॑",
      "start": 18.4,
      "end": 26.28
    },
    {
      "text": "दुश्च्यव॒नेन॑ धृ॒ष्णुना᳚",
      "start": 26.28,
      "end": 29.84
