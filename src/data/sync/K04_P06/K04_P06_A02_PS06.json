  "phrases": [
    {
      "text": "मनो॒युजं॒ ॅवाजे॑ अ॒द्या हु॑वेम",
      "start": 185.64,
      "end": 188.28
    },
    {
      "text": "स नो॒ नेदि॑ष्ठा॒ हव॑नानि",
      "start": 188.28,
      "end": 193.32
    },
    {
      "text": "जोषते वि॒श्वश॑भूं॒रव॑से सा॒धुक॑र्मा",
      "start": 193.32,
      "end": 200.92
    },
    {
      "text": "विश्व॑कर्मन्. ह॒विषा॑ वावृधा॒नः स्व॒यं",
      "start": 200.92,
      "end": 206.92
    },
    {
      "text": "ॅय॑जस्व त॒नुवं॑ जुषा॒णः",
      "start": 206.92,
      "end": 210.72
    },
    {
      "text": "मुह्य॑न्त्व॒न्ये अ॒भितः॑ स॒पत्ना॑ इ॒हास्माकं॑",
      "start": 210.72,
      "end": 222.6
    },
    {
      "text": "म॒घवा॑ सू॒रिर॑स्तु",
      "start": 222.6,
      "end": 225.72
    },
    {
      "text": "विश्व॑कर्मन्. ह॒विषा॒ वर्द्ध॑नेन त्रा॒तार॒मिन्द्र॑-मकृणोरव॒द्ध्यं",
      "start": 225.72,
      "end": 225.72
    },
    {
      "text": "तस्मै॒ विशः॒ सम॑नमन्त पू॒र्वीर॒यमु॒ग्रो",
      "start": 225.72,
      "end": 225.72
    },
    {
      "text": "वि॑ह॒व्यो॑ यथाऽस॑त्",
      "start": 225.72,
      "end": 225.72
    },
    {
      "text": "स॒मु॒द्राय॑ व॒युना॑य॒ सिन्धू॑नां॒ पत॑ये॒",
      "start": 225.72,
      "end": 225.72
    },
    {
      "text": "नमः॑ ( )",
      "start": 225.72,
      "end": 225.72
    },
    {
      "text": "न॒दीनाꣳ॒॒ सर्वा॑सां पि॒त्रे जु॑हु॒ता",
      "start": 225.72,
      "end": 230.2
    },
    {
      "text": "वि॒श्वक॑र्मणे॒ विश्वाऽहाम॑र्त्यꣳ ह॒विः",
      "start": 230.2,
      "end": 237.48
    }
  ],
