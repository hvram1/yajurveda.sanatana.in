    {
      "text": "अ॒ग्नेर्वै दी॒क्षया॑ दे॒वा वि॒राज॑माप्नुवन्",
      "start": 0.0,
      "end": 0.88
    },
    {
      "text": "ति॒स्रो रात्री᳚र्दीक्षि॒तः स्या᳚त् त्रि॒पदा॑",
      "start": 0.88,
      "end": 5.2
