  "phrases": [
    {
      "text": "-स्त्रिषा॑हस्रो॒ वा अ॒सौ लो॒को॑",
      "start": 83.88,
      "end": 83.88
    },
    {
      "text": "ऽमुमे॒व लो॒कम॒भि ज॑यति जानुद॒घ्नं",
      "start": 83.88,
      "end": 83.88
    },
    {
      "text": "चि॑न्वीत प्रथ॒मं चि॑न्वा॒नो गा॑यत्रि॒यैवेमं",
      "start": 83.88,
      "end": 83.88
    },
    {
      "text": "ॅलो॒कम॒भ्यारो॑हति नाभिद॒घ्नं चि॑न्वीत द्वि॒तीयं॑",
      "start": 83.88,
      "end": 83.88
    },
    {
      "text": "चिन्वा॒नस्त्रि॒ष्टुभै॒वा-न्तरि॑क्ष-म॒भ्यारो॑हति ग्रीवद॒घ्नं चि॑न्वीत तृ॒तीयं॑",
      "start": 83.88,
      "end": 83.88
    },
    {
      "text": "चिन्वा॒नो जग॑त्यै॒वामुन् ॅलो॒कम॒भ्यारो॑हति॒ नाग्निं",
      "start": 83.88,
      "end": 83.88
    },
    {
      "text": "चि॒त्वा रा॒मामुपे॑यादयो॒नौ रेतो॑ धास्या॒मीति॒",
      "start": 83.88,
      "end": 83.88
    },
    {
      "text": "न द्वि॒तीयं॑ चि॒त्वाऽन्यस्य॒ स्त्रिय॒",
