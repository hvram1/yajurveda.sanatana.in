  "phrases": [
    {
      "text": "त्रिꣳ॒॒शद॑क्षरा वि॒राड् वि॒राज॑माप्नोति॒ मासं॑",
      "start": 93.16,
      "end": 101.04
    },
    {
      "text": "दीक्षि॒तः स्या॒द्-यो मासः॒ स",
      "start": 101.04,
      "end": 104.12
    },
    {
      "text": "सं॑ॅवथ्स॒रः सं॑ॅवथ्स॒रो वि॒राड् वि॒राज॑माप्नोति",
      "start": 104.12,
      "end": 113.44
    },
    {
      "text": "च॒तुरो॑ मा॒सो दी᳚क्षि॒तः स्या᳚च्च॒तुरो॒",
      "start": 113.44,
      "end": 118.0
    },
    {
      "text": "वा ए॒तं मा॒सो वस॑वोऽबिभरु॒स्ते",
      "start": 118.0,
      "end": 118.0
    },
    {
      "text": "पृ॑थि॒वीमाऽज॑यन् गाय॒त्रीं छन्दो॒ऽष्टौ रु॒द्रास्ते᳚-ऽन्तरि॑क्ष॒माऽज॑यन्",
      "start": 118.0,
      "end": 118.0
    },
    {
      "text": "त्रि॒ष्टुभं॒ छन्दो॒ द्वाद॑शा-ऽऽदि॒त्यास्ते दिव॒माऽज॑य॒न्",
      "start": 118.0,
      "end": 123.88
    },
    {
      "text": "जग॑तीं॒ छन्द॒स्ततो॒ वै ते",
      "start": 123.88,
      "end": 127.88
    },
    {
      "text": "( ) व्या॒वृत॑-मगच्छ॒ञ्छ्रैष्ठ्यं॑ दे॒वानां॒",
      "start": 127.88,
      "end": 129.92
    },
    {
      "text": "तस्मा॒द् द्वाद॑श मा॒सो भृ॒त्वाऽग्निं",
      "start": 129.92,
      "end": 132.72
    },
    {
      "text": "चि॑न्वीत॒ द्वाद॑श॒ मासाः᳚ संॅवथ्स॒रः",
      "start": 132.72,
      "end": 136.96
    },
    {
      "text": "सं॑ॅवथ्स॒रो᳚ -ऽग्निश्चित्य॒स्तस्या॑-होरा॒त्राणीष्ट॑का आ॒प्तेष्ट॑कमेनं चिनु॒तेऽथो᳚",
      "start": 136.96,
      "end": 145.64
    },
    {
      "text": "व्या॒वृत॑मे॒व ग॑च्छति॒ श्रैष्ठ्यꣳ॑ समा॒नानां᳚",
      "start": 145.64,
      "end": 150.56
    }
  ],
  "total_phrases": 13
}