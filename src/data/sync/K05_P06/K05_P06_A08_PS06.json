  "phrases": [
    {
      "text": "-मूं चोप॑ दधाति॒ मन॑सा",
      "start": 161.24,
      "end": 164.04
    },
    {
      "text": "मद्ध्य॒मामे॒षां ॅलो॒कानां॒ क्लृप्त्या॒ अथो᳚",
      "start": 164.04,
      "end": 169.88
    },
    {
      "text": "प्रा॒णाना॑मि॒ष्टो य॒ज्ञो भृगु॑भिराशी॒र्दा वसु॑भि॒स्तस्य॑",
      "start": 169.88,
      "end": 179.28
    },
    {
      "text": "त इ॒ष्टस्य॑ वी॒तस्य॒ द्रवि॑णे॒ह",
      "start": 179.28,
      "end": 181.8
    },
    {
      "text": "भ॑क्षी॒येत्या॑ह स्तुतश॒स्त्रे ए॒वैतेन॑ दुहे",
      "start": 181.8,
      "end": 192.16
    },
    {
      "text": "पि॒ता मा॑त॒रिश्वाऽच्छि॑द्रा प॒दा धा॒",
      "start": 192.16,
      "end": 193.64
    },
    {
      "text": "अच्छि॑द्रा उ॒शिजः॑ प॒दाऽनु॑ तक्षुः॒",
      "start": 193.64,
      "end": 194.08
    },
    {
      "text": "सोमो॑ विश्व॒विन्ने॒ता ने॑ष॒द्-बृह॒स्पति॑रुक्थाम॒दानि॑ शꣳसिष॒दित्या॑है॒तद्वा",
      "start": 194.08,
      "end": 205.04
    },
    {
      "text": "( ) अ॒ग्नेरु॒क्थं तेनै॒वैन॒मनु॑",
      "start": 205.04,
      "end": 207.72
    },
    {
      "text": "शꣳसति",
      "start": 207.72,
      "end": 208.2
    }
  ],
  "total_phrases": 10
}