  "panchasat": 3,
  "phrases": [
    {
      "text": "-स्त्रि॒वृद्ध्य॑ग्निर्यद् द्वे द्वि॒पाद्-यज॑मानः॒ प्रति॑ष्ठित्यै॒",
      "start": 66.0,
      "end": 79.32
    },
    {
      "text": "पञ्च॒ चित॑यो भवन्ति॒ पाङ्क्तः॒",
      "start": 79.32,
      "end": 79.32
    },
    {
      "text": "पुरु॑ष आ॒त्मान॑मे॒व स्पृ॑णोति॒ पञ्च॒",
      "start": 79.32,
      "end": 79.32
    },
    {
      "text": "चित॑यो भवन्ति प॒ञ्चभिः॒ पुरी॑षैर॒भ्यू॑हति॒",
      "start": 79.32,
      "end": 79.32
    },
    {
      "text": "दश॒ सं प॑द्यन्ते॒ दशा᳚क्षरो॒",
      "start": 79.32,
      "end": 80.12
    },
    {
      "text": "वै पुरु॑षो॒ यावा॑ने॒व पुरु॑ष॒स्तꣳ",
      "start": 80.12,
      "end": 83.72
    },
    {
      "text": "स्पृ॑णो॒त्यथो॒ दशा᳚क्षरा वि॒राडन्नं॑ ॅवि॒राड्",
      "start": 83.72,
      "end": 89.08
    },
    {
      "text": "वि॒राज्ये॒वान्नाद्ये॒ प्रति॑ तिष्ठति संॅवथ्स॒रो",
      "start": 89.08,
      "end": 94.32
    },
    {
      "text": "वै ष॒ष्ठी चिति॑र्.ऋ॒तवः॒ पुरी॑षꣳ॒॒",
      "start": 94.32,
      "end": 101.56
    },
    {
      "text": "( ) षट् चित॑यो",
      "start": 101.56,
      "end": 102.08
    },
    {
      "text": "भवन्ति॒ षट् पुरी॑षाणि॒ द्वाद॑श॒",
      "start": 102.08,
      "end": 107.6
    },
    {
      "text": "सं प॑द्यन्ते॒ द्वाद॑श॒ मासाः᳚",
      "start": 107.6,
      "end": 111.64
    },
    {
      "text": "संॅवथ्स॒रः सं॑ॅवथ्स॒र ए॒व प्रति॑",
      "start": 111.64,
      "end": 118.48
    },
    {
      "text": "तिष्ठति",
      "start": 118.48,
      "end": 118.92
    }
  ],
  "total_phrases": 14
}