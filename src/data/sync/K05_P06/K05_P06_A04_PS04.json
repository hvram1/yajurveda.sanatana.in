  "phrases": [
    {
      "text": "स उत्त॑रः प॒क्षो॑ऽभव॒थ् सोदी॑ची॒",
      "start": 112.44,
      "end": 116.08
    },
    {
      "text": "दिग्यामु॒परि॑ष्टा-दु॒पाद॑धा॒त् तत् पृ॒ष्ठम॑भव॒थ् सोर्द्ध्वा",
      "start": 116.08,
      "end": 123.36
    },
    {
      "text": "दिगि॒यं ॅवा अ॒ग्निः पञ्चे᳚ष्टक॒-स्तस्मा॒द्-यद॒स्यां",
      "start": 123.36,
      "end": 132.08
