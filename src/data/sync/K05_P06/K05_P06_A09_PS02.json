    {
      "text": "पुरु॑ष आ॒त्मा च॒ शिर॑श्च",
      "start": 18.36,
      "end": 22.44
    },
    {
      "text": "च॒त्वार्यङ्गा᳚न्या॒त्मन्ने॒वैनं॑ बिभर्ति प्र॒जाप॑ति॒र्वा ए॒ष",
      "start": 22.44,
      "end": 34.48
    },
    {
      "text": "यद॒ग्निस्तस्यो॒खा चो॒लूख॑लं च॒ स्तनौ॒",
      "start": 34.48,
      "end": 41.0
    },
    {
      "text": "ताव॑स्य प्र॒जा उप॑ जीवन्ति॒",
      "start": 41.0,
      "end": 46.92
    },
    {
      "text": "यदु॒खां चो॒लूख॑लं चोप॒दधा॑ति॒ ताभ्या॑मे॒व",
      "start": 46.92,
      "end": 52.48
    },
    {
      "text": "यज॑मानो॒ऽमुष्मि॑न् ॅलो॒के᳚ऽग्निं दु॑हे संॅवथ्स॒रो",
      "start": 52.48,
      "end": 63.84
    },
    {
