    {
      "text": "सु॒व॒र्गाय॒ वा ए॒ष लो॒काय॑",
      "start": 0.0,
      "end": 4.64
    },
    {
      "text": "चीयते॒ यद॒ग्निस्तं ॅयन्नान्वा॒रोहे᳚थ् सुव॒र्गाल्लो॒काद्-यज॑मानो",
      "start": 4.64,
      "end": 9.16
    },
    {
      "text": "हीयेत पृथि॒वीमाऽक्र॑मिषं प्रा॒णो मा॒",
      "start": 9.16,
      "end": 14.4
    },
    {
      "text": "मा हा॑सीद॒न्तरि॑क्ष॒माऽक्र॑मिषं प्र॒जा मा॒",
      "start": 14.4,
      "end": 21.92
    },
    {
      "text": "मा हा॑सी॒द्-दिव॒माऽक्र॑मिषꣳ॒॒ सुव॑रग॒न्मेत्या॑है॒ष वा",
      "start": 21.92,
      "end": 28.56
    },
    {
      "text": "अ॒ग्नेर॑न्वारो॒हस्तेनै॒वैन॑-म॒न्वारो॑हति सुव॒र्गस्य॑ लो॒कस्य॒ सम॑ष्ट्यै॒",
      "start": 28.56,
      "end": 42.2
    },
    {
      "text": "यत् प॒क्षस॑म्मितां मिनु॒यात् -",
      "start": 42.2,
      "end": 45.4
