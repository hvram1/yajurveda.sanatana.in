    {
      "text": "दे॒वास्मा॒ अन्न॒मव॑ रुन्धे मद्ध्य॒त",
      "start": 155.6,
      "end": 164.16
    },
    {
      "text": "उप॑ दधाति मद्ध्य॒त ए॒वास्मा॒",
      "start": 164.16,
      "end": 167.64
    },
    {
      "text": "अन्नं॑ दधाति॒ तस्मा᳚न् मद्ध्य॒तोऽन्न॑मद्यते",
      "start": 167.64,
      "end": 172.8
    },
    {
      "text": "बार्.हस्प॒त्यो भ॑वति॒ ब्रह्म॒ वै",
      "start": 172.8,
      "end": 175.2
    },
    {
      "text": "दे॒वानां॒ बृह॒स्पति॒-र्ब्रह्म॑णै॒वास्मा॒ अन्न॒मव॑ रुन्धे",
      "start": 175.2,
      "end": 179.24
    },
    {
      "text": "ब्रह्मवर्च॒सम॑सि ब्रह्मवर्च॒साय॒ त्वेत्या॑ह तेज॒स्वी",
      "start": 179.24,
      "end": 187.24
