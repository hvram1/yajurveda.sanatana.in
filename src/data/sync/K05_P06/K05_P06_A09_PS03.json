  "phrases": [
    {
      "text": "-र्वै᳚श्वकर्म॒णी-र॑होरा॒त्राण्ये॒वास्य॑ प्राजाप॒त्या यदुख्यं॑ बि॒भर्ति॑",
      "start": 77.04,
      "end": 90.56
    },
    {
      "text": "प्राजाप॒त्या ए॒व तदुप॑ धत्ते॒",
      "start": 90.56,
      "end": 95.84
    },
    {
      "text": "यथ् स॒मिध॑ आ॒दधा॑ति वैष्ण॒वा",
      "start": 95.84,
      "end": 100.0
    },
    {
      "text": "वै वन॒स्पत॑यो वैष्ण॒वीरे॒व तदुप॑",
      "start": 100.0,
      "end": 107.12
    },
    {
      "text": "धत्ते॒ यदिष्ट॑काभिर॒ग्निं चि॒नोती॒यं ॅवै",
      "start": 107.12,
      "end": 107.12
    },
    {
      "text": "वि॒श्वक॑र्मा वैश्वकर्म॒णीरे॒व तदुप॑ धत्ते॒",
      "start": 107.12,
      "end": 107.12
    },
    {
      "text": "तस्मा॑-दाहु-स्त्रि॒वृद॒ग्निरिति॒ तं ॅवा ए॒तं",
      "start": 107.12,
      "end": 107.12
    },
    {
      "text": "ॅयज॑मान ए॒व चि॑न्वीत॒ यद॑स्या॒न्य",
      "start": 107.12,
      "end": 107.12
    },
    {
      "text": "( ) श्चि॑नु॒याद्यत् तं",
      "start": 107.12,
      "end": 107.12
    },
    {
      "text": "दक्षि॑णाभि॒र्न रा॒धये॑द॒ग्निम॑स्य वृञ्जीत॒ यो᳚ऽस्या॒ऽग्निं",
      "start": 107.12,
      "end": 112.4
    },
    {
      "text": "चि॑नु॒यात् तं दक्षि॑णाभी राधयेद॒ग्निमे॒व",
      "start": 112.4,
      "end": 117.32
    },
    {
      "text": "तथ् स्पृ॑णोति",
      "start": 117.32,
      "end": 118.36
    }
  ],
  "total_phrases": 12
