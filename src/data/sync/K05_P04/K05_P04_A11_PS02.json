    {
      "text": "-व भ्रातृ॑व्यान् नुदत उभ॒यतः॑",
      "start": 44.36,
      "end": 44.36
    },
    {
      "text": "प्रौगं चिन्वीत॒यः का॒मये॑त॒ प्रजा॒तान्",
      "start": 44.36,
      "end": 45.0
    },
    {
      "text": "भ्रातृ॑व्यान् नु॒देय॒ प्रति॑ जनि॒ष्यमा॑णा॒निति॒",
      "start": 45.0,
      "end": 50.36
    },
    {
      "text": "प्रैव जा॒तान् भ्रातृ॑व्यान् नु॒दते॒",
      "start": 50.36,
      "end": 54.6
    },
    {
      "text": "प्रति॑ जनि॒ष्यमा॑णान् रथचक्र॒चितं॑ चिन्वीत॒",
      "start": 54.6,
      "end": 54.6
    },
    {
      "text": "भ्रातृ॑व्यवा॒न्॒ वज्रो॒ वै रथो॒",
      "start": 54.6,
      "end": 54.6
    },
    {
      "text": "वज्र॑मे॒व भ्रातृ॑व्येभ्यः॒ प्रह॑रति द्रोण॒चितं॑",
      "start": 54.6,
      "end": 54.6
    },
    {
      "text": "चिन्वी॒तान्न॑कामो॒ द्रोणे॒ वा अन्नं॑",
      "start": 54.6,
      "end": 54.6
    },
    {
      "text": "भ्रियते॒ सयो᳚न्ये॒वान्न॒मव॑ रुन्धे समू॒ह्यं॑",
