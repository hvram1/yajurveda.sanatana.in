    {
      "text": "नृ॒षदे॒ वडिति॒ व्याघा॑रयति प॒ङ्क्त्याऽऽहु॑त्या",
      "start": 0.0,
      "end": 4.68
    },
    {
      "text": "यज्ञ्मु॒खमा र॑भते ऽक्ष्ण॒या व्याघा॑रयति॒",
      "start": 4.68,
      "end": 10.72
    },
    {
      "text": "तस्मा॑दक्ष्ण॒या प॒शवोऽङ्गा॑नि॒ प्रह॑रन्ति॒ प्रति॑ष्ठित्यै॒",
      "start": 10.72,
      "end": 10.72
    },
    {
      "text": "यद्व॑षट्कु॒र्याद्-या॒तया॑माऽस्य वषट्का॒रः स्या॒द्यन्न व॑षट्कु॒र्याद्-रक्षाꣳ॑सि",
      "start": 10.72,
      "end": 10.72
    },
    {
      "text": "य॒ज्ञ्ꣳ ह॑न्यु॒र्वडित्या॑ह प॒रोक्ष॑मे॒व वष॑ट्",
      "start": 10.72,
      "end": 14.16
    },
    {
      "text": "करोति॒ नास्य॑ या॒तया॑मा वषट्का॒रो",
      "start": 14.16,
      "end": 20.72
    },
    {
      "text": "भव॑ति॒ न य॒ज्ञ्ꣳ रक्षाꣳ॑सि",
      "start": 20.72,
      "end": 25.32
    },
    {
