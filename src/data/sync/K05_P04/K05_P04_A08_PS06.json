    {
      "text": "मनुष्यछन्द॒सं चत॑स्रश्चा॒ष्टौ च॑ देवछन्द॒सं",
      "start": 157.52,
      "end": 164.28
    },
    {
      "text": "चै॒व म॑नुष्य छन्द॒सश्चाव॑ रुन्ध॒",
      "start": 164.28,
      "end": 167.36
    },
    {
      "text": "आ त्रय॑स्त्रिꣳ शतो जुहोति॒",
      "start": 167.36,
      "end": 170.2
    },
    {
      "text": "त्रय॑स्त्रिꣳश॒द्वै दे॒वता॑ दे॒वता॑ ए॒वाव॑",
      "start": 170.2,
      "end": 179.84
    },
    {
      "text": "रुन्ध॒ आऽष्टाच॑त्वारिꣳशतो जुहोत्य॒ष्टाच॑त्वारिꣳ-शदक्षरा॒ जग॑ती॒",
      "start": 179.84,
      "end": 183.28
    },
    {
      "text": "जाग॑ताः प॒शवो॒ जग॑त्यै॒वास्मै॑ प॒शूनव॑",
      "start": 183.28,
      "end": 183.28
    },
    {
      "text": "रुन्धे॒ वाज॑श्च प्रस॒वश्चेति॑ द्वाद॒शं",
      "start": 183.28,
      "end": 186.08
    },
    {
      "text": "जु॑होति॒ द्वाद॑श॒ मासाः᳚ संॅवथ्स॒रः",
      "start": 186.08,
      "end": 192.28
    },
    {
      "text": "सं॑ॅवथ्स॒र ए॒व प्रति॑ तिष्ठति",
