    {
      "text": "ज्योतीꣳ॑षि कुरुते सुव॒र्गस्य॑ लो॒कस्यानु॑ख्यात्यै॒",
      "start": 82.88,
      "end": 91.32
    },
    {
      "text": "यथ् सꣳस्पृ॑ष्टा उपद॒द्ध्याद्-वृष्ट्यै॑ लो॒कमपि॑",
      "start": 91.32,
      "end": 97.92
    },
    {
      "text": "दद्ध्या॒दव॑र्.षुकः प॒र्जन्यः॑ स्या॒दसꣳ॑स्पृष्टा॒ उप॑",
      "start": 97.92,
      "end": 110.24
    },
    {
      "text": "दधाति॒ वृष्ट्या॑ ए॒व लो॒कं",
      "start": 110.24,
      "end": 114.08
    },
    {
      "text": "क॑रोति॒ वर्.षु॑कः प॒र्जन्यो॑ भवति",
      "start": 114.08,
      "end": 116.96
    },
    {
      "text": "पु॒रस्ता॑द॒न्याः प्र॒तीची॒रुप॑ दधाति प॒श्चाद॒न्याः",
      "start": 116.96,
      "end": 119.6
    },
    {
      "text": "प्राची॒स्तस्मा᳚त् प्रा॒चीना॑नि च प्रती॒चीना॑नि",
      "start": 119.6,
      "end": 122.76
    },
    {
      "text": "च॒ नक्ष॑त्रा॒ण्या व॑र्तन्ते",
      "start": 122.76,
      "end": 130.08
    }
  ],
