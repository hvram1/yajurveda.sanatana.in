  "phrases": [
    {
      "text": "-दे॒व वै᳚श्वान॒रमव॑ रुन्धे॒ यत्",
      "start": 204.88,
      "end": 209.68
    },
    {
      "text": "प्र॑याजानूया॒जान् कु॒र्याद्विक॑स्तिः॒ सा य॒ज्ञ्स्य॑",
      "start": 209.68,
      "end": 215.76
    },
    {
      "text": "दर्विहो॒मं क॑रोति य॒ज्ञ्स्य॒ प्रति॑ष्ठित्यै",
      "start": 215.76,
      "end": 223.64
    },
    {
      "text": "रा॒ष्ट्रं ॅवै वै᳚श्वान॒रो विण्म॒रुतो॑",
      "start": 223.64,
      "end": 227.08
    },
    {
      "text": "वैश्वान॒रꣳ हु॒त्वा मा॑रु॒तान् जु॑होति",
      "start": 227.08,
      "end": 227.08
    },
    {
      "text": "रा॒ष्ट्र ए॒व विश॒मनु॑ बद्ध्नात्यु॒च्चै-र्वै᳚श्वान॒रस्याऽऽ",
      "start": 227.08,
      "end": 227.08
    },
    {
      "text": "श्रा॑वयत्युपाꣳ॒॒शु मा॑रु॒तान् जु॑होति॒ तस्मा᳚द्-रा॒ष्ट्रं",
      "start": 227.08,
      "end": 229.88
    },
    {
      "text": "ॅविश॒मति॑ वदति मारु॒ता भ॑वन्ति",
      "start": 229.88,
      "end": 234.92
    },
    {
      "text": "म॒रुतो॒ वै दे॒वानां॒ ॅविशो॑",
      "start": 234.92,
      "end": 236.32
    },
    {
      "text": "देववि॒शेनै॒वास्मै॑ मनुष्यवि॒श ( )",
      "start": 236.32,
      "end": 236.4
    },
    {
      "text": "-मव॑ रुन्धे स॒प्त भ॑वन्ति",
      "start": 236.4,
      "end": 240.04
    },
    {
      "text": "स॒प्तग॑णा॒ वै म॒रुतो॑ गण॒श",
      "start": 240.04,
      "end": 245.6
    },
    {
      "text": "ए॒व विश॒मव॑ रुन्धे ग॒णेन॑",
      "start": 245.6,
      "end": 249.76
    },
    {
      "text": "ग॒णम॑नु॒द्रुत्य॑ जुहोति॒ विश॑मे॒वास्मा॒ अनु॑वर्त्मानं",
      "start": 249.76,
      "end": 260.32
    },
    {
      "text": "करोति",
      "start": 260.32,
      "end": 261.32
    }
  ],
