  "phrases": [
    {
      "text": "-ऽभि ज॑यत्यग्नि॒चितꣳ॑ ह॒ वा",
      "start": 123.2,
      "end": 127.44
    },
    {
      "text": "अ॒मुष्मि॑न् ॅलो॒के वातो॒ऽभि प॑वते",
      "start": 127.44,
      "end": 131.36
    },
    {
      "text": "वातना॒मानि॑ जुहोत्य॒भ्ये॑वैन॑-म॒मुष्मि॑न् ॅलो॒के वातः॑",
      "start": 131.36,
      "end": 134.96
    },
    {
      "text": "पवते॒ त्रीणि॑ जुहोति॒ त्रय॑",
      "start": 134.96,
      "end": 134.96
    },
    {
      "text": "इ॒मे लो॒का ए॒भ्य ए॒व",
      "start": 134.96,
      "end": 134.96
    },
    {
      "text": "लो॒केभ्यो॒ वात॒मव॑ रुन्धे समु॒द्रो॑ऽसि॒",
      "start": 134.96,
      "end": 134.96
    },
    {
      "text": "नभ॑स्वा॒नित्या॑है॒तद्वै वात॑स्य रू॒पꣳ रू॒पेणै॒व",
      "start": 134.96,
      "end": 134.96
    },
    {
      "text": "वात॒मव॑ रुन्धे ऽञ्ज॒लिना॑ जुहोति॒",
