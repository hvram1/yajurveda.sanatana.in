  "phrases": [
    {
      "text": "भुव॑नमसि॒ वि प्र॑थ॒स्वाग्ने॒ यष्ट॑रि॒दं नमः॑",
      "start": 0.0,
      "end": 7.04
    },
    {
      "text": "जुह्वेह्य॒ग्निस्त्वा᳚ ह्वयति देवय॒ज्याया॒ उप॑भृ॒देहि॑",
      "start": 7.04,
      "end": 19.36
    },
    {
      "text": "दे॒वस्त्वा॑ सवि॒ता ह्व॑यति देवय॒ज्याया॒",
      "start": 19.36,
      "end": 26.72
    },
    {
      "text": "अग्ना॑विष्णू॒ मा वा॒मव॑ क्रमिषं॒",
      "start": 26.72,
      "end": 30.24
    },
    {
      "text": "ॅवि जि॑हाथां॒ मा मा॒",
      "start": 30.24,
      "end": 33.28
    },
    {
      "text": "सं ता᳚प्तं ॅलो॒कं मे॑",
      "start": 33.28,
      "end": 35.6
    },
    {
      "text": "लोककृतौ कृणुतं॒ ॅविष्णोः॒ स्थान॑मसी॒त",
      "start": 35.6,
      "end": 39.64
    },
    {
      "text": "इन्द्रो॑ अकृणोद् वी॒र्या॑णि समा॒रभ्यो॒र्द्ध्वो",
      "start": 39.64,
      "end": 42.84
    },
    {
      "text": "अ॑द्ध्व॒रो दि॑वि॒स्पृश॒मह्रु॑तो ( )",
      "start": 42.84,
      "end": 42.84
    },
    {
      "text": "य॒ज्ञो य॒ज्ञ्प॑ते॒-रिन्द्रा॑वा॒न्थ् स्वाहा॑ बृ॒हद्भाः",
      "start": 42.84,
      "end": 46.92
    },
    {
      "text": "पा॒हि मा᳚ऽग्ने॒ दुश्च॑रिता॒दा मा॒",
      "start": 46.92,
      "end": 52.88
    },
    {
      "text": "सुच॑रिते भज म॒खस्य॒ शिरो॑ऽसि॒",
      "start": 52.88,
      "end": 57.28
    },
    {
      "text": "संज्योति॑षा॒ ज्योति॑रङ्क्तां",
