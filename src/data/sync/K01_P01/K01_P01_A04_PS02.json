  "phrases": [
    {
      "text": "हिꣳसिषमु॒रु वाता॑य दे॒वस्य॑ त्वा",
      "start": 58.68,
      "end": 64.08
    },
    {
      "text": "सवि॒तुः प्र॑स॒वे᳚ऽश्विनो᳚र् बा॒हुभ्यां᳚ पू॒ष्णो",
      "start": 64.08,
      "end": 70.08
    },
    {
      "text": "हस्ता᳚भ्या-म॒ग्नये॒ जुष्टं॒ निर्व॑पाम्य॒ग्नीषोमा᳚भ्या-मि॒दं दे॒वाना॑मि॒दमु॑",
      "start": 70.08,
      "end": 70.08
    },
    {
      "text": "नः स॒ह स्फा॒त्यै त्वा॒",
      "start": 70.08,
      "end": 70.08
    },
    {
      "text": "नारा᳚त्यै॒ सुव॑र॒भि वि ख्ये॑षं",
      "start": 70.08,
      "end": 72.32
    },
    {
      "text": "ॅवैश्वान॒रं ज्योति॒र् दृꣳह॑न्तां॒ दुर्या॒",
      "start": 72.32,
      "end": 81.28
    },
    {
      "text": "द्यावा॑पृथि॒व्यो- रु॒र्व॑न्तरि॑क्ष॒ मन्वि॒-ह्यदि॑त्या स्त्वो॒पस्थे॑",
      "start": 81.28,
      "end": 90.6
    },
    {
      "text": "सादया॒म्यग्ने॑ ह॒व्यꣳ र॑क्षस्व",
      "start": 90.6,
      "end": 97.88
    }
  ],
