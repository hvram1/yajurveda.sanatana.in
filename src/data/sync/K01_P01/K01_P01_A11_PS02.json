  "phrases": [
    {
      "text": "दक्षि॑णो॒ यज॑मानस्य परि॒धिरि॒ड ई॑डि॒तो",
      "start": 66.64,
      "end": 74.36
    },
    {
      "text": "मि॒त्रावरु॑णौ त्वोत्तर॒तः परि॑ धत्तां",
      "start": 74.36,
      "end": 74.92
    },
    {
      "text": "ध्रु॒वेण॒ धर्म॑णा॒ यज॑मानस्य परि॒धिरि॒ड",
      "start": 74.92,
      "end": 79.76
    },
    {
      "text": "ई॑डि॒तः सूर्य॑स्त्वा पु॒रस्ता᳚त् पातु॒",
      "start": 79.76,
      "end": 85.92
    },
    {
      "text": "कस्या᳚श्चिद॒भिश॑स्त्या वी॒तिहो᳚त्रं त्वा कवे",
      "start": 85.92,
      "end": 88.64
    },
    {
      "text": "द्यु॒मन्तꣳ॒॒ समि॑धीम॒ह्यग्ने॑ बृ॒हन्त॑मद्ध्व॒रे वि॒शो",
      "start": 88.64,
      "end": 88.64
    },
    {
      "text": "य॒न्त्रे स्थो॒ वसू॑नाꣳ रु॒द्राणा॑-मादि॒त्यानाꣳ॒॒",
      "start": 88.64,
      "end": 88.64
    },
    {
      "text": "सद॑सि सीद जु॒हूरु॑प॒भृद् ध्रु॒वाऽसि॑",
      "start": 88.64,
      "end": 92.92
    },
    {
      "text": "घृ॒ताची॒ नाम्ना᳚ प्रि॒येण॒ नाम्ना᳚",
      "start": 92.92,
      "end": 94.2
    },
    {
      "text": "प्रि॒ये सद॑सि ( )",
      "start": 94.2,
      "end": 96.88
    },
    {
      "text": "सीदै॒ता अ॑सदन्थ् सुकृ॒तस्य॑ लो॒के",
      "start": 96.88,
      "end": 101.04
    },
    {
      "text": "ता वि॑ष्णो पाहि पा॒हि",
      "start": 101.04,
      "end": 103.92
    },
    {
      "text": "य॒ज्ञ्ं पा॒हि य॒ज्ञ्प॑तिं पा॒हि",
      "start": 103.92,
      "end": 107.8
    },
    {
      "text": "मां ॅय॑ज्ञ्॒नियं᳚",
      "start": 107.8,
      "end": 109.72
    }
