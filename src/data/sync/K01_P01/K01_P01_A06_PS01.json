  "phrases": [
    {
      "text": "अव॑धूतꣳ॒॒ रक्षोऽव॑धूता॒ अरा॑त॒योऽदि॑त्या॒स्त्वग॑सि॒ प्रति॑",
      "start": 0.0,
      "end": 13.0
    },
    {
      "text": "त्वा पृथि॒वीवे᳚त्तु दि॒वः स्कं॑भ॒निर॑सि॒",
      "start": 13.0,
      "end": 20.88
    },
    {
      "text": "प्रति॒ त्वाऽदि॑त्या॒स्त्वग्वे᳚त्तु धि॒षणा॑ऽसि पर्व॒त्या",
      "start": 20.88,
      "end": 34.72
