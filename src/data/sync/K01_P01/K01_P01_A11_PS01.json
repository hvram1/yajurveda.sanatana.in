    {
      "text": "ब॒र्॒.हिषे᳚ त्वा॒ स्वाहा ॑ब॒र्॒.हिर॑सि",
      "start": 11.28,
      "end": 20.28
    },
    {
      "text": "स्रु॒ग्भ्यस्त्वा॒ स्वाहा॑ दि॒वे त्वा॒ऽन्तरि॑क्षाय",
      "start": 20.28,
      "end": 29.48
    },
    {
