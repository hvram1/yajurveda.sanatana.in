  "phrases": [
    {
      "text": "सेदु॒ होता॒ सो अ॑द्ध्व॒रान्थ्",
      "start": 165.2,
      "end": 165.2
    },
    {
      "text": "स ऋ॒तून् क॑ल्पयाति",
      "start": 165.2,
      "end": 165.2
    },
    {
      "text": "यद्वाहि॑ष्ठं॒ तद॒ग्नये॑ बृ॒हद॑र्च विभावसो",
      "start": 165.2,
      "end": 165.2
    },
    {
      "text": "महि॑षीव॒ त्वद्र॒यिस्त्वद्वाजा॒ उदी॑रते",
      "start": 165.2,
      "end": 165.2
    },
    {
      "text": "अग्ने॒ त्वं पा॑रया॒ नव्यो॑",
      "start": 165.2,
      "end": 165.24
    },
    {
      "text": "अ॒स्मान्थ् स्व॒स्तिभि॒रति॑ दु॒र्गाणि॒ विश्वा᳚",
      "start": 165.24,
      "end": 177.92
    },
    {
      "text": "पूश्च॑ पृ॒थ्वी ब॑हु॒ला न॑",
      "start": 177.92,
      "end": 184.12
    },
    {
      "text": "उ॒र्वी भवा॑ तो॒काय॒ तन॑याय॒",
      "start": 184.12,
      "end": 190.96
    },
    {
      "text": "शं ॅयोः",
      "start": 190.96,
      "end": 191.8
    },
    {
      "text": "त्वम॑ग्ने व्रत॒पा अ॑सि दे॒व",
      "start": 191.8,
      "end": 197.48
    },
    {
      "text": "आ ( ) मर्त्ये॒ष्वा",
      "start": 197.48,
      "end": 201.2
    },
    {
      "text": "त्वं ॅय॒ज्ञेष्वीड्यः॑",
      "start": 201.2,
      "end": 208.28
    },
    {
      "text": "यद्वो॑ व॒यं प्र॑मि॒नाम॑ व्र॒तानि॑",
      "start": 208.28,
      "end": 218.16
    },
    {
      "text": "वि॒दुषां᳚ देवा॒ अवि॑दुष्टरासः",
      "start": 218.16,
      "end": 221.32
    },
    {
      "text": "अ॒ग्निष्टद् विश्व॒मा पृ॑णाति वि॒द्वान्.",
      "start": 221.32,
      "end": 228.0
    },
    {
      "text": "येभि॑र् दे॒वाꣳ ऋ॒तुभिः॑ क॒ल्पया॑ति",
      "start": 228.0,
      "end": 235.52
    }
  ],
