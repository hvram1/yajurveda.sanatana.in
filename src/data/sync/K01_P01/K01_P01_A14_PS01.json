  "phrases": [
    {
      "text": "उ॒भा वा॑मिन्द्राग्नी आहु॒वद्ध्या॑ उ॒भा",
      "start": 0.0,
      "end": 2.68
    },
    {
      "text": "राध॑सः स॒ह मा॑द॒यद्ध्यै᳚",
      "start": 2.68,
      "end": 4.28
    },
    {
      "text": "उ॒भा दा॒तारा॑वि॒षाꣳ र॑यी॒णामु॒भा वाज॑स्य",
      "start": 4.28,
      "end": 12.08
    },
    {
      "text": "सा॒तये॑ हुवे वां",
      "start": 12.08,
      "end": 13.84
    },
    {
      "text": "अश्र॑वꣳ॒॒ हि भू॑रि॒दाव॑त्तरा वां॒",
      "start": 13.84,
      "end": 20.48
    },
    {
      "text": "ॅविजा॑मातुरु॒त वा॑ घा स्या॒लात्",
      "start": 20.48,
      "end": 27.32
    },
    {
      "text": "अथा॒ सोम॑स्य॒ प्रय॑ती यु॒वभ्या॒मिन्द्रा᳚ग्नी॒",
      "start": 27.32,
      "end": 36.64
    },
    {
      "text": "स्तोमं॑ जनयामि॒ नव्यं᳚",
      "start": 36.64,
      "end": 38.8
    },
    {
      "text": "इन्द्रा᳚ग्नी नव॒तिं पुरो॑ दा॒सप॑त्नीरधूनुतं",
      "start": 38.8,
      "end": 41.8
    },
    {
      "text": "सा॒कमेके॑न॒ कर्म॑णा",
      "start": 41.8,
      "end": 46.16
    },
    {
      "text": "शुचिं॒ नु स्तोमं॒ नव॑जात-म॒द्येन्द्रा᳚ग्नी",
      "start": 46.16,
      "end": 51.76
    },
    {
      "text": "वृत्रहणा जु॒षेथां᳚",
      "start": 51.76,
