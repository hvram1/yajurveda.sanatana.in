    {
      "text": "गच्छ॒ ततो॑ नो॒ वृष्टि॒मेर॑य",
      "start": 33.48,
      "end": 37.56
    },
    {
      "text": "आ॒यु॒ष्पा अ॑ग्ने॒ऽस्यायु॑र्मे पाहि चक्षु॒ष्पा",
      "start": 37.56,
      "end": 43.64
    },
    {
      "text": "अ॑ग्नेऽसि॒ चक्षु॑र्मे पाहि ध्रु॒वाऽसि॒",
      "start": 43.64,
      "end": 47.2
    },
    {
      "text": "यं प॑रि॒धिं प॒र्यध॑त्था॒ अग्ने॑",
      "start": 47.2,
      "end": 55.04
    },
    {
      "text": "देव प॒णिभि॑र् वी॒यमा॑णः",
      "start": 55.04,
      "end": 59.32
    },
    {
      "text": "तं त॑ ए॒तमनु॒ जोषं॑",
      "start": 59.32,
      "end": 61.8
    },
    {
      "text": "भरामि॒ नेदे॒ष त्वद॑पचे॒तया॑तै य॒ज्ञ्स्य॒",
      "start": 61.8,
      "end": 65.76
    },
    {
      "text": "पाथ॒ उप॒ समि॑तꣳ सꣳस्रा॒वभा॑गाः",
