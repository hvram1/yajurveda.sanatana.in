  "phrases": [
    {
      "text": "इ॒षे त्वो॒र्जे त्वा॑ वा॒यवः॑",
      "start": 0.0,
      "end": 5.64
    },
    {
      "text": "स्थोपा॒यवः॑ स्थ दे॒वो वः॑",
      "start": 5.64,
      "end": 8.44
    },
    {
      "text": "सवि॒ता प्रार्प॑यतु॒ श्रेष्ठ॑तमाय॒ कर्म॑ण॒",
      "start": 8.44,
      "end": 15.92
    },
    {
      "text": "आ प्या॑यद्ध्वमघ्निया देवभा॒गमूर्ज॑स्वतीः॒ पय॑स्वतीः",
      "start": 15.92,
      "end": 19.56
    },
    {
      "text": "प्र॒जाव॑तीरनमी॒वा अ॑य॒क्ष्मा मा वः॑",
      "start": 19.56,
      "end": 26.2
    },
    {
      "text": "स्ते॒न ई॑शत॒ माऽघशꣳ॑सो रु॒द्रस्य॑",
      "start": 26.2,
      "end": 35.6
    },
    {
      "text": "हे॒तिः परि॑ वो वृणक्तु",
      "start": 35.6,
      "end": 37.52
    },
    {
      "text": "ध्रु॒वा अ॒स्मिन् गोप॑तौ स्यात",
      "start": 37.52,
      "end": 39.64
    },
    {
      "text": "ब॒ह्वीर् यज॑मानस्य प॒शून् पा॑हि",
      "start": 39.64,
      "end": 45.04
    }
  ],
