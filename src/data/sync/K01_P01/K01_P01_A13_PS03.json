  "phrases": [
    {
      "text": "दे॒वा इ॒मां ॅवाच॑म॒भि विश्वे॑",
      "start": 77.44,
      "end": 77.44
    },
    {
      "text": "गृ॒णन्त॑ आ॒सद्या॒स्मिन् ब॒र्॒.हिषि॑ मादयद्ध्वम॒ग्नेर्",
      "start": 77.44,
      "end": 83.68
    },
    {
      "text": "वा॒मप॑न्नगृहस्य॒ सद॑सि सादयामि सुं॒नाय॑",
      "start": 83.68,
      "end": 90.76
    },
    {
      "text": "सुंनिनी सुं॒ने मा॑ धत्तं",
      "start": 90.76,
      "end": 93.4
    },
    {
      "text": "धु॒रि ध॒र्यौ॑ पात॒मग्ने॑ ऽदब्धायो",
      "start": 93.4,
      "end": 96.44
    },
    {
      "text": "ऽशीततनो पा॒हि मा॒ऽद्य दि॒वः",
      "start": 96.44,
      "end": 100.16
    },
    {
      "text": "पा॒हि प्रसि॑त्यै पा॒हि दुरि॑ष्ट्यै",
      "start": 100.16,
      "end": 107.84
    },
    {
      "text": "पा॒हि दु॑रद्म॒न्यै पा॒हि दुश्च॑रिता॒दवि॑षं",
      "start": 107.84,
      "end": 116.96
    },
    {
      "text": "नः पि॒तुं कृ॑णु सु॒षदा॒",
      "start": 116.96,
      "end": 121.44
    },
    {
      "text": "योनिꣳ॒॒ स्वाहा॒ देवा॑ गातुविदो",
      "start": 121.44,
      "end": 123.44
    },
    {
      "text": "गा॒तुं ॅवि॒त्त्वा गा॒तु (",
      "start": 123.44,
      "end": 126.12
    },
    {
      "text": ") मि॑त॒ मन॑सस्पत इ॒मं",
      "start": 126.12,
      "end": 129.36
    },
    {
      "text": "नो॑ देव दे॒वेषु॑ य॒ज्ञ्ꣳ",
      "start": 129.36,
      "end": 133.52
    },
    {
      "text": "स्वाहा॑ वा॒चि स्वाहा॒ वाते॑",
      "start": 133.52,
      "end": 137.96
    },
    {
      "text": "धाः",
      "start": 137.96,
      "end": 139.08
    }
  ],
  "total_phrases": 15
}