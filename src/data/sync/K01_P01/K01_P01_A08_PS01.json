  "phrases": [
    {
      "text": "सं ॅव॑पामि॒ समापो॑ अ॒द्भिर॑ग्मत॒",
      "start": 0.0,
      "end": 4.24
    },
    {
      "text": "समोष॑धयो॒ रसे॑न॒ सꣳ रे॒वती॒र्",
      "start": 4.24,
      "end": 8.92
    },
    {
      "text": "जग॑तीभि॒र् मधु॑मती॒र् मधु॑मतीभिः सृज्यद्ध्वम॒द्भ्यः",
      "start": 8.92,
      "end": 8.92
    },
    {
      "text": "परि॒ प्रजा॑ताः स्थ॒ सम॒द्भिः",
      "start": 8.92,
      "end": 8.92
    },
    {
      "text": "पृ॑च्यद्ध्वं॒ जन॑यत्यै त्वा॒ सं",
      "start": 8.92,
      "end": 13.4
    },
    {
      "text": "ॅयौ᳚म्य॒ग्नये᳚ त्वा॒ऽग्नीषोमा᳚भ्यां म॒खस्य॒ शिरो॑ऽसि",
      "start": 13.4,
      "end": 18.44
    },
    {
      "text": "घ॒र्मो॑ऽसि वि॒श्वायु॑रु॒रु प्र॑थस्वो॒रु ते॑",
      "start": 18.44,
      "end": 27.04
    },
    {
      "text": "य॒ज्ञ्प॑तिः प्रथतां॒ त्वचं॑ गृह्णीष्वा॒न्तरि॑तꣳ॒॒",
      "start": 27.04,
      "end": 37.24
    },
    {
      "text": "रक्षो॒ऽन्तरि॑ता॒ अरा॑तयोदे॒वस्त्वा॑ सवि॒ता (",
      "start": 37.24,
      "end": 40.76
    },
    {
      "text": ") श्र॑पयतु॒ वर्.षि॑ष्ठे॒ अधि॒",
      "start": 40.76,
      "end": 40.76
    },
    {
      "text": "नाके॒ऽग्निस्ते॑ त॒नुवं॒ माऽति॑ धा॒गग्ने॑",
      "start": 40.76,
      "end": 49.28
    },
    {
      "text": "ह॒व्यꣳ र॑क्षस्व॒ सं ब्रह्म॑णा",
      "start": 49.28,
      "end": 54.96
    },
    {
      "text": "पृच्यस्वैक॒ताय॒ स्वाहा᳚ द्वि॒ताय॒ स्वाहा᳚",
      "start": 54.96,
      "end": 62.8
    },
    {
      "text": "त्रि॒ताय॒ स्वाहा᳚",
      "start": 62.8,
      "end": 66.04
    }
  ],
  "total_phrases": 14
}