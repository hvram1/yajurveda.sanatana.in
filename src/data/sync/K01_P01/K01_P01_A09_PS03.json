  "phrases": [
    {
      "text": "मौ॑ग॒ररु॑स्ते॒ दिवं॒ मा स्का॒न्॒.",
      "start": 98.68,
      "end": 98.68
    },
    {
      "text": "वस॑वस्त्वा॒ परि॑ गृह्णन्तु गाय॒त्रेण॒",
      "start": 98.68,
      "end": 98.68
    },
    {
      "text": "छन्द॑सारु॒द्रास्त्वा॒ परि॑ गृह्णन्तु॒ त्रैष्टु॑भेन॒",
      "start": 98.68,
      "end": 98.68
    },
    {
      "text": "छन्द॑साऽऽदि॒त्यास्त्वा॒ परि॑ गृह्णन्तु॒ जाग॑तेन॒",
      "start": 98.68,
      "end": 98.68
    },
    {
      "text": "छन्द॑सा दे॒वस्य॑ सवि॒तुः स॒वे",
      "start": 98.68,
      "end": 103.12
    },
    {
      "text": "कर्म॑ कृण्वन्ति वे॒धस॑ ऋ॒तम॑स्यृत॒सद॑न-मस्यृत॒श्रीर॑सि॒",
      "start": 103.12,
      "end": 114.6
    },
    {
      "text": "धा अ॑सि स्व॒धा अ॑स्यु॒र्वी",
      "start": 114.6,
      "end": 115.92
    },
    {
      "text": "चासि॒ वस्वी॑ चासि पु॒रा",
      "start": 115.92,
      "end": 115.96
    },
    {
      "text": "क्रू॒रस्य॑ वि॒सृपो॑ विरफ्शिन् (",
      "start": 115.96,
      "end": 120.88
    },
    {
      "text": ") नुदा॒दाय॑ पृथि॒वीं जी॒रदा॑नु॒र्यामैर॑यन्",
      "start": 120.88,
      "end": 126.12
    },
    {
      "text": "च॒न्द्रम॑सि स्व॒धाभि॒स्तां धीरा॑सो अनु॒दृश्य॑",
      "start": 126.12,
      "end": 135.76
    },
    {
      "text": "यजन्ते",
      "start": 135.76,
      "end": 136.52
    }
  ],
