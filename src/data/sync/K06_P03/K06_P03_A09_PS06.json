  "phrases": [
    {
      "text": "य॒ज्ञ्स्य॒ समि॑ष्ट्यै प्राणापा॒नौ वा",
      "start": 157.44,
      "end": 165.08
    },
    {
      "text": "ए॒तौ प॑शू॒नां ॅयत् पृ॑षदा॒ज्यमा॒त्मा",
      "start": 165.08,
      "end": 172.48
    },
    {
      "text": "व॒पा पृ॑षदा॒ज्यम॑भि॒घार्य॑ व॒पाम॒भि घा॑रयत्या॒त्मन्ने॒व",
      "start": 172.48,
      "end": 181.76
    },
    {
      "text": "प॑शू॒नां प्रा॑णापा॒नौ द॑धाति॒ स्वाहो॒र्द्ध्वन॑भसं",
      "start": 181.76,
      "end": 192.76
    },
    {
      "text": "मारु॒तं ग॑च्छत॒मित्या॑हो॒र्द्ध्वन॑भा ह स्म॒",
      "start": 192.76,
      "end": 202.56
    },
    {
      "text": "वै मा॑रु॒तो दे॒वानां᳚ ॅवपा॒श्रप॑णी॒",
      "start": 202.56,
      "end": 203.16
    },
    {
      "text": "प्र ह॑रति॒ तेनै॒वैने॒ प्र",
      "start": 203.16,
      "end": 203.16
    },
    {
      "text": "ह॑रति॒ विषू॑ची॒ प्र ह॑रति॒",
      "start": 203.16,
      "end": 203.16
    },
    {
      "text": "तस्मा॒द् विष्व॑ञ्चौ प्राणापा॒नौ",
      "start": 203.16,
      "end": 205.56
    }
  ],
