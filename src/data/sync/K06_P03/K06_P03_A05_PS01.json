    {
      "text": "सा॒द्ध्या वै दे॒वा अ॒स्मिॅल्लो॒क",
      "start": 0.0,
      "end": 4.72
    },
    {
      "text": "आ॑स॒न् नान्यत् किं॑ च॒न",
      "start": 4.72,
      "end": 5.24
    },
    {
      "text": "मि॒षत् ते᳚ऽग्निमे॒वाग्नये॒ मेधा॒या ऽल॑भन्त॒",
      "start": 5.24,
      "end": 5.24
    },
    {
      "text": "न ह्य॑न्यदा॑ल॒भ्यं॑-मवि॑न्द॒न् ततो॒ वा",
      "start": 5.24,
      "end": 5.24
    },
    {
      "text": "इ॒माः प्र॒जाः प्राजा॑यन्त॒ यद॒ग्नाव॒ग्निं",
      "start": 5.24,
      "end": 5.24
    },
    {
      "text": "म॑थि॒त्वा प्र॒हर॑ति प्र॒जानां᳚ प्र॒जन॑नाय",
      "start": 5.24,
      "end": 5.24
    },
    {
      "text": "रु॒द्रो वा ए॒ष यद॒ग्निर्यज॑मानः",
      "start": 5.24,
      "end": 5.24
    },
    {
      "text": "प॒शुर्यत् प॒शुमा॒लभ्या॒ग्निं मन्थे᳚द् रु॒द्राय॒",
      "start": 5.24,
      "end": 11.08
