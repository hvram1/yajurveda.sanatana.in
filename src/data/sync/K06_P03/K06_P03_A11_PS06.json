  "phrases": [
    {
      "text": "पु॒रस्ता॑दसृजत प॒शुं म॑द्ध्य॒तः पृ॑षदा॒ज्यं",
      "start": 168.68,
      "end": 174.16
    },
    {
      "text": "प॒श्चात् तस्मा॒दाज्ये॑न प्रया॒जा इ॑ज्यन्ते",
      "start": 174.16,
      "end": 174.16
    },
    {
      "text": "प॒शुना॑ मद्ध्य॒तः पृ॑षदा॒ज्येना॑-नूया॒जा-स्तस्मा॑दे॒तन्मि॒श्रमि॑व पश्चाथ्",
      "start": 174.16,
      "end": 178.24
    },
    {
      "text": "सृ॒ष्टꣳ ह्येका॑दशानूया॒जान्. य॑जति॒ दश॒",
      "start": 178.24,
      "end": 186.76
    },
    {
      "text": "वै प॒शोः प्रा॒णा आ॒त्मैका॑द॒शो",
      "start": 186.76,
      "end": 191.28
    },
    {
      "text": "यावा॑ने॒व प॒शुस्तमनु॑ यजति॒ घ्नन्ति॒",
      "start": 191.28,
      "end": 197.36
    },
    {
      "text": "वा ए॒तत् प॒शुं ॅयथ्",
      "start": 197.36,
      "end": 199.6
    },
    {
      "text": "स᳚ज्ञ्ं॒पय॑न्ति प्रा॒णापा॒नौ खलु॒ वा",
      "start": 199.6,
      "end": 204.2
    },
    {
      "text": "ए॒तौ प॑शू॒नां ॅयत् पृ॑षदा॒ज्यं",
      "start": 204.2,
      "end": 207.56
    },
    {
      "text": "ॅयत् पृ॑षदा॒ज्येना॑ ( )",
