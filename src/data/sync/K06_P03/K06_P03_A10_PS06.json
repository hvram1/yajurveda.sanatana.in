    {
      "text": "सो᳚ऽब्रवी॒द् वरं॑ ॅवृणै प॒शोरु॑द्धा॒रमुद्ध॑रा॒",
      "start": 180.6,
      "end": 187.4
    },
    {
      "text": "इति॒ स ए॒तमु॑द्धा॒रमुद॑हरत॒ दोः",
      "start": 187.4,
      "end": 189.88
    },
    {
      "text": "पू᳚र्वा॒र्द्धस्य॑ गु॒दं म॑द्ध्य॒तः श्रोणिं॑",
      "start": 189.88,
      "end": 194.24
    },
    {
      "text": "जघना॒र्द्धस्य॒ ततो॑ दे॒वा अभ॑व॒न्",
      "start": 194.24,
      "end": 194.24
    },
    {
      "text": "पराऽसु॑रा॒ यत् त्र्य॒ङ्गाणाꣳ॑ समव॒द्यति॒",
      "start": 194.24,
      "end": 194.24
    },
    {
      "text": "भ्रातृ॑व्याभिभूत्यै॒ भव॑त्या॒त्मना॒ परा᳚ऽस्य॒ भ्रातृ॑व्यो",
      "start": 194.24,
      "end": 194.24
    },
    {
      "text": "भवत्यक्ष्ण॒याऽव॑ द्यति॒ तस्मा॑दक्ष्ण॒या प॒शवोऽङ्गा॑नि॒",
      "start": 194.24,
      "end": 206.96
