  "phrases": [
    {
      "text": "मेद॑सा॒ स्रुचौ॒ प्रोर्णो॑ति॒ मेदो॑रूपा॒",
      "start": 0.0,
      "end": 4.6
    },
    {
      "text": "वै प॒शवो॑ रू॒पमे॒व प॒शुषु॑",
      "start": 4.6,
      "end": 8.28
    },
    {
      "text": "दधाति यू॒षन्न॑व॒धाय॒ प्रोर्णो॑ति॒ रसो॒",
      "start": 8.28,
      "end": 14.0
    },
    {
      "text": "वा ए॒ष प॑शू॒नां ॅयद्यू",
      "start": 14.0,
      "end": 16.44
    },
    {
      "text": "रस॑मे॒व प॒शुषु॑ दधाति पा॒र्श्वेन॑",
      "start": 16.44,
      "end": 22.72
    },
    {
      "text": "वसाहो॒मं प्रयौ॑ति॒ मद्ध्यं॒ ॅवा",
      "start": 22.72,
      "end": 28.24
    },
    {
      "text": "ए॒तत् प॑शू॒नां ॅयत् पा॒र्श्वꣳ",
      "start": 28.24,
      "end": 34.0
    },
    {
      "text": "रस॑ ए॒ष प॑शू॒नां ॅयद्वसा॒",
      "start": 34.0,
      "end": 38.68
    },
    {
      "text": "यत् पा॒र्श्वेन॑ वसाहो॒मं प्र॒यौति॑",
