  "phrases": [
    {
      "text": "-मव॑से॒ सखा॒योऽनु॑ त्वा मा॒ता",
      "start": 69.8,
      "end": 71.48
    },
    {
      "text": "पि॒तरो॑ मद॒न्त्वित्या॒हा-नु॑मतमे॒वैनं॑ मा॒त्रा पि॒त्रा",
      "start": 71.48,
      "end": 77.24
    },
    {
      "text": "सु॑व॒र्गं ॅलो॒कं ग॑मयत्यर्द्ध॒र्चे व॑साहो॒मं",
      "start": 77.24,
      "end": 84.72
    },
    {
      "text": "जु॑होत्य॒सौ वा अ॑र्द्ध॒र्च इ॒यम॑र्द्ध॒च",
      "start": 84.72,
      "end": 92.16
    },
    {
      "text": "इ॒मे ए॒व रसे॑नानक्ति॒ दिशो॑",
      "start": 92.16,
      "end": 94.92
    },
    {
      "text": "जुहोति॒ दिश॑ ए॒व रसे॑नान॒क्त्यथो॑",
      "start": 94.92,
      "end": 101.32
    },
    {
      "text": "दि॒ग्भ्य ए॒वोर्जꣳ॒॒ रस॒मव॑ रुन्धे",
      "start": 101.32,
      "end": 105.76
    },
    {
