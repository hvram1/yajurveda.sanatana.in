  "phrases": [
    {
      "text": "चात्वा॑ला॒द्-धिष्णि॑या॒नुप॑ वपति॒ योनि॒र्वै य॒ज्ञ्स्य॒",
      "start": 0.0,
      "end": 12.24
    },
    {
      "text": "चात्वा॑लं ॅय॒ज्ञ्स्य॑ सयोनि॒त्वाय॑ दे॒वा",
      "start": 12.24,
      "end": 12.24
    },
    {
      "text": "वै य॒ज्ञ्ं परा॑ऽजयन्त॒ तमाग्नी᳚द्ध्रा॒त्",
      "start": 12.24,
      "end": 12.24
    },
    {
      "text": "पुन॒रपा॑जयन्ने॒तद्वै य॒ज्ञ्स्या-प॑राजितं॒ ॅयदाग्नी᳚द्ध्रं॒ ॅयदाग्नी᳚द्ध्रा॒द्धिष्णि॑यान्.",
      "start": 12.24,
      "end": 12.24
    },
    {
      "text": "वि॒हर॑ति॒ यदे॒व य॒ज्ञ्स्या-प॑राजितं॒ तत॑",
      "start": 12.24,
      "end": 12.24
    },
    {
      "text": "ए॒वैनं॒ पुन॑स्तनुते परा॒जित्ये॑व॒ खलु॒",
      "start": 12.24,
      "end": 12.24
    },
    {
      "text": "वा ए॒ते य॑न्ति॒ ये",
      "start": 12.24,
      "end": 12.24
    },
    {
      "text": "ब॑हिष्पवमा॒नꣳ सर्प॑न्ति बहिष्पवमा॒ने स्तु॒त-",
      "start": 12.24,
      "end": 23.4
    },
