  "phrases": [
    {
      "text": "न॑मति॒ षड॑रत्निं प्रति॒ष्ठाका॑मस्य॒ षड्वा",
      "start": 156.92,
      "end": 164.12
    },
    {
      "text": "ऋ॒तव॑ ऋ॒तुष्वे॒व प्रति॑ तिष्ठति",
      "start": 164.12,
      "end": 167.64
    },
    {
      "text": "स॒प्तार॑त्निं प॒शुका॑मस्य स॒प्तप॑दा॒ शक्व॑री",
      "start": 167.64,
      "end": 176.4
    },
    {
      "text": "प॒शवः॒ शक्व॑री प॒शूने॒वाव॑ रुन्धे॒",
      "start": 176.4,
      "end": 183.64
    },
    {
      "text": "नवा॑रत्निं॒ तेज॑स्कामस्य त्रि॒वृता॒ स्तोमे॑न॒",
      "start": 183.64,
      "end": 183.64
    },
    {
      "text": "सम्मि॑तं॒ तेज॑स्त्रि॒वृत् ते॑ज॒स्व्ये॑व भ॑व॒-त्येका॑दशारत्नि-मिन्द्रि॒यका॑म॒-स्यैका॑दशाक्षरा",
      "start": 183.64,
      "end": 194.04
    },
    {
      "text": "त्रि॒ष्टुगि॑न्द्रि॒यं त्रि॒ष्टुगि॑न्द्रिया॒व्ये॑व भ॑वति॒ पञ्च॑दशारत्निं॒",
      "start": 194.04,
      "end": 201.08
    },
    {
      "text": "भ्रातृ॑व्यवतः पञ्चद॒शो वज्रो॒ भ्रातृ॑व्याभिभूत्यै",
      "start": 201.08,
      "end": 201.08
    },
    {
      "text": "स॒प्तद॑शारत्निं प्र॒जाका॑मस्य सप्तद॒शः प्र॒जाप॑तिः",
      "start": 201.08,
      "end": 201.08
    },
    {
      "text": "प्र॒जाप॑ते॒राप्त्या॒ ( ) एक॑विꣳशत्यरत्निं",
      "start": 201.08,
      "end": 204.0
    },
    {
      "text": "प्रति॒ष्ठाका॑म-स्यैकविꣳ॒॒शः स्तोमा॑नां प्रति॒ष्ठा प्रति॑ष्ठित्या",
      "start": 204.0,
      "end": 216.12
    },
    {
      "text": "अ॒ष्टाश्रि॑र्भव-त्य॒ष्टाक्ष॑रा गाय॒त्री तेजो॑ गाय॒त्री",
      "start": 216.12,
      "end": 224.24
    },
    {
      "text": "गा॑य॒त्री य॑ज्ञ्मु॒खं तेज॑सै॒व गा॑यत्रि॒या",
      "start": 224.24,
      "end": 231.48
    },
    {
      "text": "य॑ज्ञ्मु॒खेन॒ संमि॑तः",
      "start": 231.48,
      "end": 235.28
    }
  ],
  "total_phrases": 14
