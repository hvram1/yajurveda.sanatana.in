  "phrases": [
    {
      "text": "चतु॑ष्पादो॒ हि प॒शवो॒ यं",
      "start": 150.24,
      "end": 151.4
    },
    {
      "text": "का॒मये॑ता प॒शुः स्या॒दित्य॑मे॒दस्कं॒ तस्मा॒",
      "start": 151.4,
      "end": 155.32
    },
    {
      "text": "आ द॑द्ध्या॒न्मेदो॑रूपा॒ वै प॒शवो॑",
      "start": 155.32,
      "end": 155.32
    },
    {
      "text": "रू॒पेणै॒वैनं॑ प॒शुभ्यो॒ निर्भ॑जत्यप॒शुरे॒व भ॑वति॒",
      "start": 155.32,
      "end": 155.32
    },
    {
      "text": "यं का॒मये॑त पशु॒मान्थ् स्या॒दिति॒",
      "start": 155.32,
      "end": 155.32
    },
    {
      "text": "मेद॑स्व॒त् तस्मा॒ आ द॑द्ध्या॒न्मेदो॑रूपा॒",
      "start": 155.32,
      "end": 155.32
    },
    {
      "text": "वै प॒शवो॑ रू॒पेणै॒वास्मै॑ प॒शूनव॑",
      "start": 155.32,
      "end": 160.2
    },
    {
      "text": "रुन्धे पशु॒माने॒व भ॑वति प्र॒जाप॑तिर्य॒ज्ञ्म॑सृजत॒",
      "start": 160.2,
      "end": 167.4
    },
    {
      "text": "स आज्यं॑- [ ]",
      "start": 167.4,
      "end": 168.68
    }
  ],
