  "phrases": [
    {
      "text": "आ ग्राव्ण्ण॒ आ वा॑य॒व्या᳚न्या",
      "start": 93.2,
      "end": 98.36
    },
    {
      "text": "द्रो॑णकल॒शमुत् पत्नी॒मा न॑य॒न्त्यन्वनाꣳ॑सि॒ प्र",
      "start": 98.36,
      "end": 98.36
    },
    {
      "text": "व॑र्तयन्ति॒ याव॑दे॒वास्यास्ति॒ तेन॑ स॒ह",
      "start": 98.36,
      "end": 98.36
    },
    {
      "text": "सु॑व॒र्गं ॅलो॒कमे॑ति॒ नय॑वत्य॒र्चाऽऽग्नी᳚द्ध्रे जुहोति",
      "start": 98.36,
      "end": 98.36
    },
    {
      "text": "सुव॒र्गस्य॑ लो॒कस्या॒भिनी᳚त्यै॒ ग्राव्ण्णो॑ वाय॒व्या॑नि",
      "start": 98.36,
      "end": 98.36
    },
    {
      "text": "द्रोणकल॒शमाग्नी᳚द्ध्र॒ उप॑ वासयति॒ वि",
      "start": 98.36,
      "end": 98.36
    },
    {
      "text": "ह्ये॑नं॒ तैर्गृ॒ह्णते॒ यथ् स॒होप॑वा॒सये॑-दपुवा॒येत॑",
      "start": 98.36,
      "end": 98.36
    },
    {
      "text": "सौ॒म्यर्चा प्र पा॑दयति॒ स्वयै॒-",
      "start": 98.36,
      "end": 98.36
