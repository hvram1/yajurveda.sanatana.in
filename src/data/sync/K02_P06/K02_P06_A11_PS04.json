  "phrases": [
    {
      "text": "सं॒ॅवतोऽव॑राꣳ अ॒भ्या त॑र",
      "start": 89.44,
      "end": 92.84
    },
    {
      "text": "यत्रा॒हमस्मि॒ ताꣳ अ॑व",
      "start": 92.84,
      "end": 97.32
    },
    {
      "text": "वि॒द्मा हि ते॑ पु॒रा",
      "start": 97.32,
      "end": 99.96
    },
    {
      "text": "व॒यमग्ने॑ पि॒तुर्यथाव॑सः",
      "start": 99.96,
      "end": 107.0
    },
    {
      "text": "अधा॑ ते सु॒म्नमी॑महे",
      "start": 107.0,
      "end": 109.96
    },
    {
      "text": "य उ॒ग्र इ॑व शर्य॒हा",
      "start": 109.96,
      "end": 114.16
    },
    {
      "text": "ति॒ग्मशृ॑ङ्गो॒ न वꣳस॑गः",
      "start": 114.16,
      "end": 116.28
    },
    {
      "text": "अग्ने॒ पुरो॑ रु॒रोजि॑थ",
      "start": 116.28,
      "end": 121.72
    },
    {
      "text": "सखा॑यः॒ सं ॅवः॑ सं॒यञ्च॒मिषꣳ॒॒",
      "start": 121.72,
      "end": 123.8
    },
    {
      "text": "स्तोमं॑ चा॒ग्नये᳚",
      "start": 123.8,
      "end": 126.04
    },
    {
      "text": "वर्.षि॑ष्ठाय क्षिती॒नामू॒र्जो नप्त्रे॒ सह॑स्वते",
      "start": 126.04,
      "end": 130.92
    },
    {
      "text": "सꣳ स॒मिद्यु॑वसे वृष॒न्न (",
      "start": 130.92,
      "end": 132.24
    },
    {
      "text": ") -ग्ने॒ विश्वा᳚न्य॒र्य आ",
      "start": 132.24,
      "end": 136.44
    },
    {
      "text": "इ॒डस्प॒दे समि॑ध्यसे॒ स नो॒",
      "start": 136.44,
      "end": 142.96
    },
    {
      "text": "वसू॒न्या भ॑र",
      "start": 142.96,
      "end": 146.04
    },
    {
      "text": "प्रजा॑पते॒ स वे॑द॒सोमा॑ पूषणे॒मौ दे॒वौ",
      "start": 146.04,
      "end": 153.4
    }
  ],
