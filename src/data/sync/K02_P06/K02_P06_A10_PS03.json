    {
      "text": "-च्छं॒ॅयोरा वृ॑णीमह॒ इत्या॑ह शं॒ॅयुमे॒व",
      "start": 63.6,
      "end": 70.76
    },
    {
      "text": "बा॑र्.हस्प॒त्यं भा॑ग॒धेये॑न॒ सम॑र्द्धयति गा॒तुं",
      "start": 70.76,
      "end": 82.24
    },
    {
      "text": "ॅय॒ज्ञाय॑ गा॒तुं ॅय॒ज्ञ्प॑तय॒ इत्या॑हा॒",
      "start": 82.24,
      "end": 87.96
    },
    {
      "text": "ऽऽशिष॑मे॒वै तामा शा᳚स्ते॒ सोमं॑",
      "start": 87.96,
      "end": 92.4
    },
    {
      "text": "ॅयजति॒ रेत॑ ए॒व तद्-द॑धाति॒",
      "start": 92.4,
      "end": 95.6
    },
    {
      "text": "त्वष्टा॑रं ॅयजति॒ रेत॑ ए॒व",
      "start": 95.6,
      "end": 98.88
    },
    {
      "text": "हि॒तं त्वष्टा॑ रू॒पाणि॒ वि",
      "start": 98.88,
      "end": 98.88
    },
    {
      "text": "क॑रोति दे॒वानां॒ पत्नी᳚र्यजति मिथुन॒त्वाया॒ग्निं",
      "start": 98.88,
      "end": 98.88
    },
    {
      "text": "गृ॒हप॑तिं ॅयजति॒ प्रति॑ष्ठित्यै जा॒मि",
