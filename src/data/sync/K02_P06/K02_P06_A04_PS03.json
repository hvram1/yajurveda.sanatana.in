    {
      "text": "यज्ञ्मु॒खेन॒ संमि॑ता॒मा प्र॑ति॒ष्ठायै॑ खनति॒",
      "start": 57.36,
      "end": 64.6
    },
    {
      "text": "यज॑मानमे॒व प्र॑ति॒ष्ठां ग॑मयति दक्षिण॒तो",
      "start": 64.6,
      "end": 71.92
    },
    {
      "text": "वर्.षी॑यसीं करोति देव॒यज॑नस्यै॒व रू॒पम॑कः॒",
      "start": 71.92,
      "end": 76.32
    },
    {
      "text": "पुरी॑षवतीं करोति प्र॒जावै प॒शवः॒",
      "start": 76.32,
      "end": 79.56
    },
    {
      "text": "पुरी॑षं प्र॒जयै॒वैनं॑ प॒शुभिः॒ पुरी॑षवन्तं",
      "start": 79.56,
      "end": 86.72
    },
    {
      "text": "करो॒त्युत्त॑रं परिग्रा॒हं परि॑ गृह्णात्ये॒ताव॑ती॒",
      "start": 86.72,
      "end": 96.72
    },
    {
      "text": "वै पृ॑थि॒वी याव॑ती॒ वेदि॒स्तस्या॑",
      "start": 96.72,
      "end": 102.04
    },
    {
      "text": "ए॒ताव॑त ए॒व भ्रातृ॑व्यं नि॒र्भज्या॒ऽऽत्मन॒",
      "start": 102.04,
      "end": 104.72
    },
    {
      "text": "उत्त॑रं परिग्रा॒हं परि॑गृह्णाति क्रू॒रमि॑व॒",
      "start": 104.72,
      "end": 104.72
