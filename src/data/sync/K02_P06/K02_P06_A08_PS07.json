  "phrases": [
    {
      "text": "प्राशि॑तं माहिꣳसिष्य॒तीति॑ ब्राह्म॒णस्यो॒दरे॒णेत्य॑ ब्रवी॒न्न",
      "start": 198.16,
      "end": 198.16
    },
    {
      "text": "हि ब्रा᳚ह्म॒णस्यो॒दरं॒ किं च॒न",
      "start": 198.16,
      "end": 198.16
    },
    {
      "text": "हि॒नस्ति॒ बृह॒स्पते॒र्ब्रह्म॒णेति॒ स हि",
      "start": 198.16,
      "end": 198.16
    },
    {
      "text": "ब्रह्मि॒ष्ठोऽप॒ वा ए॒तस्मा᳚त् प्रा॒णाः",
      "start": 198.16,
      "end": 198.16
    },
    {
      "text": "क्रा॑मन्ति॒ यः प्रा॑शि॒त्रं प्रा॒श्नात्य॒द्भि-र्मा᳚र्जयि॒त्वा",
      "start": 198.16,
      "end": 199.64
    },
    {
      "text": "प्रा॒णान्थ् सं मृ॑शते॒ऽमृतं॒ ॅवै",
      "start": 199.64,
      "end": 208.76
    },
    {
      "text": "प्रा॒णा अ॒मृत॒मापः॑ प्रा॒णाने॒व य॑थास्था॒नमुप॑",
      "start": 208.76,
      "end": 217.84
    },
    {
      "text": "ह्वयते",
      "start": 217.84,
      "end": 218.64
    }
  ],
  "total_phrases": 8
}