  "phrases": [
    {
      "text": "या॒ज्या॑ जनि॒ष्यमा॑णाने॒व प्रति॑नुदते पु॒रस्ता᳚ल्लक्ष्मा",
      "start": 103.88,
      "end": 105.88
    },
    {
      "text": "पुरोऽनुवा॒क्या॑ भवत्य॒स्मिन्ने॒व लो॒के ज्योति॑र्द्धत्त",
      "start": 105.88,
      "end": 116.0
    },
    {
      "text": "उ॒परि॑ष्टाल्लक्ष्मा या॒ज्या॑ऽमुष्मि॑न्ने॒व लो॒के ज्योति॑र्द्धत्ते॒",
      "start": 116.0,
      "end": 128.36
    },
    {
      "text": "ज्योति॑ष्मन्तावस्मा इ॒मौ लो॒कौ भ॑वतो॒",
      "start": 128.36,
      "end": 133.08
    },
    {
      "text": "य ए॒वं ॅवेद॑ पु॒रस्ता᳚ल्लक्ष्मा",
      "start": 133.08,
      "end": 137.6
    },
    {
      "text": "पुरोऽनुवा॒क्या॑ भवति॒ तस्मा᳚त् पूर्वा॒र्द्धेना॑न॒ड्वान्",
      "start": 137.6,
      "end": 148.28
    },
    {
      "text": "भु॑नक्त्यु॒परि॑ष्टाल्लक्ष्मा या॒ज्या॑ तस्मा᳚ज्जघना॒र्द्धेन॑ धे॒नुर्य",
      "start": 148.28,
      "end": 156.64
    },
    {
      "text": "ए॒वं ॅवेद॑ भु॒ङ्क्त ए॑नमे॒तौ",
      "start": 156.64,
      "end": 163.08
    },
    {
