      "text": "चक्षु॑षी॒ वा ए॒ते य॒ज्ञ्स्य॒",
      "start": 0.0,
      "end": 6.08
    },
    {
      "text": "यदाज्य॑भागौ॒ यदाज्य॑भागौ॒ यज॑ति॒ चक्षु॑षी",
      "start": 6.08,
      "end": 15.88
    },
    {
      "text": "ए॒व तद्-य॒ज्ञ्स्य॒ प्रति॑ दधाति",
      "start": 15.88,
      "end": 21.0
    },
    {
      "text": "पूर्वा॒र्द्धे जु॑होति॒ तस्मा᳚त् पूर्वा॒र्द्धे",
      "start": 21.0,
      "end": 23.28
    },
    {
      "text": "चक्षु॑षी प्र॒बाहु॑ग्-जुहोति॒ तस्मा᳚त् प्र॒बाहु॒क्",
      "start": 23.28,
      "end": 27.16
