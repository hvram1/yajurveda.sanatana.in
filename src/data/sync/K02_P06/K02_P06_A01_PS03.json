  "phrases": [
    {
      "text": "य॒ज्ञ् ए॒वान्तरि॑क्षे॒ प्रति॑ तिष्ठती॒डो",
      "start": 74.12,
      "end": 80.28
    },
    {
      "text": "य॑जति प॒शुष्वे॒व प्रति॑तिष्ठति ब॒र॒.हिर्य॑जति॒",
      "start": 80.28,
      "end": 80.28
    },
    {
      "text": "य ए॒व दे॑व॒यानाः॒ पन्था॑न॒स्तेष्वे॒व",
      "start": 80.28,
      "end": 84.96
    },
    {
      "text": "प्रति॑तिष्ठति स्वाहाका॒रं ॅय॑जति सुव॒र्ग",
      "start": 84.96,
      "end": 87.84
    },
    {
      "text": "ए॒व लो॒के प्रति॑ तिष्ठत्ये॒ताव॑न्तो॒",
      "start": 87.84,
      "end": 91.2
    },
    {
      "text": "वै दे॑वलो॒कास्तेष्वे॒व य॑थापू॒र्वं प्रति॑तिष्ठति",
      "start": 91.2,
      "end": 97.48
    },
    {
      "text": "देवासु॒रा ए॒षु लो॒केष्व॑स्पर्द्धन्त॒ ते",
      "start": 97.48,
      "end": 103.8
    },
    {
      "text": "दे॒वाः प्र॑या॒जैरे॒भ्यो लो॒केभ्यो ऽसु॑रा॒न्",
      "start": 103.8,
      "end": 110.4
    },
    {
      "text": "प्राणु॑दन्त॒ तत् प्र॑या॒जानां᳚ -",
      "start": 110.4,
      "end": 112.2
