    },
    {
      "text": "तस्मै॑ नू॒ नम॒भिद्य॑वे वा॒चा",
      "start": 40.16,
      "end": 40.16
    },
    {
      "text": "वि॑रूप॒ नित्य॑या",
      "start": 40.16,
      "end": 40.16
    },
    {
      "text": "वृष्णे॑ चोदस्व सुष्टु॒तिं",
      "start": 40.16,
      "end": 40.16
    },
    {
      "text": "कमु॑ ष्विदस्य॒ सेन॑या॒ऽग्नेरपा॑कचक्षसः",
      "start": 40.16,
      "end": 46.04
    },
    {
      "text": "प॒णिं गोषु॑ स्तरामहे",
