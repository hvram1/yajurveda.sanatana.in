      "end": 48.36
    },
    {
      "text": "मा नो॑ दे॒वानां॒ ॅविशः॑ प्रस्ना॒तीरि॑वो॒स्राः",
      "start": 48.36,
      "end": 58.76
    },
    {
      "text": "कृ॒शं न हा॑सु॒रघ्नि॑याः",
      "start": 58.76,
      "end": 63.4
    },
    {
      "text": "मा नः॑ समस्य दू॒ढ्यः॑",
      "start": 63.4,
      "end": 69.32
    },
    {
      "text": "परि॑द्वेषसो अꣳ ह॒तिः",
      "start": 69.32,
      "end": 74.44
    },
    {
      "text": "ऊ॒र्मिर्न नाव॒मा व॑धीत्",
      "start": 74.44,
      "end": 79.2
    },
    {
      "text": "नम॑स्ते अग्न॒ ओज॑से गृ॒णन्ति॑",
