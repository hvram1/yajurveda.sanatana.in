    {
      "text": "दे॒वा वै य॒ज्ञ्स्य॑ स्वगाक॒र्तारं॒",
      "start": 0.0,
      "end": 8.48
    },
    {
      "text": "नावि॑न्द॒न् ते शं॒ॅयुं बा॑र्.हस्प॒त्यम॑ब्रुवन्नि॒मं",
      "start": 8.48,
      "end": 19.08
    },
    {
      "text": "नो॑ य॒ज्ञ्ꣳ स्व॒गा कु॒र्विति॒",
      "start": 19.08,
      "end": 24.48
    },
    {
      "text": "सो᳚ऽब्रवी॒द्वरं॑ ॅवृणै॒ यदे॒वा-ब्रा᳚ह्मणो॒क्तो-ऽश्र॑द्दधानो॒ यजा॑तै॒",
      "start": 24.48,
      "end": 25.0
    },
    {
      "text": "सा मे॑ य॒ज्ञ्स्या॒ऽऽशीर॑स॒दिति॒ तस्मा॒द्-यद्-ब्रा᳚ह्मणो॒क्तोऽश्र॑द्दधानो॒",
      "start": 25.0,
      "end": 25.0
    },
    {
      "text": "यज॑ते शं॒ॅयुमे॒व तस्य॑ बार्.हस्प॒त्यं",
