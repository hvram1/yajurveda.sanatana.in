    {
      "text": "दे॒वस्य॑ त्वा सवि॒तुः प्र॑स॒व",
      "start": 0.0,
      "end": 5.6
    },
    {
      "text": "इति॒ स्फ्यमा द॑त्ते॒ प्रसू᳚त्या",
      "start": 5.6,
      "end": 5.6
    },
    {
      "text": "अ॒श्विनो᳚ र्बा॒हुभ्या॒मित्या॑हा॒-श्विनौ॒ हि दे॒वाना॑मद्ध्व॒र्यू",
      "start": 5.6,
      "end": 11.76
    },
    {
      "text": "आस्तां᳚ पू॒ष्णो हस्ता᳚भ्या॒मित्या॑ह॒ यत्यै॑",
      "start": 11.76,
      "end": 21.08
    },
    {
      "text": "श॒तभृ॑ष्टिरसि वानस्प॒त्यो द्वि॑ष॒तो व॒ध",
      "start": 21.08,
      "end": 27.88
    },
    {
      "text": "इत्या॑ह॒ वज्र॑मे॒व तथ् सꣳश्य॑ति॒",
      "start": 27.88,
      "end": 34.64
    },
    {
      "text": "भ्रातृ॑व्याय प्रहरि॒ष्यन्थ् स्त॑म्ब य॒जुर्.",
      "start": 34.64,
      "end": 34.64
    },
    {
      "text": "ह॑रत्ये॒ताव॑ती॒ वै पृ॑थि॒वी याव॑ती॒",
      "start": 34.64,
      "end": 34.64
    },
    {
      "text": "वेदि॒स्तस्या॑ ए॒ताव॑त ए॒व भ्रातृ॑व्यं॒",
