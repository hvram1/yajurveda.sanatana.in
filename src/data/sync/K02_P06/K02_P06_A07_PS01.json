    {
      "text": "मनुः॑ पृथि॒व्या य॒ज्ञिय॑मैच्छ॒थ् स",
      "start": 0.0,
      "end": 1.56
    },
    {
      "text": "घृ॒तं निषि॑क्तमविन्द॒थ् सो᳚ऽब्रवी॒त् को᳚ऽस्येश्व॒रो",
      "start": 1.56,
      "end": 1.56
    },
    {
      "text": "य॒ज्ञेऽपि॒ कर्तो॒रिति॒ ताव॑ब्रूतां मि॒त्रावरु॑णौ॒",
      "start": 1.56,
      "end": 1.56
    },
    {
      "text": "गोरे॒वाऽऽवमी᳚श्व॒रौ कर्तोः᳚ स्व॒ इति॒",
      "start": 1.56,
      "end": 1.56
    },
    {
      "text": "तौ ततो॒ गाꣳ समै॑रयताꣳ॒॒",
      "start": 1.56,
      "end": 1.56
