  "phrases": [
    {
      "text": "छि॑न्दन्ति॒ यन्म॑द्ध्य॒तः प्रा॒श्नन्त्य॒द्भि-र्मा᳚र्जयन्त॒ आपो॒",
      "start": 69.88,
      "end": 69.88
    },
    {
      "text": "वै सर्वा॑ दे॒वता॑ दे॒वता॑भिरे॒व",
      "start": 69.88,
      "end": 69.88
    },
    {
      "text": "य॒ज्ञ्ꣳ सं त॑न्वन्ति दे॒वा",
      "start": 69.88,
      "end": 69.88
    },
    {
      "text": "वै य॒ज्ञाद्-रु॒द्रम॒न्तरा॑य॒न्थ्स य॒ज्ञ्म॑विद्ध्य॒त् तं",
      "start": 69.88,
      "end": 69.88
    },
    {
      "text": "दे॒वा अ॒भि सम॑गच्छन्त॒ कल्प॑तां",
      "start": 69.88,
      "end": 73.96
    },
    {
      "text": "न इ॒दमिति॒ ते᳚ऽब्रुव॒न्थ् स्वि॑ष्टं॒",
      "start": 73.96,
      "end": 79.28
    },
    {
      "text": "ॅवै न॑ इ॒दं भ॑विष्यति॒",
      "start": 79.28,
      "end": 82.32
    },
    {
      "text": "यदि॒मꣳ रा॑धयि॒ष्याम॒ इति॒ तथ्",
      "start": 82.32,
      "end": 83.2
    },
    {
      "text": "स्वि॑ष्ट॒कृतः॑ स्विष्टकृ॒त्त्वं तस्या ऽऽवि॑द्धं॒",
      "start": 83.2,
      "end": 96.64
    },
