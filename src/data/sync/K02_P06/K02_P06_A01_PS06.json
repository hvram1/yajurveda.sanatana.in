  "phrases": [
    {
      "text": "इति॑ स्वाहाका॒रेण॑ प्रया॒जेषु॑ य॒ज्ञ्ꣳ",
      "start": 158.24,
      "end": 162.4
    },
    {
      "text": "सꣳ॒॒स्थाप्य॑मपश्य॒न् तꣳ स्वा॑हाका॒रेण॑ प्रया॒जेषु॒",
      "start": 162.4,
      "end": 167.52
    },
    {
      "text": "सम॑स्थापय॒न् वि वा ए॒तद्-य॒ज्ञ्ं",
      "start": 167.52,
      "end": 170.32
    },
    {
      "text": "छि॑न्दन्ति॒ यथ् स्वा॑हाका॒रेण॑ प्रया॒जेषु॑",
      "start": 170.32,
      "end": 177.4
    },
    {
      "text": "सꣳस्था॒पय॑न्ति प्रया॒जानि॒ष्ट्वा ह॒वीꣳष्य॒भि घा॑रयति",
      "start": 177.4,
      "end": 181.0
    },
    {
      "text": "य॒ज्ञ्स्य॒ संत॑त्या॒ अथो॑ ह॒विरे॒वाक॒रथो॑",
      "start": 181.0,
      "end": 187.44
    },
    {
      "text": "यथापू॒र्वमुपै॑ति पि॒ता वै प्र॑या॒जाः",
      "start": 187.44,
      "end": 189.48
    },
    {
      "text": "प्र॒जाऽनू॑या॒जा यत् प्र॑या॒जानि॒ष्ट्वा ह॒वीꣳष्य॑भिघा॒रय॑ति",
      "start": 189.48,
      "end": 200.84
    },
    {
      "text": "पि॒तैव तत् पु॒त्रेण॒ साधा॑रणं",
      "start": 200.84,
      "end": 203.24
    },
    {
