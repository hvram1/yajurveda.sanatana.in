    {
      "text": "प॒शव॑ उच्यन्ते॒ मा छन्द॒",
      "start": 121.48,
      "end": 127.96
    },
    {
      "text": "इति॑ दक्षिण॒त उप॑ दधाति॒",
      "start": 127.96,
      "end": 133.52
    },
    {
      "text": "तस्मा᳚द्-दक्षि॒णा वृ॑तो॒ मासाः᳚ पृथि॒वी",
      "start": 133.52,
      "end": 137.28
    },
    {
      "text": "छन्द॒ इति॑ प॒श्चात् प्रति॑ष्ठित्या",
      "start": 137.28,
      "end": 139.68
    },
    {
      "text": "अ॒ग्निर्दे॒वतेत्यु॑त्तर॒त ओजो॒ वा अ॒ग्निरोज॑",
      "start": 139.68,
      "end": 139.68
    },
    {
      "text": "ए॒वोत्त॑र॒तो ध॑त्ते॒ तस्मा॑दुत्तरतो ऽभिप्रया॒यी",
      "start": 139.68,
      "end": 139.68
    },
    {
      "text": "ज॑यति॒ षट्त्रिꣳ॑श॒थ् संप॑द्यन्ते॒ षट्त्रिꣳ॑शदक्षरा",
      "start": 139.68,
      "end": 139.68
    },
    {
      "text": "बृह॒ती बार्.ह॑ताः प॒शवो॑ बृह॒त्यैवास्मै॑",
      "start": 139.68,
      "end": 139.68
    },
    {
      "text": "प॒शूनव॑ रुन्धे बृह॒ती छन्द॑साꣳ॒॒",
      "start": 139.68,
      "end": 143.44
    },
    {
      "text": "स्वारा᳚ज्यं॒ परी॑याय॒ यस्यै॒ता -",
