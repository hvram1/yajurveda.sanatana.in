  "phrases": [
    {
      "text": "ऽश्राम्य॒न् ते तपो॑ऽतप्यन्त॒ तानि॒",
      "start": 104.24,
      "end": 104.24
    },
    {
      "text": "तप॑साऽपश्य॒न् तेभ्य॑ ए॒ता इष्ट॑का॒",
      "start": 104.24,
      "end": 104.24
    },
    {
      "text": "निर॑मिम॒तेव॒श्छन्दो॒ वरि॑व॒श्छन्द॒ इति॒ ता",
      "start": 104.24,
      "end": 104.24
    },
    {
      "text": "उपा॑दधत॒ ताभि॒र्वै ते सु॑व॒र्गं",
      "start": 104.24,
      "end": 106.96
    },
    {
      "text": "ॅलो॒कमा॑य॒न॒. यदे॒ता इष्ट॑का उप॒दधा॑ति॒",
      "start": 106.96,
      "end": 113.52
    },
    {
      "text": "यान्ये॒व छन्दाꣳ॑सि सुव॒र्ग्या॑णि॒ तैरे॒व",
      "start": 113.52,
      "end": 119.24
    },
    {
      "text": "यज॑मानः सुव॒र्गं ॅलो॒कमे॑ति य॒ज्ञेन॒",
      "start": 119.24,
      "end": 125.32
    },
    {
      "text": "वै प्र॒जाप॑तिः प्र॒जा अ॑सृजत॒",
      "start": 125.32,
      "end": 125.32
    },
    {
      "text": "ताः स्तोम॑ भागैरे॒वाऽसृ॑जत॒ यथ्",
