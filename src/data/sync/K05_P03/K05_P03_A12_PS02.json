  "phrases": [
    {
      "text": "तरति॒ तर॑ति ब्रह्मह॒त्यां ॅयो᳚ऽश्वमे॒धेन॒",
      "start": 44.08,
      "end": 49.24
    },
    {
      "text": "यज॑ते॒ य उ॑ चैनमे॒वं",
      "start": 49.24,
      "end": 52.16
    },
    {
      "text": "ॅवेदोत्त॑रं॒ ॅवै तत् प्र॒जाप॑ते॒रक्ष्य॑श्वय॒त्",
      "start": 52.16,
      "end": 62.08
    },
    {
      "text": "तस्मा॒दश्व॑स्योत्तर॒तोऽव॑ द्यन्ति दक्षिण॒तो᳚ऽन्येषां᳚ पशू॒नां",
      "start": 62.08,
      "end": 71.16
    },
    {
      "text": "ॅवै॑त॒सः कटो॑ भवत्य॒फ्सुयो॑नि॒र्वा अश्वो᳚ऽफ्सु॒जो",
      "start": 71.16,
      "end": 73.4
    },
    {
      "text": "वे॑त॒सः स्व ए॒वैनं॒ ॅयोनौ॒",
      "start": 73.4,
      "end": 73.4
    },
    {
      "text": "प्रति॑ष्ठापयति चतुष्टो॒मः स्तोमो॑ भवति",
      "start": 73.4,
      "end": 73.4
    },
    {
      "text": "स॒रड्ढ॒ वा अश्व॑स्य॒ सक्थ्याऽवृ॑ह॒त्",
      "start": 73.4,
      "end": 73.4
    },
    {
      "text": "( ) तद्-दे॒वाश्च॑तुष्टो॒मेनै॒व प्रत्य॑दधु॒र्यच्च॑तुष्टो॒मः",
      "start": 73.4,
      "end": 73.4
    },
    {
      "text": "स्तोमो॒ भव॒त्यश्व॑स्य सर्व॒त्वाय॑",
      "start": 73.4,
      "end": 76.4
    }
  ],
