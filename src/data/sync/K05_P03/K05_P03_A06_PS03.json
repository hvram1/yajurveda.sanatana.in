  "phrases": [
    {
      "text": "भव॑न्ती॒र्न प्राजा॑यन्त॒ ताः सꣳ॑रो॒हो॑ऽसि",
      "start": 58.8,
      "end": 58.8
    },
    {
      "text": "नीरो॒हो॑ऽसीत्ये॒व प्राऽज॑नय॒त् ताः प्र॒जाः",
      "start": 58.8,
      "end": 58.8
    },
    {
      "text": "प्रजा॑ता॒ न प्रत्य॑तिष्ठ॒न् ता",
      "start": 58.8,
      "end": 65.48
    },
    {
      "text": "व॑सु॒को॑ऽसि॒ वेष॑श्रिरसि॒ वस्य॑ष्टिर॒सीत्ये॒वैषु लो॒केषु॒",
      "start": 65.48,
      "end": 75.36
    },
    {
      "text": "प्रत्य॑स्थापय॒द्यदाह॑ वसु॒को॑ऽसि॒ वेष॑श्रिरसि॒ वस्य॑ष्टिर॒सीति॑",
      "start": 75.36,
      "end": 84.48
    },
    {
      "text": "प्र॒जा ए॒व प्रजा॑ता ए॒षु",
      "start": 84.48,
      "end": 88.28
    },
    {
      "text": "लो॒केषु॒ प्रति॑ष्ठापयति॒ सात्मा॒ऽन्तरि॑क्षꣳ (",
      "start": 88.28,
      "end": 94.8
    },
    {
      "text": ") रोहति॒ सप्रा॑णो॒ऽमुष्मि॑न् ॅलो॒के",
      "start": 94.8,
      "end": 95.88
    },
    {
      "text": "प्रति॑ तिष्ठ॒त्यव्य॑र्द्धुकः प्राणापा॒नाभ्यां᳚ भवति॒",
      "start": 95.88,
      "end": 99.72
    },
    {
      "text": "य ए॒वं ॅवेद॑",
