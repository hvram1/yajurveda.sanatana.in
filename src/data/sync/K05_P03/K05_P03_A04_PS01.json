  "phrases": [
    {
      "text": "अ॒ग्नेर्भा॒गो॑ऽसीति॑ पु॒रस्ता॒दुप॑ दधाति यज्ञ्मु॒खं",
      "start": 0.0,
      "end": 6.16
    },
    {
      "text": "ॅवा अ॒ग्निर्य॑ज्ञ्मु॒खं दी॒क्षा य॑ज्ञ्मु॒खं",
      "start": 6.16,
      "end": 9.2
    },
    {
      "text": "ब्रह्म॑ यज्ञ्मु॒खं त्रि॒वृद्-य॑ज्ञ्मु॒खमे॒व पु॒रस्ता॒द्वि",
      "start": 9.2,
      "end": 9.2
    },
    {
      "text": "या॑तयति नृ॒चक्ष॑सां भा॒गो॑ऽसीति॑ दक्षिण॒तः",
      "start": 9.2,
      "end": 9.2
    },
    {
      "text": "शु॑श्रु॒वाꣳसो॒ वै नृ॒चक्ष॒सोऽन्नं॑ धा॒ता",
      "start": 9.2,
      "end": 9.2
    },
    {
      "text": "जा॒तायै॒वास्मा॒ अन्न॒मपि॑ दधाति॒ तस्मा᳚ज्जा॒तोऽन्न॑मत्ति",
      "start": 9.2,
      "end": 9.2
    },
    {
      "text": "ज॒नित्रꣳ॑ स्पृ॒तꣳ स॑प्तद॒शः स्तोम॒",
      "start": 9.2,
      "end": 15.56
    },
    {
