  "phrases": [
    {
      "text": "दुत्तरतोऽभिप्रया॒यी ज॑यति॒ वज्रो॒ वै",
      "start": 37.44,
      "end": 37.44
    },
    {
      "text": "च॑तुश्चत्वारिꣳ॒॒शो वज्रः॑ षोड॒शो यदे॒ते",
      "start": 37.44,
      "end": 40.88
    },
    {
      "text": "इष्ट॑के उप॒दधा॑ति जा॒ताꣳश्चै॒व ज॑नि॒ष्यमा॑णाꣳश्च॒",
      "start": 40.88,
      "end": 49.36
    },
    {
      "text": "भ्रातृ॑व्यान् प्र॒णुद्य॒ वज्र॒मनु॒ प्रह॑रति॒",
      "start": 49.36,
      "end": 56.6
    },
    {
      "text": "स्तृत्यै॒ पुरी॑षवतीं॒ मद्ध्य॒ उप॑दधाति॒",
      "start": 56.6,
      "end": 62.76
    },
    {
      "text": "पुरी॑षं॒ ॅवै मद्ध्य॑मा॒त्मनः॒ सात्मा॑नमे॒वाग्निं",
      "start": 62.76,
      "end": 72.96
    },
    {
      "text": "चि॑नुते॒ सात्मा॒ऽमुष्मि॑न् ॅलो॒के भ॑वति॒",
      "start": 72.96,
      "end": 78.56
    },
    {
      "text": "य ए॒वं ॅवेदै॒ता वा",
      "start": 78.56,
      "end": 78.56
    },
    {
      "text": "अ॑सप॒त्ना नामेष्ट॑का॒ यस्यै॒ता उ॑पधी॒यन्ते॒",
      "start": 78.56,
      "end": 78.6
    },
