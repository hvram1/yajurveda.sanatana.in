  "phrases": [
    {
      "text": "स्तोम॑ भागा उप॒दधा॑ति प्र॒जा",
      "start": 125.32,
      "end": 126.04
    },
    {
      "text": "ए॒व तद्-यज॑मानः सृजते॒ बृह॒स्पति॒र्वा",
      "start": 126.04,
      "end": 128.72
    },
    {
      "text": "ए॒तद्-य॒ज्ञ्स्य॒ तेजः॒ सम॑भर॒द्यथ् स्तोम॑भागा॒",
      "start": 128.72,
      "end": 136.12
    },
    {
      "text": "यथ् स्तोम॑भागा उप॒दधा॑ति॒ सते॑जसमे॒वाग्निं",
      "start": 136.12,
      "end": 141.48
    },
    {
      "text": "चि॑नुते॒ बृह॒स्पति॒र्वा ए॒तां ॅय॒ज्ञ्स्य॑",
      "start": 141.48,
      "end": 148.08
    },
    {
      "text": "प्रति॒ष्ठाम॑पश्य॒द्यथ् स्तोम॑भागा॒ यथ् स्तोम॑भागा",
      "start": 148.08,
      "end": 158.16
    },
    {
      "text": "उप॒दधा॑ति य॒ज्ञ्स्य॒ प्रति॑ष्ठित्यै स॒प्तस॒प्तोप॑",
      "start": 158.16,
      "end": 166.8
    },
    {
      "text": "दधाति सवीर्य॒त्वाय॑ ति॒स्रो मद्ध्ये॒",
      "start": 166.8,
      "end": 171.88
    },
    {
      "text": "प्रति॑ष्ठित्यै",
      "start": 171.88,
      "end": 174.84
    }
