  "phrases": [
    {
      "text": "ना॒क॒सद्भि॒र्वै दे॒वाः सु॑व॒र्गं ॅलो॒कमा॑य॒न्",
      "start": 0.0,
      "end": 11.44
    },
    {
      "text": "तन्ना॑क॒सदां᳚ नाकस॒त्त्वं ॅयन्ना॑क॒सद॑ उप॒दधा॑ति",
      "start": 11.44,
      "end": 14.64
    },
    {
      "text": "नाक॒सद्भि॑रे॒व तद्-यज॑मानः सुव॒र्गं ॅलो॒कमे॑ति",
      "start": 14.64,
      "end": 17.68
    },
    {
      "text": "सुव॒र्गो वै लो॒को नाको॒",
      "start": 17.68,
      "end": 18.24
    },
    {
      "text": "यस्यै॒ता उ॑पधी॒यन्ते॒ नास्मा॒ अकं॑",
      "start": 18.24,
      "end": 25.96
    },
    {
      "text": "भवति यजमानायत॒नं ॅवै ना॑क॒सदो॒",
      "start": 25.96,
      "end": 29.28
    },
    {
      "text": "यन्ना॑क॒सद॑ उप॒दधा᳚त्या॒यत॑नमे॒व तद्-यज॑मानः कुरुते",
      "start": 29.28,
      "end": 39.2
    },
    {
      "text": "पृ॒ष्ठानां॒ ॅवा ए॒तत् तेजः॒",
      "start": 39.2,
      "end": 39.8
    },
    {
      "text": "संभृ॑तं॒ ॅयन्ना॑क॒सदो॒ यन्ना॑क॒सद॑ -",
