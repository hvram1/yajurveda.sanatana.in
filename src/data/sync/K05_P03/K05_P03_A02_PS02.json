      "end": 55.16
    },
    {
      "text": "सु॑व॒र्गं ॅलो॒कं ॅय॒तां दिशः॒",
      "start": 55.16,
      "end": 59.88
    },
    {
      "text": "सम॑व्लीयन्त॒ त ए॒ता दिश्या॑",
      "start": 59.88,
      "end": 65.84
