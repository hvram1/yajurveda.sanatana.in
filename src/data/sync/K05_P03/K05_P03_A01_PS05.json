  "phrases": [
    {
      "text": "मू᳚र्द्ध॒न्वती᳚र्भवन्ति॒ तस्मा᳚त् पु॒रस्ता᳚न्मू॒र्द्धा पञ्च॒",
      "start": 138.4,
      "end": 138.4
    },
    {
      "text": "दक्षि॑णायाꣳ॒॒ श्रोण्या॒मुप॑ दधाति॒ पञ्चोत्त॑रस्यां॒",
      "start": 138.4,
      "end": 138.4
    },
    {
      "text": "तस्मा᳚त् प॒श्चाद्-वर्.षी॑यान् पु॒रस्ता᳚त् प्रवणः",
      "start": 138.4,
      "end": 141.72
    },
    {
      "text": "प॒शुर्ब॒स्तो वय॒ इति॒ दक्षि॒णेऽꣳस॒",
      "start": 141.72,
      "end": 147.24
    },
    {
      "text": "उप॑ दधाति वृ॒ष्णिर्वय॒ इत्युत्त॒रे",
      "start": 147.24,
      "end": 153.28
    },
    {
      "text": "ऽꣳसा॑वे॒व प्रति॑ दधाति व्या॒घ्रो",
      "start": 153.28,
      "end": 158.36
    },
    {
      "text": "वय॒ इति॒ दक्षि॑णे प॒क्ष",
      "start": 158.36,
      "end": 163.6
    },
    {
      "text": "उप॑ दधाति सिꣳ॒॒हो वय॒",
      "start": 163.6,
      "end": 166.56
    },
    {
      "text": "इत्युत्त॑रे प॒क्षयो॑रे॒व वी॒र्यं॑ दधाति॒",
      "start": 166.56,
      "end": 173.52
    },
    {
      "text": "पुरु॑षो॒ वय॒ इति॒ (",
      "start": 173.52,
      "end": 175.8
    },
    {
      "text": ") मद्ध्ये॒ तस्मा॒त् पुरु॑षः",
      "start": 175.8,
      "end": 180.36
    },
    {
      "text": "पशू॒नामधि॑पतिः",
      "start": 180.36,
      "end": 182.4
    }
  ],
