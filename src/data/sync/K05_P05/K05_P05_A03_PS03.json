  "phrases": [
    {
      "text": "पु॑रुषशी॒र्॒.षमुप॑ दधाति मुख॒त ए॒वैन॒माहु॑तय",
      "start": 58.92,
      "end": 65.36
    },
    {
      "text": "ऋच्छन्ति॒ नोत्ता॒नं चि॑नुते सुव॒र्ग्यो᳚ऽस्य",
      "start": 65.36,
      "end": 72.08
    },
    {
      "text": "भवति सौ॒र्या जु॑होति॒ चक्षु॑रे॒वास्मि॒न्",
      "start": 72.08,
      "end": 78.36
    },
    {
      "text": "प्रति॑ दधाति॒ द्विर्जु॑होति॒ द्वे",
      "start": 78.36,
      "end": 84.52
    },
    {
      "text": "हि चक्षु॑षी समा॒न्या जु॑होति",
      "start": 84.52,
      "end": 87.56
    },
    {
      "text": "समा॒नꣳ हि चक्षुः॒ समृ॑द्ध्यै",
      "start": 87.56,
      "end": 90.88
    },
    {
      "text": "देवासु॒राः संॅय॑त्ता आस॒न् ते",
      "start": 90.88,
      "end": 97.52
    },
    {
      "text": "वा॒मं ॅवसु॒ सं न्य॑दधत॒",
      "start": 97.52,
      "end": 98.96
    },
    {
      "text": "तद्दे॒वा वा॑म॒भृता॑ऽवृञ्जत॒ तद्वा॑म॒भृतो॑ वामभृ॒त्त्वं",
      "start": 98.96,
      "end": 104.92
    },
    {
      "text": "ॅयद्वा॑म॒भृत॑ ( ) मुप॒दधा॑ति",
      "start": 104.92,
      "end": 107.68
    },
    {
      "text": "वा॒ममे॒व तया॒ वसु॒ यज॑मानो॒",
      "start": 107.68,
      "end": 110.84
    },
    {
      "text": "भ्रातृ॑व्यस्य वृङ्क्ते॒ हिर॑ण्यमूर्द्ध्नी भवति॒",
      "start": 110.84,
      "end": 112.6
    },
    {
      "text": "ज्योति॒र्वै हिर॑ण्यं॒ ज्योति॑र्वा॒मं ज्योति॑षै॒वास्य॒",
      "start": 112.6,
      "end": 112.6
    },
    {
      "text": "ज्योति॑र्वा॒मं ॅवृ॑ङ्क्ते द्विय॒जुर्भ॑वति॒ प्रति॑ष्ठित्यै",
      "start": 112.6,
      "end": 120.44
    }
  ],
  "total_phrases": 14
