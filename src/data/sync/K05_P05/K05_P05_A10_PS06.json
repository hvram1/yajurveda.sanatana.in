  "phrases": [
    {
      "text": "-नुपरि॒क्रामं॑ जुहो॒त्यप॑रिवर्गमे॒वैना᳚न् प्रीणाती॒मꣳ स्तन॒मूर्ज॑स्वन्तं",
      "start": 161.64,
      "end": 161.64
    },
    {
      "text": "धया॒पां प्रप्या॑तमग्ने सरि॒रस्य॒ मद्ध्ये᳚",
      "start": 161.64,
      "end": 161.64
    },
    {
      "text": "उथ्सं॑ जुषस्व॒ मधु॑मन्तमूर्व समु॒द्रियꣳ॒॒",
      "start": 161.64,
      "end": 161.64
    },
    {
      "text": "सद॑न॒मा वि॑शस्व",
      "start": 161.64,
      "end": 161.64
    },
    {
      "text": "यो वा अ॒ग्निं प्र॒युज्य॒",
      "start": 161.64,
      "end": 161.64
    },
    {
      "text": "न वि॑मु॒ञ्चति॒ यथाऽश्वो॑ यु॒क्तोऽवि॑मुच्यमानः॒",
      "start": 161.64,
      "end": 161.64
    },
    {
      "text": "क्षुद्ध्य॑न् परा॒भव॑त्ये॒वम॑स्या॒ग्निः परा॑ भवति॒",
      "start": 161.64,
      "end": 169.4
    },
    {
      "text": "तं प॑रा॒भव॑न्तं॒ ॅयज॑मा॒नोऽनु॒ परा॑",
      "start": 169.4,
      "end": 176.8
    },
    {
      "text": "भवति॒ सो᳚ऽग्निं चि॒त्वा लू॒क्षो",
      "start": 176.8,
      "end": 181.88
    },
