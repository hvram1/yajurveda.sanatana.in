  "phrases": [
    {
      "text": "तद्वा अ॒ग्नेः शिरः॒ सशी॑र्.षाणमे॒वाग्निं",
      "start": 111.16,
      "end": 113.68
    },
    {
      "text": "चि॑नुते॒ सशी॑र्.षा॒ऽमुष्मि॑न् ॅलो॒के भ॑वति॒",
      "start": 113.68,
      "end": 117.96
    },
    {
      "text": "य ए॒वं ॅवेद॑ सुव॒र्गाय॒",
      "start": 117.96,
      "end": 117.96
    },
    {
      "text": "वा ए॒ष लो॒काय॑ चीयते॒",
      "start": 117.96,
      "end": 117.96
    },
    {
      "text": "यद॒ग्निस्तस्य॒ यदय॑थापूर्वं क्रि॒यते ऽसु॑वर्ग्यमस्य॒",
      "start": 117.96,
      "end": 117.96
    },
    {
      "text": "तथ् सु॑व॒र्ग्यो᳚ ऽग्निश्चिति॑मुप॒धाया॒भि मृ॑शे॒च्चित्ति॒मचि॑त्तिं",
      "start": 117.96,
      "end": 117.96
    },
    {
      "text": "चिनव॒द्वि वि॒द्वान् पृ॒ष्ठेव॑ वी॒ता",
      "start": 117.96,
      "end": 122.8
    },
    {
      "text": "वृ॑जि॒ना च॒ मर्ता᳚न् रा॒ये",
      "start": 122.8,
      "end": 126.6
    },
    {
      "text": "च॑ नः स्वप॒त्याय॑ (",
      "start": 126.6,
      "end": 129.72
    },
    {
      "text": ") देव॒ दितिं॑ च॒",
      "start": 129.72,
      "end": 133.12
    },
    {
      "text": "रास्वा-दि॑तिमुरु॒ष्येति॑ यथापू॒र्वमे॒वैना॒मुप॑ धत्ते॒ प्राञ्च॑मेनं",
      "start": 133.12,
      "end": 137.8
    },
    {
      "text": "चिनुते सुव॒र्ग्यो᳚ऽस्य भवति",
      "start": 137.8,
      "end": 139.76
    }
  ],
