  "phrases": [
    {
      "text": "जाग॑तेन॒ छन्द॑सा सवि॒त्रा दे॒वत॑या॒ऽग्नेः",
      "start": 92.44,
      "end": 100.04
    },
    {
      "text": "पुच्छे॑ना॒ग्नेः पुच्छ॒मुप॑ दधा॒म्युदी᳚च्या त्वा",
      "start": 100.04,
      "end": 102.64
    },
    {
      "text": "दि॒शा सा॑दया॒म्यानु॑ष्टुभेन॒ छन्द॑सा मि॒त्रावरु॑णाभ्यां",
      "start": 102.64,
      "end": 110.48
    },
    {
      "text": "ए॒वत॑या॒ऽग्नेः प॒क्षेणा॒ग्नेः प॒क्षमुप॑ दधाम्यू॒र्द्ध्वया᳚",
      "start": 110.48,
      "end": 118.08
    },
    {
      "text": "त्वा दि॒शा सा॑दयामि॒ पाङ्क्ते॑न॒",
      "start": 118.08,
      "end": 121.68
    },
    {
      "text": "छन्द॑सा॒ बृह॒स्पति॑ना दे॒वत॑या॒ऽग्नेः पृ॒ष्ठेना॒ग्नेः",
      "start": 121.68,
      "end": 123.4
    },
    {
      "text": "पृ॒ष्ठमुप॑ दधामि॒ योऽवा अपा᳚त्मानम॒ग्निं",
      "start": 123.4,
      "end": 123.4
    },
    {
      "text": "चि॑नु॒तेऽपा᳚त्मा॒ऽमुष्मि॑न् ॅलो॒के भ॑वति॒ यः",
      "start": 123.4,
      "end": 123.4
    },
    {
      "text": "सात्मा॑नं चिनु॒ते ( )",
      "start": 123.4,
      "end": 123.4
    },
    {
      "text": "सात्मा॒ऽमुष्मि॑न् ॅलो॒के भ॑वत्यात्मेष्ट॒का उप॑",
      "start": 123.4,
      "end": 125.84
    },
    {
      "text": "दधात्ये॒ष वा अ॒ग्नेरा॒त्मा सात्मा॑नमे॒वाग्निं",
      "start": 125.84,
      "end": 131.12
    },
    {
      "text": "चि॑नुते॒ सात्मा॒ऽमुष्मि॑न् ॅलो॒के भ॑वति॒",
      "start": 131.12,
      "end": 138.04
    },
    {
      "text": "य ए॒वं ॅवेद॑",
      "start": 138.04,
      "end": 140.12
    }
  ],
  "total_phrases": 13
