  "phrases": [
    {
      "text": "-न्व॒हमे॒वैनं॑ चिनु॒ते ऽवाह्नाꣳ॑ रू॒पाणि॑",
      "start": 14.52,
      "end": 18.92
    },
    {
      "text": "रुन्धे ब्रह्मवा॒दिनो॑ वदन्ति॒ कस्मा᳚थ्",
      "start": 18.92,
      "end": 20.64
    },
    {
      "text": "स॒त्याद्या॒तया᳚म्नीर॒न्या इष्ट॑का॒ अया॑तयाम्नी लोकं",
      "start": 20.64,
      "end": 26.4
    },
    {
      "text": "पृ॒णेत्यै᳚न्द्रा॒ग्नी हि बा॑र्.हस्प॒त्येति॑ ब्रूयादिन्द्रा॒ग्नी",
      "start": 26.4,
      "end": 33.2
    },
    {
      "text": "च॒ हि दे॒वानां॒ बृह॒स्पति॒श्चा-या॑तयामानो",
      "start": 33.2,
      "end": 38.96
    },
    {
      "text": "ऽनुच॒रव॑ती भव॒त्यजा॑मित्वाया -नु॒ष्टुभाऽनु॑ चरत्या॒त्मा",
      "start": 38.96,
      "end": 43.28
    },
    {
      "text": "वै लो॑कं पृ॒णा प्रा॒णो॑",
      "start": 43.28,
      "end": 47.84
    },
    {
      "text": "ऽनु॒ष्टुप् तस्मा᳚त् प्रा॒णः सर्वा॒ण्यङ्गा॒न्यनु॑",
      "start": 47.84,
      "end": 56.52
    },
    {
      "text": "चरति॒ ता अ॑स्य॒ सूद॑दोहस॒",
