  "phrases": [
    {
      "text": "लो॒केष्वधि॒ प्रजा॑यते प्रा॒णाय॑ व्या॒नाया॑पा॒नाय॑",
      "start": 103.6,
      "end": 103.6
    },
    {
      "text": "वा॒चे त्वा॒ चक्षु॑षे त्वा॒",
      "start": 103.6,
      "end": 103.6
    },
    {
      "text": "तया॑ दे॒वत॑याऽङ्गिर॒स्वद् ध्रु॒वा सी॑दा॒ग्निना॒",
      "start": 103.6,
      "end": 103.6
    },
    {
      "text": "वै दे॒वाः सु॑व॒र्गं ॅलो॒कम॑जिगाꣳस॒न्",
      "start": 103.6,
      "end": 105.68
    },
    {
      "text": "तेन॒ पति॑तुं॒ नाश॑क्नुव॒न् त",
      "start": 105.68,
      "end": 108.28
    },
    {
      "text": "ए॒ताश्चत॑स्रः स्वयमातृ॒ण्णा अ॑पश्य॒न् ता",
      "start": 108.28,
      "end": 114.24
    },
    {
      "text": "दि॒क्षूपा॑दधत॒ तेन॑ स॒र्वत॑श्चक्षुषा सुव॒र्गं",
      "start": 114.24,
      "end": 124.08
    },
    {
      "text": "ॅलो॒कमा॑य॒न्॒ यच्चत॑स्रः स्वयमातृ॒ण्णा दि॒क्षू॑प॒दधा॑ति",
      "start": 124.08,
      "end": 136.68
    },
    {
      "text": "स॒र्वत॑श्चक्षुषै॒व तद॒ग्निना॒ यज॑मानः (",
      "start": 136.68,
      "end": 144.08
    },
    {
