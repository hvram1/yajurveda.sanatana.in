  "phrases": [
    {
      "text": "ॅयद्-वा॑रव॒न्तीये॑नोप॒तिष्ठ॑ते वा॒रय॑त ऐ॒वैनꣳ॑ श्यै॒तेन॑",
      "start": 35.2,
      "end": 44.84
    },
    {
      "text": "श्ये॒ती कु॑रुते प्र॒जाप॑ते॒र्.हृद॑येना-पिप॒क्षं प्रत्युप॑",
      "start": 44.84,
      "end": 51.88
    },
    {
      "text": "तिष्ठते प्रे॒माण॑मे॒वास्य॑ गच्छति॒ प्राच्या᳚",
      "start": 51.88,
      "end": 59.16
    },
    {
      "text": "त्वा दि॒शा सा॑दयामि गाय॒त्रेण॒",
      "start": 59.16,
      "end": 65.4
    },
    {
      "text": "छन्द॑सा॒ऽग्निना॑ दे॒वत॑या॒ऽग्नेः शीर्ष्णाग्नेः शिर॒",
      "start": 65.4,
      "end": 71.6
    },
    {
      "text": "उप॑ दधामि॒ दक्षि॑णया त्वा",
      "start": 71.6,
      "end": 75.32
    },
    {
      "text": "दि॒शा सा॑दयामि॒ त्रैष्टु॑भेन॒ छन्द॒सेन्द्रे॑ण",
      "start": 75.32,
      "end": 82.32
    },
    {
      "text": "दे॒वत॑या॒ऽग्नेः प॒क्षेणा॒ग्नेः प॒क्षमुप॑ दधामि",
      "start": 82.32,
      "end": 88.32
    },
    {
      "text": "प्र॒तीच्या᳚ त्वा दि॒शा सा॑दयामि॒",
      "start": 88.32,
      "end": 92.44
    },
