  "phrases": [
    {
      "text": "वो रू॒पम॒भ्यैमि॒ वय॑सा॒ वयः॑",
      "start": 58.48,
      "end": 64.28
    },
    {
      "text": "तु॒थो वो॑ वि॒श्ववे॑दा॒ वि",
      "start": 64.28,
      "end": 67.52
    },
    {
      "text": "भ॑जतु॒ वर्.षि॑ष्ठे॒ अधि॒ नाके᳚",
      "start": 67.52,
      "end": 71.8
    },
    {
      "text": "ए॒तत्ते॑ अग्ने॒ राध॒ ऐति॒",
      "start": 71.8,
      "end": 71.8
    },
    {
      "text": "सोम॑च्युतं॒ तन्मि॒त्रस्य॑ प॒था न॑य॒र्तस्य॑",
      "start": 71.8,
      "end": 71.8
    },
    {
      "text": "प॒था प्रेत॑ च॒न्द्रद॑क्षिणा य॒ज्ञ्स्य॑",
      "start": 71.8,
      "end": 71.8
    },
    {
      "text": "प॒था सु॑वि॒ता नय॑न्तीर् ब्राह्म॒णम॒द्य",
      "start": 71.8,
      "end": 71.8
    },
    {
      "text": "रा᳚द्ध्यास॒मृषि॑मार्.षे॒यं पि॑तृ॒मन्तं॑ पैतृम॒त्यꣳ सु॒धातु॑दक्षिणं॒",
      "start": 71.8,
      "end": 81.2
    },
    {
      "text": "ॅवि सुवः॒ पश्य॒ व्य॑न्तरि॑क्षं॒",
      "start": 81.2,
      "end": 81.2
    },
    {
      "text": "ॅयत॑स्व सद॒स्यै॑ ( )",
      "start": 81.2,
      "end": 81.2
    },
    {
      "text": "र॒स्मद्दा᳚त्रा देव॒त्रा ग॑च्छत॒ मधु॑मतीः",
      "start": 81.2,
      "end": 84.76
    },
    {
      "text": "प्रदा॒तार॒मा वि॑श॒ताऽन॑वहाया॒ऽस्मान् दे॑व॒याने॑न प॒थेत॑",
      "start": 84.76,
      "end": 95.88
    },
    {
      "text": "सु॒कृतां᳚ ॅलो॒के सी॑द॒त तन्नः॑",
