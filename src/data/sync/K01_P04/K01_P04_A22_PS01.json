  "phrases": [
    {
      "text": "क॒दा च॒न स्त॒रीर॑सि॒ नेन्द्र॑",
      "start": 0.0,
      "end": 4.32
    },
    {
      "text": "सश्चसि दा॒शुषे᳚",
      "start": 4.32,
      "end": 6.24
    },
    {
      "text": "उपो॒पेन्नु म॑घव॒न् भूय॒ इन्नु",
      "start": 6.24,
      "end": 10.0
    },
    {
      "text": "ते॒ दानं॑ दे॒वस्य॑ पृच्यते",
      "start": 10.0,
      "end": 15.6
    },
    {
      "text": "उ॒प॒या॒मगृ॑हीतोऽस्या-दि॒त्येभ्य॑स्त्वा",
      "start": 15.6,
      "end": 25.08
    },
    {
      "text": "क॒दा च॒न प्र यु॑च्छस्यु॒भे",
      "start": 25.08,
      "end": 26.48
    },
    {
      "text": "नि पा॑सि॒ जन्म॑नी",
      "start": 26.48,
      "end": 26.48
    },
    {
      "text": "तुरी॑यादित्य॒ सव॑नं त इन्द्रि॒यमा",
      "start": 26.48,
      "end": 26.48
    },
    {
      "text": "त॑स्थाव॒मृतं॑ दि॒वि",
      "start": 26.48,
      "end": 29.92
    },
    {
      "text": "य॒ज्ञो दे॒वानां॒ प्रत्ये॑ति सु॒म्नमादि॑त्यासो॒",
      "start": 29.92,
      "end": 34.52
    },
    {
      "text": "भव॑ता मृड॒यन्तः॑",
      "start": 34.52,
      "end": 36.12
    },
    {
      "text": "आ वो॒ ( )",
      "start": 36.12,
      "end": 36.12
    },
    {
      "text": "ऽर्वाची॑ सुम॒तिर् व॑वृत्यादꣳ॒॒हो-श्चि॒द्या व॑रिवो॒वित्त॒राऽस॑त्",
      "start": 36.12,
      "end": 45.64
    },
    {
      "text": "विव॑स्व आदित्यै॒ष ते॑ सोमपी॒थस्तेन॑",
      "start": 45.64,
      "end": 50.52
    },
    {
      "text": "मन्दस्व॒ तेन॑ तृप्य तृ॒प्यास्म॑",
      "start": 50.52,
      "end": 53.12
    },
    {
      "text": "ते व॒यं त॑र्पयि॒तारो॒ या",
      "start": 53.12,
      "end": 55.4
    },
    {
      "text": "दि॒व्या वृष्टि॒स्तया᳚ त्वा श्रीणामि",
      "start": 55.4,
      "end": 57.32
    }
  ],
