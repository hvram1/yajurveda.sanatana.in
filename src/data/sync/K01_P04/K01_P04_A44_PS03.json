      "start": 81.32,
      "end": 85.8
    },
    {
      "text": "वह॑माना॒ भर॑माणा ह॒वीꣳषि॒ वसुं॑",
      "start": 85.8,
      "end": 91.48
    },
    {
      "text": "घ॒र्मं दिव॒मा ति॑ष्ठ॒तानु॑",
      "start": 91.48,
      "end": 93.84
    },
    {
      "text": "यज्ञ्॑ य॒ज्ञ्ं ग॑च्छ य॒ज्ञ्प॑तिं",
      "start": 93.84,
      "end": 93.84
    },
    {
      "text": "गच्छ॒ स्वां ॅयोनिं॑ गच्छ॒",
      "start": 93.84,
      "end": 93.84
    },
    {
      "text": "स्वाहै॒ष ते॑ य॒ज्ञो य॑ज्ञ्पते",
      "start": 93.84,
      "end": 93.84
    },
    {
      "text": "स॒हसू᳚क्तवाकः सु॒वीरः॒ स्वाहा॒ देवा॑",
      "start": 93.84,
      "end": 100.52
    },
    {
      "text": "गातुविदो गा॒तुं ॅवि॒त्त्वा गा॒तुमि॑त॒",
