  "phrases": [
    {
      "text": "ये दे॑वा दि॒व्येका॑दश॒ स्थ",
      "start": 0.0,
      "end": 0.04
    },
    {
      "text": "पृ॑थि॒व्यामद्ध्येका॑दश॒ स्थाऽफ्सु॒षदो॑ महि॒नैका॑दश॒ स्थ",
      "start": 0.04,
      "end": 9.24
    },
    {
      "text": "ते दे॑वा य॒ज्ञ्मि॒मं जु॑षद्ध्व-मुपया॒मगृ॑हीतो-ऽस्याग्रय॒णो॑ऽसि॒",
      "start": 9.24,
      "end": 18.68
    },
    {
      "text": "स्वा᳚ग्रयणो॒ जिन्व॑ य॒ज्ञ्ं जिन्व॑",
      "start": 18.68,
      "end": 19.96
    },
    {
      "text": "य॒ज्ञ्प॑तिम॒भि सव॑ना पाहि॒ विष्णु॒स्त्वां",
      "start": 19.96,
      "end": 22.52
    },
    {
      "text": "पा॑तु॒ विशं॒ त्वं पा॑हीन्द्रि॒येणै॒ष",
      "start": 22.52,
      "end": 25.84
    },
    {
      "text": "ते॒ योनि॒र् विश्वे᳚भ्यस्त्वा दे॒वेभ्यः॑",
      "start": 25.84,
      "end": 31.92
    }
  ],
