  "phrases": [
    {
      "text": "उ॒प॒या॒मगृ॑हीतो ऽस्य॒न्तर्य॑च्छ मघवन् पा॒हि",
      "start": 0.0,
      "end": 0.68
    },
    {
      "text": "सोम॑मुरु॒ष्य रायः॒ समिषो॑ यजस्वा॒ऽन्तस्ते॑",
      "start": 0.68,
      "end": 0.68
    },
    {
      "text": "दधामि॒ द्यावा॑पृथि॒वी अ॒न्तरु॒र्व॑न्तरि॑क्षꣳ स॒जोषा॑",
      "start": 0.68,
      "end": 8.84
    },
    {
      "text": "दे॒वैरव॑रैः॒ परै᳚श्चाऽन्तर्या॒मे म॑घवन् मादयस्व॒",
      "start": 8.84,
      "end": 8.84
    },
    {
      "text": "स्वांकृ॑तोऽसि॒ मधु॑मतीर्न॒ इष॑स्कृधि॒ विश्वे᳚भ्यस्त्वेन्द्रि॒येभ्यो॑",
      "start": 8.84,
      "end": 12.64
    },
    {
      "text": "दि॒व्येभ्यः॒ पार्त्थि॑वेभ्यो॒ मन॑स्त्वाऽष्टू॒र्व॑न्तरि॑क्ष॒मन्वि॑हि॒ स्वाहा᳚",
      "start": 12.64,
      "end": 32.16
    },
    {
      "text": "त्वा सुभवः॒ सूर्या॑य दे॒वेभ्य॑",
      "start": 32.16,
      "end": 38.84
    },
    {
      "text": "( ) स्त्वा मरीचि॒पेभ्य॑",
      "start": 38.84,
      "end": 42.2
    },
    {
      "text": "ए॒ष ते॒",
