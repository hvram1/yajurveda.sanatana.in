    {
      "text": "स॒मिधं॑ ॅयक्ष्यग्ने",
      "start": 23.08,
      "end": 24.68
    },
    {
      "text": "प्रति॑ ते जि॒ह्वा घृ॒तमुच्च॑रण्येथ्",
      "start": 24.68,
      "end": 27.96
    },
    {
      "text": "समु॒द्रे ते॒ हृद॑यम॒फ्स्व॑न्तः",
      "start": 27.96,
      "end": 32.64
    },
    {
      "text": "सं त्वा॑ विश॒न्त्वोष॑धी-रु॒ताऽऽपो॑ य॒ज्ञ्स्य॑",
      "start": 32.64,
      "end": 42.92
    },
    {
      "text": "त्वा यज्ञ्पते ह॒विर्भिः॑",
      "start": 42.92,
      "end": 46.52
    },
    {
      "text": "सू॒क्त॒वा॒के न॑मोवा॒के वि॑धे॒माऽव॑भृथ निचङ्कुण",
      "start": 46.52,
      "end": 55.16
    },
    {
      "text": "निचे॒रुर॑सि निचङ्कु॒णाऽव॑ दे॒वैर् दे॒वकृ॑त॒मेनो॑ऽया॒डव॒",
      "start": 55.16,
      "end": 64.48
    },
    {
      "text": "मर्त्यै॒र् मर्त्य॑कृतमु॒रोरा नो॑ देव",
      "start": 64.48,
      "end": 71.88
    },
    {
      "text": "रि॒षस्पा॑हि सुमि॒त्रा न॒ आप॒",
      "start": 71.88,
      "end": 77.76
    },
    {
