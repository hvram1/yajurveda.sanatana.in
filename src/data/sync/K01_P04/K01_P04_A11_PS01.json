    {
      "text": "त्रिꣳ॒॒शत्त्रय॑श्च ग॒णिनो॑ रु॒जन्तो॒ दिवꣳ॑",
      "start": 0.0,
      "end": 8.64
    },
    {
      "text": "रु॒द्राः पृ॑थि॒वीं च॑ सचन्ते",
      "start": 8.64,
      "end": 12.32
    },
    {
      "text": "ए॒का॒द॒शासो॑ अफ्सु॒षदः॑ सु॒तꣳ सोमं॑",
      "start": 12.32,
      "end": 16.08
    },
    {
      "text": "जुषन्ताꣳ॒॒ सव॑नाय॒ विश्वे᳚",
      "start": 16.08,
      "end": 16.08
    },
    {
      "text": "उ॒प॒या॒मगृ॑हीतो -ऽस्याग्रय॒णो॑ऽसि॒ स्वा᳚ग्रयणो॒ जिन्व॑",
      "start": 16.08,
      "end": 18.68
    },
    {
      "text": "य॒ज्ञ्ं जिन्व॑ य॒ज्ञ्प॑तिम॒भि सव॑ना",
      "start": 18.68,
      "end": 23.64
    },
    {
      "text": "पाहि॒ विष्णु॒स्त्वां पा॑तु॒ विशं॒",
