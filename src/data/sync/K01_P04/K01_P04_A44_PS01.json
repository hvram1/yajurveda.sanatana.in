    {
      "text": "धा॒ता रा॒तिः स॑वि॒तेदं जु॑षन्तां",
      "start": 0.0,
      "end": 6.52
    },
    {
      "text": "प्र॒जाप॑तिर् निधि॒पति॑र्नो अ॒ग्निः",
      "start": 6.52,
      "end": 6.52
    },
    {
      "text": "त्वष्टा॒ विष्णुः॑ प्र॒जया॑ सꣳररा॒णो",
      "start": 6.52,
      "end": 6.52
    },
    {
      "text": "यज॑मानाय॒ द्रवि॑णं दधातु",
      "start": 6.52,
      "end": 6.52
    },
    {
      "text": "समि॑न्द्र णो॒ मन॑सा नेषि॒",
      "start": 6.52,
      "end": 6.52
    },
    {
      "text": "गोभिः॒ सꣳ सू॒रिभि॑र्मघव॒न्थ् सꣳ",
      "start": 6.52,
      "end": 6.52
    },
    {
      "text": "स्व॒स्त्या",
      "start": 6.52,
      "end": 6.52
    },
    {
      "text": "सं ब्रह्म॑णा दे॒वकृ॑तं॒ ॅयदस्ति॒",
      "start": 6.52,
      "end": 6.52
    },
    {
      "text": "सं दे॒वानाꣳ॑ सुम॒त्या य॒ज्ञिया॑नां",
      "start": 6.52,
      "end": 12.8
    },
    {
      "text": "सं ॅवर्च॑सा॒ पय॑सा॒ सं",
      "start": 12.8,
      "end": 17.36
    },
    {
      "text": "त॒नूभि॒-रग॑न्महि॒ मन॑सा॒ सꣳ शि॒वेन॑",
      "start": 17.36,
      "end": 23.24
