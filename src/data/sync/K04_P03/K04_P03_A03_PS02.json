  "phrases": [
    {
      "text": "द्रवि॑णꣳ सप्तद॒श स्तोमः॒ स",
      "start": 38.92,
      "end": 42.24
    },
    {
      "text": "उ॑ वेकविꣳ॒॒ शव॑र्तनि-स्त्रिव॒थ्सो वयो᳚",
      "start": 42.24,
      "end": 43.92
    },
    {
      "text": "द्वाप॒रोऽया॑नां पश्चाद्वा॒तो वातो॑ऽह॒भून॒ ऋषि॒रुदी॑ची",
      "start": 43.92,
      "end": 50.36
    },
    {
      "text": "दि॒शाꣳ श॒रद्-ऋ॑तू॒नां मि॒त्रावरु॑णौ दे॒वता॑",
      "start": 50.36,
      "end": 56.76
    },
    {
      "text": "पु॒ष्टं द्रवि॑णमेकविꣳ॒॒शः स्तोमः॒ स",
      "start": 56.76,
      "end": 62.72
    },
    {
      "text": "उ॑ त्रिण॒वव॑र्तनि-स्तुर्य॒वाड् वय॑ आस्क॒न्दो",
      "start": 62.72,
      "end": 64.56
    },
    {
      "text": "ऽया॑नामुत्तराद्-वा॒तो वातः॑ प्र॒त्न ऋषि॑रू॒र्द्ध्वा",
      "start": 64.56,
      "end": 72.88
    },
    {
      "text": "दि॒शाꣳ हे॑मन्तशिशि॒रावृ॑तू॒नां बृह॒स्पति॑र्दे॒वता॒ वर्चो॒",
      "start": 72.88,
      "end": 80.48
    },
    {
      "text": "द्रवि॑णं त्रिण॒व स्तोमः॒ स",
      "start": 80.48,
      "end": 82.04
    },
    {
      "text": "उ॑ त्रयस्त्रिꣳ॒॒शव॑र्तनिः पष्ठ॒वाद्वयो॑ (",
      "start": 82.04,
      "end": 82.04
    },
    {
      "text": ") ऽभि॒भूरया॑नां ॅविष्वग्वा॒तो वातः॑",
      "start": 82.04,
      "end": 82.72
    },
    {
      "text": "सुप॒र्ण ऋषिः॑ पि॒तरः॑ पिताम॒हाः",
      "start": 82.72,
      "end": 87.28
    },
    {
      "text": "परेऽव॑रे॒ ते नः॑ पान्तु॒",
      "start": 87.28,
      "end": 89.4
    },
    {
      "text": "ते नो॑ऽवन्त्व॒स्मिन् ब्रह्म॑न्न॒स्मिन् क्ष॒त्रे᳚ऽस्या-मा॒शिष्य॒स्यां",
      "start": 89.4,
      "end": 95.72
    },
    {
      "text": "पु॑रो॒धाया॑म॒स्मिन् कर्म॑न्न॒स्यां दे॒वहू᳚त्यां",
      "start": 95.72,
      "end": 101.72
    }
  ],
  "total_phrases": 15
}