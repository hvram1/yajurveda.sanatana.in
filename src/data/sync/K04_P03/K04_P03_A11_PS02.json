  "phrases": [
    {
      "text": "व्र॒तमेका॑ रक्षति देवयू॒नां",
      "start": 31.24,
      "end": 35.56
    },
    {
      "text": "च॒तु॒ष्टो॒मो अ॑भव॒द्या तु॒रीया॑ य॒ज्ञ्स्य॑",
      "start": 35.56,
      "end": 46.84
    },
    {
      "text": "प॒क्षावृ॑षयो॒ भव॑न्ती",
      "start": 46.84,
      "end": 50.08
    },
    {
      "text": "गा॒य॒त्रीं त्रि॒ष्टुभं॒ ज॑गतीमनु॒ष्टुभं॑ बृ॒हद॒र्कं",
      "start": 50.08,
      "end": 58.88
    },
    {
      "text": "ॅयु॑ञ्जा॒नाः सुव॒राऽभ॑रन्नि॒दं",
      "start": 58.88,
      "end": 62.24
    },
    {
      "text": "प॒ञ्चभि॑र्द्धा॒ता वि द॑धावि॒दं ॅयत्",
      "start": 62.24,
      "end": 68.2
    },
    {
      "text": "तासाꣳ॒॒ स्वसॄ॑रजनय॒त् पञ्च॑पञ्च",
      "start": 68.2,
      "end": 74.32
    },
    {
      "text": "तासा॑मु यन्ति प्रय॒वेण॒ पञ्च॒",
      "start": 74.32,
      "end": 77.2
    },
    {
      "text": "नाना॑ रू॒पाणि॒ क्रत॑वो॒ वसा॑नाः",
      "start": 77.2,
      "end": 82.64
    },
    {
      "text": "त्रिꣳ॒॒शथ् स्वसा॑र॒ उप॑यन्ति निष्कृ॒तꣳ",
      "start": 82.64,
      "end": 89.52
    },
    {
      "text": "स॑मा॒नं के॒तुं प्र॑तिमु॒ञ्चमा॑नाः",
      "start": 89.52,
      "end": 97.32
    }
  ],
