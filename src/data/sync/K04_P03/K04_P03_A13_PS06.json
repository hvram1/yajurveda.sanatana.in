  "phrases": [
    {
      "text": "-श्चर्.षणी॒नां",
      "start": 202.56,
      "end": 202.88
    },
    {
      "text": "प्रबु॒द्ध्निया॑ ईरते वो॒ महाꣳ॑सि॒",
      "start": 202.88,
      "end": 208.36
    },
    {
      "text": "प्रणामा॑नि प्रयज्यवस्तिरद्ध्वं",
      "start": 208.36,
      "end": 210.32
    },
    {
      "text": "स॒ह॒स्रियं॒ दम्यं॑ भा॒गमे॒तं गृ॑हमे॒धीयं॑",
      "start": 210.32,
      "end": 218.8
    },
    {
      "text": "मरुतो जुषद्ध्वं",
      "start": 218.8,
      "end": 219.52
    },
    {
      "text": "उप॒ यमेति॑ युव॒तिः सु॒दक्षं॑",
      "start": 219.52,
      "end": 224.92
    },
    {
      "text": "दो॒षा वस्तोर्॑. ह॒विष्म॑ती घृ॒ताची᳚",
      "start": 224.92,
      "end": 227.36
    },
    {
      "text": "उप॒ स्वैन॑म॒रम॑तिर्व-सू॒युः",
      "start": 227.36,
      "end": 227.36
    },
    {
      "text": "इ॒मो अ॑ग्ने वी॒तत॑मानि ह॒व्या",
      "start": 227.36,
      "end": 231.12
    },
    {
      "text": "ऽज॑स्रो वक्षि दे॒वता॑ति॒मच्छ॑",
      "start": 231.12,
      "end": 236.16
    },
    {
      "text": "प्रति॑ न ईꣳ सुर॒भीणि॑ वियन्तु",
      "start": 236.16,
      "end": 238.64
    },
    {
      "text": "क्री॒डं ॅवः॒ शर्द्धो॒ मारु॑तमन॒र्वाणꣳ॑ रथे॒शुभं᳚",
      "start": 238.64,
      "end": 246.28
    }
  ],
