  "phrases": [
    {
      "text": "रु॒द्राणा॒माधि॑पत्यं॒ चतु॑ष्पाथ् स्पृ॒तं च॑तुर्विꣳ॒॒शः",
      "start": 39.24,
      "end": 47.44
    },
    {
      "text": "स्तोम॑ आदि॒त्यानां᳚ भा॒गो॑ऽसि म॒रुता॒माधि॑पत्यं॒",
      "start": 47.44,
      "end": 47.44
    },
    {
      "text": "गर्भाः᳚ स्पृ॒ताः प॑ञ्चविꣳ॒॒शः स्तोमो॑",
      "start": 47.44,
      "end": 47.44
    },
    {
      "text": "दे॒वस्य॑ सवि॒तुर्भा॒गो॑ऽसि॒ बृह॒स्पते॒राधि॑पत्यꣳ स॒मीची॒र्दिशः॑",
      "start": 47.44,
      "end": 52.8
    },
    {
      "text": "स्पृ॒ताश्च॑तुष्टो॒मः स्तोमो॒ यावा॑नां भा॒गो᳚ऽस्यया॑वाना॒माधि॑पत्यं",
      "start": 52.8,
      "end": 63.24
    },
    {
      "text": "प्र॒जाः स्पृ॒ता-श्च॑तु-श्चत्वारिꣳ॒॒शः स्तोम॑ ऋभू॒णां",
      "start": 63.24,
      "end": 68.6
    },
    {
      "text": "भा॒गो॑ऽसि॒ विश्वे॑षां दे॒वाना॒माधि॑पत्यं भू॒तं",
      "start": 68.6,
      "end": 75.84
    },
    {
      "text": "निशा᳚न्तꣳ स्पृ॒तं त्र॑यस्त्रिꣳ॒॒शः स्तोमः॑",
      "start": 75.84,
      "end": 79.12
    }
  ],
