  "phrases": [
    {
      "text": "अ॒ग्निर्वृ॒त्राणि॑ जङ्घनद् द्रविण॒स्युर्वि॑प॒न्यया᳚",
      "start": 0.0,
      "end": 1.0
    },
    {
      "text": "समि॑द्धः शु॒क्र आहु॑तः",
      "start": 1.0,
      "end": 6.28
    },
    {
      "text": "त्वꣳ सो॑मासि॒ सत्प॑ति॒स्त्वꣳ राजो॒त वृ॑त्र॒हा",
      "start": 6.28,
      "end": 17.88
    },
    {
      "text": "त्वं भ॒द्रो अ॑सि॒ क्रतुः॑",
      "start": 17.88,
      "end": 21.8
    },
    {
      "text": "भ॒द्रा ते॑ अग्ने स्वनीक",
      "start": 21.8,
      "end": 24.52
    },
    {
      "text": "स॒दृंग्घो॒रस्य॑ स॒तो विषु॑णस्य॒ चारुः॑",
      "start": 24.52,
      "end": 31.24
    },
    {
      "text": "न यत् ते॑ शो॒चिस्तम॑सा॒",
      "start": 31.24,
      "end": 36.84
    },
    {
      "text": "वर॑न्त॒ न ध्व॒स्मान॑स्त॒नुवि॒ रेप॒",
      "start": 36.84,
      "end": 46.08
    },
    {
      "text": "आ धुः॑",
      "start": 46.08,
      "end": 46.96
    },
    {
      "text": "भ॒द्रं ते॑ अग्ने सहसि॒न्ननी॑कमुपा॒क",
      "start": 46.96,
      "end": 52.6
    },
    {
      "text": "आ रो॑चते॒ सूर्य॑स्य",
      "start": 52.6,
      "end": 55.84
    }
