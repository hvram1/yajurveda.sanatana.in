  "phrases": [
    {
      "text": "प्रति॑ तिष्ठन्ति पृ॒ष्ठं ॅवै",
      "start": 70.08,
      "end": 74.36
    },
    {
      "text": "दि॑वाकी॒र्त्यं॑ पा॒र्श्वे पर॑स्सामानो॒ ऽभितो॑",
      "start": 74.36,
      "end": 77.32
    },
    {
      "text": "दिवाकी॒र्त्यं॑ पर॑स्सामानो भवन्ति॒ तस्मा॑द॒भितः॑",
      "start": 77.32,
      "end": 84.48
    },
    {
      "text": "पृ॒ष्ठं पा॒र्श्वे भूयि॑ष्ठा॒ ग्रहा॑",
      "start": 84.48,
      "end": 91.8
    },
    {
      "text": "गृह्यन्ते॒ भूयि॑ष्ठꣳ शस्यते य॒ज्ञ्स्यै॒व",
      "start": 91.8,
      "end": 98.56
    },
    {
      "text": "तन्म॑द्ध्य॒तो ग्र॒न्थिं ग्र॑थ्न॒न्त्यवि॑स्रꣳसाय स॒प्त",
      "start": 98.56,
      "end": 108.6
    },
    {
      "text": "गृ॑ह्यन्ते स॒प्त वै शी॑र्.ष॒ण्याः᳚",
      "start": 108.6,
      "end": 108.6
    },
    {
      "text": "प्रा॒णाः प्रा॒णाने॒व यज॑मानेषु दधति॒",
      "start": 108.6,
      "end": 108.6
    },
    {
      "text": "यत् प॑रा॒चीना॑नि पृ॒ष्ठानि॒ भव॑न्त्य॒मुमे॒व",
      "start": 108.6,
      "end": 108.6
    },
    {
      "text": "तै-र्लो॒कम॒भ्यारो॑हन्ति॒ यदि॒मं ॅलो॒कं न",
      "start": 108.6,
      "end": 108.6
    },
    {
