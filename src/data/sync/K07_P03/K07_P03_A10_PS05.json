  "phrases": [
    {
      "text": "स्युस्त ए॑कविꣳशति-रा॒त्रमा॑सीर॒न् द्वाद॑श॒ मासाः॒",
      "start": 158.24,
      "end": 167.48
    },
    {
      "text": "पञ्च॒र्तव॒स्त्रय॑ इ॒मे लो॒का अ॒सावा॑दि॒त्य",
      "start": 167.48,
      "end": 171.36
    },
    {
      "text": "ए॑कविꣳ॒॒श ए॒ताव॑न्तो॒ वै दे॑वलो॒कास्तेष्वे॒व",
      "start": 171.36,
      "end": 177.84
    },
    {
      "text": "य॑था पू॒र्वं प्रति॑ तिष्ठन्त्य॒सावा॑दि॒त्यो",
      "start": 177.84,
      "end": 182.28
    },
    {
      "text": "न व्य॑रोचत॒ स प्र॒जाप॑ति॒मुपा॑धाव॒त्",
      "start": 182.28,
      "end": 189.16
    },
    {
      "text": "तस्मा॑ ए॒तमे॑कविꣳशतिरा॒त्रं प्राय॑च्छ॒त् तमाऽह॑र॒त्",
      "start": 189.16,
      "end": 199.76
    },
    {
      "text": "तेना॑यजत॒ ततो॒ वै सो॑",
      "start": 199.76,
      "end": 201.8
    },
    {
      "text": "ऽरोचत॒ य ए॒वं वि॒द्वाꣳस॑",
      "start": 201.8,
      "end": 203.4
    },
    {
      "text": "एकविꣳशतिरा॒त्रमास॑ते॒ ( ) रोच॑न्त",
      "start": 203.4,
      "end": 203.4
    },
    {
      "text": "ए॒वैक॑विꣳशतिरा॒त्रो भ॑वति॒ रुग्वा ए॑कविꣳ॒॒शो",
      "start": 203.4,
      "end": 203.52
    },
    {
      "text": "रुच॑मे॒व ग॑च्छ॒न्त्यथो᳚ प्रति॒ष्ठामे॒व प्र॑ति॒ष्ठा",
      "start": 203.52,
      "end": 211.64
    },
    {
      "text": "ह्ये॑कविꣳ॒॒शो॑ ऽतिरा॒त्राव॒भितो॑ भवतो ब्रह्मवर्च॒सस्य॒",
      "start": 211.64,
      "end": 215.76
    },
    {
      "text": "परि॑गृहीत्यै",
      "start": 215.76,
      "end": 218.36
    }
  ],
