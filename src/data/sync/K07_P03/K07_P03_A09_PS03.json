  "phrases": [
    {
      "text": "ॅलो॒कम॒भ्यारो॑हन्ति॒ यद॒न्यतः॑ पृ॒ष्ठानि॒ स्युर्विवि॑वधꣳ",
      "start": 78.96,
      "end": 90.2
    },
    {
      "text": "स्या॒न्मद्ध्ये॑ पृ॒ष्ठानि॑ भवन्ति सविवध॒त्वायौजो॒",
      "start": 90.2,
      "end": 97.56
    },
    {
      "text": "वै वी॒र्यं॑ पृ॒ष्ठान्योज॑ ए॒व",
      "start": 97.56,
      "end": 98.6
    },
    {
      "text": "वी॒र्यं॑ मद्ध्य॒तो द॑धते बृहद्-रथन्त॒राभ्यां᳚",
      "start": 98.6,
      "end": 98.68
    },
    {
      "text": "ॅयन्ती॒यं ॅवाव र॑थन्त॒रम॒सौ बृ॒हदा॒भ्यामे॒व",
      "start": 98.68,
      "end": 106.92
    },
    {
      "text": "य॒न्त्यथो॑ अ॒नयो॑रे॒व प्रति॑ तिष्ठन्त्ये॒ते",
      "start": 106.92,
      "end": 106.92
    },
    {
      "text": "वै य॒ज्ञ्स्या᳚ञ्ज॒साय॑नी स्रु॒ती ताभ्या॑मे॒व",
      "start": 106.92,
      "end": 106.92
    },
    {
      "text": "सु॑व॒र्गं ॅलो॒कं ॅय॑न्ति॒ परा᳚ञ्चो॒",
      "start": 106.92,
      "end": 106.92
    },
    {
      "text": "वा ए॒ते सु॑व॒र्गं (",
      "start": 106.92,
      "end": 106.92
    },
    {
      "text": ") ॅलो॒कम॒भ्यारो॑हन्ति॒ ये प॑रा॒चीना॑नि",
      "start": 106.92,
      "end": 106.92
    },
    {
      "text": "पृ॒ष्ठान्यु॑प॒यन्ति॑ प्र॒त्यङ् त्र्य॒हो भ॑वति",
      "start": 106.92,
      "end": 106.92
    },
    {
      "text": "प्र॒त्यव॑रूढ्या॒ अथो॒ प्रति॑ष्ठित्या उ॒भयो᳚र्लो॒कयोर्॑.",
      "start": 106.92,
      "end": 116.04
    },
    {
      "text": "ऋ॒द्ध्वोत् ति॑ष्ठन्त्यतिरा॒त्राव॒भितो॑ भवतो ब्रह्मवर्च॒स-स्या॒न्नाद्य॑स्य॒",
      "start": 116.04,
      "end": 132.32
    },
    {
      "text": "परि॑गृहीत्यै",
      "start": 132.32,
      "end": 134.76
    }
  ],
  "total_phrases": 14
}