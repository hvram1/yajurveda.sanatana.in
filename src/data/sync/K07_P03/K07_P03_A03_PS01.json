    {
      "text": "ए॒ष वा आ॒प्तो द्वा॑दशा॒हो",
      "start": 0.0,
      "end": 0.76
    },
    {
      "text": "यत् त्र॑योदशरा॒त्रः स॑मा॒नꣳ ह्ये॑तदह॒र्यत्",
      "start": 0.76,
      "end": 6.88
    },
    {
      "text": "प्रा॑य॒णीय॑श्चोदय॒नीय॑श्च॒ त्र्य॑तिरात्रो भवति॒ त्रय॑",
      "start": 6.88,
      "end": 14.92
    },
    {
      "text": "इ॒मे लो॒का ए॒षां ॅलो॒काना॒माप्त्यै᳚",
      "start": 14.92,
      "end": 20.2
    },
    {
      "text": "प्रा॒णो वै प्र॑थ॒मो॑ऽतिरा॒त्रो व्या॒नो",
      "start": 20.2,
      "end": 23.96
    },
    {
      "text": "द्वि॒तीयो॑ ऽपा॒नस्तृ॒तीयः॑ प्राणापानो-दा॒नेष्वे॒वान्नाद्ये॒ प्रति॑",
      "start": 23.96,
      "end": 36.56
    },
    {
      "text": "तिष्ठन्ति॒ सर्व॒मायु॑र्यन्ति॒ य ए॒वं",
