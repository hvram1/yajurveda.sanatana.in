  "phrases": [
    {
      "text": "-जो॒ वै वी॒र्यं॑ पृ॒ष्ठान्योज॑",
      "start": 63.52,
      "end": 63.52
    },
    {
      "text": "ए॒व वी॒र्यं॑ मद्ध्य॒तो द॑धते",
      "start": 63.52,
      "end": 66.84
    },
    {
      "text": "बृहद्-रथन्त॒राभ्यां᳚ ॅयन्ती॒यं ॅवाव र॑थन्त॒रम॒सौ",
      "start": 66.84,
      "end": 70.6
    },
    {
      "text": "बृ॒हदा॒भ्यामे॒व य॒न्त्यथो॑ अ॒नयो॑रे॒व प्रति॑",
      "start": 70.6,
      "end": 80.44
    },
    {
      "text": "तिष्ठन्त्ये॒ते वै य॒ज्ञ्स्या᳚ञ्ज॒साय॑नी स्रु॒ती",
      "start": 80.44,
      "end": 91.36
    },
    {
      "text": "ताभ्या॑मे॒व सु॑व॒र्गं ॅलो॒कं ॅय॑न्ति॒",
      "start": 91.36,
      "end": 98.12
    },
    {
      "text": "परा᳚ञ्चो॒ वा ए॒ते सु॑व॒र्गं",
      "start": 98.12,
      "end": 102.36
    },
    {
      "text": "ॅलो॒कम॒भ्यारो॑हन्ति॒ ये प॑रा॒चीना॑नि पृ॒ष्ठान्यु॑प॒यन्ति॑",
      "start": 102.36,
      "end": 114.4
    },
    {
      "text": "प्र॒त्यङ् त्र्य॒हो भ॑वति प्र॒त्यव॑रूढ्या॒",
      "start": 114.4,
      "end": 114.56
    },
    {
      "text": "अथो॒ प्रति॑ष्ठित्या ( )",
      "start": 114.56,
      "end": 114.56
    },
    {
      "text": "उ॒भयो᳚र्लो॒कयोर्॑ ऋ॒द्ध्वोत् ति॑ष्ठन्ति॒ चतु॑र्दशै॒तास्तासां॒",
      "start": 114.56,
      "end": 114.56
    },
    {
      "text": "ॅया दश॒ दशा᳚क्षरा वि॒राडन्नं॑",
      "start": 114.56,
      "end": 114.56
    },
    {
      "text": "ॅवि॒राड् वि॒राजै॒वान्नाद्य॒मव॑ रुन्धते॒ याश्चत॑स्र॒श्चत॑स्रो॒",
      "start": 114.56,
      "end": 118.36
    },
    {
      "text": "दिशो॑ दि॒क्ष्वे॑व प्रति॑ तिष्ठन्त्यतिरा॒त्राव॒भितो॑",
      "start": 118.36,
      "end": 132.92
    },
    {
      "text": "भवतः॒ परि॑गृहीत्यै",
      "start": 132.92,
      "end": 135.36
    }
  ],
