    {
      "text": "अ॒सावा॑दि॒त्यो᳚ऽस्मिन् ॅलो॒क आ॑सी॒त् तं",
      "start": 0.0,
      "end": 5.44
    },
    {
      "text": "दे॒वाः पृ॒ष्ठैः प॑रि॒गृह्य॑ सुव॒र्गं",
      "start": 5.44,
      "end": 13.4
    },
    {
      "text": "ॅलो॒कम॑गमय॒न् परै॑र॒वस्ता॒त् पर्य॑गृह्णन् दिवाकी॒र्त्ये॑न",
      "start": 13.4,
      "end": 24.8
    },
    {
      "text": "सुव॒र्गे लो॒के प्रत्य॑स्थापय॒न् परैः᳚",
      "start": 24.8,
      "end": 24.8
    },
    {
      "text": "प॒रस्ता॒त् पर्य॑गृह्णन् पृ॒ष्ठैरु॒पावा॑रोह॒न्थ्स वा",
      "start": 24.8,
      "end": 24.88
    },
    {
      "text": "अ॒सावा॑दि॒त्यो॑ऽमुष्मि॑न् ॅलो॒के परै॑रुभ॒यतः॒ परि॑गृहीतो॒",
      "start": 24.88,
      "end": 36.48
    },
    {
      "text": "यत् पृ॒ष्ठानि॒ भव॑न्ति सुव॒र्गमे॒व",
      "start": 36.48,
      "end": 44.12
    },
    {
      "text": "तैर्लो॒कं ॅयज॑माना यन्ति॒ परै॑र॒वस्ता॒त्",
      "start": 44.12,
      "end": 51.04
    },
