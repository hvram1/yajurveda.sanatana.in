  "phrases": [
    {
      "text": "स्युस्ते वि ब्रू॑यु॒र्यदि॒ तत्र॒",
      "start": 51.0,
      "end": 56.96
    },
    {
      "text": "न वि॒न्देयु॑रन्तस्सद॒साद्-व्युच्यं॒ ॅयदि॒ तत्र॒",
      "start": 56.96,
      "end": 70.08
    },
    {
      "text": "न वि॒न्देयु॑र्गृ॒हप॑तिना॒ व्युच्यं॒ तद्व्युच्य॑मे॒वाथ॒",
      "start": 70.08,
      "end": 82.16
    },
    {
      "text": "वा ए॒तथ् स॑र्परा॒ज्ञिया॑ ऋ॒ग्भिः",
      "start": 82.16,
      "end": 87.52
    },
    {
      "text": "स्तु॑वन्त॒यं ॅवै सर्प॑तो॒ राज्ञी॒",
      "start": 87.52,
      "end": 94.08
    },
    {
      "text": "यद्वा अ॒स्यां किं चार्च॑न्ति॒",
      "start": 94.08,
      "end": 99.56
    },
    {
      "text": "यदा॑नृ॒चुस्तेने॒यꣳ स॑र्परा॒ज्ञी ते यदे॒व",
      "start": 99.56,
      "end": 108.76
    },
    {
      "text": "किं च॑ वा॒चा ऽऽनृ॒चुर्यद॒तोऽद्ध्य॑र्चि॒तार॒",
      "start": 108.76,
      "end": 113.8
