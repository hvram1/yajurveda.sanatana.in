    {
      "text": "ही॑यते॒ तस्मा᳚द्-दश॒मे ऽह॑न्नविवा॒क्य उप॑हताय॒",
      "start": 46.24,
      "end": 46.24
    },
    {
      "text": "न व्युच्य॒मथो॒ खल्वा॑हुर्य॒ज्ञ्स्य॒ वै",
      "start": 46.24,
      "end": 46.24
    },
    {
      "text": "समृ॑द्धेन दे॒वाः सु॑व॒र्गं ॅलो॒कमा॑यन्",
      "start": 46.24,
      "end": 46.24
    },
    {
      "text": "य॒ज्ञ्स्य॒ व्यृ॑द्धे॒नासु॑रा॒न् परा॑ऽभावय॒न्निति॒ यत्",
      "start": 46.24,
      "end": 46.24
    },
    {
      "text": "खलु॒ वै य॒ज्ञ्स्य॒ समृ॑द्धं॒",
      "start": 46.24,
      "end": 46.24
    },
    {
      "text": "तद्-यज॑मानस्य॒ यद्व्यृ॑द्धं॒ तद्भ्रातृ॑व्यस्य॒ स",
      "start": 46.24,
      "end": 46.24
    },
    {
      "text": "यो वै द॑श॒मेऽह॑न्नविवा॒क्य उ॑पह॒न्यते॒",
      "start": 46.24,
      "end": 46.24
