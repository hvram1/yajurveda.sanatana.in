  "phrases": [
    {
      "text": "दिश॑ ए॒वैतेन॒ प्र जा॑नाती॒मं",
      "start": 51.92,
      "end": 51.92
    },
    {
      "text": "नो॑ य॒ज्ञ्ं न॑यतु प्रजा॒नन्नित्या॑ह",
      "start": 51.92,
      "end": 58.52
    },
    {
      "text": "सुव॒र्गस्य॑ लो॒कस्या॒भिनी᳚त्यै॒ ब्रह्म॑ स॒मिद्-भ॑व॒त्याहु॑तीना॒-मित्या॑ह॒",
      "start": 58.52,
      "end": 71.24
    },
    {
      "text": "ब्रह्म॑णा॒ वै दे॒वाः सु॑व॒र्गं",
      "start": 71.24,
      "end": 77.76
    },
    {
      "text": "ॅलो॒कमा॑य॒न्॒ यद्-ब्रह्म॑ण्वत्योप॒दधा॑ति॒ ब्रह्म॑णै॒व तद्-यज॑मानः",
      "start": 77.76,
      "end": 86.52
    },
    {
      "text": "सुव॒र्गं ॅलो॒कमे॑ति प्र॒जाप॑ति॒र्वा ए॒ष",
      "start": 86.52,
      "end": 89.44
    },
    {
      "text": "यद॒ग्निस्तस्य॑ प्र॒जाः प॒शवः॒ छन्दाꣳ॑सि",
      "start": 89.44,
      "end": 95.72
    },
    {
      "text": "रू॒पꣳ सर्वा॒न्॒ वर्णा॒निष्ट॑कानां (",
      "start": 95.72,
      "end": 96.24
    },
    {
      "text": ") कुर्याद् रू॒पेणै॒व प्र॒जां",
      "start": 96.24,
      "end": 97.6
    },
    {
      "text": "प॒शून् छन्दाꣳ॒॒स्यव॑ रु॒न्धेऽथो᳚ प्र॒जाभ्य॑",
      "start": 97.6,
      "end": 102.4
    },
    {
      "text": "ए॒वैनं॑ प॒शुभ्यः॒ छन्दो᳚भ्यो ऽव॒रुद्ध्य॑",
      "start": 102.4,
      "end": 110.52
    },
    {
      "text": "चिनुते",
      "start": 110.52,
      "end": 111.16
    }
  ],
  "total_phrases": 12
}