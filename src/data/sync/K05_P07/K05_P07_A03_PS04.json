    {
      "text": "प्रति॒ष्ठां ॅवेद॒ प्रत्ये॒व ति॑ष्ठति॒",
      "start": 96.08,
      "end": 104.76
    },
    {
      "text": "यदाज्य॑मु॒च्छिष्ये॑त॒ तस्मि॑न् ब्रह्मौद॒नं प॑चे॒त्",
      "start": 104.76,
      "end": 114.04
    },
    {
      "text": "तं ब्रा᳚ह्म॒णाश्च॒त्वारः॒ प्राश्नी॑युरे॒ष वा",
      "start": 114.04,
      "end": 116.72
    },
    {
      "text": "अ॒ग्निर्वै᳚श्वान॒रो यद्ब्रा᳚ह्म॒ण ए॒षा खलु॒",
      "start": 116.72,
      "end": 124.0
    },
    {
      "text": "वा अ॒ग्नेः प्रि॒या त॒नूर्यद्-वै᳚श्वान॒रः",
      "start": 124.0,
      "end": 129.72
    },
    {
      "text": "प्रि॒याया॑मे॒वैनां᳚ त॒नुवां॒ प्रति॑ ष्ठापयति॒",
      "start": 129.72,
      "end": 133.76
    },
    {
      "text": "चत॑स्रो धे॒नूर्द॑द्या॒त् ताभि॑रे॒व यज॑मानो॒ऽमुष्मि॑न्",
      "start": 133.76,
      "end": 140.48
    },
    {
      "text": "ॅलो॒के᳚ऽग्निं दु॑हे",
      "start": 140.48,
      "end": 141.72
    }
  ],
