    {
      "text": "यथा॒ वै पु॒त्रो जा॒तो",
      "start": 0.0,
      "end": 3.04
    },
    {
      "text": "म्रि॒यत॑ ए॒वं ॅवा ए॒ष",
      "start": 3.04,
      "end": 7.56
    },
    {
      "text": "म्रि॑यते॒ यस्या॒ग्निरुख्य॑ उ॒द्वाय॑ति॒ यन्नि॑र्म॒न्थ्यं॑",
      "start": 7.56,
      "end": 11.64
    },
    {
      "text": "कु॒र्याद्-विच्छि॑न्द्या॒द्-भ्रातृ॑व्यमस्मै जनये॒थ् स ए॒व",
      "start": 11.64,
      "end": 11.64
    },
    {
      "text": "पुनः॑ प॒रीद्ध्यः॒ स्वादे॒वैनं॒ ॅयोने᳚र्जनयति॒",
      "start": 11.64,
      "end": 11.64
    },
    {
      "text": "नास्मै॒ भ्रातृ॑व्यं जनयति॒ तमो॒",
      "start": 11.64,
      "end": 11.64
    },
    {
      "text": "वा ए॒तं गृ॑ह्णाति॒ यस्या॒ग्निरुख्य॑",
      "start": 11.64,
      "end": 11.64
    },
    {
      "text": "उ॒द्वाय॑ति मृ॒त्युस्तमः॑ कृ॒ष्णं ॅवासः॑",
      "start": 11.64,
      "end": 12.8
