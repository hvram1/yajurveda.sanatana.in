    {
      "text": "-मे॒तामुप॑ दधाती॒यं ॅवा वैषैका᳚ष्ट॒का",
      "start": 58.96,
      "end": 58.96
    },
    {
      "text": "यदे॒वैका᳚ष्ट॒काया॒मन्नं॑ क्रि॒यते॒ तदे॒वैतयाव॑ रुन्ध",
      "start": 58.96,
      "end": 58.96
    },
    {
      "text": "ए॒षा वै प्र॒जाप॑तेः काम॒दुघा॒",
      "start": 58.96,
      "end": 58.96
    },
    {
      "text": "तयै॒व यज॑मानो॒ऽमुष्मि॑न् ॅलो॒के᳚ऽग्निं दु॑हे॒",
      "start": 58.96,
      "end": 58.96
    },
    {
      "text": "येन॑ दे॒वा ज्योति॑षो॒र्द्ध्वा उ॒दाय॒न्॒",
      "start": 58.96,
      "end": 58.96
    },
    {
      "text": "येना॑ऽऽदि॒त्या वस॑वो॒ येन॑ रु॒द्राः",
      "start": 58.96,
      "end": 59.92
    },
    {
      "text": "येनाङ्गि॑रसो महि॒मान॑-मान॒शुस्तेनै॑तु॒ यज॑मानः स्व॒स्ति",
      "start": 59.92,
