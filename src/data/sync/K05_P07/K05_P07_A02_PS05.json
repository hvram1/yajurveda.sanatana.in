  "phrases": [
    {
      "text": "आ वि॑शस्व॒ शं तो॒काय॑",
      "start": 176.52,
      "end": 182.08
    },
    {
      "text": "त॒नुवे᳚ स्यो॒नः",
      "start": 182.08,
      "end": 184.64
    },
    {
      "text": "अज्या॑नीरे॒ता उप॑ दधात्ये॒ता वै",
      "start": 184.64,
      "end": 191.04
    },
    {
      "text": "दे॒वता॒ अप॑राजिता॒स्ता ए॒व प्र",
      "start": 191.04,
      "end": 195.8
    },
    {
      "text": "वि॑शति॒ नैव जी॑यते ब्रह्मवा॒दिनो॑",
      "start": 195.8,
      "end": 199.72
    },
    {
      "text": "वदन्ति॒ यद॑र्द्धमा॒सा मासा॑ ऋ॒तवः॑",
      "start": 199.72,
      "end": 204.36
    },
    {
      "text": "संॅवथ्स॒र ओष॑धीः॒ पच॒न्त्यथ॒ कस्मा॑द॒न्याभ्यो॑",
      "start": 204.36,
      "end": 215.12
    },
    {
      "text": "दे॒वता᳚भ्य आग्रय॒णं निरु॑प्यत॒ इत्ये॒ता",
      "start": 215.12,
      "end": 216.2
    },
    {
      "text": "हि तद्-दे॒वता॑ उ॒दज॑य॒न्॒ यदृ॒तुभ्यो॑",
      "start": 216.2,
      "end": 216.2
    },
    {
      "text": "नि॒र्वपे᳚द् दे॒वता᳚भ्यः स॒मदं॑ दद्ध्यादाग्रय॒णं",
      "start": 216.2,
      "end": 216.2
    },
    {
      "text": "( ) नि॒रुप्यै॒ता आहु॑ती",
      "start": 216.2,
      "end": 216.2
    },
    {
      "text": "र्जुहोत्यर्द्धमा॒साने॒व मासा॑नृ॒तून्थ् सं॑ॅवथ्स॒रं प्री॑णाति॒",
      "start": 216.2,
      "end": 216.2
    },
    {
      "text": "न दे॒वता᳚भ्यः स॒मदं॑ दधाति",
      "start": 216.2,
      "end": 216.2
    },
    {
      "text": "भ॒द्रान्नः॒ श्रेयः॒ सम॑नैष्ट देवा॒",
      "start": 216.2,
      "end": 221.48
    },
    {
      "text": "इत्या॑ह हु॒ताद्या॑य॒ यज॑मान॒स्याऽ*प॑राभावाय",
      "start": 221.48,
      "end": 229.56
    }
  ],
  "total_phrases": 15
}