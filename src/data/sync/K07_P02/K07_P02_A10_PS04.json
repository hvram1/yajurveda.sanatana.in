  "phrases": [
    {
      "text": "यास्तृ॒तीयाः॒ पात्रा॑णि॒ ताभि॒र्निर्णे॑निक्ते॒ याश्च॑तु॒र्थीरपि॒",
      "start": 95.76,
      "end": 100.56
    },
    {
      "text": "ताभि॑रा॒त्मान॑मन्तर॒तः शु॑न्धते॒ यो वा",
      "start": 100.56,
      "end": 108.68
    },
    {
      "text": "अ॑स्य प॒शुमत्ति॑ माꣳ॒॒सꣳ सो᳚ऽत्ति॒",
      "start": 108.68,
      "end": 116.68
    },
    {
      "text": "यः पु॑रो॒डाशं॑ म॒स्तिष्कꣳ॒॒ स",
      "start": 116.68,
      "end": 119.04
    },
    {
      "text": "यः प॑रिवा॒पं पुरी॑षꣳ॒॒ स",
      "start": 119.04,
      "end": 122.36
    },
    {
      "text": "य आज्यं॑ म॒ज्जानꣳ॒॒ स",
      "start": 122.36,
      "end": 124.4
    },
    {
      "text": "यः सोमꣳ॒॒ स्वेदꣳ॒॒ सोऽपि॑",
      "start": 124.4,
      "end": 128.44
    },
    {
      "text": "ह॒ वा अ॑स्य शीर्.ष॒ण्या॑",
      "start": 128.44,
      "end": 131.36
    },
    {
      "text": "नि॒ष्पदः॒ प्रति॑ गृह्णाति॒ यो",
      "start": 131.36,
      "end": 134.56
    },
    {
      "text": "द्वा॑दशा॒हे प्र॑तिगृ॒ह्णाति॒ तस्मा᳚द् द्वादशा॒हेन॒",
      "start": 134.56,
      "end": 144.16
    },
    {
      "text": "( ) न याज्यं॑",
      "start": 144.16,
      "end": 146.4
    },
    {
      "text": "पा॒प्मनो॒ व्यावृ॑त्त्यै",
      "start": 146.4,
      "end": 149.4
    }
