  "phrases": [
    {
      "text": "सा॒द्ध्या वै दे॒वाः सु॑व॒र्गका॑मा",
      "start": 0.0,
      "end": 6.56
    },
    {
      "text": "ए॒तꣳ ष॑ड्-रा॒त्रम॑पश्य॒न् तमाऽह॑र॒न् तेना॑यजन्त॒",
      "start": 6.56,
      "end": 12.4
    },
    {
      "text": "ततो॒ वै ते सु॑व॒र्गं",
      "start": 12.4,
      "end": 13.44
    },
    {
      "text": "ॅलो॒कमा॑य॒न॒. य ए॒वं ॅवि॒द्वाꣳसः॑",
      "start": 13.44,
      "end": 18.4
    },
    {
      "text": "षड्-रा॒त्रमास॑ते सुव॒र्गमे॒व लो॒कं ॅय॑न्ति",
      "start": 18.4,
      "end": 22.24
    },
    {
      "text": "देवस॒त्रं ॅवै ष॑ड्-रा॒त्रः प्र॒त्यक्षꣳ॒॒",
      "start": 22.24,
      "end": 33.2
    },
    {
      "text": "ह्ये॑तानि॑ पृ॒ष्ठानि॒ य ए॒वं",
      "start": 33.2,
      "end": 38.8
    },
    {
      "text": "ॅवि॒द्वाꣳसः॑ षड्-रा॒त्रमास॑ते सा॒क्षादे॒व दे॒वता॑",
      "start": 38.8,
      "end": 46.88
    },
    {
      "text": "अ॒भ्यारो॑हन्ति॒ षड्-रा॒त्रो भ॑वति॒ षड्",
      "start": 46.88,
      "end": 48.08
    },
    {
      "text": "वा ऋ॒तवः॒ षट् पृ॒ष्ठानि॑",
