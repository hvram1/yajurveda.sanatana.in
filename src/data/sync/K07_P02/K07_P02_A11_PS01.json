    {
      "text": "एक॑स्मै॒ स्वाहा॒ द्वाभ्याꣳ॒॒ स्वाहा᳚",
      "start": 0.0,
      "end": 7.12
    },
    {
      "text": "त्रि॒भ्यः स्वाहा॑ च॒तुर्भ्यः॒ स्वाहा॑",
      "start": 7.12,
      "end": 9.2
    },
    {
      "text": "प॒ञ्चभ्यः॒ स्वाहा॑ ष॒ड्भ्यः स्वाहा॑",
      "start": 9.2,
      "end": 9.2
    },
    {
      "text": "स॒प्तभ्यः॒ स्वाहा᳚ ऽष्टा॒भ्यः स्वाहा॑",
      "start": 9.2,
      "end": 9.2
    },
    {
      "text": "न॒वभ्यः॒ स्वाहा॑ द॒शभ्यः॒ स्वाहै॑",
      "start": 9.2,
      "end": 9.2
    },
    {
      "text": "-काद॒शभ्यः॒ स्वाहा᳚ द्वाद॒शभ्यः॒ स्वाहा᳚",
      "start": 9.2,
      "end": 9.2
    },
    {
      "text": "त्रयोद॒शभ्यः॒ स्वाहा॑ चतुर्द॒शभ्यः॒ स्वाहा॑",
      "start": 9.2,
      "end": 9.56
    },
    {
      "text": "पञ्चद॒शभ्यः॒ स्वाहा॑ षोड॒शभ्यः॒ स्वाहा॑",
      "start": 9.56,
      "end": 20.2
    },
    {
      "text": "सप्तद॒शभ्यः॒ स्वाहा᳚ ऽष्टाद॒शभ्यः॒ स्वाहै-का॒न्न",
      "start": 20.2,
      "end": 29.16
    },
    {
      "text": "विꣳ॑श॒त्यै स्वाहा॒ नव॑विꣳशत्यै॒ स्वाहै-का॒न्न",
      "start": 29.16,
      "end": 36.6
    },
    {
      "text": "च॑त्वारिꣳ॒॒शते॒ स्वाहा॒ नव॑चत्वारिꣳशते॒ स्वाहै-का॒न्न",
      "start": 36.6,
      "end": 44.84
    },
    {
      "text": "( ) ष॒ष्ट्यै स्वाहा॒",
      "start": 44.84,
      "end": 47.28
    },
    {
      "text": "नव॑षष्ट्यै॒ स्वाहै -का॒न्नाशी॒त्यै स्वाहा॒",
      "start": 47.28,
      "end": 56.36
    },
    {
      "text": "नवा॑शीत्यै॒ स्वाहैका॒न्न श॒ताय॒ स्वाहा॑",
      "start": 56.36,
      "end": 63.32
    },
    {
      "text": "श॒ताय॒ स्वाहा॒ द्वाभ्याꣳ॑ श॒ताभ्याꣳ॒॒",
      "start": 63.32,
      "end": 64.88
    },
    {
      "text": "स्वाहा॒ सर्व॑स्मै॒ स्वाहा᳚",
      "start": 64.88,
