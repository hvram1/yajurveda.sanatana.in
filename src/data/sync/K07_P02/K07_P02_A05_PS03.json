  "phrases": [
    {
      "text": "ए॒ष य॒ज्ञो यद्-द॑शरा॒त्रः क॒कुत्",
      "start": 54.28,
      "end": 61.44
    },
    {
      "text": "प॑ञ्चद॒शः क॒कुदे॑कविꣳ॒॒शः क॒कुत् त्र॑यस्त्रिꣳ॒॒शो",
      "start": 61.44,
      "end": 75.28
    },
    {
      "text": "य ए॒वं ॅवि॒द्वान् द॑शरा॒त्रेण॒",
      "start": 75.28,
      "end": 81.52
    },
    {
      "text": "यज॑ते त्रिक॒कुदे॒व स॑मा॒नानां᳚ भवति॒",
      "start": 81.52,
      "end": 81.52
    },
    {
      "text": "यज॑मानः पञ्चद॒शो यज॑मान एकविꣳ॒॒शो",
      "start": 81.52,
      "end": 88.44
    },
    {
      "text": "यज॑मानस्त्रयस्त्रिꣳ॒॒शः पुर॒ इत॑रा अभिच॒र्यमा॑णो",
      "start": 88.44,
      "end": 98.8
    },
    {
      "text": "दशरा॒त्रेण॑ यजेत देवपु॒रा ए॒व",
      "start": 98.8,
      "end": 103.28
    },
    {
      "text": "पर्यू॑हते॒ तस्य॒ न कुत॑श्च॒नोपा᳚व्या॒धो",
      "start": 103.28,
      "end": 110.6
    },
    {
      "text": "भ॑वति॒ नैन॑मभि॒चरन्᳚थ् स्तृणुते देवासु॒राः",
      "start": 110.6,
      "end": 114.92
    },
    {
      "text": "संॅय॑त्ता आस॒न् ते दे॒वा",
      "start": 114.92,
      "end": 118.36
    },
    {
      "text": "ए॒ता - [ ]",
