    {
      "text": "मलं॑ जायत॒ एक॑ ए॒व",
      "start": 78.0,
      "end": 82.04
    },
    {
      "text": "य॑जे॒तैको॒ हि प्र॒जाप॑ति॒रार्द्ध्नो॒द् द्वाद॑श॒",
      "start": 82.04,
      "end": 95.76
    },
    {
      "text": "रात्री᳚र्दीक्षि॒तः स्या॒द् द्वाद॑श॒ मासाः᳚",
      "start": 95.76,
      "end": 95.76
    },
    {
      "text": "संॅवथ्स॒रः सं॑ॅवथ्स॒रः प्र॒जाप॑तिः प्र॒जाप॑ति॒र्वावैष",
      "start": 95.76,
      "end": 95.76
    },
    {
      "text": "ए॒ष ह॒ त्वै जा॑यते॒",
      "start": 95.76,
      "end": 95.76
    },
    {
      "text": "यस्तप॒सोऽधि॒ जाय॑ते चतु॒र्द्धा वा",
      "start": 95.76,
      "end": 95.76
    },
    {
      "text": "ए॒तास्ति॒स्रस्ति॑स्रो॒ रात्र॑यो॒ यद् द्वाद॑शोप॒सदो॒",
      "start": 95.76,
      "end": 95.76
    },
    {
      "text": "याः प्र॑थ॒मा य॒ज्ञ्ं ताभिः॒",
      "start": 95.76,
      "end": 95.76
    },
    {
      "text": "सं भ॑रति॒ या द्वि॒तीया॑",
      "start": 95.76,
      "end": 95.76
    },
    {
      "text": "य॒ज्ञ्ं ताभि॒रा र॑भते॒ -",
