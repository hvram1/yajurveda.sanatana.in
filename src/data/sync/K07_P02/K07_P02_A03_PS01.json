  "phrases": [
    {
      "text": "बृह॒स्पति॑रकामयत ब्रह्मवर्च॒सी स्या॒मिति॒ स",
      "start": 0.0,
      "end": 7.08
    },
    {
      "text": "ए॒त-म॑ष्टरा॒त्र-म॑पश्य॒त् तमाऽह॑र॒त् तेना॑यजत॒ ततो॒",
      "start": 7.08,
      "end": 16.52
    },
    {
      "text": "वै स ब्र॑ह्मवर्च॒स्य॑भव॒द्य ए॒वं",
      "start": 16.52,
      "end": 23.76
    },
    {
      "text": "ॅवि॒द्वान॑ष्टरा॒त्रेण॒ यज॑ते ब्रह्मवर्च॒स्ये॑व भ॑वत्यष्टरा॒त्रो",
      "start": 23.76,
      "end": 32.84
    },
    {
      "text": "भ॑वत्य॒ष्टाक्ष॑रा गाय॒त्री गा॑य॒त्री ब्र॑ह्मवर्च॒सं",
      "start": 32.84,
      "end": 40.32
    },
    {
      "text": "गा॑यत्रि॒यैव ब्र॑ह्मवर्च॒समव॑ रुन्धेऽष्टरा॒त्रो भ॑वति॒",
      "start": 40.32,
      "end": 41.44
    },
    {
      "text": "चत॑स्रो॒ वै दिश॒श्चत॑स्रो ऽवान्तरदि॒शा",
      "start": 41.44,
      "end": 41.44
    },
    {
      "text": "दि॒ग्भ्य ए॒व ब्र॑ह्मवर्च॒समव॑ रुन्धे-",
      "start": 41.44,
      "end": 41.44
    },
    {
