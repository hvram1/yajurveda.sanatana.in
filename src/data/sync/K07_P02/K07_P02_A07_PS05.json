  "phrases": [
    {
      "text": "सर॑स्वती वा॒चैवैन॒मति॒ प्रयु॑ङ्क्ते॒ मा",
      "start": 150.52,
      "end": 150.52
    },
    {
      "text": "त्वत् क्षेत्रा॒ण्यर॑णानि ग॒न्मेत्या॑ह मृ॒त्योर्वै",
      "start": 150.52,
      "end": 150.52
    },
    {
      "text": "क्षेत्रा॒ण्यर॑णानि॒ तेनै॒व मृ॒त्योः क्षेत्रा॑णि॒",
      "start": 150.52,
      "end": 157.04
    },
    {
      "text": "न ग॑च्छति पू॒र्णान् ग्रहा᳚न्",
      "start": 157.04,
      "end": 159.72
    },
    {
      "text": "गृह्णीयादामया॒विनः॑ प्रा॒णान् वा ए॒तस्य॒",
      "start": 159.72,
      "end": 165.24
    },
    {
      "text": "शुगृ॑च्छति॒ यस्या॒ ऽऽ*मय॑ति प्रा॒णा",
      "start": 165.24,
      "end": 174.16
    },
    {
      "text": "ग्रहाः᳚ प्रा॒णाने॒वास्य॑ शु॒चो मु॑ञ्चत्यु॒त",
      "start": 174.16,
      "end": 182.08
    },
    {
      "text": "यदी॒तासु॒र्भव॑ति॒ जीव॑त्ये॒व पू॒र्णान् ग्रहा᳚न्",
      "start": 182.08,
      "end": 182.08
    },
    {
      "text": "( ) गृह्णीया॒द्-यर्.हि॑ प॒र्जन्यो॒",
      "start": 182.08,
      "end": 187.68
    },
    {
      "text": "न वर्.षे᳚त् प्रा॒णान् वा",
