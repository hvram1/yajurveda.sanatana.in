  "phrases": [
    {
      "text": "न रथा॑यै॒तद्वा आ॒प्तं दे॑व॒यज॑नमा॒प्नोत्ये॒व",
      "start": 42.8,
      "end": 42.8
    },
    {
      "text": "भ्रातृ॑व्यं॒ नैनं॒ भ्रातृ॑व्य आप्नो॒त्येको᳚न्नते",
      "start": 42.8,
      "end": 42.8
    },
    {
      "text": "देव॒य॑जने याजयेत् प॒शुका॑म॒-मेको᳚न्नता॒द्वै दे॑व॒यज॑ना॒दङ्गि॑रसः",
      "start": 42.8,
      "end": 42.8
