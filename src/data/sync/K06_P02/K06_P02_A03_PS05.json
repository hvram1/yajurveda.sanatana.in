  "phrases": [
    {
      "text": "प॑द्यन्ते॒ चतु॑र्विꣳशति-रर्द्धमा॒सा अ॑र्द्धमा॒साने॒व प्री॑णा॒त्यारा᳚ग्रा-मवान्तरदी॒क्षा-मुपे॑या॒द्यः",
      "start": 153.28,
      "end": 153.28
    },
    {
      "text": "का॒मये॑ता॒ऽस्मिन् मे॑ लो॒केऽर्द्धु॑कꣳ स्या॒दित्येक॒मग्रेऽथ॒",
      "start": 153.28,
      "end": 158.16
    },
    {
      "text": "द्वावथ॒ त्रीनथ॑ च॒तुर॑ ए॒षा",
      "start": 158.16,
      "end": 160.96
    },
    {
      "text": "वा आरा᳚ग्रा ऽवान्तरदी॒क्षा ऽस्मिन्ने॒वास्मै॑",
      "start": 160.96,
      "end": 166.6
    },
    {
      "text": "लो॒केऽर्द्धु॑कं भवति प॒रोव॑रीयसी-मवान्तरदी॒क्षा-मुपे॑या॒द्यः का॒मये॑ता॒मुष्मि॑न्",
      "start": 166.6,
      "end": 178.64
    },
    {
      "text": "मे लो॒केऽर्द्धु॑कꣳ स्या॒दिति॑ च॒तुरोऽग्रे",
      "start": 178.64,
      "end": 182.68
    },
    {
      "text": "( ) ऽथ॒ त्रीनथ॒",
      "start": 182.68,
      "end": 184.24
    },
    {
      "text": "द्वावथैक॑मे॒षा वै प॒रोव॑रीयस्य-वान्तरदी॒क्षा ऽमुष्मि॑न्ने॒वास्मै॑",
      "start": 184.24,
      "end": 192.44
    },
    {
      "text": "लो॒केऽर्द्धु॑कं भवति",
      "start": 192.44,
      "end": 193.76
    }
