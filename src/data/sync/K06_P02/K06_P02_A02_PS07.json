  "phrases": [
    {
      "text": "ऽग्निमे॒व वरू॑थं कृ॒त्वा ऽसु॑रान॒भ्य॑भव-न्न॒ग्निमि॑व॒",
      "start": 202.2,
      "end": 202.2
    },
    {
      "text": "खलु॒ वा ए॒ष प्रवि॑शति॒",
      "start": 202.2,
      "end": 202.2
    },
    {
      "text": "यो॑ऽवान्तरदी॒क्षामु॒पैति॒ भ्रातृ॑व्याभिभूत्यै॒ भव॑त्या॒त्मना॒ परा᳚ऽस्य॒",
      "start": 202.2,
      "end": 209.68
    },
    {
      "text": "भ्रातृ॑व्यो भवत्या॒त्मान॑मे॒व दी॒क्षया॑ पाति",
      "start": 209.68,
      "end": 220.12
    },
    {
      "text": "प्र॒जाम॑वान्तरदी॒क्षया॑ सन्त॒रां मेख॑लाꣳ स॒माय॑च्छते",
      "start": 220.12,
      "end": 233.84
    },
    {
      "text": "प्र॒जा ह्या᳚त्मनोऽन्त॑रतरा त॒प्तव्र॑तो भवति॒",
      "start": 233.84,
      "end": 235.28
    },
    {
      "text": "मद॑न्तीभिर्मार्जयते॒ निर्ह्य॑ग्निः शी॒तेन॒ वाय॑ति॒",
      "start": 235.28,
      "end": 243.08
    },
    {
      "text": "समि॑द्ध्यै॒ या ते॑ अग्ने॒",
      "start": 243.08,
      "end": 246.88
    },
    {
      "text": "( ) रुद्रि॑या त॒नूरित्या॑ह॒",
      "start": 246.88,
      "end": 246.88
    },
    {
      "text": "स्वयै॒वैन॑द् दे॒वत॑या व्रतयति सयोनि॒त्वाय॒",
      "start": 246.88,
      "end": 250.64
    },
    {
      "text": "शान्त्यै᳚",
      "start": 250.64,
      "end": 251.84
    }
  ],
  "total_phrases": 11
