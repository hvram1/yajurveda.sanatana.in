  "phrases": [
    {
      "text": "नव॑ रुन्धे पशु॒माने॒व भ॑वति॒",
      "start": 119.96,
      "end": 119.96
    },
    {
      "text": "निर्.ऋ॑तिगृहीते देव॒यज॑ने याजये॒द्यं का॒मये॑त॒",
      "start": 119.96,
      "end": 119.96
    },
    {
      "text": "निर्.ऋ॑त्यास्य य॒ज्ञ्ं ग्रा॑हयेय॒मित्ये॒तद्वै निर्.ऋ॑तिगृहीतं",
      "start": 119.96,
      "end": 119.96
    },
    {
      "text": "देव॒यज॑नं॒ ॅयथ् स॒दृश्यै॑ स॒त्या॑",
      "start": 119.96,
      "end": 124.92
    },
    {
      "text": "ऋ॒क्षं निर्.ऋ॑त्यै॒वास्य॑ य॒ज्ञ्ं ग्रा॑हयति॒",
      "start": 124.92,
      "end": 130.8
    },
    {
      "text": "व्यावृ॑त्ते देव॒यज॑ने याजयेद् व्या॒वृत्का॑मं॒",
      "start": 130.8,
      "end": 135.36
    },
    {
      "text": "ॅयं पात्रे॑ वा॒ तल्पे॑",
      "start": 135.36,
      "end": 139.52
    },
    {
      "text": "वा॒ मीमाꣳ॑सेरन् प्रा॒चीन॑माहव॒नीया᳚त् प्रव॒णꣳ",
      "start": 139.52,
      "end": 145.24
    },
    {
      "text": "स्या᳚त् प्रती॒चीनं॒ गार्.ह॑पत्यादे॒तद्वै व्यावृ॑त्तं",
      "start": 145.24,
      "end": 151.04
    },
    {
      "text": "देव॒यज॑नं॒ ॅवि पा॒प्मना॒ (",
      "start": 151.04,
      "end": 155.56
    },
    {
      "text": ") भ्रातृ॑व्ये॒णा- ऽऽ*व॑र्तते॒ नैनं॒",
      "start": 155.56,
      "end": 159.12
    },
    {
      "text": "पात्रे॒ न तल्पे॑ मीमाꣳ",
      "start": 159.12,
      "end": 162.4
    },
    {
      "text": "सन्ते का॒र्ये॑ देव॒यज॑ने याजये॒द्-भूति॑कामं",
      "start": 162.4,
      "end": 163.52
    },
    {
      "text": "का॒या॑ वै पुरु॑षो॒ भव॑त्ये॒व",
      "start": 163.52,
      "end": 166.76
    }
