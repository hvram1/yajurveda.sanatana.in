  "phrases": [
    {
      "text": "-कुर्वत॒ तैर्वै ते रक्षाꣳ॒॒स्यपा᳚घ्नत॒",
      "start": 190.76,
      "end": 196.84
    },
    {
      "text": "यत् का᳚र्ष्मर्य॒मयाः᳚ परि॒धयो॒ भव॑न्ति॒",
      "start": 196.84,
      "end": 203.52
    },
    {
      "text": "रक्ष॑सा॒मप॑हत्यै॒ सꣳ स्प॑र्.शयति॒ रक्ष॑सा॒मन॑न्व-वचाराय॒",
      "start": 203.52,
      "end": 214.56
    },
    {
      "text": "न पु॒रस्ता॒त् परि॑ दधात्यादि॒त्यो",
      "start": 214.56,
      "end": 221.16
    },
    {
      "text": "ह्ये॑वोद्यन् पु॒रस्ता॒द्-रक्षाꣳ॑स्यप॒हन्त्यू॒र्द्ध्वे स॒मिधा॒वा द॑धात्यु॒परि॑ष्टादे॒व",
      "start": 221.16,
      "end": 222.76
    },
    {
      "text": "रक्षाꣳ॒॒स्यप॑ हन्ति॒ यजु॑षा॒ऽन्यां तू॒ष्णीम॒न्यां",
      "start": 222.76,
      "end": 222.76
    },
    {
      "text": "मि॑थुन॒त्वाय॒ द्वे आ द॑धाति",
      "start": 222.76,
      "end": 222.76
    },
    {
      "text": "द्वि॒पाद्-यज॑मानः॒ प्रति॑ष्ठित्यै ब्रह्मवा॒दिनो॑ वदन्त्य॒-",
      "start": 222.76,
      "end": 222.76
    },
    {
      "text": "[ ]",
      "start": 222.76,
      "end": 222.76
    }
  ],
