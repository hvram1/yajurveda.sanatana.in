  "phrases": [
    {
      "text": "शिरो॒ वा ए॒तद्-य॒ज्ञ्स्य॒ यद्ध॑वि॒र्द्धानं॑",
      "start": 0.0,
      "end": 6.6
    },
    {
      "text": "प्रा॒णा उ॑पर॒वा ह॑वि॒र्द्धाने॑ खायन्ते॒",
      "start": 6.6,
      "end": 13.56
    },
    {
      "text": "तस्मा᳚च्छी॒र्॒.षन् प्रा॒णा अ॒धस्ता᳚त् खायन्ते॒",
      "start": 13.56,
      "end": 21.52
    },
    {
      "text": "तस्मा॑द॒धस्ता᳚च्छीर्ष्णः प्रा॒णा र॑क्षो॒हणो॑ वलग॒हनो॑",
      "start": 21.52,
      "end": 26.8
    },
    {
      "text": "वैष्ण॒वान् ख॑ना॒मीत्या॑ह वैष्ण॒वा हि",
      "start": 26.8,
      "end": 34.12
    },
    {
      "text": "दे॒वत॑योपर॒वा असु॑रा॒ वै नि॒र्यन्तो॑",
      "start": 34.12,
      "end": 38.24
    },
    {
      "text": "दे॒वानां᳚ प्रा॒णेषु॑ वल॒गान् न्य॑खन॒न्",
      "start": 38.24,
      "end": 40.32
    },
    {
      "text": "तान् बा॑हुमा॒त्रेऽन्व॑विन्द॒न् तस्मा᳚द् बाहुमा॒त्राः",
      "start": 40.32,
      "end": 47.96
    },
    {
      "text": "खा॑यन्त इ॒दम॒हं तं ॅव॑ल॒गमुद्व॑पामि॒-",
      "start": 47.96,
      "end": 55.48
    },
    {
