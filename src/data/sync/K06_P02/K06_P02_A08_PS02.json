  "phrases": [
    {
      "text": "ऽका॑मयन्त प॒शून्. वि॑न्देम॒हीति॒ ते॑ऽजुहवुः",
      "start": 25.72,
      "end": 32.48
    },
    {
      "text": "सिꣳ॒॒हीर॑सि रायस्पोष॒वनिः॒ स्वाहेति॒ ते",
      "start": 32.48,
      "end": 40.48
    },
    {
      "text": "प॒शून॑विन्दन्त॒ ते प॒शून्. वि॒त्त्वाऽका॑मयन्त",
      "start": 40.48,
      "end": 49.56
    },
    {
      "text": "प्रति॒ष्ठां ॅवि॑न्देम॒हीति॒ ते॑ऽजुहवुः सिꣳ॒॒ही-र॑स्यादित्य॒वनिः॒",
      "start": 49.56,
      "end": 61.52
    },
    {
      "text": "स्वाहेति॒ त इ॒मां प्र॑ति॒ष्ठाम॑विन्दन्त॒",
      "start": 61.52,
      "end": 69.56
    },
    {
      "text": "त इ॒मां प्र॑ति॒ष्ठां ॅवि॒त्त्वाऽका॑मयन्त",
      "start": 69.56,
      "end": 74.56
    },
    {
      "text": "दे॒वता॑ आ॒शिष॒ उपे॑या॒मेति॒ ते॑ऽजुहवुः",
      "start": 74.56,
      "end": 74.56
    },
    {
      "text": "सिꣳ॒॒हीर॒स्या व॑ह दे॒वान् दे॑वय॒ते-",
      "start": 74.56,
      "end": 74.56
    },
    {
      "text": "[ ]",
      "start": 74.56,
