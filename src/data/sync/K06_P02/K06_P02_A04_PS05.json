    {
      "text": "सा वा इ॒यꣳ सर्वै॒व",
      "start": 115.44,
      "end": 117.96
    },
    {
      "text": "वेदि॒रिय॑ति शक्ष्या॒मीति॒ त्वा अ॑व॒माय॑",
      "start": 117.96,
      "end": 124.04
    },
    {
      "text": "यजन्ते त्रिꣳ॒॒शत् प॒दानि॑ प॒श्चात्",
      "start": 124.04,
      "end": 128.08
    },
    {
      "text": "ति॒रश्ची॑ भवति॒ षट्त्रिꣳ॑श॒त् प्राची॒",
      "start": 128.08,
      "end": 136.16
    },
    {
      "text": "चतु॑र्विꣳशतिः पु॒रस्ता᳚त् ति॒रश्ची॒ दश॑दश॒",
      "start": 136.16,
      "end": 140.32
    },
    {
      "text": "संप॑द्यन्ते॒ दशा᳚क्षरा वि॒राडन्नं॑ ॅवि॒राड्",
      "start": 140.32,
      "end": 146.48
    },
    {
      "text": "वि॒राजै॒वान्नाद्य॒मव॑ रुन्ध॒ उद्ध॑न्ति॒ यदे॒वास्या॑",
      "start": 146.48,
      "end": 157.4
    },
    {
      "text": "अमे॒द्ध्यं तदप॑ ह॒न्त्युद्ध॑न्ति॒ तस्मा॒दोष॑धयः॒",
      "start": 157.4,
      "end": 157.96
    },
    {
      "text": "परा॑ भवन्ति ( )",
      "start": 157.96,
      "end": 157.96
    },
    {
      "text": "ब॒र्॒.हिः स्तृ॑णाति॒ तस्मा॒दोष॑धयः॒ पुन॒रा",
      "start": 157.96,
      "end": 165.8
    },
    {
      "text": "भ॑व॒न्त्युत्त॑रं ब॒र्॒.हिष॑ उत्तरब॒र्॒.हिः स्तृ॑णाति",
      "start": 165.8,
      "end": 165.8
