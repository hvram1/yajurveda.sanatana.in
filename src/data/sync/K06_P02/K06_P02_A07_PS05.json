  "phrases": [
    {
      "text": "-नुदत॒ मनो॑जवाः पि॒तृभि॑ र्दक्षिण॒तः",
      "start": 128.56,
      "end": 128.56
    },
    {
      "text": "प्रचे॑ता रु॒द्रैः प॒श्चाद्-वि॒श्वक॑र्माऽऽदि॒त्यैरु॑त्तर॒तो यदे॒वमु॑त्तरवे॒दिं",
      "start": 128.56,
      "end": 128.56
    },
    {
      "text": "प्रो॒क्षति॑ दि॒ग्भ्य ए॒व तद्-यज॑मानो॒",
      "start": 128.56,
      "end": 128.56
    },
    {
      "text": "भ्रातृ॑व्या॒न् प्र णु॑दत॒ इन्द्रो॒",
      "start": 128.56,
      "end": 128.56
    },
    {
      "text": "यती᳚न्थ् सालावृ॒केभ्यः॒ प्राय॑च्छ॒त् तान्",
      "start": 128.56,
      "end": 131.12
    },
    {
      "text": "द॑क्षिण॒त उ॑त्तरवे॒द्या आ॑द॒न्॒ यत्",
      "start": 131.12,
      "end": 133.92
    },
    {
      "text": "प्रोक्ष॑णीना-मु॒च्छिष्ये॑त॒ तद् द॑क्षिण॒त उ॑त्तरवे॒द्यै",
      "start": 133.92,
      "end": 141.92
    },
    {
      "text": "नि न॑ये॒द्-यदे॒व तत्र॑ क्रू॒रं",
      "start": 141.92,
      "end": 144.6
    },
    {
      "text": "तत् तेन॑ शमयति॒ यं",
      "start": 144.6,
      "end": 146.68
    },
    {
      "text": "द्वि॒ष्यात् तं ध्या॑येच्छु॒चै (",
