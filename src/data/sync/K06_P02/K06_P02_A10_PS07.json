  "phrases": [
    {
      "text": "मद्ध्य॒त ऊ॒र्जा भु॑ञ्जते यजमानलो॒के",
      "start": 215.84,
      "end": 217.6
    },
    {
      "text": "वै दक्षि॑णानि छ॒दीꣳषि॑ भ्रातृव्यलो॒क",
      "start": 217.6,
      "end": 223.44
    },
    {
      "text": "उत्त॑राणि॒ दक्षि॑णा॒न्युत्त॑राणि करोति॒ यज॑मान-मे॒वा-य॑जमाना॒दुत्त॑रं",
      "start": 223.44,
      "end": 225.28
    },
    {
      "text": "करोति॒ तस्मा॒द् यज॑मा॒नोऽय॑जमाना॒दुत्त॑रो ऽन्तर्व॒र्तान्",
      "start": 225.28,
      "end": 225.28
    },
    {
      "text": "क॑रोति॒ व्यावृ॑त्त्यै॒ तस्मा॒दर॑ण्यं प्र॒जा",
      "start": 225.28,
      "end": 231.28
    },
    {
      "text": "उप॑ जीवन्ति॒ परि॑ त्वा",
      "start": 231.28,
      "end": 234.88
    },
    {
      "text": "गिर्वणो॒ गिर॒ इत्या॑ह यथाय॒जुरे॒वैतदिन्द्र॑स्य॒",
      "start": 234.88,
      "end": 241.6
    },
    {
      "text": "स्यूर॒सीन्द्र॑स्य ध्रु॒वम॒सीत्या॑है॒न्द्रꣳ हि दे॒वत॑या॒",
      "start": 241.6,
      "end": 254.0
    },
    {
      "text": "सदो॒ ( ) यं",
      "start": 254.0,
      "end": 255.4
    },
    {
      "text": "प्र॑थ॒मं ग्र॒न्थिं ग्र॑थ्नी॒याद्यत् तं",
      "start": 255.4,
      "end": 259.84
    },
    {
      "text": "न वि॑स्रꣳ॒॒ सये॒दमे॑हेनाद्ध्व॒र्युः प्रमी॑येत॒",
      "start": 259.84,
      "end": 264.0
    },
    {
      "text": "तस्मा॒थ् स वि॒स्रस्यः॑",
      "start": 264.0,
      "end": 270.2
    }
  ],
  "total_phrases": 12
