  "phrases": [
    {
      "text": "सौ॒म्येन॑ दधाति॒ प्र ज॑नयति",
      "start": 42.32,
      "end": 42.32
    },
    {
      "text": "पौ॒ष्णेन॑ बार्.हस्प॒त्यो भ॑वति॒ ब्रह्म॒",
      "start": 42.32,
      "end": 42.32
    },
    {
      "text": "वै दे॒वानां॒ बृह॒स्पति॒र्ब्रह्म॑णै॒वास्मै᳚ प्र॒जाः",
      "start": 42.32,
      "end": 42.32
    },
    {
      "text": "प्रज॑नयति वैश्वदे॒वो भ॑वति वैश्वदे॒व्यो॑",
      "start": 42.32,
      "end": 42.32
    },
    {
      "text": "वै प्र॒जाः प्र॒जा ए॒वास्मै॒",
      "start": 42.32,
      "end": 42.32
    },
    {
      "text": "प्रज॑नयती-न्द्रि॒यमे॒वैन्द्रेणाव॑ रुन्धे॒ विशं॑ मारु॒तेनौजो॒",
      "start": 42.32,
      "end": 45.36
    },
    {
      "text": "बल॑मैन्द्रा॒ग्नेन॑ प्रस॒वाय॑ सावि॒त्रो नि॑र्वरुण॒त्वाय॑",
      "start": 45.36,
      "end": 54.56
    },
    {
      "text": "वारु॒णो म॑द्ध्य॒त ऐ॒न्द्रमा ल॑भते",
      "start": 54.56,
      "end": 60.68
    },
    {
      "text": "मद्ध्य॒त ए॒वेन्द्रि॒यं ॅयज॑माने दधाति-",
      "start": 60.68,
      "end": 60.68
    },
    {
      "text": "[ ]",
      "start": 60.68,
      "end": 60.68
    }
  ],
