      "end": 42.36
    },
    {
      "text": "लो॒कान् प्री॑णाति॒ यज्ञ्॑ य॒ज्ञ्ं",
      "start": 42.36,
      "end": 50.72
    },
    {
      "text": "ग॑च्छ य॒ज्ञ्प॑तिं ग॒च्छेत्या॑ह य॒ज्ञ्प॑तिमे॒वैनं॑",
      "start": 50.72,
      "end": 57.48
    },
    {
      "text": "गमयति॒ स्वां ॅयोनिं॑ ग॒च्छेत्या॑ह॒",
      "start": 57.48,
      "end": 57.48
    },
    {
      "text": "स्वामे॒वैनं॒ ॅयोनिं॑ गमयत्ये॒ष ते॑",
      "start": 57.48,
      "end": 57.48
    },
    {
      "text": "य॒ज्ञो य॑ज्ञ्पते स॒हसू᳚क्तवाकः सु॒वीर॒",
      "start": 57.48,
      "end": 57.48
    },
    {
      "text": "इत्या॑ह॒ यज॑मान ए॒व वी॒र्यं॑",
      "start": 57.48,
      "end": 57.48
    },
    {
      "text": "दधाति वासि॒ष्ठो ह॑ सात्यह॒व्यो",
      "start": 57.48,
      "end": 57.48
    },
    {
      "text": "दे॑वभा॒गं प॑प्रच्छ॒ यथ् सृञ्ज॑यान्",
      "start": 57.48,
      "end": 57.48
    },
