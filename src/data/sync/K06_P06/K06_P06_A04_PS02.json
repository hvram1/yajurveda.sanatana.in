  "phrases": [
    {
      "text": "अनु॑ प॒शव॒ उप॑ तिष्ठन्ते",
      "start": 35.4,
      "end": 35.4
    },
    {
      "text": "पशु॒माने॒व भ॑वति॒ व्यति॑षजे॒दित॑रान् प्र॒जयै॒वैनं॑",
      "start": 35.4,
      "end": 38.16
    },
    {
      "text": "प॒शुभि॒र्व्यति॑षजति॒ यं का॒मये॑त प्र॒मायु॑कः",
      "start": 38.16,
      "end": 43.92
    },
    {
      "text": "स्या॒दिति॑ गर्त॒मितं॒ तस्य॑ मिनुयादुत्तरा॒र्द्ध्यं॑",
      "start": 43.92,
      "end": 51.44
    },
    {
      "text": "ॅवर्.षि॑ष्ठ॒मथ॒ ह्रसी॑याꣳसमे॒षा वै ग॑र्त॒मिद्यस्यै॒वं",
      "start": 51.44,
      "end": 56.64
    },
    {
      "text": "मि॒नोति॑ ता॒जक् प्र मी॑यते",
      "start": 56.64,
      "end": 59.68
    },
    {
      "text": "दक्षिणा॒र्द्ध्यं॑ ॅवर्.षि॑ष्ठं मिनुयाथ् सुव॒र्गका॑म॒स्याथ॒",
      "start": 59.68,
      "end": 70.24
    },
    {
      "text": "ह्रसी॑याꣳस-मा॒क्रम॑णमे॒व तथ् सेतुं॒ ॅयज॑मानः",
      "start": 70.24,
      "end": 77.4
    },
    {
      "text": "कुरुते सुव॒र्गस्य॑ लो॒कस्य॒ सम॑ष्ट्यै॒-",
      "start": 77.4,
      "end": 85.4
    },
    {
      "text": "[ ]",
      "start": 85.4,
      "end": 85.48
    }
  ],
