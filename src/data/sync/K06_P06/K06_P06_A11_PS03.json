    {
      "text": "ऽग्र॑मे॒व स॑मा॒नानां॒ पर्ये॑ति प्रातस्सव॒ने",
      "start": 83.48,
      "end": 90.16
    },
    {
      "text": "गृ॑ह्णाति॒ वज्रो॒ वै षो॑ड॒शी",
      "start": 90.16,
      "end": 94.2
    },
    {
      "text": "वज्रः॑ प्रातस्सव॒नꣳ स्वादे॒वैनं॒ ॅयोने॒र्निगृ॑ह्णाति॒",
      "start": 94.2,
      "end": 99.64
    },
    {
      "text": "सव॑नेसवने॒ऽभि गृ॑ह्णाति॒ सव॑नाथ्सवनादे॒वैनं॒ प्र",
      "start": 99.64,
      "end": 104.84
    },
    {
      "text": "ज॑नयति तृतीयसव॒ने प॒शुका॑मस्य गृह्णीया॒द्-वज्रो॒",
      "start": 104.84,
      "end": 108.16
    },
    {
      "text": "वै षो॑ड॒शी प॒शव॑स्तृतीयसव॒नं ॅवज्रे॑णै॒वास्मै॑",
      "start": 108.16,
      "end": 108.16
    },
    {
      "text": "तृतीयसव॒नात् प॒शूनव॑ रुन्धे॒ नोक्थ्ये॑",
      "start": 108.16,
      "end": 108.16
    },
    {
      "text": "गृह्णीयात् प्र॒जा वै प॒शव॑",
      "start": 108.16,
      "end": 108.16
