    {
      "text": "-स्यप॑ हन्ति॒ पुरु॑षःपुरुषो नि॒धन॒मुपै॑ति॒",
      "start": 38.72,
      "end": 38.72
    },
    {
      "text": "पुरु॑षःपुरुषो॒ हि र॑क्ष॒स्वी रक्ष॑सा॒मप॑हत्या",
      "start": 38.72,
      "end": 40.92
    },
    {
      "text": "उ॒रुꣳ हि राजा॒ वरु॑णश्च॒कारेत्या॑ह॒",
      "start": 40.92,
      "end": 46.72
    },
    {
      "text": "प्रति॑ष्ठित्यै श॒तं ते॑ राजन्",
      "start": 46.72,
      "end": 52.92
    },
    {
      "text": "भि॒षजः॑ स॒हस्र॒मित्या॑ह भेष॒जमे॒वास्मै॑ करोत्य॒भिष्ठि॑तो॒",
      "start": 52.92,
      "end": 65.32
    },
    {
      "text": "वरु॑णस्य॒ पाश॒ इत्या॑ह वरुणपा॒शमे॒वाभि",
      "start": 65.32,
      "end": 70.96
    },
    {
      "text": "ति॑ष्ठति ब॒र्॒.हिर॒भि जु॑हो॒त्याहु॑तीनां॒ प्रति॑ष्ठित्या॒",
      "start": 70.96,
      "end": 80.44
    },
