    {
      "text": "इन्द्रः॒ पत्नि॑या॒ मनु॑मयाजय॒त् तां",
      "start": 0.0,
      "end": 5.24
    },
    {
      "text": "पर्य॑ग्निकृता॒-मुद॑सृज॒त् तया॒ मनु॑रार्द्ध्नो॒द्यत् पर्य॑ग्निकृतं",
      "start": 5.24,
      "end": 11.56
    },
    {
      "text": "पात्नीव॒तमु॑थ् सृ॒जति॒ यामे॒व मनु॒र॒.",
      "start": 11.56,
      "end": 11.56
    },
    {
      "text": "ऋद्धि॒मार्द्ध्नो॒त् तामे॒व यज॑मान ऋध्नोति",
      "start": 11.56,
      "end": 11.56
    },
    {
      "text": "य॒ज्ञ्स्य॒ वा अप्र॑तिष्ठिताद्-य॒ज्ञ्ः परा॑",
      "start": 11.56,
      "end": 12.72
    },
    {
      "text": "भवति य॒ज्ञ्ं प॑रा॒भव॑न्तं॒ ॅयज॑मा॒नोऽनु॒",
      "start": 12.72,
      "end": 17.96
    },
    {
      "text": "परा॑ भवति॒ यदाज्ये॑न पात्नीव॒तꣳ",
      "start": 17.96,
      "end": 17.96
    },
    {
      "text": "सꣳ॑स्था॒पय॑ति य॒ज्ञ्स्य॒ प्रति॑ष्ठित्यै य॒ज्ञ्ं",
      "start": 17.96,
      "end": 25.04
    },
    {
      "text": "प्र॑ति॒तिष्ठ॑न्तं॒ ॅयज॑मा॒नोऽनु॒ प्रति॑ तिष्ठती॒ष्टं",
