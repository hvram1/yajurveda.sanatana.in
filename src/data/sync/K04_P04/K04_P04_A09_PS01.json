  "phrases": [
    {
      "text": "प्र॒जाप॑ति॒र्मन॒सा ऽन्धोऽच्छे॑तो धा॒ता दी॒क्षायाꣳ॑",
      "start": 0.0,
      "end": 9.56
    },
    {
      "text": "सवि॒ता भृ॒त्यां पू॒षा सो॑म॒क्रय॑ण्यां॒",
      "start": 9.56,
      "end": 16.2
    },
    {
      "text": "ॅवरु॑ण॒ उप॑न॒द्धो ऽसु॑रः क्री॒यमा॑णो",
      "start": 16.2,
      "end": 22.84
    },
    {
      "text": "मि॒त्रः क्री॒तः शि॑पिवि॒ष्ट आसा॑दितो",
      "start": 22.84,
      "end": 23.52
    },
    {
      "text": "न॒रंधि॑षः प्रो॒ह्यमा॒णो ऽधि॑पति॒राग॑तः प्र॒जाप॑तिः",
      "start": 23.52,
      "end": 23.52
    },
    {
      "text": "प्रणी॒यमा॑नो॒ ऽग्निराग्नी᳚द्ध्रे॒ बृह॒स्पति॒राग्नी᳚द्ध्रात् प्रणी॒यमा॑न॒",
      "start": 23.52,
      "end": 23.52
    },
    {
      "text": "इन्द्रो॑ हवि॒र्द्धाने ऽदि॑ति॒रासा॑दितो॒ विष्णु॑रुपावह्रि॒यमा॒णो",
      "start": 23.52,
      "end": 30.28
    },
    {
      "text": "ऽथ॒र्वोपो᳚त्तो य॒मो॑ऽभिषु॑तो ऽपूत॒पा आ॑धू॒यमा॑नो",
      "start": 30.28,
      "end": 34.92
    },
    {
      "text": "वा॒युः पू॒यमा॑नो मि॒त्रः क्षी॑र॒श्रीर्म॒न्थी",
      "start": 34.92,
      "end": 37.56
    },
    {
      "text": "स॑क्तु॒श्रीर्वै᳚श्वदे॒व उन्नी॑तो रु॒द्र (",
      "start": 37.56,
      "end": 40.48
    },
    {
      "text": ") आहु॑तो वा॒युरावृ॑त्तो नृ॒चक्षाः॒",
      "start": 40.48,
      "end": 44.8
    },
    {
      "text": "प्रति॑ख्यातो भ॒क्ष आग॑तः पितृ॒णां",
      "start": 44.8,
      "end": 49.32
    },
    {
      "text": "ना॑राशꣳ॒॒सो ऽसु॒रात्तः॒ सिन्धु॑र-वभृ॒थम॑वप्र॒यन्थ् स॑मु॒द्रो",
      "start": 49.32,
      "end": 60.64
    },
    {
      "text": "ऽव॑गतः सलि॒लः प्रप्लु॑तः॒ सुव॑रु॒दृचं॑",
      "start": 60.64,
      "end": 65.2
    },
    {
      "text": "ग॒तः",
      "start": 65.2,
      "end": 66.48
    }
  ],
  "total_phrases": 15
}