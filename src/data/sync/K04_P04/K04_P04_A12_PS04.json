  "phrases": [
    {
      "text": "बृह॒तीर्नु शक्व॑रीरि॒मं ॅय॒ज्ञ्म॑वन्तु नो घृ॒ताचीः᳚",
      "start": 150.56,
      "end": 153.16
    },
    {
      "text": "सुव॑र्वती सु॒दुघा॑ नः॒ पय॑स्वती",
      "start": 153.16,
      "end": 158.68
    },
    {
      "text": "दि॒शां दे॒व्य॑वतु नो घृ॒ताची᳚",
      "start": 158.68,
      "end": 160.84
    },
    {
      "text": "त्वं गो॒पाः पु॑रए॒तोत प॒श्चाद्",
      "start": 160.84,
      "end": 164.88
    },
    {
      "text": "बृह॑स्पते॒ याम्यां᳚ ॅयुङ्ग्धि॒ वाचं᳚",
      "start": 164.88,
      "end": 166.4
    },
    {
      "text": "ऊ॒र्द्ध्वा दि॒शाꣳ रन्ति॒राशौष॑धीनाꣳ संॅवथ्स॒रेण॑",
      "start": 166.4,
      "end": 172.76
    },
    {
      "text": "सवि॒ता नो॒ अह्नां᳚",
      "start": 172.76,
      "end": 173.8
    },
    {
      "text": "रे॒वथ् सामाति॑च्छन्दा उ॒ छन्दोऽजा॑त",
      "start": 173.8,
      "end": 180.88
    },
    {
      "text": "शत्रुः स्यो॒ना नो॑ अस्तु",
      "start": 180.88,
      "end": 181.88
    },
    {
      "text": "स्तोम॑त्रयस्त्रिꣳशे॒ भुव॑नस्य पत्नि॒ विव॑स्वद्वाते",
      "start": 181.88,
      "end": 187.64
    },
    {
      "text": "अ॒भि नो॑ - [",
