    {
      "text": "स्तोमं॑ चा॒ग्नये᳚",
      "start": 140.2,
      "end": 141.88
    },
    {
      "text": "वर्.षि॑ष्ठाय क्षिती॒नामू॒र्जो नप्त्रे॒ सह॑स्वते",
      "start": 141.88,
      "end": 150.88
    },
    {
      "text": "सꣳस॒मिद्यु॑वसे वृष॒न्नग्ने॒ विश्वा᳚न्य॒र्य आ",
      "start": 150.88,
      "end": 154.84
    },
    {
      "text": "इ॒डस्प॒दे समि॑द्ध्यसे॒ स नो॒",
      "start": 154.84,
      "end": 161.48
    },
    {
      "text": "वसू॒न्या भ॑र",
      "start": 161.48,
      "end": 164.48
    },
    {
      "text": "ए॒ना वो॑ अ॒ग्निं नम॑सो॒र्जो",
      "start": 164.48,
      "end": 171.4
    },
    {
      "text": "नपा॑त॒मा हु॑वे",
      "start": 171.4,
      "end": 173.0
    },
    {
      "text": "प्रि॒यं चेति॑ष्ठमर॒तिꣳ स्व॑द्ध्व॒रं ॅविश्व॑स्य दू॒तम॒मृतं᳚",
      "start": 173.0,
      "end": 176.52
    },
    {
      "text": "स यो॑जते अरु॒षो वि॒श्वभो॑जसा॒",
      "start": 176.52,
      "end": 179.28
    },
    {
      "text": "स दु॑द्रव॒थ् स्वा॑हुतः",
      "start": 179.28,
      "end": 184.12
    },
    {
      "text": "सु॒ब्रह्मा॑ य॒ज्ञ्ः सु॒शमी॒ -",
