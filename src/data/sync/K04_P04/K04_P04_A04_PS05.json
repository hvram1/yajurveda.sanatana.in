  "phrases": [
    {
      "text": "वसू॑नां दे॒वꣳ राधो॒ जना॑नां",
      "start": 190.64,
      "end": 191.68
    },
    {
      "text": "उद॑स्य शो॒चिर॑स्थादा॒-जुह्वा॑नस्य मी॒ढुषः॑",
      "start": 191.68,
      "end": 199.76
    },
    {
      "text": "उद्ध॒मासो॑ अरु॒षासो॑ दिवि॒स्पृशः॒ सम॒ग्निमि॑न्धते॒ नरः॑",
      "start": 199.76,
      "end": 203.08
    },
    {
      "text": "अग्ने॒ वाज॑स्य॒ गोम॑त॒ ईशा॑नः",
      "start": 203.08,
      "end": 203.08
    },
    {
      "text": "सहसो यहो",
      "start": 203.08,
      "end": 203.08
    },
    {
      "text": "अ॒स्मे धे॑हि जातवेदो॒ महि॒ श्रवः॑",
      "start": 203.08,
      "end": 203.08
    },
    {
      "text": "स इ॑धा॒नो वसु॑ष्क॒वि-र॒ग्निरी॒डेन्यो॑ गि॒रा",
      "start": 203.08,
      "end": 203.08
    },
    {
      "text": "रे॒वद॒स्मभ्यं॑ पुर्वणीक दीदिहि",
      "start": 203.08,
      "end": 203.08
    },
    {
      "text": "क्ष॒पो रा॑जन्नु॒त त्मनाऽग्ने॒ वस्तो॑रु॒तोषसः॑",
      "start": 203.08,
      "end": 203.08
    },
    {
      "text": "स ति॑ग्मजंभ - [ ]",
      "start": 203.08,
      "end": 203.08
    }
