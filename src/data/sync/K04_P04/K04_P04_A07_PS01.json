    {
      "text": "भू॒य॒स्कृद॑सि वरिव॒स्कृद॑सि॒ प्राच्य॑स्यू॒र्द्ध्वाऽस्य॑-न्तरिक्ष॒सद॑स्य॒-न्तरि॑क्षे सीदा-फ्सु॒षद॑सि",
      "start": 0.0,
      "end": 18.76
    },
    {
      "text": "श्येन॒सद॑सि गृद्ध्र॒सद॑सि सुपर्ण॒सद॑सि नाक॒सद॑सि",
      "start": 18.76,
      "end": 29.08
    },
    {
      "text": "पृथि॒व्यास्त्वा॒ द्रवि॑णे सादयाम्य॒-न्तरि॑क्षस्य त्वा॒",
      "start": 29.08,
      "end": 29.08
    },
    {
      "text": "द्रवि॑णे सादयामि दि॒वस्त्वा॒ द्रवि॑णे",
      "start": 29.08,
      "end": 29.08
    },
    {
      "text": "सादयामि दि॒शां त्वा॒ द्रवि॑णे",
      "start": 29.08,
      "end": 29.08
    },
    {
      "text": "सादयामि द्रविणो॒दां त्वा॒ द्रवि॑णे",
      "start": 29.08,
      "end": 29.08
    },
    {
      "text": "सादयामि प्रा॒णं मे॑ पाह्य-पा॒नं",
