  "phrases": [
    {
      "text": "सुव॒र्न ज्योतिः॑",
      "start": 270.76,
      "end": 272.72
    },
    {
      "text": "अग्ने॒ विश्वे॑भिः सु॒मना॒ अनी॑कैः",
      "start": 272.72,
      "end": 277.16
    },
    {
      "text": "अ॒ग्निꣳ होता॑रं मन्ये॒ दास्व॑न्तं॒",
      "start": 277.16,
      "end": 281.08
    },
    {
      "text": "ॅवसोः᳚ सू॒नुꣳ सह॑सो जा॒तवे॑दसं",
      "start": 281.08,
      "end": 285.8
    },
    {
      "text": "विप्रं॒ न जा॒तवे॑दसं",
      "start": 285.8,
      "end": 287.64
    },
    {
      "text": "य ऊ॒र्द्ध्वया᳚ स्वद्ध्व॒रो दे॒वो",
      "start": 287.64,
      "end": 290.76
    },
    {
      "text": "दे॒वाच्या॑ कृ॒पा",
      "start": 290.76,
      "end": 293.56
    },
    {
      "text": "घृ॒तस्य॒ विभ्रा᳚ष्टि॒मनु॑ शु॒क्रशो॑चिष आ॒जुह्वा॑नस्य स॒र्पिषः॑",
      "start": 293.56,
      "end": 303.88
    },
    {
      "text": "अग्ने॒ त्वं नो॒ अन्त॑मः",
      "start": 303.88,
      "end": 307.28
    },
    {
      "text": "उ॒त त्रा॒ता शि॒वो भ॑व वरू॒थ्यः॑",
      "start": 307.28,
      "end": 313.4
    },
    {
      "text": "तं त्वा॑ शोचिष्ठ दीदिवः",
      "start": 313.4,
      "end": 314.72
    },
    {
      "text": "सु॒म्नाय॑ नू॒नमी॑महे॒ सखि॑भ्यः",
      "start": 314.72,
      "end": 321.4
    },
    {
      "text": "वसु॑र॒ग्निर्वसु॑श्रवाः ( )",
      "start": 321.4,
      "end": 324.6
    },
    {
      "text": "अच्छा॑ नक्षि द्यु॒मत्त॑मो र॒यिं दाः᳚",
      "start": 324.6,
      "end": 330.96
    }
  ],
