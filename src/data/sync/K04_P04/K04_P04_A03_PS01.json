    {
      "text": "अ॒यं पु॒रो हरि॑केशः॒ सूर्य॑रश्मि॒स्तस्य॑",
      "start": 0.0,
      "end": 2.8
    },
    {
      "text": "रथगृ॒थ्सश्च॒ रथौ॑जाश्च सेनानि ग्राम॒ण्यौ॑",
      "start": 2.8,
      "end": 7.8
    },
    {
      "text": "पुञ्जिकस्थ॒ला च॑ कृतस्थ॒ला चा᳚फ्स॒रसौ॑",
      "start": 7.8,
      "end": 13.4
    },
    {
      "text": "यातु॒धाना॑ हे॒ती रक्षाꣳ॑सि॒ प्रहे॑ति",
      "start": 13.4,
      "end": 19.04
    },
    {
      "text": "र॒यं द॑क्षि॒णा वि॒श्व क॑र्मा॒",
      "start": 19.04,
      "end": 24.2
    },
    {
      "text": "तस्य॑ रथस्व॒नश्च॒ रथे॑चित्रश्च सेनानि",
