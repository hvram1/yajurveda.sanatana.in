  "phrases": [
    {
      "text": "इ॒न्द्रा॒ग्निभ्यां᳚ त्वा स॒युजा॑ यु॒जा",
      "start": 0.0,
      "end": 1.4
    },
    {
      "text": "यु॑नज्म्या घा॒राभ्यां॒ तेज॑सा॒ वर्च॑सो॒",
      "start": 1.4,
      "end": 9.0
    },
    {
      "text": "क्थेभिः॒ स्तोमे॑भि॒ श्छन्दो॑भी र॒य्यै",
      "start": 9.0,
      "end": 14.92
    },
    {
      "text": "पोषा॑य सजा॒तानां᳚ मद्ध्यम॒स्थेया॑य॒ मया᳚",
      "start": 14.92,
      "end": 20.04
    },
    {
      "text": "त्वा स॒युजा॑ यु॒जा यु॑नज्म्य॒बां",
      "start": 20.04,
      "end": 25.16
    },
    {
      "text": "दु॒ला नि॑त॒त्नि र॒भ्रय॑न्ती मे॒घय॑न्ती",
      "start": 25.16,
      "end": 32.04
    },
    {
      "text": "व॒र्॒.षय॑न्ती चुपु॒णीका॒ नामा॑सि प्र॒जाप॑तिना",
      "start": 32.04,
      "end": 39.44
    },
    {
      "text": "त्वा॒ विश्वा॑भिर्द्धी॒भिरुप॑ दधामि पृथि॒व्यु॑दपु॒रमन्ने॑न",
      "start": 39.44,
      "end": 44.8
    },
    {
      "text": "वि॒ष्टा म॑नु॒ष्या᳚स्ते गो॒प्तारो॒ ऽग्निर्विय॑त्तोऽस्यां॒",
      "start": 44.8,
      "end": 50.64
    },
    {
      "text": "ताम॒हं प्र॑ पद्ये॒ सा",
      "start": 50.64,
      "end": 53.08
    },
