  "phrases": [
    {
      "text": "बृह॒स्पति॑र्.हेती॒नां प्र॑तिध॒र्ता त्रि॑णवत्रयस्त्रिꣳ॒॒शौ त्वा॒",
      "start": 87.24,
      "end": 87.24
    },
    {
      "text": "स्तोमौ॑ पृथि॒व्याꣳ श्र॑यतां ॅवैश्वदेवाग्निमारु॒ते",
      "start": 87.24,
      "end": 87.24
    },
    {
      "text": "उ॒क्थे अव्य॑थयन्ती स्तभ्नीताꣳ शाक्वररैव॒ते",
      "start": 87.24,
      "end": 90.32
    },
    {
      "text": "साम॑नी॒ प्रति॑ष्ठित्या अ॒न्तरि॑क्षा॒यर्.ष॑यस्त्वा प्रथम॒जा",
      "start": 90.32,
      "end": 96.68
    },
    {
      "text": "दे॒वेषु॑ दि॒वो मात्र॑या वरि॒णा",
      "start": 96.68,
      "end": 99.56
    },
    {
      "text": "प्र॑थन्तु विध॒र्ता चा॒यमधि॑पतिश्च॒ ते",
      "start": 99.56,
      "end": 105.6
    },
    {
      "text": "त्वा॒ सर्वे॑ संॅविदा॒ना नाक॑स्य",
      "start": 105.6,
      "end": 109.12
    },
    {
      "text": "पृ॒ष्ठे सु॑व॒र्गे लो॒के यज॑मानं",
      "start": 109.12,
      "end": 111.44
    },
    {
      "text": "च सादयन्तु",
      "start": 111.44,
      "end": 112.2
    }
