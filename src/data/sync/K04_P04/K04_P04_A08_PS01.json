  "phrases": [
    {
      "text": "अ॒ग्निना॑ विश्वा॒षाट् सूर्ये॑ण स्व॒राट्",
      "start": 0.0,
      "end": 8.56
    },
    {
      "text": "क्रत्वा॒ शची॒पति॑र्. ऋष॒भेण॒ त्वष्टा॑",
      "start": 8.56,
      "end": 16.8
    },
    {
      "text": "य॒ज्ञेन॑ म॒घवा॒न् दक्षि॑णया सुव॒र्गो",
      "start": 16.8,
      "end": 24.16
    },
    {
      "text": "म॒न्युना॑ वृत्र॒हा सौहा᳚र्द्येन तनू॒धा",
      "start": 24.16,
      "end": 26.88
    },
    {
      "text": "अन्ने॑न॒ गयः॑ पृथि॒व्याऽस॑नो दृ॒ग्भिर॑न्ना॒दो",
      "start": 26.88,
      "end": 26.88
    },
    {
      "text": "व॑षट्का॒रेण॒र्द्धः साम्ना॑ तनू॒पा वि॒राजा॒",
      "start": 26.88,
      "end": 26.88
    },
    {
      "text": "ज्योति॑ष्मा॒न् ब्रह्म॑णा सोम॒पा गोभि॑र्य॒ज्ञ्ं",
      "start": 26.88,
      "end": 26.96
    },
    {
      "text": "दा॑धार क्ष॒त्रेण॑ मनु॒ष्या॑-नश्वे॑न च॒",
      "start": 26.96,
      "end": 29.68
    },
    {
      "text": "रथे॑न च व॒ज्र्यृ॑तुभिः॑ प्र॒भुः",
      "start": 29.68,
      "end": 35.16
    },
    {
      "text": "सं॑ॅवथ्स॒रेण॑ परि॒भू स्तप॒साऽना॑धृष्टः॒ सूर्यः॒",
      "start": 35.16,
      "end": 41.68
    },
    {
      "text": "सन् त॒नूभिः॑",
      "start": 41.68,
      "end": 43.04
    }
