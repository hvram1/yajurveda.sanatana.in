  "phrases": [
    {
      "text": "-रसि स्तनयित्नु॒सनि॑रसि वृष्टि॒सनि॑रस्य॒-ग्नेर्यान्य॑सि दे॒वाना॑मग्ने॒",
      "start": 33.64,
      "end": 44.48
    },
    {
      "text": "यान्य॑सि वा॒योर्यान्य॑सि दे॒वानां᳚ ॅवायो॒यान्य॑स्य॒न्तरि॑क्षस्य॒",
      "start": 44.48,
      "end": 55.6
    },
    {
      "text": "यान्य॑सि दे॒वाना॑- मन्तरिक्ष॒यान्य॑स्य॒-न्तरि॑क्षमस्य॒न्तरि॑क्षाय त्वा",
      "start": 55.6,
      "end": 66.6
    },
    {
      "text": "सलि॒लाय॑ त्वा॒ सर्णी॑काय त्वा॒",
      "start": 66.6,
      "end": 73.2
    },
    {
      "text": "सती॑काय त्वा॒ केता॑य त्वा॒",
      "start": 73.2,
      "end": 75.56
    },
    {
      "text": "प्रचे॑तसे त्वा॒ विव॑स्वते त्वा",
      "start": 75.56,
      "end": 78.72
    },
    {
      "text": "दि॒वस्त्वा॒ ज्योति॑ष आदि॒त्येभ्य॑स्त्व॒र्चे त्वा॑",
      "start": 78.72,
      "end": 78.72
    },
    {
      "text": "रु॒चे त्वा᳚ द्यु॒ते त्वा॑",
      "start": 78.72,
      "end": 78.72
    },
    {
      "text": "( ) भा॒से त्वा॒",
      "start": 78.72,
      "end": 78.72
    },
    {
      "text": "ज्योति॑षे त्वा यशो॒दां त्वा॒",
      "start": 78.72,
      "end": 79.28
    },
    {
      "text": "यश॑सि तेजो॒दां त्वा॒ तेज॑सि",
      "start": 79.28,
      "end": 82.88
    },
    {
      "text": "पयो॒दां त्वा॒ पय॑सि वर्चो॒दां",
      "start": 82.88,
      "end": 86.16
    },
    {
      "text": "त्वा॒ वर्च॑सि द्रविणो॒दां त्वा॒",
      "start": 86.16,
      "end": 91.12
    },
    {
      "text": "द्रवि॑णे सादयामि॒ तेनर्.षि॑णा॒ तेन॒",
      "start": 91.12,
      "end": 94.68
    },
    {
      "text": "ब्रह्म॑णा॒ तया॑ दे॒वत॑याऽङ्गिर॒स्वद् ध्रु॒वा",
