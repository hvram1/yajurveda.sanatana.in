      "start": 195.28,
      "end": 195.28
    },
    {
      "text": "ध्रु॒वा दि॒शां ॅविष्णु॑प॒त्न्यघो॑रा॒ऽस्येशा॑ना॒ सह॑सो॒",
      "start": 195.28,
      "end": 207.0
    },
    {
      "text": "या म॒नोता᳚",
      "start": 207.0,
      "end": 208.4
    },
    {
      "text": "बृह॒स्पति॑ र्मात॒रिश्वो॒त वा॒युः स॑न्धुवा॒ना",
      "start": 208.4,
      "end": 216.84
    },
    {
      "text": "वाता॑ अ॒भि नो॑ गृणन्तु",
      "start": 216.84,
      "end": 219.2
