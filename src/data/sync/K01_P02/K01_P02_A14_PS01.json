  "phrases": [
    {
      "text": "कृ॒णु॒ष्व पाजः॒ प्रसि॑ति॒न्न पृ॒थ्वीं",
      "start": 0.0,
      "end": 5.84
    },
    {
      "text": "ॅया॒हि राजे॒वाम॑वाꣳ॒॒ इभे॑न",
      "start": 5.84,
      "end": 7.6
    },
    {
      "text": "तृ॒ष्वीमनु॒ प्रसि॑तिं-द्रूणा॒नो-ऽस्ता॑ऽसि॒ विद्ध्य॑ र॒क्षस॒ स्तपि॑ष्ठैः",
      "start": 7.6,
      "end": 17.88
    },
    {
      "text": "तव॑ भ्र॒मास॑ आशु॒या प॑न्त॒त्यनु॑",
      "start": 17.88,
      "end": 26.12
    },
    {
      "text": "स्पृश-धृष॒ता शोशु॑चानः",
      "start": 26.12,
      "end": 28.84
    },
    {
      "text": "तपूꣳ॑ष्यग्ने जु॒ह्वा॑ पत॒ङ्गानस॑न्दितो॒ विसृ॑ज॒ विष्व॑गु॒ल्काः",
      "start": 28.84,
      "end": 40.76
    },
    {
      "text": "प्रति॒स्पशो॒ विसृ॑ज॒-तूर्णि॑तमो॒ भवा॑ पा॒युर्वि॒शो",
      "start": 40.76,
      "end": 47.44
    },
    {
      "text": "अ॒स्या अद॑ब्धः",
      "start": 47.44,
      "end": 48.8
    },
    {
      "text": "यो नो॑ दू॒रे अ॒घशꣳ॑सो॒",
      "start": 48.8,
      "end": 51.36
    },
