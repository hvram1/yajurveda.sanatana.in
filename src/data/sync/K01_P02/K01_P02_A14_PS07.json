    {
      "text": "सरि॒षः पा॑तु॒नक्तं᳚",
      "start": 268.48,
      "end": 268.48
    },
    {
      "text": "विज्योति॑षा बृह॒ता भा᳚त्य॒ग्नि-रा॒विर् विश्वा॑नि",
      "start": 268.48,
      "end": 268.48
    },
    {
      "text": "कृणुते महि॒त्वा",
      "start": 268.48,
      "end": 268.48
    },
    {
      "text": "प्रादे॑वीर् मा॒याः स॑हते-दु॒रेवाः॒ शिशी॑ते॒",
      "start": 268.48,
      "end": 268.48
    },
    {
      "text": "शृङ्गे॒ रक्ष॑से वि॒निक्षे᳚",
      "start": 268.48,
      "end": 268.48
    },
    {
      "text": "उ॒त स्वा॒नासो॑ दि॒विष॑न्त्व॒ग्ने स्ति॒ग्मायु॑धा॒",
      "start": 268.48,
      "end": 268.48
    },
    {
      "text": "रक्ष॑से॒ हन्त॒वा उ॑",
      "start": 268.48,
      "end": 269.52
