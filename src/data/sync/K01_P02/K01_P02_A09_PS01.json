  "phrases": [
    {
      "text": "प्र च्य॑वस्व भुवस्पते॒ विश्वा᳚न्य॒भि",
      "start": 0.0,
      "end": 6.92
    },
    {
      "text": "धामा॑नि॒ मा त्वा॑ परिप॒री",
      "start": 6.92,
      "end": 9.96
    },
    {
      "text": "वि॑द॒न्मा त्वा॑ परिप॒न्थिनो॑ विद॒न्मा",
      "start": 9.96,
      "end": 16.2
    },
    {
      "text": "त्वा॒ वृका॑ अघा॒यवो॒ मा",
      "start": 16.2,
      "end": 18.36
    },
    {
      "text": "ग॑न्ध॒र्वो वि॒श्वाव॑सु॒रा द॑घच्छ्ये॒नो भू॒त्वा",
      "start": 18.36,
      "end": 20.76
    },
    {
      "text": "परा॑ पत॒ यज॑मानस्य नो",
      "start": 20.76,
      "end": 20.76
    },
    {
      "text": "गृ॒हे दे॒वैः सꣳ॑स्कृ॒तं ॅयज॑मानस्य",
      "start": 20.76,
      "end": 20.76
    },
    {
      "text": "स्व॒स्त्यय॑न्य॒स्यपि॒ पन्था॑मगस्महि स्वस्ति॒गा-म॑ने॒हसं॒ ॅयेन॒",
      "start": 20.76,
      "end": 20.76
    },
    {
      "text": "विश्वाः॒ परि॒ द्विषो॑ वृ॒णक्ति॑",
      "start": 20.76,
      "end": 23.44
    },
    {
      "text": "वि॒न्दते॒ वसु॒ नमो॑ मि॒त्रस्य॒",
      "start": 23.44,
      "end": 28.04
    },
    {
      "text": "( ) वरु॑णस्य॒ चक्ष॑से",
      "start": 28.04,
      "end": 31.12
    },
    {
      "text": "म॒हो दे॒वाय॒ तदृ॒तꣳ स॑पर्यत",
      "start": 31.12,
      "end": 33.84
    },
    {
      "text": "दूरे॒दृशे॑ दे॒वजा॑ताय के॒तवे॑ दि॒वस्पु॒त्राय॒",
      "start": 33.84,
      "end": 41.56
    },
    {
      "text": "सूर्या॑य शꣳसत॒ वरु॑णस्य॒ स्कंभ॑नमसि॒",
      "start": 41.56,
      "end": 46.72
    },
    {
      "text": "वरु॑णस्य स्कंभ॒सर्ज॑न-म॒स्युन्मु॑क्तो॒ वरु॑णस्य॒ पाशः॑",
      "start": 46.72,
      "end": 57.84
    }
  ],
  "total_phrases": 15
