  "phrases": [
    {
      "text": "सोमं॑ ते क्रीणा॒म्यूर्ज॑स्वन्तं॒ पय॑स्वन्तं",
      "start": 0.0,
      "end": 4.72
    },
    {
      "text": "ॅवी॒र्या॑वन्तमभि-माति॒षाहꣳ॑ शु॒क्रं ते॑ शु॒क्रेण॑",
      "start": 4.72,
      "end": 9.68
    },
    {
      "text": "क्रीणामि च॒न्द्रं च॒न्द्रेणा॒मृत॑म॒मृते॑न स॒म्यत्ते॒",
      "start": 9.68,
      "end": 14.28
    },
    {
      "text": "गोर॒स्मे च॒न्द्राणि॒ तप॑सस्त॒नूर॑सि प्र॒जाप॑ते॒र्",
      "start": 14.28,
      "end": 22.48
    },
    {
      "text": "वर्ण॒स्तस्या᳚स्ते सहस्रपो॒षं पुष्य॑न्त्याश्चर॒मेण॑ प॒शुना᳚",
      "start": 22.48,
      "end": 34.28
    },
    {
      "text": "क्रीणाम्य॒स्मे ते॒ बन्धु॒र्मयि॑ ते॒",
      "start": 34.28,
      "end": 43.72
    },
    {
      "text": "रायः॑ श्रयन्ताम॒स्मे ज्योतिः॑ सोमविक्र॒यिणि॒",
      "start": 43.72,
      "end": 45.32
    },
    {
      "text": "तमो॑ मि॒त्रो न॒ एहि॒",
      "start": 45.32,
      "end": 45.32
    },
    {
      "text": "सुमि॑त्रधा॒ इन्द्र॑स्यो॒रु ( )",
      "start": 45.32,
      "end": 48.6
    },
    {
      "text": "मा वि॑श॒ दक्षि॑ण-मु॒शन्नु॒शन्तꣳ॑ स्यो॒नः",
      "start": 48.6,
      "end": 56.76
    },
    {
      "text": "स्यो॒नꣳ स्वान॒ भ्राजाङ्घा॑रे॒ बंभा॑रे॒",
      "start": 56.76,
      "end": 59.56
    },
    {
      "text": "हस्त॒ सुह॑स्त॒ कृशा॑नवे॒ते वः॑",
      "start": 59.56,
      "end": 59.56
    },
    {
      "text": "सोम॒ क्रय॑णा॒स्तान् र॑क्षद्ध्वं॒ मा",
      "start": 59.56,
      "end": 60.0
    },
    {
      "text": "वो॑ दभन्",
      "start": 60.0,
      "end": 61.56
    }
  ],
  "total_phrases": 14
}