    },
    {
      "text": "अ॒स्त्वथे॒मव॑ स्य॒ ( )",
      "start": 114.16,
      "end": 118.4
    },
    {
      "text": "वर॒ आ पृ॑थि॒व्या आ॒रे",
      "start": 118.4,
      "end": 121.56
    },
    {
      "text": "शत्रू᳚न् कृणुहि॒ सर्व॑वीर॒ एदम॑गन्म",
      "start": 121.56,
      "end": 124.68
    },
    {
      "text": "देव॒यज॑नं पृथि॒व्या विश्वे॑ दे॒वा",
      "start": 124.68,
      "end": 127.2
    },
    {
      "text": "यदजु॑षन्त॒ पूर्व॑ ऋख्सा॒माभ्यां॒ ॅयजु॑षा",
