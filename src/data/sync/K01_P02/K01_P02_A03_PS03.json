    {
      "text": "वा॒यवे᳚ त्वा॒ वरु॑णाय त्वा॒",
      "start": 84.08,
      "end": 84.08
    },
    {
      "text": "निर्.ऋ॑त्यै त्वा रु॒द्राय॑ त्वा॒",
      "start": 84.08,
      "end": 84.08
    },
    {
      "text": "देवी॑रापो अपां नपा॒द्य ऊ॒र्मिर्.",
      "start": 84.08,
      "end": 87.76
    },
    {
      "text": "ह॑वि॒ष्य॑ इन्द्रि॒यावा᳚न् म॒दिन्त॑म॒स्तं ॅवो॒",
      "start": 87.76,
      "end": 97.08
    },
    {
      "text": "माऽव॑ क्रमिष॒मच्छि॑न्नं॒ तन्तुं॑ पृथि॒व्या",
      "start": 97.08,
      "end": 103.68
    },
    {
      "text": "अनु॑ गेषं भ॒द्राद॒भि श्रेयः॒",
      "start": 103.68,
      "end": 107.48
    },
    {
      "text": "प्रेहि॒ बृह॒स्पतिः॑ पुरए॒ता ते॑",
