  "phrases": [
    {
      "text": "मयि॑ धेहि वृ॒त्रस्य॑ क॒नीनि॑काऽसि",
      "start": 38.2,
      "end": 43.64
    },
    {
      "text": "चक्षु॒ष्पा अ॑सि॒ चक्षु॑र्मे पाहि",
      "start": 43.64,
      "end": 50.64
    },
    {
      "text": "चि॒त्पति॑स्त्वा पुनातु वा॒क्पति॑स्त्वा पुनातु",
      "start": 50.64,
      "end": 53.28
    },
    {
      "text": "दे॒वस्त्वा॑ सवि॒ता पु॑ना॒त्वच्छि॑द्रेण प॒वित्रे॑ण॒",
      "start": 53.28,
      "end": 53.28
    },
    {
      "text": "वसोः॒ सूर्य॑स्य र॒श्मिभि॒स्तस्य॑ ते",
      "start": 53.28,
      "end": 57.0
    },
    {
      "text": "पवित्रपते प॒वित्रे॑ण॒ यस्मै॒ कं",
      "start": 57.0,
      "end": 61.84
    },
    {
      "text": "पु॒ने तच्छ॑केय॒मा वो॑ देवास",
      "start": 61.84,
      "end": 66.36
    },
    {
      "text": "ईमहे॒ सत्य॑धर्माणो अद्ध्व॒रे यद्वो॑",
      "start": 66.36,
      "end": 69.36
    },
    {
      "text": "देवास आगु॒रे यज्ञि॑यासो॒ हवा॑मह॒",
      "start": 69.36,
      "end": 75.4
    },
    {
      "text": "इन्द्रा᳚ग्नी॒ द्यावा॑पृथिवी॒ आप॑ ओषधी॒",
      "start": 75.4,
      "end": 82.2
    },
    {
      "text": "( ) स्त्वं दी॒क्षाणा॒-मधि॑पतिरसी॒ह",
      "start": 82.2,
      "end": 89.8
    },
    {
      "text": "मा॒ सन्तं॑ पाहि",
      "start": 89.8,
      "end": 93.92
    }
  ],
  "total_phrases": 12
