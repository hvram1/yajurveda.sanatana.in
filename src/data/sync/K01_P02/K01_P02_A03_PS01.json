  "phrases": [
    {
      "text": "दैवीं॒ धियं॑ मनामहे सुमृडी॒का-म॒भिष्ट॑ये",
      "start": 0.0,
      "end": 4.84
    },
    {
      "text": "वर्चो॒धां ॅय॒ज्ञ्वा॑हसꣳ सुपा॒रा नो॑",
      "start": 4.84,
      "end": 11.24
    },
    {
      "text": "अस॒द् वशे᳚",
      "start": 11.24,
      "end": 12.84
    },
    {
      "text": "ये दे॒वा मनो॑जाता मनो॒युजः॑",
      "start": 12.84,
      "end": 15.76
    },
    {
      "text": "सु॒दक्षा॒ दक्ष॑पितार॒स्ते नः॑ पान्तु॒",
      "start": 15.76,
      "end": 21.12
    },
    {
      "text": "ते नो॑ऽवन्तु॒ तेभ्यो॒ नम॒स्तेभ्यः॒",
      "start": 21.12,
      "end": 23.4
    },
    {
      "text": "स्वाहाऽग्ने॒ त्वꣳ सु जा॑गृहि",
      "start": 23.4,
      "end": 26.52
    },
    {
      "text": "व॒यꣳ सु म॑न्दिषीमहि गोपा॒य",
      "start": 26.52,
      "end": 29.84
    },
    {
      "text": "नः॑ स्व॒स्तये᳚ प्र॒बुधे॑ नः॒",
      "start": 29.84,
      "end": 35.32
    },
    {
      "text": "पुन॑र्ददः",
      "start": 35.32,
      "end": 35.8
    },
    {
      "text": "त्वम॑ग्ने व्रत॒पा अ॑सि दे॒व",
      "start": 35.8,
      "end": 39.48
    },
    {
      "text": "आ मर्त्ये॒ष्वा",
