  "phrases": [
    {
      "text": "वर्द्ध॑न्तु त्वा सुष्टु॒तयो॒ गिरो॑",
      "start": 128.04,
      "end": 133.8
    },
    {
      "text": "मे यू॒यं पा॑त स्व॒स्तिभिः॒",
      "start": 133.8,
      "end": 138.48
    },
    {
      "text": "सदा॑ नः",
      "start": 138.48,
      "end": 139.64
    },
    {
      "text": "प्र तत् ते॑ अ॒द्य",
      "start": 139.64,
      "end": 142.92
    },
    {
      "text": "शि॑पिविष्ट॒ नामा॒ऽर्यः शꣳ॑ सामि",
      "start": 142.92,
      "end": 146.44
    },
    {
      "text": "व॒युना॑नि वि॒द्वान्",
      "start": 146.44,
      "end": 149.56
    },
    {
      "text": "तन्त्वा॑ गृणामि त॒वस॒मत॑वीया॒न् क्षय॑न्तम॒स्य",
      "start": 149.56,
      "end": 160.72
    },
    {
      "text": "रज॑सः परा॒के",
      "start": 160.72,
      "end": 162.8
    },
    {
      "text": "किमित् ते॑ विष्णो परि॒चक्ष्यं॑",
      "start": 162.8,
      "end": 167.96
    },
    {
      "text": "भू॒त् प्र यद्व॑व॒क्षे शि॑पिवि॒ष्टो",
      "start": 167.96,
      "end": 175.76
    },
    {
      "text": "अ॑स्मि",
      "start": 175.76,
      "end": 177.52
    },
    {
      "text": "मा वर्पो॑ अ॒स्मदप॑ गूह",
      "start": 177.52,
      "end": 180.96
    },
    {
      "text": "ए॒तद्यद॒न्यरू॑पः समि॒थे ब॒भूथ॑",
