  "phrases": [
    {
      "text": "-परि॑ष्टादिन्द्रि॒येणै॒वास्मा॑ उभ॒यतः॑ सजा॒तान् परि॑",
      "start": 110.56,
      "end": 113.6
    },
    {
      "text": "गृह्णात्युपाधा॒य्य॑ पूर्वयं॒ ॅवासो॒ दक्षि॑णा",
      "start": 113.6,
      "end": 116.68
    },
    {
      "text": "सजा॒ताना॒मुप॑हित्यै॒ पृश्नि॑यै दु॒ग्धे प्रैय॑ङ्गवं",
      "start": 116.68,
      "end": 121.32
    },
    {
      "text": "च॒रुं निर्व॑पेन्म॒रुद्भ्यो॒ ग्राम॑कामः॒ पृश्नि॑यै॒",
      "start": 121.32,
      "end": 130.12
    },
    {
      "text": "वै पय॑सो म॒रुतो॑ जा॒ताः",
      "start": 130.12,
      "end": 132.8
    },
    {
      "text": "पृश्नि॑यै प्रि॒यङ्ग॑वो मारु॒ताः खलु॒",
      "start": 132.8,
      "end": 138.4
    },
    {
      "text": "वै दे॒वत॑या सजा॒ता म॒रुत॑",
      "start": 138.4,
      "end": 141.16
    },
    {
      "text": "ए॒व स्वेन॑ भाग॒धेये॒नोप॑ धावति॒",
      "start": 141.16,
      "end": 146.72
    },
    {
      "text": "त ए॒वास्मै॑ सजा॒तान् प्रय॑च्छन्ति",
      "start": 146.72,
      "end": 150.16
    },
    {
      "text": "ग्रा॒म्ये॑व भ॑वति प्रि॒यव॑ती याज्यानुवा॒क्ये॑",
      "start": 150.16,
      "end": 150.16
    },
