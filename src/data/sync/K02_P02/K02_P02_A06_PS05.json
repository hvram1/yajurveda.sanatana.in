  "phrases": [
    {
      "text": "प्र॒युज्य॒ न वि॑मु॒ञ्चत्य॑प्रतिष्ठा॒नो वै",
      "start": 135.0,
      "end": 140.72
    },
    {
      "text": "स भ॑वत्ये॒तमे॒व वै᳚श्वान॒रं पुन॑रा॒गत्य॒",
      "start": 140.72,
      "end": 146.52
    },
    {
      "text": "निर्व॑पे॒द्यमे॒व प्र॑यु॒ङ्क्ते तं भा॑ग॒धेये॑न॒",
      "start": 146.52,
      "end": 153.04
    },
    {
      "text": "वि मु॑ञ्चति॒ प्रति॑ष्ठित्यै॒ यया॒",
      "start": 153.04,
      "end": 158.04
    },
    {
      "text": "रज्वो᳚त्त॒मां गामा॒जेत् तां भ्रातृ॑व्याय॒",
      "start": 158.04,
      "end": 163.32
    },
    {
      "text": "प्र हि॑णुया॒न्निर्.ऋ॑तिमे॒वास्मै॒ प्र हि॑णोति",
