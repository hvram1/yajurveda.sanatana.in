  "phrases": [
    {
      "text": "आ॒दि॒त्यं च॒रुं निर्व॑पेथ् संग्रा॒म-मु॑पप्रया॒स्यन्नि॒यं",
      "start": 0.0,
      "end": 12.16
    },
    {
      "text": "ॅवा अदि॑तिर॒स्यामे॒व पूर्वे॒ प्रति॑तिष्ठन्ति",
      "start": 12.16,
      "end": 18.24
    },
    {
      "text": "वैश्वान॒रं द्वाद॑शकपालं॒ निर्व॑पेदा॒यत॑नं ग॒त्वासं॑ॅवथ्स॒रो",
      "start": 18.24,
      "end": 22.44
    },
    {
      "text": "वा अ॒ग्नि र्वै᳚श्वान॒रः सं॑ॅवथ्स॒रः",
      "start": 22.44,
      "end": 22.44
    },
    {
      "text": "खलु॒ वै दे॒वाना॑-मा॒यत॑नमे॒तस्मा॒द्वा आ॒यत॑नाद्-दे॒वा",
      "start": 22.44,
      "end": 22.44
    },
    {
      "text": "असु॑रानजय॒न॒. यद्-वै᳚श्वान॒रं द्वाद॑शकपालं नि॒र्वप॑ति",
      "start": 22.44,
      "end": 22.44
    },
    {
      "text": "दे॒वाना॑मे॒वायत॑ने यतते॒ जय॑ति॒ तꣳ",
      "start": 22.44,
      "end": 22.44
    },
    {
      "text": "स॑ग्रां॒ममे॒तस्मि॒न् वा ए॒तौ मृ॑जाते॒",
      "start": 22.44,
      "end": 22.44
    },
