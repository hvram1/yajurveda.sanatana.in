    {
      "text": "प्र॒जापतिः॑ प्र॒जा अ॑सृजत॒ ताः",
      "start": 0.0,
      "end": 4.68
    },
    {
      "text": "सृ॒ष्टा॒ इन्द्रा॒ग्नी अपा॑गूहताꣳ॒॒ सो॑ऽचायत्",
      "start": 4.68,
      "end": 11.28
    },
    {
      "text": "प्र॒जाप॑तिरिन्द्रा॒ग्नी वै मे᳚ प्र॒जा",
      "start": 11.28,
      "end": 17.44
    },
    {
      "text": "अपा॑घुक्षता॒मिति॒ स ए॒तमै᳚न्द्रा॒ग्न- मेका॑दशकपाल-मपश्य॒त्",
      "start": 17.44,
      "end": 29.52
    },
    {
      "text": "तं निर॑वप॒त् ताव॑स्मै प्र॒जाः",
      "start": 29.52,
      "end": 33.8
    },
    {
      "text": "प्रासा॑धयता- मिन्द्रा॒ग्नी वा ए॒तस्य॑",
      "start": 33.8,
      "end": 35.52
    },
    {
      "text": "प्र॒जामप॑ गूहतो॒ योऽलं॑ प्र॒जायै॒",
      "start": 35.52,
      "end": 35.52
    },
    {
      "text": "सन् प्र॒जां न वि॒न्दत॑",
      "start": 35.52,
      "end": 35.52
    },
    {
