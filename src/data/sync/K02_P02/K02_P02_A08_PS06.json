  "phrases": [
    {
      "text": "सो॑ऽभव॒थ् सो॑ऽबिभेद्-भू॒तः प्र मा॑",
      "start": 165.6,
      "end": 171.12
    },
    {
      "text": "धक्ष्य॒तीति॒ स प्र॒जाप॑तिं॒ पुन॒रुपा॑धाव॒थ्",
      "start": 171.12,
      "end": 177.04
    },
    {
      "text": "स प्र॒जाप॑तिः॒ शक्व॑र्या॒ अधि॑",
      "start": 177.04,
      "end": 183.92
    },
    {
      "text": "रे॒वतीं॒ निर॑मिमीत॒ शान्त्या॒ अप्र॑दाहाय॒",
      "start": 183.92,
      "end": 190.92
    },
    {
      "text": "योऽलꣳ॑ श्रि॒यै सन्थ्-स॒दृङ्ख्स॑मा॒नैः स्यात्",
      "start": 190.92,
      "end": 195.2
    },
    {
      "text": "तस्मा॑ ए॒तमै॒न्द्रमेका॑दशकपालं॒ निर्व॑पे॒दिन्द्र॑मे॒व स्वेन॑",
      "start": 195.2,
      "end": 195.2
    },
    {
      "text": "भाग॒धेये॒नोप॑ धावति॒ स ए॒वास्मि॑न्निन्द्रि॒यं",
      "start": 195.2,
      "end": 195.2
    },
    {
      "text": "द॑धाति रे॒वती॑ पुरोऽनुवा॒क्या॑ भवति॒",
      "start": 195.2,
      "end": 195.2
    },
    {
      "text": "( ) शान्त्या॒ अप्र॑दाहाय॒",
      "start": 195.2,
      "end": 195.2
    },
    {
      "text": "शक्व॑री या॒ज्या॑ वज्रो॒ वै",
      "start": 195.2,
      "end": 195.2
    },
    {
      "text": "शक्व॑री॒स ए॑नं॒ ॅवज्रो॒ भूत्या॑",
      "start": 195.2,
      "end": 195.2
    },
    {
      "text": "इन्धे॒ भव॑त्ये॒व",
      "start": 195.2,
      "end": 198.0
    }
  ],
