  "phrases": [
    {
      "text": "प्रति॒गृह्य॑ संवथ्स॒रो वा अ॒ग्निर्वै᳚श्वान॒रः",
      "start": 118.56,
      "end": 125.04
    },
    {
      "text": "सं॑ॅवथ्स॒र-स्व॑दितमे॒व प्रति॑ गृह्णाति॒ नात्मनो॒",
      "start": 125.04,
      "end": 130.8
    },
    {
      "text": "मात्रा॑माप्नोति वैश्वान॒रं द्वाद॑शकपालं॒ निर्व॑पेथ्-स॒निमे॒ष्यन्थ्-सं॑ॅवथ्स॒रो",
      "start": 130.8,
      "end": 130.8
    },
    {
      "text": "वा अ॒ग्निर्वै᳚श्वान॒रो य॒दा खलु॒",
      "start": 130.8,
      "end": 130.8
    },
    {
      "text": "वै सं॑ॅवथ्स॒रं ज॒नता॑यां॒ चर॒त्यथ॒",
      "start": 130.8,
      "end": 130.8
    },
    {
      "text": "स ध॑ना॒र्घो भ॑वति॒यद्-वै᳚श्वान॒रं द्वाद॑शकपालं",
      "start": 130.8,
      "end": 130.8
    },
    {
      "text": "नि॒र्वप॑ति संॅवथ्स॒र-सा॑तामे॒व स॒निम॒भि प्रच्य॑वते॒",
      "start": 130.8,
      "end": 130.8
    },
    {
      "text": "दान॑कामा अस्मै प्र॒जा भ॑वन्ति॒",
      "start": 130.8,
      "end": 132.16
    },
    {
      "text": "यो वै सं॑ॅवथ्स॒रं -",
      "start": 132.16,
      "end": 135.0
    },
