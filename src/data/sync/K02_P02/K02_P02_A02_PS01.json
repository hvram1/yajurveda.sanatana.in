  "phrases": [
    {
      "text": "अ॒ग्नये॑ पथि॒कृते॑ पुरो॒डाश॑-म॒ष्टाक॑पालं॒ निर्व॑पे॒द्यो",
      "start": 0.0,
      "end": 9.92
    },
    {
      "text": "द॑र्.शपूर्णमासया॒जी सन्न॑मावा॒स्यां᳚ ॅवा पौर्णमा॒सीं",
      "start": 9.92,
      "end": 19.4
    },
    {
      "text": "ॅवा॑ऽतिपा॒दये᳚त् प॒थो वा ए॒षोद्ध्यप॑थेनैति॒",
      "start": 19.4,
      "end": 26.16
    },
    {
      "text": "यो द॑र्.शपूर्णमासया॒जी सन्न॑मावा॒स्यां᳚ ॅवा",
      "start": 26.16,
      "end": 31.72
    },
    {
      "text": "पौर्णमा॒सीं ॅवा॑तिपा॒दय॑त्य॒ग्निमे॒व प॑थि॒कृतꣳ॒॒ स्वेन॑",
      "start": 31.72,
      "end": 32.84
    },
    {
      "text": "भाग॒धेये॒नोप॑ धावति॒ स ए॒वैन॒मप॑था॒त्",
      "start": 32.84,
      "end": 35.68
    },
    {
      "text": "पन्था॒मपि॑ नयत्यन॒ड्वान् दक्षि॑णा व॒ही",
      "start": 35.68,
      "end": 41.84
    },
    {
      "text": "ह्ये॑ष समृ॑द्ध्या अ॒ग्नये᳚ व्र॒तप॑तये",
      "start": 41.84,
      "end": 46.24
    },
