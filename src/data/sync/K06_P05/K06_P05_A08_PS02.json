    {
      "text": "ॅलो॒कम॑जिगाꣳस॒न् ते सु॑व॒र्गं ॅलो॒कं",
      "start": 43.64,
      "end": 52.6
    },
    {
      "text": "न प्राजा॑न॒न् त ए॒तं",
      "start": 52.6,
      "end": 55.4
    },
    {
      "text": "पा᳚त्नीव॒तम॑पश्य॒न् तम॑गृह्णत॒ ततो॒ वै",
      "start": 55.4,
      "end": 63.04
    },
    {
      "text": "ते सु॑व॒र्गं ॅलो॒कं प्राजा॑न॒न्॒.",
      "start": 63.04,
      "end": 67.4
    },
    {
      "text": "यत् पा᳚त्नीव॒तो गृ॒ह्यते॑ सुव॒र्गस्य॑",
      "start": 67.4,
      "end": 71.76
    },
    {
      "text": "लो॒कस्य॒ प्रज्ञा᳚त्यै॒ स सोमो॒",
      "start": 71.76,
      "end": 75.88
    },
    {
      "text": "नाति॑ष्ठत स्त्री॒भ्यो गृ॒ह्यमा॑ण॒स्तं घृ॒तं",
      "start": 75.88,
      "end": 80.0
    },
    {
      "text": "ॅवज्रं॑ कृ॒त्वाऽघ्न॒न् तं निरि॑न्द्रियं",
      "start": 80.0,
      "end": 80.0
    },
    {
      "text": "भू॒तम॑गृह्ण॒न् तस्मा॒थ् स्त्रियो॒ निरि॑न्द्रिया॒",
      "start": 80.0,
      "end": 80.0
    },
    {
      "text": "अदा॑यादी॒रपि॑ पा॒पात् पुꣳ॒॒स उप॑स्तितरं-",
