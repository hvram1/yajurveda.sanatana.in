  "phrases": [
    {
      "text": "नेष्टः॒ पत्नी॑-मु॒दान॒येत्या॑हा॒-ग्नीदे॒व नेष्ट॑रि॒ रेतो॒",
      "start": 184.6,
      "end": 184.6
    },
    {
      "text": "दधा॑ति॒ नेष्टा॒ पत्नि॑यामुद्-गा॒त्रा सं",
      "start": 184.6,
      "end": 184.6
    },
    {
      "text": "ख्या॑पयति प्र॒जाप॑ति॒र्वा ए॒ष यदु॑द्गा॒ता",
      "start": 184.6,
      "end": 193.68
    },
    {
      "text": "प्र॒जानां᳚ प्र॒जन॑नाया॒प उप॒ प्र",
      "start": 193.68,
      "end": 201.68
    },
    {
      "text": "व॑र्तयति॒ रेत॑ ए॒व तथ्",
      "start": 201.68,
      "end": 204.12
    },
    {
      "text": "सि॑ञ्चत्यू॒रुणोप॒ प्र व॑र्तयत्यू॒रुणा॒ हि",
      "start": 204.12,
      "end": 212.68
    },
    {
      "text": "रेतः॑ सि॒च्यते॑ नग्नं॒ कृत्यो॒-रुमुप॒",
      "start": 212.68,
      "end": 216.8
    },
    {
      "text": "प्र व॑र्तयति य॒दा हि",
      "start": 216.8,
      "end": 216.8
    },
    {
      "text": "न॒ग्न ऊ॒रुर्भव॒त्यथ॑ मिथु॒नी (",
      "start": 216.8,
      "end": 220.72
    },
    {
      "text": ") भ॑व॒तोऽथ॒ रेतः॑ सिच्य॒तेऽथ॑",
      "start": 220.72,
      "end": 227.4
    },
    {
      "text": "प्र॒जाः प्र जा॑यन्ते",
      "start": 227.4,
      "end": 232.52
