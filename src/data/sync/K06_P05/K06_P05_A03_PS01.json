  "phrases": [
    {
      "text": "य॒ज्ञेन॒ वै दे॒वाः सु॑व॒र्गं",
      "start": 0.0,
      "end": 5.44
    },
    {
      "text": "ॅलो॒कमा॑य॒न् ते॑ऽमन्यन्त मनु॒ष्या॑ नो॒ऽन्वाभ॑विष्य॒न्तीति॒",
      "start": 5.44,
      "end": 15.68
    },
    {
      "text": "ते सं॑ॅवथ्स॒रेण॑ योपयि॒त्वा सु॑व॒र्गं",
      "start": 15.68,
      "end": 23.96
    },
    {
      "text": "ॅलो॒कमा॑य॒न् तमृष॑य ऋतुग्र॒हैरे॒वानु॒ प्राजा॑न॒न॒.",
      "start": 23.96,
      "end": 23.96
    },
    {
      "text": "यदृ॑तुग्र॒हा गृ॒ह्यन्ते॑ सुव॒र्गस्य॑ लो॒कस्य॒",
      "start": 23.96,
      "end": 25.64
    },
    {
      "text": "प्रज्ञा᳚त्यै॒ द्वाद॑श गृह्यन्ते॒ द्वाद॑श॒",
      "start": 25.64,
      "end": 34.0
    },
    {
      "text": "मासाः᳚ संॅवथ्स॒रः सं॑ॅवथ्स॒रस्य॒ प्रज्ञा᳚त्यै",
      "start": 34.0,
      "end": 38.8
    },
    {
      "text": "स॒ह प्र॑थ॒मौ गृ॑ह्येते स॒होत्त॒मौ",
      "start": 38.8,
      "end": 44.92
    },
    {
      "text": "तस्मा॒द् द्वौद्वा॑वृ॒तू उ॑भ॒यतो॑मुख-मृतुपा॒त्रं भ॑वति॒",
      "start": 44.92,
      "end": 52.04
    },
    {
      "text": "को- [ ]",
      "start": 52.04,
      "end": 52.04
    }
  ],
