  "phrases": [
    {
      "text": "आयु॒र्वा ए॒तद्-य॒ज्ञ्स्य॒ यद् ध्रु॒व",
      "start": 0.0,
      "end": 5.0
    },
    {
      "text": "उ॑त्त॒मो ग्रहा॑णां गृह्यते॒ तस्मा॒दायुः॑",
      "start": 5.0,
      "end": 10.6
    },
    {
      "text": "प्रा॒णाना॑मुत्त॒मं मू॒र्द्धानं॑ दि॒वो अ॑र॒तिं",
      "start": 10.6,
      "end": 14.36
    },
    {
      "text": "पृ॑थि॒व्या इत्या॑ह मू॒र्द्धान॑मे॒वैनꣳ॑ समा॒नानां᳚",
      "start": 14.36,
      "end": 14.76
    },
    {
      "text": "करोति वैश्वान॒रमृ॒ताय॑ जा॒तम॒ग्निमित्या॑ह वैश्वान॒रꣳ",
      "start": 14.76,
      "end": 23.84
    },
    {
      "text": "हि दे॒वत॒याऽऽयु॑रुभ॒यतो॑ वैश्वानरो गृह्यते॒",
      "start": 23.84,
      "end": 29.28
    },
    {
      "text": "तस्मा॑दुभ॒यतः॑ प्रा॒णा अ॒धस्ता᳚-च्चो॒परि॑ष्टा-च्चा॒र्द्धिनो॒ऽन्ये ग्रहा॑",
      "start": 29.28,
      "end": 39.72
    },
    {
      "text": "गृ॒ह्यन्ते॒ऽर्द्धी ध्रु॒वस्तस्मा॑- [ ]",
      "start": 39.72,
      "end": 50.8
    }
  ],
