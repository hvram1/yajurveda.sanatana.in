    {
      "text": "एनं प॒शवो॑ भु॒ञ्जन्त॒ उप॑तिष्ठेर॒न्॒.",
      "start": 111.08,
      "end": 115.28
    },
    {
      "text": "यन्न स॑भिं॒न्द्याद्-ब॒हव॑ एनं प॒शवोऽभु॑ञ्जन्त॒",
      "start": 115.28,
      "end": 121.56
    },
    {
      "text": "उप॑ तिष्ठेर॒न् मन॑सा॒ सं",
      "start": 121.56,
      "end": 123.44
    },
    {
      "text": "बा॑धत उ॒भयं॑ करोति ब॒हव॑",
      "start": 123.44,
      "end": 127.32
    },
    {
      "text": "ए॒वैनं॑ प॒शवो॑ भु॒ञ्जन्त॒ उप॑",
      "start": 127.32,
      "end": 132.88
    },
    {
      "text": "तिष्ठन्त उन्ने॒तर्यु॑पह॒वमि॑च्छन्ते॒ य ए॒व",
      "start": 132.88,
      "end": 135.92
    },
    {
      "text": "तत्र॑ सोमपी॒थस्तमे॒वाव॑ रुन्धत उत्तरवे॒द्यां",
      "start": 135.92,
      "end": 135.92
    },
    {
      "text": "निव॑पति प॒शवो॒ वा उ॑त्तरवे॒दिः",
      "start": 135.92,
      "end": 141.52
    },
    {
      "text": "प॒शवो॑ हारियोज॒नीः प॒शुष्वे॒व प॒शून्",
      "start": 141.52,
      "end": 149.4
    },
    {
      "text": "प्रति॑ ष्ठापयन्ति ( )",
      "start": 149.4,
      "end": 151.28
    }
