    {
      "text": "इन्द्रो॑ म॒रुद्भिः॒ सांॅवि॑द्येन॒ माद्ध्य॑न्दिने॒",
      "start": 0.0,
      "end": 4.12
    },
    {
      "text": "सव॑ने वृ॒त्रम॑ह॒न्॒. यन्माद्ध्य॑न्दिने॒ सव॑ने",
      "start": 4.12,
      "end": 4.12
    },
    {
      "text": "मरुत्व॒तीया॑ गृ॒ह्यन्ते॒ वार्त्र॑घ्ना ए॒व",
      "start": 4.12,
      "end": 4.12
    },
    {
      "text": "ते यज॑मानस्य गृह्यन्ते॒ तस्य॑",
      "start": 4.12,
      "end": 4.12
    },
    {
      "text": "वृ॒त्रं ज॒घ्नुष॑ ऋ॒तवो॑ऽमुह्य॒न्थ्स ऋ॑तुपा॒त्रेण॑",
      "start": 4.12,
      "end": 7.36
    },
    {
