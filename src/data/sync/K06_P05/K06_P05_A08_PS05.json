  "phrases": [
    {
      "text": "वद्ध्यं॒ प्रप॑न्नं॒ न प्रति॒",
      "start": 161.4,
      "end": 167.4
    },
    {
      "text": "प्रय॑च्छन्ति॒ तस्मा᳚त् पात्नीव॒ते त्वष्ट्रेऽपि॑",
      "start": 167.4,
      "end": 174.36
    },
    {
      "text": "गृह्यते॒ न सा॑दय॒त्यस॑न्ना॒द्धि प्र॒जाः",
      "start": 174.36,
      "end": 181.68
    },
    {
      "text": "प्र॒जाय॑न्ते॒ नानु॒ वष॑ट् करोति॒",
      "start": 181.68,
      "end": 184.6
    },
    {
      "text": "यद॑नुवषट् कु॒र्याद्-रु॒द्रं प्र॒जा अ॒न्वव॑सृजे॒द्-यन्नानु॑वषट्कु॒र्या-दशा᳚न्त-म॒ग्नीथ्",
      "start": 184.6,
      "end": 184.6
    },
    {
      "text": "सोमं॑ भक्षयेदुपाꣳ॒॒श्वनु॒ वष॑ट् करोति॒",
      "start": 184.6,
      "end": 184.6
    },
    {
      "text": "न रु॒द्रं प्र॒जा अ॑न्ववसृ॒जति॑",
      "start": 184.6,
      "end": 184.6
    },
    {
      "text": "शा॒न्तम॒ग्नीथ् सोमं॑ भक्षय॒त्यग्नी॒-न्नेष्टु॑रु॒पस्थ॒मा सी॑द॒-",
      "start": 184.6,
      "end": 184.6
    },
    {
      "text": "[ ]",
      "start": 184.6,
      "end": 184.6
    }
