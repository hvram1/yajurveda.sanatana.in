    {
      "text": "अदि॑तिः पु॒त्रका॑मा सा॒द्ध्येभ्यो॑ दे॒वेभ्यो᳚",
      "start": 0.0,
      "end": 9.72
    },
    {
      "text": "ब्रह्मौद॒नम॑पच॒त् तस्या॑ उ॒च्छेष॑णमददु॒स्तत् प्राश्ना॒थ्",
      "start": 9.72,
      "end": 21.64
    },
    {
      "text": "सा रेतो॑ऽधत्त॒ तस्यै॑ च॒त्वार॑",
      "start": 21.64,
      "end": 26.8
    },
    {
      "text": "आदि॒त्या अ॑जायन्त॒ सा द्वि॒तीय॑मपच॒थ्",
      "start": 26.8,
      "end": 31.92
    },
    {
      "text": "साऽम॑न्यतो॒च्छेष॑णान्म इ॒मे᳚ऽज्ञ्त॒ यदग्रे᳚ प्राशि॒ष्यामी॒तो",
      "start": 31.92,
      "end": 31.92
    },
    {
      "text": "मे॒ वसी॑याꣳसो जनिष्यन्त॒ इति॒",
      "start": 31.92,
      "end": 31.92
    },
    {
      "text": "साऽग्रे॒ प्राश्ना॒थ् सा रेतो॑ऽधत्त॒",
      "start": 31.92,
      "end": 31.92
    },
    {
