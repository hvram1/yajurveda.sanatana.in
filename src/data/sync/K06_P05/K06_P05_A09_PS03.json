  "phrases": [
    {
      "text": "घा॒सं प्र य॑च्छेत् प्र॒हृत्य॑",
      "start": 77.08,
      "end": 79.32
    },
    {
      "text": "परि॒धीञ्जु॑होति॒ निरा॑धानाभ्यामे॒व घा॒सं प्र",
      "start": 79.32,
      "end": 83.08
    },
    {
      "text": "य॑च्छत्युन्ने॒ता जु॑होति या॒तया॑मेव॒ ह्ये॑तर्ह्य॑द्ध्व॒र्युः",
      "start": 83.08,
      "end": 85.48
    },
    {
      "text": "स्व॒गाकृ॑तो॒ यद॑द्ध्व॒र्युर्जु॑हु॒याद्-यथा॒ विमु॑क्तं॒ पुन॑र्यु॒नक्ति॑",
      "start": 85.48,
      "end": 98.8
    },
    {
      "text": "ता॒दृगे॒व तच्छी॒र्॒.ष-न्न॑धिनि॒धाय॑ जुहोति शीर्.ष॒तो",
      "start": 98.8,
      "end": 106.48
    },
    {
      "text": "हि स स॒मभ॑वद्-वि॒क्रम्य॑ जुहोति",
      "start": 106.48,
      "end": 111.08
    },
    {
      "text": "वि॒क्रम्य॒ हीन्द्रो॑ वृ॒त्रमह॒न्थ् समृ॑द्ध्यै",
      "start": 111.08,
      "end": 111.08
    },
    {
      "text": "प॒शवो॒ वै हा॑रियोज॒नीर्यथ् स॑भिं॒न्द्यादल्पा॑-",
      "start": 111.08,
      "end": 111.08
    },
    {
      "text": "[ ]",
      "start": 111.08,
      "end": 111.08
    }
  ],
