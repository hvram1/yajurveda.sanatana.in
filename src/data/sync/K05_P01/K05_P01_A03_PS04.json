  "phrases": [
    {
      "text": "ॅवेद॒ मन॑सा॒ त्वै तामाप्तु॑मर्.हति॒",
      "start": 112.36,
      "end": 115.72
    },
    {
      "text": "याम॑द्ध्व॒र्युर॑-न॒ग्नावाहु॑तिं जु॒होति॒ मन॑स्वतीभ्यां जुहो॒त्याहु॑त्यो॒राप्त्यै॒",
      "start": 115.72,
      "end": 115.72
    },
    {
      "text": "द्वाभ्यां॒ प्रति॑ष्ठित्यै यज्ञ्मु॒खे य॑ज्ञ्मुखे॒",
      "start": 115.72,
      "end": 115.72
    },
    {
      "text": "वै क्रि॒यमा॑णे य॒ज्ञ्ꣳ रक्षाꣳ॑सि",
      "start": 115.72,
      "end": 115.72
    },
    {
      "text": "जिघाꣳ सन्त्ये॒तर्.हि॒ खलु॒ वा",
      "start": 115.72,
      "end": 117.88
    },
    {
      "text": "ए॒तद्-य॑ज्ञ्मु॒खं ॅयर्.ह्ये॑न॒दाहु॑तिरश्नु॒ते परि॑ लिखति॒",
      "start": 117.88,
      "end": 128.48
    },
    {
      "text": "रक्ष॑सा॒मप॑हत्यै ति॒सृभिः॒ परि॑ लिखति",
      "start": 128.48,
      "end": 135.72
    },
    {
      "text": "त्रि॒वृद्वा अ॒ग्निर्यावा॑ने॒वा-ऽग्निस्तस्मा॒द्-रक्षाꣳ॒॒स्यप॑ हन्ति -",
      "start": 135.72,
      "end": 145.44
