    {
      "text": "-ह॒ समृ॑द्ध्यै च॒तुर्भि॒रभ्रि॒मा द॑त्ते",
      "start": 116.36,
      "end": 123.28
    },
    {
      "text": "च॒त्वारि॒ छन्दाꣳ॑सि॒ छन्दो॑भिरे॒व दे॒वस्य॑",
      "start": 123.28,
      "end": 130.72
    },
    {
      "text": "त्वा सवि॒तुः प्र॑स॒व इत्या॑ह॒",
      "start": 130.72,
      "end": 136.16
    },
    {
      "text": "प्रसू᳚त्या अ॒ग्निर्दे॒वेभ्यो॒ निला॑यत॒ स",
      "start": 136.16,
      "end": 140.12
    },
    {
      "text": "वेणुं॒ प्राऽवि॑श॒थ् स ए॒तामू॒तिमनु॒",
      "start": 140.12,
      "end": 143.52
    },
    {
      "text": "सम॑चर॒द्-यद्-वेणोः᳚ सुषि॒रꣳ सु॑षि॒रा-ऽभ्रि॑र्भवति सयोनि॒त्वाय॒",
      "start": 143.52,
      "end": 153.2
    },
    {
      "text": "स यत्र॑य॒त्राऽव॑स॒त् तत् कृ॒ष्णम॑भवत्",
      "start": 153.2,
      "end": 153.2
    },
    {
      "text": "कल्मा॒षी भ॑वति रू॒पस॑मृद्ध्या उभयतः॒",
      "start": 153.2,
      "end": 153.2
    },
    {
      "text": "क्ष्णूर्भ॑वती॒तश्चा॒ऽ-( ) -मुत॑श्चा॒ऽर्कस्या-व॑रुद्ध्यै व्याममा॒त्री",
      "start": 153.2,
      "end": 153.2
    },
    {
      "text": "भ॑वत्ये॒ताव॒द्वै पुरु॑षे वी॒र्यं॑ ॅवी॒र्य॑सम्मि॒ता",
      "start": 153.2,
      "end": 153.2
    },
    {
      "text": "ऽप॑रिमिता भव॒त्य-प॑रिमित॒स्याऽ व॑रुद्ध्यै॒ यो",
      "start": 153.2,
      "end": 153.2
    },
    {
      "text": "वन॒स्पती॑नां फल॒ग्रहिः॒ स ए॑षां",
