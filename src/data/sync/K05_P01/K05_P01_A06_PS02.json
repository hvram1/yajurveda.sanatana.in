  "phrases": [
    {
      "text": "-नꣳ॒॒ सꣳ सृ॑जति॒ शान्त्यै॒",
      "start": 36.32,
      "end": 41.76
    },
    {
      "text": "यद्ग्रा॒म्याणां॒ पात्रा॑णां क॒पालैः᳚ सꣳसृ॒जेद्-ग्रा॒म्याणि॒",
      "start": 41.76,
      "end": 52.88
    },
    {
      "text": "पात्रा॑णि शु॒चाऽर्प॑येदर्मकपा॒लैः सꣳ सृ॑जत्ये॒तानि॒",
      "start": 52.88,
      "end": 58.76
    },
    {
      "text": "वा अ॑नुपजीवनी॒यानि॒ तान्ये॒व शु॒चाऽर्प॑यति॒",
      "start": 58.76,
      "end": 62.04
    },
    {
      "text": "शर्क॑राभिः॒ सꣳ सृ॑जति॒ धृत्या॒",
      "start": 62.04,
      "end": 66.52
    },
    {
      "text": "अथो॑ श॒त्वांया॑ जलो॒मैः सꣳ",
      "start": 66.52,
      "end": 71.44
    },
    {
      "text": "सृ॑जत्ये॒षा वा अ॒ग्नेः प्रि॒या",
      "start": 71.44,
      "end": 75.32
    },
    {
      "text": "त॒नूर्यद॒जा प्रि॒ययै॒वैनं॑ त॒नुवा॒ सꣳ",
      "start": 75.32,
      "end": 78.36
    },
    {
      "text": "सृ॑ज॒त्यथो॒ तेज॑सा कृष्णाजि॒नस्य॒ लोम॑भिः॒",
      "start": 78.36,
      "end": 84.8
    },
    {
      "text": "सꣳ - [ ]",
