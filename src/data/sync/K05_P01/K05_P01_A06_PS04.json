  "phrases": [
    {
      "text": "प॒दे अथो॒ प्रति॑ष्ठित्यै॒ प्रान्याभि॒-र्यच्छ॒त्यन्व॒न्यै-र्म॑न्त्रयते",
      "start": 109.68,
      "end": 124.2
    },
    {
      "text": "मिथुन॒त्वाय॒ त्र्यु॑द्धिं करोति॒ त्रय॑",
      "start": 124.2,
      "end": 129.36
    },
    {
      "text": "इ॒मे लो॒का ए॒षां ॅलो॒काना॒माप्त्यै॒",
      "start": 129.36,
      "end": 129.36
    },
    {
      "text": "छन्दो॑भिः करोति वी॒र्यं॑ ॅवै",
      "start": 129.36,
      "end": 129.36
    },
    {
      "text": "छन्दाꣳ॑सि वी॒र्ये॑णै॒वैनां᳚ करोति॒ यजु॑षा॒",
      "start": 129.36,
      "end": 129.36
    },
    {
      "text": "बिलं॑ करोति॒ व्यावृ॑त्त्या॒ इय॑तीं",
      "start": 129.36,
      "end": 129.36
    },
    {
      "text": "करोति प्र॒जाप॑तिना यज्ञ्मु॒खेन॒ संमि॑तां",
      "start": 129.36,
      "end": 129.36
    },
    {
      "text": "द्विस्त॒नां क॑रोति॒ यावा॑पृथि॒व्योर्दोहा॑य॒ चतुः॑स्तनां",
      "start": 129.36,
      "end": 129.36
    },
    {
      "text": "करोति पशू॒नां दोहा॑या॒ष्टास्त॑नां करोति॒",
      "start": 129.36,
      "end": 129.36
    },
    {
      "text": "छन्द॑सां॒ दोहा॑य॒ नवा᳚श्रि-मभि॒चर॑तः (",
      "start": 129.36,
      "end": 133.04
    },
    {
      "text": ") कुर्यात् त्रि॒वृत॑मे॒व वज्रꣳ॑",
      "start": 133.04,
      "end": 137.72
    },
    {
      "text": "स॒भृंत्य॒ भ्रातृ॑व्याय॒ प्रह॑रति॒ स्तृत्यै॑",
      "start": 137.72,
      "end": 150.48
    },
    {
      "text": "कृ॒त्वाय॒ सा म॒हीमु॒खामिति॒ नि",
      "start": 150.48,
      "end": 150.52
    },
    {
      "text": "द॑धाति दे॒वता᳚स्वे॒वैनां॒ प्रति॑ष्ठापयति",
      "start": 150.52,
      "end": 161.12
    }
  ],
  "total_phrases": 14
}