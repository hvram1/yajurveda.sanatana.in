  "phrases": [
    {
      "text": "प्रा॒णैर्दा॑धा॒रा ऽऽसी॑नः॒ प्रति॑मुञ्चते॒ तस्मा॒दासी॑नाः",
      "start": 137.36,
      "end": 146.56
    },
    {
      "text": "प्र॒जाः प्रजा॑यन्ते कृष्णाजि॒नमुत्त॑रं॒ तेजो॒",
      "start": 146.56,
      "end": 150.92
    },
    {
      "text": "वै हिर॑ण्यं॒ ब्रह्म॑ कृष्णाजि॒नं",
      "start": 150.92,
      "end": 157.92
    },
    {
      "text": "तेज॑सा चै॒वैनं॒ ब्रह्म॑णा चोभ॒यतः॒",
      "start": 157.92,
      "end": 165.04
    },
    {
      "text": "परि॑गृह्णाति॒ षडु॑द्यामꣳ शि॒क्यं॑ भवति॒",
      "start": 165.04,
      "end": 172.04
    },
    {
      "text": "षड्वा ऋ॒तव॑ ऋ॒तुभि॑रे॒वैन॒-मुद्य॑च्छते॒ यद्",
      "start": 172.04,
      "end": 178.84
    },
    {
      "text": "द्वाद॑शोद्यामꣳ संॅवथ्स॒रेणै॒व मौ॒ञ्जं भ॑व॒त्यूर्ग्वै",
      "start": 178.84,
      "end": 181.64
    },
    {
      "text": "मुञ्जा॑ ऊ॒र्जैवैनꣳ॒॒ स (",
      "start": 181.64,
      "end": 181.64
    },
    {
      "text": ") म॑र्द्धयति सुप॒र्णो॑ऽसि ग॒रुत्मा॒नित्यवे᳚क्षते",
      "start": 181.64,
      "end": 181.64
    },
    {
      "text": "रू॒पमे॒वास्यै॒तन्म॑हि॒मानं॒ ॅव्याच॑ष्टे॒ दिवं॑ गच्छ॒",
      "start": 181.64,
      "end": 189.2
    },
    {
      "text": "सुवः॑ प॒तेत्या॑ह सुव॒र्गमे॒वैनं॑ ॅलो॒कं",
      "start": 189.2,
      "end": 192.76
    },
    {
      "text": "ग॑मयति",
      "start": 192.76,
      "end": 193.84
    }
  ],
