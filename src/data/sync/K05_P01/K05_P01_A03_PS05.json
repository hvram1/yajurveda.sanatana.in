  "phrases": [
    {
      "text": "गायत्रि॒या परि॑ लिखति॒ तेजो॒",
      "start": 145.44,
      "end": 145.44
    },
    {
      "text": "वै गा॑य॒त्री तेज॑सै॒वैनं॒ परि॑गृह्णाति",
      "start": 145.44,
      "end": 145.44
    },
    {
      "text": "त्रि॒ष्टुभा॒ परि॑ लिखतीन्द्रि॒यं ॅवै",
      "start": 145.44,
      "end": 145.44
    },
    {
      "text": "त्रि॒ष्टुगि॑न्द्रि॒येणै॒वैनं॒ परि॑ गृह्णात्यनु॒ष्टुभा॒ परि॑",
      "start": 145.44,
      "end": 145.44
    },
    {
      "text": "लिखत्यनु॒ष्टुफ् सर्वा॑णि॒ छन्दाꣳ॑सि परि॒भूः",
      "start": 145.44,
      "end": 145.44
    },
    {
      "text": "पर्या᳚प्त्यै मद्ध्य॒तो॑ऽनु॒ष्टुभा॒ वाग्वा अ॑नु॒ष्टुप्",
      "start": 145.44,
      "end": 145.44
    },
    {
      "text": "तस्मा᳚न् मद्ध्य॒तो वा॒चा व॑दामो",
      "start": 145.44,
      "end": 145.44
    },
    {
      "text": "गायत्रि॒या प्र॑थ॒मया॒ परि॑ लिख॒त्यथा॑-ऽनु॒ष्टुभाऽथ॑",
      "start": 145.44,
      "end": 153.36
    },
    {
      "text": "त्रि॒ष्टुभा॒ तेजो॒ वै गा॑य॒त्री",
      "start": 153.36,
      "end": 159.76
    },
    {
      "text": "( ) य॒ज्ञो॑ ऽनु॒ष्टुगि॑न्द्रि॒यं",
      "start": 159.76,
      "end": 163.8
    },
    {
      "text": "त्रि॒ष्टुप् तेज॑सा चै॒वेन्द्रि॒येण॑ चोभ॒यतो॑",
      "start": 163.8,
      "end": 173.04
    },
    {
      "text": "य॒ज्ञ्ं परि॑ गृह्णाति",
      "start": 173.04,
      "end": 174.92
    }
  ],
  "total_phrases": 12
}