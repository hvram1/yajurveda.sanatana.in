  "phrases": [
    {
      "text": "स॒प्तभि॑र्द्धूपयति स॒प्त वै शी॑र्.ष॒ण्याः᳚",
      "start": 0.0,
      "end": 7.6
    },
    {
      "text": "प्रा॒णाः शिर॑ ए॒तद्-य॒ज्ञ्स्य॒ यदु॒खा",
      "start": 7.6,
      "end": 14.16
    },
    {
      "text": "शी॒र्.॒षन्ने॒व य॒ज्ञ्स्य॑ प्रा॒णान् द॑धाति॒",
      "start": 14.16,
      "end": 16.4
    },
    {
      "text": "तस्मा᳚थ् स॒प्त शी॒र्.॒षन् प्रा॒णा",
      "start": 16.4,
      "end": 20.76
    },
    {
      "text": "अ॑श्वश॒केन॑ धूपयति प्राजाप॒त्यो वा",
      "start": 20.76,
      "end": 26.92
    },
    {
      "text": "अश्वः॑ सयोनि॒त्वाया-दि॑ति॒स्त्वेत्या॑हे॒यं ॅवा अदि॑ति॒रदि॑त्यै॒वादि॑त्यां",
      "start": 26.92,
      "end": 40.64
    },
    {
      "text": "खनत्य॒स्या अक्रू॑रंकाराय॒ न हि",
      "start": 40.64,
      "end": 40.64
    },
    {
      "text": "स्वः स्वꣳ हि॒नस्ति॑ दे॒वानां᳚",
      "start": 40.64,
      "end": 40.68
    },
    {
      "text": "त्वा॒ पत्नी॒रित्या॑ह दे॒वानां॒ -",
      "start": 40.68,
      "end": 40.68
    },
    {
      "text": "[ ]",
      "start": 40.68,
      "end": 40.68
    }
