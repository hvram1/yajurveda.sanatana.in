  "phrases": [
    {
      "text": "आ॒त्मान॒मा ऽप्री॑णीत॒ यदे॒ता आ॒प्रियो॒",
      "start": 112.84,
      "end": 117.64
    },
    {
      "text": "भव॑न्ति य॒ज्ञो वै प्र॒जाप॑ति-र्य॒ज्ञ्मे॒वैताभि॑र्मुख॒त",
      "start": 117.64,
      "end": 123.0
    },
    {
      "text": "आ प्री॑णा॒त्य-प॑रिमितछन्दसो भव॒न्त्यप॑रिमितः प्र॒जाप॑तिः",
      "start": 123.0,
      "end": 131.36
    },
    {
      "text": "प्र॒जाप॑ते॒राप्त्या॑ ऊनातिरि॒क्ता मि॑थु॒नाः प्रजा᳚त्यै",
      "start": 131.36,
      "end": 138.96
    },
    {
      "text": "लोम॒शं ॅवै नामै॒तच्छन्दः॑ प्र॒जाप॑तेः",
      "start": 138.96,
      "end": 147.12
    },
    {
      "text": "प॒शवो॑ लोम॒शाः प॒शूने॒वाऽव॑ रुन्धे॒",
      "start": 147.12,
      "end": 152.72
    },
    {
      "text": "सर्वा॑णि॒ वा ए॒ता रू॒पाणि॒",
      "start": 152.72,
      "end": 154.36
    },
    {
      "text": "सर्वा॑णि रू॒पाण्य॒ग्नौ चित्ये᳚ क्रियन्ते॒",
      "start": 154.36,
      "end": 154.36
    },
    {
