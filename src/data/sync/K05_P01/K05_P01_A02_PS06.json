  "phrases": [
    {
      "text": "मख्य॒दित्या॒हा-नु॑ख्यात्या आ॒गत्य॑ वा॒ज्यद्ध्व॑न आ॒क्रम्य॑",
      "start": 181.0,
      "end": 192.44
    },
    {
      "text": "वाजिन् पृथि॒वीमित्या॑हे॒च्छत्ये॒वैनं॒ पूर्व॑या वि॒न्दत्युत्त॑रया॒",
      "start": 192.44,
      "end": 196.4
    },
    {
      "text": "द्वाभ्या॒मा क्र॑मयति॒ प्रति॑ष्ठित्या॒ अनु॑रूपाभ्यां॒",
      "start": 196.4,
      "end": 196.4
    },
    {
      "text": "तस्मा॒दनु॑रूपाः प॒शवः॒ प्रजा॑यन्ते॒ द्यौस्ते॑",
      "start": 196.4,
      "end": 196.4
    },
    {
      "text": "पृ॒ष्ठं पृ॑थि॒वी स॒धस्थ॒मित्या॑है॒भ्यो वा",
      "start": 196.4,
      "end": 196.4
    },
    {
      "text": "ए॒तं ॅलो॒केभ्यः॑ प्र॒जाप॑तिः॒ समै॑रयद्",
      "start": 196.4,
      "end": 201.16
    },
    {
      "text": "रू॒पमे॒वास्यै॒-तन्म॑हि॒मानं॒ ॅव्याच॑ष्टे व॒ज्री वा",
      "start": 201.16,
      "end": 208.12
    },
    {
      "text": "( ) ए॒ष यदश्वो॑",
      "start": 208.12,
      "end": 209.36
    },
    {
      "text": "द॒द्-भिर॒न्यतो॑दद्भ्यो॒ भूयां॒ ॅलोम॑भिरुभ॒याद॑द्भ्यो॒ यं",
      "start": 209.36,
      "end": 211.24
    },
    {
      "text": "द्वि॒ष्यात् तम॑धस्प॒दं ध्या॑ये॒द्-वज्रे॑णै॒वैनꣳ॑ स्तृणुते",
      "start": 211.24,
      "end": 219.12
    }
  ],
  "total_phrases": 10
}