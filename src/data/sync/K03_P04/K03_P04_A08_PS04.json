  "phrases": [
    {
      "text": "भ॑व॒त्यङ्गा॑रा ए॒व प्र॑ति॒वेष्ट॑माना अ॒मित्रा॑णामस्य॒",
      "start": 115.72,
      "end": 120.12
    },
    {
      "text": "सेनां॒ प्रति॑वेष्टयन्ति॒ य उ॒न्माद्ये॒त्",
      "start": 120.12,
      "end": 127.36
    },
    {
      "text": "तस्मै॑ होत॒व्या॑ गन्धर्वाफ्स॒रसो॒ वा",
      "start": 127.36,
      "end": 132.96
    },
    {
      "text": "ए॒तमुन्मा॑दयन्ति॒ य उ॒न्माद्य॑त्ये॒ते खलु॒",
      "start": 132.96,
      "end": 141.64
    },
    {
      "text": "वै ग॑न्धर्वाफ्स॒रसो॒ यद्रा᳚ष्ट्र॒भृत॒स्तस्मै॒ स्वाहा॒",
      "start": 141.64,
      "end": 148.76
    },
    {
      "text": "ताभ्यः॒ स्वाहेति॑ जुहोति॒ तेनै॒वैना᳚ञ्छमयति॒",
      "start": 148.76,
      "end": 151.88
    },
    {
      "text": "नैय॑ग्रोध॒ औदु॑म्बर॒ आश्व॑त्थः॒ प्लाक्ष॒",
      "start": 151.88,
      "end": 157.0
    },
    {
      "text": "इती॒द्ध्मो भ॑वत्ये॒ते वै ग॑न्धर्वाफ्स॒रसां᳚",
      "start": 157.0,
      "end": 162.12
    },
    {
      "text": "गृ॒हाः स्व ए॒वैना॑ -",
      "start": 162.12,
      "end": 162.72
    },
