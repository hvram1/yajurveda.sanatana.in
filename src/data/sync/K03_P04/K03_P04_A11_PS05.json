  "phrases": [
    {
      "text": "विश्वचर्.षणे",
      "start": 160.0,
      "end": 160.48
    },
    {
      "text": "मि॒त्रस्य॑ चर्.षणी॒धृतः॒ श्रवो॑ दे॒वस्य॑ सान॒सिं",
      "start": 160.48,
      "end": 167.72
    },
    {
      "text": "स॒त्यं चि॒त्र श्र॑वस्तमं",
      "start": 167.72,
      "end": 172.8
    },
    {
      "text": "मि॒त्रो जनान्॑ यातयति प्रजा॒नन्",
      "start": 172.8,
      "end": 176.96
    },
    {
      "text": "मि॒त्रो दा॑धार पृथि॒वीमु॒त द्यां",
      "start": 176.96,
      "end": 176.96
    },
    {
      "text": "मि॒त्रः कृ॒ष्टीरनि॑मिषा॒ऽभि च॑ष्टे स॒त्याय॑",
      "start": 176.96,
      "end": 185.56
    },
    {
      "text": "ह॒व्यं घृ॒तव॑द्-विधेम",
      "start": 185.56,
      "end": 189.2
    },
    {
      "text": "प्रसमि॑त्र॒ मर्तो॑ अस्तु॒ प्रय॑स्वा॒न्॒.",
      "start": 189.2,
      "end": 193.88
    },
    {
      "text": "यस्त॑ आदित्य॒ शिक्ष॑ति व्र॒तेन॑",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "न ह॑न्यते॒ न जी॑यते॒",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "त्वोतो॒ नैन॒मꣳहो॑ अश्नो॒त्यन्ति॑तो॒ न",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "दू॒रात्",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "य- [ ]",
