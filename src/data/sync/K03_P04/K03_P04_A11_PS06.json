  "phrases": [
    {
      "text": "च्चि॒द्धि ते॒ विशो॑ यथा॒",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "प्रदे॑व वरुण व्र॒तं",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "मि॒नी॒मसि॒ द्यवि॑द्यवि",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "यत् किञ्चे॒दं ॅव॑रुण॒ दैव्ये॒",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "जने॑ऽभिद्रो॒हं म॑नु॒ष्या᳚श्चरा॑मसि",
      "start": 193.88,
      "end": 193.88
    },
    {
      "text": "अचि॑त्ती॒यत् तव॒ धर्मा॑ युयोपि॒ममा",
      "start": 193.88,
      "end": 194.32
    },
    {
      "text": "न॒स्तस्मा॒ देन॑सो देव रीरिषः",
      "start": 194.32,
      "end": 198.44
    },
    {
      "text": "कि॒त॒वासो॒ यद्रि॑ रि॒पुर्न दी॒वि",
      "start": 198.44,
      "end": 204.08
    },
    {
      "text": "यद्वा॑ घा स॒त्य मु॒तयन्न",
      "start": 204.08,
      "end": 209.96
    },
    {
      "text": "वि॒द्म",
      "start": 209.96,
      "end": 211.52
    },
    {
      "text": "सर्वा॒ ता विष्य॑ शिथि॒रे",
      "start": 211.52,
      "end": 213.68
    },
    {
      "text": "( ) व॑ दे॒वाथा॑",
      "start": 213.68,
      "end": 216.84
    },
    {
      "text": "ते स्याम वरुण प्रि॒यासः॑",
