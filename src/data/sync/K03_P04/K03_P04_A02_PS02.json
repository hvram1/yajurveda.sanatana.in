  "phrases": [
    {
      "text": "त्वं तु॒रीया॑ व॒शिनी॑ व॒शाऽसि॑",
      "start": 44.96,
      "end": 44.96
    },
    {
      "text": "स॒कृद्यत् त्वा॒ मन॑सा॒ गर्भ॒",
      "start": 44.96,
      "end": 44.96
    },
    {
      "text": "आऽश॑यत्",
      "start": 44.96,
      "end": 44.96
    },
    {
      "text": "व॒शा त्वं ॅव॒शिनी॑ गच्छ",
      "start": 44.96,
      "end": 44.96
    },
    {
      "text": "दे॒वान्थ्-स॒त्याः स॑न्तु॒ यज॑मानस्य॒ कामाः᳚",
      "start": 44.96,
      "end": 44.96
    },
    {
      "text": "अ॒जाऽसि॑ रयि॒ष्ठा पृ॑थि॒व्याꣳ सी॑दो॒र्द्ध्वाऽन्तरि॑क्ष॒मुप॑",
      "start": 44.96,
      "end": 46.68
    },
    {
      "text": "तिष्ठस्व दि॒वि ते॑ बृ॒हद्भाः",
      "start": 46.68,
      "end": 52.04
    },
    {
      "text": "तन्तुं॑ त॒न्वन् रज॑सो भा॒नुमन्वि॑हि॒",
      "start": 52.04,
      "end": 60.4
    },
    {
      "text": "ज्योति॑ष्मतः प॒थो र॑क्ष धि॒या",
      "start": 60.4,
      "end": 66.6
    },
    {
      "text": "कृ॒तान्",
      "start": 66.6,
      "end": 68.44
    },
    {
      "text": "अ॒नु॒ल्ब॒णं ॅव॑यत॒ जोगु॑वा॒मपो॒ मनु॑",
      "start": 68.44,
      "end": 75.96
    },
    {
      "text": "( ) र्भव ज॒नया॒",
      "start": 75.96,
      "end": 77.44
    },
    {
      "text": "दैव्यं॒ जनं᳚",
      "start": 77.44,
      "end": 77.8
    },
    {
      "text": "मन॑सो ह॒विर॑सि प्र॒जाप॑ते॒र्वर्णो॒ गात्रा॑णां",
      "start": 77.8,
      "end": 85.24
    },
    {
      "text": "ते गात्र॒भाजो॑ भूयास्म",
      "start": 85.24,
      "end": 88.04
    }
  ],
