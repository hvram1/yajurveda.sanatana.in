  "phrases": [
    {
      "text": "मव॑ रुन्धे मद्ध्य॒तो धा॒तारं॑",
      "start": 65.76,
      "end": 67.36
    },
    {
      "text": "करोति मद्ध्य॒त ए॒वैनं॒ ग्राम॑स्य",
      "start": 67.36,
      "end": 73.8
    },
    {
      "text": "दधात्ये॒ता ए॒व निर्व॑पे॒ज्ज्योगा॑मयावी॒ छन्दाꣳ॑सि॒",
      "start": 73.8,
      "end": 84.04
    },
    {
      "text": "वै देवि॑का॒श्छन्दाꣳ॑सि॒ खलु॒ वा",
      "start": 84.04,
      "end": 87.84
    },
    {
      "text": "ए॒तम॒भि म॑न्यन्ते॒ यस्य॒ ज्योगा॒मय॑ति॒",
      "start": 87.84,
      "end": 87.84
    },
    {
      "text": "छन्दो॑भिरे॒वैन॑-मग॒दं क॑रोति मद्ध्य॒तो धा॒तारं॑",
      "start": 87.84,
      "end": 87.84
    },
    {
      "text": "करोति मद्ध्य॒तो वा ए॒तस्याक्लृ॑प्तं॒",
      "start": 87.84,
      "end": 91.88
    },
    {
      "text": "ॅयस्य॒ ज्योगा॒मय॑ति मद्ध्य॒त ए॒वास्य॒",
      "start": 91.88,
      "end": 98.68
    },
    {
      "text": "तेन॑ कल्पयत्ये॒ता ए॒व नि",
      "start": 98.68,
