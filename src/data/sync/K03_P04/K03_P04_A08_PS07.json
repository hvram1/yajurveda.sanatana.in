  "phrases": [
    {
      "text": "यो ज्ये॒ष्ठब॑न्धु॒रप॑ भूतः॒ स्यात्",
      "start": 211.2,
      "end": 211.2
    },
    {
      "text": "तꣳस्थले॑ऽव॒साय्य॑ ब्रह्मौद॒नं चतुः॑ शरावं",
      "start": 211.2,
      "end": 211.2
    },
    {
      "text": "प॒क्त्वा तस्मै॑ होत॒व्या॑ वर्ष्म॒",
      "start": 211.2,
      "end": 211.2
    },
    {
      "text": "वै रा᳚ष्ट्र॒भृतो॒ वष्म॒ स्थलं॒",
      "start": 211.2,
      "end": 211.2
    },
    {
      "text": "ॅवर्ष्म॑णै॒वैनं॒ ॅवष्म॑ समा॒नानां᳚ गमयति॒",
      "start": 211.2,
      "end": 217.6
    },
    {
      "text": "चतुः॑ शरावो भवति दि॒क्ष्वे॑व",
      "start": 217.6,
      "end": 221.6
    },
    {
      "text": "प्रति॑तिष्ठति क्षी॒रे भ॑वति॒ रुच॑मे॒वास्मि॑न्",
      "start": 221.6,
      "end": 226.96
    },
    {
      "text": "दधा॒त्युद्ध॑रति शृत॒त्वाय॑ स॒र्पिष्वा᳚न् भवति",
      "start": 226.96,
      "end": 235.84
    },
    {
      "text": "मेद्ध्य॒त्वाय॑ च॒त्वार॑ आर्.षे॒याः प्राश्न॑न्ति",
      "start": 235.84,
      "end": 244.76
    },
    {
      "text": "दि॒शामे॒व ज्योति॑षि जुहोति",
      "start": 244.76,
      "end": 247.64
    }
  ],
  "total_phrases": 10
