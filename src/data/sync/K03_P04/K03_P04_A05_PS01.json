  "phrases": [
    {
      "text": "अ॒ग्निर्भू॒ताना॒मधि॑पतिः॒ समा॑ऽव॒त्विन्द्रो᳚ ज्ये॒ष्ठानां᳚ ॅय॒मः",
      "start": 0.0,
      "end": 8.24
    },
    {
      "text": "पृ॑थि॒व्या वा॒युर॒न्तरि॑क्षस्य॒ सूर्यो॑दि॒वश्च॒न्द्रमा॒ नक्ष॑त्राणां॒",
      "start": 8.24,
      "end": 14.84
    },
    {
      "text": "बृह॒स्पति॒र्ब्रह्म॑णो मि॒त्रः स॒त्यानां॒ ॅवरु॑णो॒ऽपाꣳ",
      "start": 14.84,
      "end": 14.84
    },
    {
      "text": "स॑मु॒द्रः स्रो॒त्याना॒मन्नꣳ॒॒ साम्रा᳚ज्याना॒मधि॑पति॒ तन्मा॑ऽवतु॒",
      "start": 14.84,
      "end": 21.4
    },
    {
      "text": "सोम॒ ओष॑धीनाꣳ सवि॒ता प्र॑स॒वानाꣳ॑",
      "start": 21.4,
      "end": 26.92
    },
    {
      "text": "रु॒द्रः प॑शू॒नां त्वष्टा॑ रू॒पाणां॒",
      "start": 26.92,
      "end": 33.28
    },
    {
      "text": "ॅविष्णुः॒ पर्व॑तानां म॒रुतो॑ ग॒णाना॒मधि॑पतय॒स्ते",
      "start": 33.28,
      "end": 41.08
    },
    {
      "text": "मा॑वन्तु॒ पित॑रः पितामहाः परेऽवरे॒",
      "start": 41.08,
      "end": 44.76
    },
    {
      "text": "( ) तता᳚स्ततामहा इ॒ह",
      "start": 44.76,
      "end": 46.32
    },
    {
      "text": "मा॑ऽवत",
      "start": 46.32,
      "end": 46.32
    },
    {
      "text": "अ॒स्मिन् ब्रह्म॑न्न॒स्मिन् क्ष॒त्रे᳚ऽस्या-मा॒शिष्य॒स्यां पु॑रो॒धाया॑म॒स्मिन्-कर्म॑न्न॒स्यां दे॒वहू᳚त्यां",
      "start": 46.32,
      "end": 57.52
