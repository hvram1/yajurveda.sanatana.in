  "phrases": [
    {
      "text": "वास्तो᳚ष्पते॒ प्रति॑ जानी ह्य॒स्मान्थ्",
      "start": 0.0,
      "end": 7.44
    },
    {
      "text": "स्वा॑वे॒शो अ॑नमी॒वो भ॑वानः",
      "start": 7.44,
      "end": 12.36
    },
    {
      "text": "यत् त्वेम॑हे॒ प्रति॒तन्नो॑ जुषस्व॒",
      "start": 12.36,
      "end": 17.2
    },
    {
      "text": "शन्न॑ एधि द्वि॒पदे॒ शञ्चतु॑ष्पदे",
      "start": 17.2,
      "end": 17.24
    },
    {
      "text": "वास्तो᳚ष्पते श॒ग्मया॑ सꣳ॒॒ सदा॑ते",
      "start": 17.24,
      "end": 20.6
    },
    {
      "text": "सक्षी॒महि॑ र॒ण्वया॑ गातु॒मत्या᳚",
      "start": 20.6,
      "end": 26.88
    },
    {
      "text": "आवः॒ क्षेम॑ उ॒त योगे॒",
      "start": 26.88,
      "end": 28.6
    },
    {
      "text": "वर॑न्नो यू॒यं पा॑त स्व॒स्तिभिः॒",
      "start": 28.6,
      "end": 28.6
    },
    {
      "text": "सदा॑नः",
      "start": 28.6,
      "end": 28.6
    },
    {
