  "phrases": [
    {
      "text": "-व भ॑वत्यधि॒देव॑ने जुहोत्यधि॒देव॑न ए॒वास्मै॑",
      "start": 55.16,
      "end": 55.16
    },
    {
      "text": "सजा॒तानव॑ रुन्धे॒ त ए॑न॒मव॑रुद्धा॒",
      "start": 55.16,
      "end": 55.16
    },
    {
      "text": "उप॑ तिष्ठन्ते रथमु॒ख ओज॑स्कामस्य",
      "start": 55.16,
      "end": 55.16
    },
    {
      "text": "होत॒व्या॑ ओजो॒ वै रा᳚ष्ट्र॒भृत॒",
      "start": 55.16,
      "end": 55.16
    },
    {
      "text": "ओजो॒ रथ॒ ओज॑सै॒वास्मा॒ ओजोऽव॑",
      "start": 55.16,
      "end": 55.16
    },
    {
      "text": "रुन्ध ओज॒स्व्ये॑व भ॑वति॒ यो",
      "start": 55.16,
      "end": 55.16
    },
    {
      "text": "रा॒ष्ट्रादप॑भूतः॒ स्यात् तस्मै॑ होत॒व्या॑",
      "start": 55.16,
      "end": 55.16
    },
    {
      "text": "याव॑न्तोऽस्य॒ रथाः॒ स्युस्तान् ब्रू॑याद्",
      "start": 55.16,
      "end": 55.16
    },
    {
      "text": "यु॒ङ्ध्वमिति॑ रा॒ष्ट्रमे॒वास्मै॑ युन॒क्त्या -",
      "start": 55.16,
      "end": 55.16
    },
