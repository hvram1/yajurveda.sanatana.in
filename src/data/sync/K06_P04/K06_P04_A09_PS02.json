  "phrases": [
    {
      "text": "भि॒षजा॒विति॒ तस्मा᳚द् ब्राह्म॒णेन॑ भेष॒जं",
      "start": 38.24,
      "end": 44.2
    },
    {
      "text": "न का॒र्य॑मपू॑तो॒ ह्ये᳚(1॒)षो॑ ऽमे॒द्ध्यो",
      "start": 44.2,
      "end": 50.4
    },
    {
      "text": "यो भि॒षक्तौ ब॑हिष्पवमा॒नेन॑ पवयि॒त्वा",
      "start": 50.4,
      "end": 60.08
    },
    {
      "text": "ताभ्या॑-मे॒तमा᳚श्वि॒न-म॑गृह्ण॒न् तस्मा᳚द् बहिष्पवमा॒ने स्तु॒त",
      "start": 60.08,
      "end": 63.32
    },
    {
      "text": "आ᳚श्वि॒नो गृ॑ह्यते॒ तस्मा॑दे॒वं ॅवि॒दुषा॑",
      "start": 63.32,
      "end": 63.32
    },
    {
      "text": "बहिष्पवमा॒न उ॑प॒सद्यः॑ प॒वित्रं॒ ॅवै",
      "start": 63.32,
      "end": 63.32
    },
    {
      "text": "ब॑हिष्पवमा॒न आ॒त्मान॑मे॒व प॑वयते॒ तयो᳚ऽस्त्रे॒धा",
      "start": 63.32,
      "end": 73.2
    },
    {
      "text": "भैष॑ज्यं॒ ॅवि न्य॑दधुर॒ग्नौ तृती॑यम॒फ्सु",
      "start": 73.2,
      "end": 78.36
    },
    {
      "text": "तृती॑यं ब्राह्म॒णे तृती॑यं॒ तस्मा॑दुदपा॒त्र-",
      "start": 78.36,
      "end": 85.44
