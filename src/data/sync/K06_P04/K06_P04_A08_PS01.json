  "phrases": [
    {
      "text": "मि॒त्रं दे॒वा अ॑ब्रुव॒न्थ् सोमꣳ॒॒",
      "start": 0.0,
      "end": 7.4
    },
    {
      "text": "राजा॑नꣳ हना॒मेति॒ सो᳚ऽब्रवी॒न्नाहꣳ सर्व॑स्य॒",
      "start": 7.4,
      "end": 15.64
    },
    {
      "text": "वा अ॒हं मि॒त्रम॒स्मीति॒ तम॑ब्रुव॒न्॒.",
      "start": 15.64,
      "end": 20.84
    },
    {
      "text": "हना॑मै॒वेति॒ सो᳚ऽब्रवी॒द् वरं॑ ॅवृणै॒",
      "start": 20.84,
      "end": 24.84
    },
    {
      "text": "पय॑सै॒व मे॒ सोमꣳ॑ श्रीण॒न्निति॒",
      "start": 24.84,
      "end": 30.04
    },
    {
      "text": "तस्मा᳚न्-मैत्रावरु॒णं पय॑सा श्रीणन्ति॒ तस्मा᳚त्",
      "start": 30.04,
      "end": 30.04
    },
    {
      "text": "प॒शवोऽपा᳚क्रामन् मि॒त्रः सन् क्रू॒रम॑क॒रिति॑",
      "start": 30.04,
      "end": 30.04
    },
    {
      "text": "क्रू॒रमि॑व॒ खलु॒ वा ए॒षः",
      "start": 30.04,
      "end": 32.2
    },
