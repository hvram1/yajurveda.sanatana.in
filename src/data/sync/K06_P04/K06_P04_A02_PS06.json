  "phrases": [
    {
      "text": "ॅलो॒के प॑शु॒मान्थ् स्या॑दु॒भयो॒रुप॑ सादयत्यु॒भयो॑रे॒वैनं॑",
      "start": 182.88,
      "end": 186.68
    },
    {
      "text": "ॅलो॒कयोः᳚ पशु॒मन्तं॑ करोति स॒र्वतः॒",
      "start": 186.68,
      "end": 186.68
    },
    {
      "text": "परि॑ हरति॒ रक्ष॑सा॒मप॑हत्या इन्द्राग्नि॒योर्भा॑ग॒धेयीः॒",
      "start": 186.68,
      "end": 190.2
    },
    {
      "text": "स्थेत्या॑ह यथाय॒जुरे॒वैतदाग्नी᳚द्ध्र॒ उप॑ वासयत्ये॒तद्वै",
      "start": 190.2,
      "end": 195.68
    },
    {
      "text": "य॒ज्ञ्स्याप॑राजितं॒ ॅयदाग्नी᳚द्ध्रं॒ ॅयदे॒व य॒ज्ञ्स्याप॑राजितं॒",
      "start": 195.68,
      "end": 203.88
    },
    {
      "text": "तदे॒वैना॒ उप॑ वासयति॒ यतः॒",
      "start": 203.88,
      "end": 206.84
    },
    {
      "text": "खलु॒ वै य॒ज्ञ्स्य॒ वित॑तस्य॒",
      "start": 206.84,
      "end": 211.0
    },
    {
      "text": "न क्रि॒यते॒ ( )",
      "start": 211.0,
      "end": 212.52
    },
    {
      "text": "तदनु॑ य॒ज्ञ्ꣳ रक्षाꣳ॒॒स्यव॑ चरन्ति॒",
      "start": 212.52,
      "end": 219.52
    },
    {
      "text": "यद् वह॑न्तीनां गृ॒ह्णाति॑ क्रि॒यमा॑णमे॒व",
      "start": 219.52,
      "end": 222.32
    },
    {
      "text": "तद् य॒ज्ञ्स्य॑ शये॒ रक्ष॑सा॒-मन॑न्ववचाराय॒",
      "start": 222.32,
      "end": 230.72
    },
    {
      "text": "न ह्ये॑ता ई॒लय॒न्त्या तृ॑तीयसव॒नात्",
      "start": 230.72,
      "end": 230.72
    },
    {
      "text": "परि॑ शेरे य॒ज्ञ्स्य॒ संत॑त्यै",
      "start": 230.72,
      "end": 236.32
    }
  ],
