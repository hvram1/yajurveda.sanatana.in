    {
      "text": "य॒ज्ञेन॒ वै प्र॒जाप॑तिः प्र॒जा",
      "start": 0.0,
      "end": 2.52
    },
    {
      "text": "अ॑सृजत॒ ता उ॑प॒यड्भि॑-रे॒वासृ॑जत॒ यदु॑प॒यज॑",
      "start": 2.52,
      "end": 5.48
    },
    {
      "text": "उप॒यज॑ति प्र॒जा ए॒व तद्",
      "start": 5.48,
      "end": 5.48
    },
    {
      "text": "यज॑मानः सृजते जघना॒र्द्धादव॑ द्यति",
      "start": 5.48,
      "end": 10.48
    },
    {
      "text": "जघना॒र्द्धाद्धि प्र॒जाः प्र॒जाय॑न्ते स्थविम॒तोऽव॑",
      "start": 10.48,
      "end": 20.12
    },
    {
      "text": "द्यति स्थविम॒तो हि प्र॒जाः",
      "start": 20.12,
      "end": 21.16
    },
    {
      "text": "प्र॒जाय॒न्ते ऽस॑भिंन्द॒न्नव॑ द्यति प्रा॒णाना॒-मस॑भेंदाय॒",
      "start": 21.16,
      "end": 26.68
    },
    {
      "text": "न प॒र्याव॑र्तयति॒ यत् प॑र्याव॒र्तये॑दुदाव॒र्तः",
      "start": 26.68,
      "end": 34.56
    },
    {
