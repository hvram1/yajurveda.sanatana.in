{
  "kanda": 6,
  "prasna": 4,
  "anuvaka": 11,
  "panchasat": 4,
  "phrases": [
    {
      "text": "तत् प्र॒जा अ॒भि जि॑घ्रति॒",
      "start": 96.92,
      "end": 96.92
    },
    {
      "text": "तस्मा᳚द् व॒थ्सं जा॒तं गौर॒भि",
      "start": 96.92,
      "end": 96.92
    },
    {
      "text": "जि॑घ्रत्या॒त्मा वा ए॒ष य॒ज्ञ्स्य॒",
      "start": 96.92,
      "end": 101.12
    },
    {
      "text": "यदा᳚ग्रय॒णः सव॑नेसवने॒ऽभि गृ॑ह्णात्या॒त्मन्ने॒व य॒ज्ञ्ꣳ",
      "start": 101.12,
      "end": 108.24
    },
    {
      "text": "सं त॑नोत्यु॒परि॑ष्टा॒दा न॑यति॒ रेत॑",
      "start": 108.24,
      "end": 115.32
    },
    {
      "text": "ए॒व तद् द॑धात्य॒धस्ता॒दुप॑ गृह्णाति॒",
      "start": 115.32,
      "end": 123.32
    },
    {
      "text": "प्र ज॑नयत्ये॒व तद्ब्र॑ह्मवा॒दिनो॑ वदन्ति॒",
      "start": 123.32,
      "end": 129.6
    },
    {
      "text": "कस्मा᳚थ् स॒त्याद्-गा॑य॒त्री कनि॑ष्ठा॒ छन्द॑साꣳ",
      "start": 129.6,
      "end": 136.76
    },
    {
      "text": "स॒ती सर्वा॑णि॒ सव॑नानि वह॒तीत्ये॒",
      "start": 136.76,
      "end": 143.2
    },
    {
      "text": "( )-ष वै गा॑यत्रि॒यै",
      "start": 143.2,
      "end": 145.88
    },
    {
      "text": "व॒थ्सो यदा᳚ग्रय॒णस्तमे॒व तद॑भिनि॒वर्तꣳ॒॒ सर्वा॑णि॒",
      "start": 145.88,
      "end": 156.72
    },
    {
      "text": "सव॑नानि वहति॒ तस्मा᳚द् व॒थ्सम॒पाकृ॑तं॒",
      "start": 156.72,
      "end": 156.72
    },
    {
      "text": "गौर॒भि नि व॑र्तते",
      "start": 156.72,
      "end": 159.0
    }
  ],
  "total_phrases": 13
}