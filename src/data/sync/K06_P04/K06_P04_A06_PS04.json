    {
      "text": "प्राणापा॒नयो॒-र्विधृ॑त्यै प्राणापा॒नौ वा ए॒तौ",
      "start": 108.64,
      "end": 109.88
    },
    {
      "text": "यदु॑पाꣳश्वन्तर्या॒मौ व्या॒न उ॑पाꣳशु॒ सव॑नो॒",
      "start": 109.88,
      "end": 109.88
    },
    {
      "text": "यं का॒मये॑त प्र॒मायु॑कः स्या॒दित्यसꣳ॑",
      "start": 109.88,
      "end": 109.88
    },
    {
      "text": "स्पृष्टौ॒ तस्य॑ सादयेद्-व्या॒नेनै॒वास्य॑ प्राणापा॒नौ",
      "start": 109.88,
      "end": 114.0
    },
    {
      "text": "वि च्छि॑नत्ति ता॒जक् प्र",
      "start": 114.0,
      "end": 118.12
    },
    {
      "text": "मी॑यते॒ यं का॒मये॑त॒ सर्व॒मायु॑रिया॒दिति॒",
      "start": 118.12,
      "end": 127.32
    },
    {
      "text": "सꣳ स्पृ॑ष्टौ॒ तस्य॑ सादयेद्-व्या॒नेनै॒वास्य॑",
      "start": 127.32,
      "end": 132.08
    },
    {
      "text": "प्राणापा॒नौ सं त॑नोति॒ सर्व॒मायु॑रेति",
      "start": 132.08,
      "end": 136.48
    }
  ],
