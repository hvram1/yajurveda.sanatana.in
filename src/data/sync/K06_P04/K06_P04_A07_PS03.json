  "phrases": [
    {
      "text": "स॒न्ना अ॑स॒-न्नित्यु॑पया॒मगृ॑हीतो॒ऽसी-त्या॑हा-दितिदेव॒त्या᳚स्तेन॒ यानि॒ हि",
      "start": 89.68,
      "end": 90.96
    },
    {
      "text": "दा॑रु॒मया॑णि॒ पात्रा᳚ण्य॒स्यै तानि॒ योनेः॒",
      "start": 90.96,
      "end": 90.96
    },
    {
      "text": "संभू॑तानि॒ यानि॑ मृ॒न्मया॑नि सा॒क्षात्",
      "start": 90.96,
      "end": 90.96
    },
    {
      "text": "तान्य॒स्यै तस्मा॑दे॒वमा॑ह॒ वाग्वै परा॒च्य-व्या॑कृताऽवद॒त्",
      "start": 90.96,
      "end": 90.96
    },
    {
      "text": "ते दे॒वा इन्द्र॑मब्रुवन्नि॒मां नो॒",
      "start": 90.96,
      "end": 90.96
    },
    {
      "text": "वाचं॒ ॅव्याकु॒र्विति॒ सो᳚ऽब्रवी॒द् वरं॑",
      "start": 90.96,
      "end": 90.96
    },
    {
      "text": "ॅवृणै॒ मह्यं॑ चै॒वैष वा॒यवे॑",
      "start": 90.96,
      "end": 91.72
    },
    {
      "text": "च स॒ह ( )",
      "start": 91.72,
      "end": 93.72
    },
    {
      "text": "गृ॑ह्याता॒ इति॒ तस्मा॑दैन्द्रवाय॒वः स॒ह",
      "start": 93.72,
      "end": 101.84
    },
    {
      "text": "गृ॑ह्यते॒ तामिन्द्रो॑ मद्ध्य॒तो॑ऽव॒क्रम्य॒ व्याक॑रो॒त्",
      "start": 101.84,
      "end": 117.44
    },
    {
      "text": "तस्मा॑दि॒यं ॅव्याकृ॑ता॒ वागु॑द्यते॒ तस्मा᳚थ्",
      "start": 117.44,
      "end": 124.6
    },
    {
      "text": "स॒कृदिन्द्रा॑य मद्ध्य॒तो गृ॑ह्यते॒ द्विर्वा॒यवे॒",
      "start": 124.6,
      "end": 126.92
    },
    {
      "text": "द्वौ हि स वरा॒ववृ॑णीत",
      "start": 126.92,
      "end": 130.72
    }
  ],
