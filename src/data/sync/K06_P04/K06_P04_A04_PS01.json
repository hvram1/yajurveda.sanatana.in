  "phrases": [
    {
      "text": "दे॒वस्य॑ त्वा सवि॒तुः प्रस॑व॒",
      "start": 0.0,
      "end": 6.68
    },
    {
      "text": "इति॒ ग्रावा॑ण॒मा द॑त्ते॒ प्रसू᳚त्या",
      "start": 6.68,
      "end": 9.32
    },
    {
      "text": "अ॒श्विनो᳚-र्बा॒हुभ्या॒मित्या॑हा॒श्विनौ॒ हि दे॒वाना॑मद्ध्व॒र्यू आस्तां᳚",
      "start": 9.32,
      "end": 9.32
    },
    {
      "text": "पू॒ष्णो हस्ता᳚भ्या॒मित्या॑ह॒ यत्यै॑ प॒शवो॒",
      "start": 9.32,
      "end": 12.88
    },
    {
      "text": "वै सोमो᳚ व्या॒न उ॑पाꣳशु॒सव॑नो॒",
      "start": 12.88,
      "end": 18.16
    },
    {
      "text": "यदु॑पाꣳशु॒सव॑न-म॒भि मिमी॑ते व्या॒नमे॒व प॒शुषु॑",
      "start": 18.16,
      "end": 25.84
    },
    {
      "text": "दधा॒तीन्द्रा॑य॒ त्वेन्द्रा॑य॒ त्वेति॑ मिमीत॒",
      "start": 25.84,
      "end": 34.08
    },
    {
      "text": "इन्द्रा॑य॒ हि सोम॑ आह्रि॒यते॒",
      "start": 34.08,
      "end": 36.88
    },
    {
      "text": "पञ्च॒ कृत्वो॒ यजु॑षा मिमीते॒-",
      "start": 36.88,
      "end": 36.88
    },
