  "phrases": [
    {
      "text": "-ऽभ्रा॑तृव्यो॒ यदिन्द्रा॑य वैमृ॒धाय॒ मृध॑",
      "start": 112.68,
      "end": 117.8
    },
    {
      "text": "ए॒व तेनाप॑ हते॒यदिन्द्रा॑येन्द्रि॒याव॑त इन्द्रि॒यमे॒व",
      "start": 117.8,
      "end": 125.92
    },
    {
      "text": "तेना॒त्मन् ध॑त्ते॒ त्रय॑स्त्रिꣳशत्कपालं पुरो॒डाशं॒",
      "start": 125.92,
      "end": 129.44
    },
    {
      "text": "निर्व॑पति॒ त्रय॑स्त्रिꣳश॒द्वै दे॒वता॒स्ता ए॒व",
      "start": 129.44,
      "end": 138.84
    },
    {
      "text": "यज॑मान आ॒त्मन्ननु॑ स॒मार॑भंयते॒ भूत्यै॒",
      "start": 138.84,
      "end": 141.36
    },
    {
      "text": "सा वा ए॒षा विजि॑ति॒र्नामेष्टि॒र्य",
      "start": 141.36,
      "end": 144.16
    },
    {
      "text": "ए॒वं ॅवि॒द्वाने॒तयेष्‌ट्या॒ यज॑त उत्त॒मामे॒व",
      "start": 144.16,
      "end": 144.16
    },
    {
      "text": "विजि॑तिं॒ भ्रातृ॑व्येण॒ वि ज॑यते",
      "start": 144.16,
      "end": 144.16
    },
    {
      "text": "(इ॒न्द्रि॒याव॑ती॒ - भूत्या॑ -",
      "start": 144.16,
      "end": 144.16
    },
    {
      "text": "उ॒तै - का॒न्न प॑ञ्चा॒शच्च॑)",
      "start": 144.16,
      "end": 146.04
    }
  ],
  "total_phrases": 10
