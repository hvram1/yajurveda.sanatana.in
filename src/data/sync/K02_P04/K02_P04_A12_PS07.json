  "phrases": [
    {
      "text": "ए॒वं ॅवेद॒ हन्ति॒ क्षुधं॒",
      "start": 170.28,
      "end": 173.72
    },
    {
      "text": "भ्रातृ॑व्यं॒ तद॑स्मै॒ प्राय॑च्छ॒त्‌तत् प्रत्य॑गृह्णा॒त्-",
      "start": 173.72,
      "end": 184.8
    },
    {
      "text": "त्रिर्मा॑ऽधा॒ इति॒ तद्-विष्ण॒वेऽति॒ प्राय॑च्छ॒त्",
      "start": 184.8,
      "end": 192.52
    },
    {
      "text": "तद्-विष्णुः॒ प्रत्य॑गृह्णाद॒स्मास्विन्द्र॑ इन्द्रि॒यं द॑धा॒त्विति॒",
      "start": 192.52,
      "end": 199.76
    },
    {
      "text": "यत्त्रिः प्राय॑च्छ॒त् त्रिः प्र॒त्यगृ॑ह्णा॒त्",
      "start": 199.76,
      "end": 199.76
    },
    {
      "text": "तत् त्रि॒धातो᳚स्त्रिधातु॒त्वं ॅयद्-विष्णु॑र॒न्वति॑ष्ठत॒ विष्ण॒वेऽति॒",
      "start": 199.76,
      "end": 199.76
    },
    {
      "text": "प्राय॑च्छ॒त् तस्मा॑दैन्द्रावैष्ण॒वꣳ ह॒विर्भ॑वति॒ (",
      "start": 199.76,
      "end": 199.76
    },
    {
      "text": ") यद्वा इ॒दं किञ्च॒",
      "start": 199.76,
      "end": 199.76
    },
    {
      "text": "तद॑स्मै॒ तत् प्राय॑च्छ॒द् ऋचः॒",
      "start": 199.76,
      "end": 199.76
    },
    {
      "text": "सामा॑नि॒ यजूꣳ॑षि स॒हस्रं॒ ॅवा",
      "start": 199.76,
      "end": 203.2
    },
    {
      "text": "अ॑स्मै॒ तत् प्राय॑च्छ॒त् तस्मा᳚थ्",
      "start": 203.2,
      "end": 209.04
    },
    {
      "text": "स॒हस्र॑दक्षिणं",
      "start": 209.04,
      "end": 211.96
    }
  ],
  "total_phrases": 12
