  "phrases": [
    {
      "text": "मिथु॒नं म॑द्ध्य॒तो द॑धाति॒ पुष्‌ट्यै᳚",
      "start": 14.84,
      "end": 21.52
    },
    {
      "text": "प्र॒जन॑नाय सिनीवा॒ल्यै च॒रुर्भ॑वति॒ वाग्वै",
      "start": 21.52,
      "end": 29.76
    },
    {
      "text": "सि॑नीवा॒ली पुष्टिः॒ खलु॒ वै",
      "start": 29.76,
      "end": 34.44
    },
    {
      "text": "वाक्पुष्टि॑मे॒व वाच॒मुपै᳚त्यै॒न्द्र उ॑त्त॒मो भ॑वति॒",
      "start": 34.44,
      "end": 42.48
    },
    {
      "text": "तेनै॒व तन्मि॑थु॒नꣳ स॒प्तैतानि॑ ह॒वीꣳषि॑",
      "start": 42.48,
      "end": 47.52
    },
    {
      "text": "भवन्ति स॒प्त ग्रा॒म्याः प॒शवः॑",
      "start": 47.52,
      "end": 49.68
    },
    {
      "text": "स॒प्तार॒ण्याः स॒प्त छन्दाꣳ॑स्यु॒-भय॒स्या-व॑रुद्ध्या॒ अथै॒ता",
      "start": 49.68,
      "end": 60.16
    },
    {
      "text": "आहु॑ती र्जुहोत्ये॒ते वै दे॒वाः",
      "start": 60.16,
      "end": 65.84
    },
    {
      "text": "पुष्टि॑पतय॒स्त ए॒वा ( )",
      "start": 65.84,
      "end": 67.88
    },
    {
      "text": "स्मि॒न् पुष्टिं॑ दधति॒ पुष्य॑ति",
      "start": 67.88,
      "end": 67.92
    },
    {
      "text": "प्र॒जया॑ प॒शुभि॒रथो॒ यदे॒ता आहु॑ती",
      "start": 67.92,
      "end": 73.48
    },
    {
      "text": "र्जु॒होति॒ प्रति॑ष्ठित्यै",
