    {
      "text": "वृ॒ष्टयः॑",
      "start": 59.4,
      "end": 61.08
    },
    {
      "text": "उदी॑रयथा मरुतः समुद्र॒तो यू॒यं",
      "start": 61.08,
      "end": 63.84
    },
    {
      "text": "ॅवृ॒ष्टिं ॅव॑र्.षयथा पुरीषिणः",
      "start": 63.84,
      "end": 67.32
    },
    {
      "text": "न वो॑ दस्रा॒ उप॑",
      "start": 67.32,
      "end": 70.08
    },
    {
      "text": "दस्यन्ति धे॒नवः॒ शुभं॑ ॅया॒तामनु॒",
      "start": 70.08,
      "end": 70.92
    },
    {
      "text": "रथा॑ अवृथ्सत",
      "start": 70.92,
      "end": 71.0
    },
    {
      "text": "सृ॒जा वृ॒ष्टिं दि॒व आऽद्भिः",
      "start": 71.0,
      "end": 75.72
    },
    {
      "text": "स॑मु॒द्रं पृ॑ण",
      "start": 75.72,
      "end": 79.36
    },
    {
      "text": "अ॒ब्जा अ॑सि प्रथम॒जा बल॑मसि समु॒द्रियं᳚",
      "start": 79.36,
      "end": 87.68
    },
    {
      "text": "उन्न॑म्भय पृथि॒वीं भि॒न्धीदं दि॒व्यं नभः॑",
      "start": 87.68,
      "end": 87.68
    },
    {
      "text": "उ॒द्नो दि॒व्यस्य॑ नो दे॒हीशा॑नो॒",
      "start": 87.68,
      "end": 87.68
    },
    {
      "text": "विसृ॑जा॒ दृतिं᳚",
      "start": 87.68,
      "end": 87.68
    },
    {
      "text": "ये दे॒वा ( )",
      "start": 87.68,
      "end": 87.68
    },
    {
      "text": "दि॒विभा॑गा॒ ये᳚ऽन्तरि॑क्ष भागा॒ ये",
      "start": 87.68,
      "end": 87.68
    },
    {
      "text": "पृ॑थि॒वि भा॑गाः",
      "start": 87.68,
      "end": 87.68
    },
    {
      "text": "त इ॒मं ॅय॒ज्ञ्म॑वन्तु॒ त",
      "start": 87.68,
      "end": 87.68
    },
    {
      "text": "इ॒दं क्षेत्र॒मा वि॑शन्तु॒ त",
      "start": 87.68,
      "end": 87.68
    },
    {
      "text": "इ॒दं क्षेत्र॒मनु॒ वि वि॑शन्तु",
      "start": 87.68,
      "end": 88.76
    }
  ],
