  "phrases": [
    {
      "text": "यः स॒हस्रे॑ण॒ यज॑ते प्र॒जाप॑तिः॒",
      "start": 94.84,
      "end": 100.64
    },
    {
      "text": "खलु॒ वै प॒शून॑सृजत॒ ताꣳस्त्रै॑धात॒",
      "start": 100.64,
      "end": 106.24
    },
    {
      "text": "वीये॑-नै॒वासृ॑जत॒ य ए॒वं ॅवि॒द्वाꣳ",
      "start": 106.24,
      "end": 111.16
    },
    {
      "text": "स्त्रै॑धात॒वीये॑नप॒शुका॑मो॒ यज॑ते॒ यस्मा॑दे॒व योनेः᳚",
      "start": 111.16,
      "end": 122.76
    },
    {
      "text": "प्र॒जाप॑तिः प॒शूनसृ॑जत॒ तस्मा॑दे॒वैना᳚न्थ् सृजत॒",
      "start": 122.76,
      "end": 126.64
    },
    {
      "text": "उपै॑न॒मुत्त॑रꣳ स॒हस्रं॑ नमति दे॒वता᳚भ्यो॒",
      "start": 126.64,
      "end": 126.64
    },
    {
      "text": "वा ए॒ष आ वृ॑श्च्यते॒",
      "start": 126.64,
      "end": 126.72
    },
    {
      "text": "यो य॒क्ष्य इत्यु॒क्त्वा न",
      "start": 126.72,
      "end": 126.72
    },
    {
      "text": "यज॑ते त्रैधात॒वीये॑न यजेत॒ सर्वो॒",
      "start": 126.72,
      "end": 126.72
    },
    {
      "text": "वा ए॒ष य॒ज्ञो -",
      "start": 126.72,
      "end": 126.72
