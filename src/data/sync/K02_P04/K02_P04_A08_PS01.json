    {
      "text": "देवा॑ वसव्या॒ अग्ने॑ सोम सूर्य",
      "start": 0.0,
      "end": 4.48
    },
    {
      "text": "देवाः᳚ शर्मण्या॒ मित्रा॑वरुणाऽर्यमन्न्",
      "start": 4.48,
      "end": 14.12
    },
    {
      "text": "देवाः᳚ सपीत॒यो ऽपा᳚न्-नपादाशुहेमन्न्",
      "start": 14.12,
      "end": 15.28
    },
    {
      "text": "उ॒द्नो द॑त्तोद॒धिं भि॑न्त्त दि॒वः",
      "start": 15.28,
      "end": 23.44
    },
    {
      "text": "प॒र्जन्या॑द॒न्तरि॑क्षात्-पृथि॒व्यास्ततो॑ नो॒ वृष्‌ट्या॑ऽवत",
      "start": 23.44,
      "end": 25.72
    },
    {
      "text": "दिवा॑ चि॒त्तमः॑ कृण्वन्ति प॒र्जन्ये॑नो-दवा॒हेन॑",
      "start": 25.72,
      "end": 29.6
    },
    {
      "text": "पृ॒थि॒वीं ॅयद् व्यु॒न्दन्ति॑",
      "start": 29.6,
      "end": 37.44
    },
    {
      "text": "आयन् नरः॑ सु॒दान॑वो ददा॒शुषे॑",
      "start": 37.44,
      "end": 43.88
    },
    {
      "text": "दि॒वः कोश॒मचु॑च्यवुः",
      "start": 43.88,
      "end": 49.84
    },
    {
      "text": "वि प॒र्जन्याः᳚ सृजन्ति॒ रोद॑सी॒",
      "start": 49.84,
      "end": 56.56
    },
    {
      "text": "अनु॒ धन्व॑ना यन्ति -",
      "start": 56.56,
