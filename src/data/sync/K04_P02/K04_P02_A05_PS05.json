  "phrases": [
    {
      "text": "शची॑भिः",
      "start": 144.56,
      "end": 145.72
    },
    {
      "text": "दे॒व इ॑व सवि॒ता स॒त्यध॒र्मेन्द्रो॒",
      "start": 145.72,
      "end": 154.4
    },
    {
      "text": "न त॑स्थौ सम॒रे प॑थी॒नां",
      "start": 154.4,
      "end": 158.12
    },
    {
      "text": "सं ॅव॑र॒त्रा द॑धातन॒ निरा॑हा॒वान् कृ॑णोतन",
      "start": 158.12,
      "end": 167.32
    },
    {
      "text": "सि॒ञ्चाम॑हा अव॒टमु॒द्रिणं॑ ॅव॒यं ॅविश्वाऽहाऽद॑स्त॒मक्षि॑तं",
      "start": 167.32,
      "end": 179.44
    },
    {
      "text": "निष्कृ॑ताहा-वमव॒टꣳ सु॑वर॒त्रꣳ सु॑षेच॒नं",
      "start": 179.44,
      "end": 182.16
    },
    {
      "text": "उ॒द्रिणꣳ॑ सिञ्चे॒ अक्षि॑तं",
      "start": 182.16,
      "end": 184.4
    },
    {
      "text": "सीरा॑ युञ्जन्ति क॒वयो॑ यु॒गा",
      "start": 184.4,
      "end": 184.4
    },
    {
      "text": "वि त॑न्वते॒ पृथ॑क्",
      "start": 184.4,
      "end": 184.4
    },
    {
      "text": "धीरा॑ दे॒वेषु॑ सुम्न॒या",
      "start": 184.4,
      "end": 184.4
    },
    {
      "text": "यु॒नक्त॒ सीरा॒ वि यु॒गा",
      "start": 184.4,
      "end": 184.4
    },
    {
      "text": "त॑नोत कृ॒ते योनौ॑ वपते॒ह",
      "start": 184.4,
      "end": 184.4
    },
