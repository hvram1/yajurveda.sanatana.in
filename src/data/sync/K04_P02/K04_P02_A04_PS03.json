    {
      "text": "-ऽफ्सु वा॑ यजत्र",
      "start": 82.32,
      "end": 82.32
    },
    {
      "text": "येना॒न्तरि॑क्ष-मु॒र्वा॑त॒तन्थ॑ त्वे॒षः स भा॒नुर॑र्ण॒वो नृ॒चक्षाः᳚",
      "start": 82.32,
      "end": 82.32
    },
    {
      "text": "पु॒री॒ष्या॑सो अ॒ग्नयः॑ प्राव॒णेभिः॑ स॒जोष॑सः",
      "start": 82.32,
      "end": 82.32
    },
    {
      "text": "जु॒षन्ताꣳ॑ ह॒व्यमाहु॑तमनमी॒वा इषो॑ म॒हीः",
      "start": 82.32,
      "end": 82.32
    },
    {
      "text": "इडा॑मग्ने पुरु॒दꣳ सꣳ॑ स॒निं",
      "start": 82.32,
      "end": 82.32
    },
    {
      "text": "गोः श॑श्वत्त॒मꣳ हव॑मानाय साध",
      "start": 82.32,
      "end": 82.32
    },
    {
      "text": "स्यान्नः॑ सू॒नुस्तन॑यो वि॒जावाऽग्ने॒ सा",
      "start": 82.32,
      "end": 82.32
    },
    {
      "text": "ते॑ सुम॒तिर्भू᳚त्व॒स्मे",
      "start": 82.32,
      "end": 82.32
    },
    {
      "text": "अ॒यं ते॒ योनि॑र्. ऋ॒त्वियो॒",
      "start": 82.32,
      "end": 86.92
    },
    {
      "text": "यतो॑ जा॒तो अरो॑चथाः",
