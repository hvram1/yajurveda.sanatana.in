  "phrases": [
    {
      "text": "पर॒मे व्यो॑मन्न्",
      "start": 39.72,
      "end": 39.72
    },
    {
      "text": "इ॒मं मा हिꣳ॑सी॒रेक॑शफं पशू॒नां",
      "start": 39.72,
      "end": 39.72
    },
    {
      "text": "क॑निक्र॒दं ॅवा॒जिनं॒ ॅवाजि॑नेषु",
      "start": 39.72,
      "end": 39.72
    },
    {
      "text": "गौ॒रमा॑र॒ण्यमनु॑ ते दिशामि॒ तेन॑",
      "start": 39.72,
      "end": 39.72
    },
    {
      "text": "चिन्वा॒नस्त॒नुवो॒ नि षी॑द",
      "start": 39.72,
      "end": 39.72
    },
    {
      "text": "अज॑स्र॒मिन्दु॑मरु॒षं भु॑र॒ण्युम॒ग्निमी॑डे पू॒र्वचि॑त्तौ॒ नमो॑भिः",
      "start": 39.72,
      "end": 48.44
    },
    {
      "text": "स पर्व॑भिर्.ऋतु॒शः कल्प॑मानो॒ गां",
      "start": 48.44,
      "end": 54.36
    },
    {
      "text": "मा हिꣳ॑सी॒रदि॑तिं ॅवि॒राजं᳚",
      "start": 54.36,
      "end": 57.04
    },
    {
      "text": "इ॒मꣳ स॑मु॒द्रꣳ श॒तधा॑र॒मुथ्-सं॑ ॅव्य॒च्यमा॑नं॒",
      "start": 57.04,
      "end": 68.64
    },
    {
      "text": "भुव॑नस्य॒ मद्ध्ये᳚",
      "start": 68.64,
      "end": 69.08
    },
    {
      "text": "घृ॒तं दुहा॑ना॒मदि॑तिं॒ जना॒याग्ने॒ मा",
      "start": 69.08,
      "end": 72.6
    },
