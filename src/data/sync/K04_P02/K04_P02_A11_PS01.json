    {
      "text": "इन्द्रा᳚ग्नी रोच॒ना दि॒वः परि॒",
      "start": 0.0,
      "end": 3.04
    },
    {
      "text": "वाजे॑षु भूषथः",
      "start": 3.04,
      "end": 4.88
    },
    {
      "text": "तद्वां᳚ चेति॒ प्रवी॒र्यं᳚",
      "start": 4.88,
      "end": 6.84
    },
    {
      "text": "श्नथ॑द्-वृ॒त्रमु॒त स॑नोति॒ वाज॒मिन्द्रा॒ यो",
      "start": 6.84,
      "end": 14.84
    },
    {
      "text": "अ॒ग्नी सहु॑री सप॒र्यात्",
      "start": 14.84,
      "end": 15.92
    },
    {
      "text": "इ॒र॒ज्यन्ता॑ वस॒व्य॑स्य॒ भूरेः॒ सह॑स्तमा॒",
      "start": 15.92,
      "end": 19.28
    },
    {
      "text": "सह॑सा वाज॒यन्ता᳚",
      "start": 19.28,
      "end": 23.48
    },
    {
