  "phrases": [
    {
      "text": "-नि व॑र्तस्व॒ पुन॑रग्न इ॒षा ऽऽयु॑षा",
      "start": 108.64,
      "end": 114.12
    },
    {
      "text": "पुन॑र्नः पाहि वि॒श्वतः॑",
      "start": 114.12,
      "end": 118.72
    },
    {
      "text": "स॒ह र॒य्या नि व॑र्त॒स्वाग्ने॒",
      "start": 118.72,
      "end": 124.84
    },
    {
      "text": "पिन्व॑स्व॒ धार॑या",
      "start": 124.84,
      "end": 127.32
    },
    {
      "text": "वि॒श्वफ्स्नि॑या वि॒श्वत॒स्परि॑",
      "start": 127.32,
      "end": 127.32
    },
    {
      "text": "पुन॑स्त्वा ऽऽदि॒त्या रु॒द्रा वस॑वः॒",
      "start": 127.32,
      "end": 127.32
    },
    {
      "text": "समि॑न्धतां॒ पुन॑र्ब्र॒ह्माणो॑ वसुनीथ य॒ज्ञिः",
      "start": 127.32,
      "end": 127.32
    },
    {
      "text": "घृ॒तेन॒ त्वं त॒नुवो॑ वर्द्धयस्व",
      "start": 127.32,
      "end": 129.36
    },
    {
      "text": "स॒त्याः स॑न्तु॒ यज॑मानस्य॒ कामाः᳚",
      "start": 129.36,
      "end": 138.24
    },
    {
      "text": "बोधा॑ नो अ॒स्य वच॑सो",
      "start": 138.24,
      "end": 143.6
    },
    {
      "text": "यविष्ठ॒ मꣳहि॑ष्ठस्य॒ प्रभृ॑तस्य स्वधावः",
      "start": 143.6,
      "end": 150.44
    },
    {
      "text": "पीय॑ति त्वो॒ अनु॑ (",
      "start": 150.44,
      "end": 150.52
    },
    {
      "text": ") त्वो गृणाति व॒न्दारु॑स्ते",
      "start": 150.52,
      "end": 150.52
    },
    {
      "text": "त॒नुवं॑ ॅवन्दे अग्ने",
      "start": 150.52,
      "end": 151.32
    },
    {
      "text": "स बो॑धि सू॒रिर्म॒घवा॑ वसु॒दावा॒ वसु॑पतिः",
      "start": 151.32,
      "end": 155.64
    },
    {
      "text": "यु॒यो॒द्ध्य॑स्मद् द्वेषाꣳ॑सि",
      "start": 155.64,
      "end": 158.96
    }
  ],
  "total_phrases": 16
}