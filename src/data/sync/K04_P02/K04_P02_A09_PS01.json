  "phrases": [
    {
      "text": "ध्रु॒वाऽसि॑ ध॒रुणाऽस्तृ॑ता वि॒श्वक॑र्मणा॒ सुकृ॑ता",
      "start": 0.0,
      "end": 7.36
    },
    {
      "text": "मा त्वा॑ समु॒द्र उद्व॑धी॒न्मा",
      "start": 7.36,
      "end": 9.48
    },
    {
      "text": "सु॑प॒र्णो व्य॑थमाना पृथि॒वीं दृꣳ॑ह",
      "start": 9.48,
      "end": 13.24
    },
    {
      "text": "प्र॒जाप॑तिस्त्वा सादयतु पृथि॒व्याः पृ॒ष्ठे",
      "start": 13.24,
      "end": 18.8
    },
    {
      "text": "व्यच॑स्वतीं॒ प्रथ॑स्वतीं॒ प्रथो॑ऽसि पृथि॒व्य॑सि॒",
      "start": 18.8,
      "end": 19.92
    },
    {
      "text": "भूर॑सि॒ भूमि॑र॒स्यदि॑तिरसि वि॒श्वधा॑या॒ विश्व॑स्य॒",
      "start": 19.92,
      "end": 28.36
    },
    {
      "text": "भुव॑नस्य ध॒र्त्री पृ॑थि॒वीं ॅय॑च्छ",
      "start": 28.36,
      "end": 34.04
    },
    {
      "text": "पृथि॒वीं दृꣳ॑ह पृथि॒वीं मा",
      "start": 34.04,
      "end": 34.04
    },
    {
      "text": "हिꣳ॑सी॒र्विश्व॑स्मै प्रा॒णाया॑पा॒नाय॑ व्या॒नायो॑दा॒नाय॑ प्रति॒ष्ठायै॑",
      "start": 34.04,
      "end": 41.52
