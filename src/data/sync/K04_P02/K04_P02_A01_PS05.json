  "phrases": [
    {
      "text": "उ॒पस्थे॒ विश्वा᳚न्यग्ने व॒युना॑नि वि॒द्वान्",
      "start": 138.4,
      "end": 139.08
    },
    {
      "text": "मैना॑म॒र्चिषा॒ मा तप॑सा॒ऽभि शू॑शुचो॒ऽन्तर॑स्याꣳ",
      "start": 139.08,
      "end": 146.0
    },
    {
      "text": "शु॒क्रज्यो॑ति॒र्वि भा॑हि",
      "start": 146.0,
      "end": 147.64
    },
    {
      "text": "अ॒न्तर॑ग्ने रु॒चा त्वमु॒खायै॒ सद॑ने॒ स्वे",
      "start": 147.64,
      "end": 148.88
    },
    {
      "text": "तस्या॒स्त्वꣳ हर॑सा॒ तप॒ञ्जात॑वेदः शि॒वो भ॑व",
      "start": 148.88,
      "end": 158.24
    },
    {
      "text": "शि॒वो भू॒त्वा मह्य॑म॒ग्नेऽथो॑ सीद शि॒वस्त्वं",
      "start": 158.24,
      "end": 162.52
    },
    {
      "text": "शि॒वाः कृ॒त्वा दिशः॒ सर्वाः॒",
      "start": 162.52,
      "end": 167.84
    },
    {
      "text": "स्वां ॅयोनि॑मि॒हाऽऽ स॑दः",
      "start": 167.84,
      "end": 171.96
    },
    {
      "text": "हꣳ॒॒सः शु॑चि॒ष ( )",
      "start": 171.96,
      "end": 173.92
    },
    {
      "text": "द्वसु॑रन्तरिक्ष॒-सद्धोता॑ वेदि॒षदति॑थि र्दुरोण॒सत्",
      "start": 173.92,
      "end": 178.0
    },
    {
      "text": "नृ॒षद्व॑र॒सद् ऋ॑त॒सद् व्यो॑म॒सद् अ॒ब्जा",
      "start": 178.0,
      "end": 178.0
    },
    {
      "text": "गो॒जा ऋ॑त॒जा अ॑द्रि॒जा ऋ॒तं",
