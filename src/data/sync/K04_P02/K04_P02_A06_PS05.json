  "phrases": [
    {
      "text": "ओष॑धयः॒ सोम॑राज्ञीः॒ प्रवि॑ष्टाः पृथि॒वीमनु॑",
      "start": 152.56,
      "end": 160.08
    },
    {
      "text": "तासां॒ त्वम॑स्युत्त॒मा प्रणो॑ जी॒वात॑वे-सुव",
      "start": 160.08,
      "end": 160.08
    },
    {
      "text": "अ॒व॒पत॑न्तीरवदन् दि॒व ओष॑दयः॒ परि॑",
      "start": 160.08,
      "end": 160.08
    },
    {
      "text": "यं जी॒व म॒श्ञवा॑ महै॒",
      "start": 160.08,
      "end": 160.08
    },
    {
      "text": "न स रि॑ष्याति॒ पूरु॑षः",
      "start": 160.08,
      "end": 160.08
    },
    {
      "text": "याश्चे॒द मु॑प-शृ॒ण्वन्ति॒ याश्च॑ दू॒रं परा॑गताः",
      "start": 160.08,
      "end": 167.12
    },
    {
      "text": "इ॒ह स॒ङ्गत्य॒ ताः सर्वा॑",
      "start": 167.12,
      "end": 172.96
    },
    {
      "text": "अ॒स्मै सं द॑त्त भेष॒जं",
      "start": 172.96,
      "end": 178.48
    },
    {
      "text": "मा वो॑ रिषत् खनि॒ता",
      "start": 178.48,
      "end": 179.36
    },
    {
      "text": "यस्मै॑ चा॒हं खना॑मि वः",
      "start": 179.36,
      "end": 180.72
    },
    {
      "text": "( )",
      "start": 180.72,
      "end": 180.72
    },
    {
      "text": "द्वि॒प-च्चतु॑ष्प-द॒स्माकꣳ॒॒ सर्व॑-म॒स्त्वना॑तुरं",
      "start": 180.72,
      "end": 192.96
    },
    {
      "text": "ओष॑धयः॒ सं ॅव॑दन्ते॒ सोमे॑न",
      "start": 192.96,
      "end": 197.6
    },
    {
      "text": "स॒ह राज्ञा᳚",
      "start": 197.6,
      "end": 199.36
    },
    {
      "text": "यस्मै॑ क॒रोति॑ ब्राह्म॒णस्तꣳ रा॑जन् पारयामसि",
      "start": 199.36,
      "end": 207.72
    }
  ],
