  "phrases": [
    {
      "text": "प॒दꣳ सदा॑ पश्यन्ति सू॒रयः॑",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "दि॒वीव॒ चक्षु॒रात॑तं",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "ध्रु॒वाऽसि॑ पृथिवि॒ सह॑स्व पृतन्य॒तः",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "स्यू॒ता दे॒वेभि॑र॒मृते॒ना ऽऽगाः᳚",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "यास्ते॑ अग्ने॒ सूर्ये॒ रुच॑",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "उद्य॒तो दिव॑मात॒न्वन्ति॑ र॒श्मिभिः॑",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "ताभिः॒ सर्वा॑भी रु॒चे जना॑य नस्कृधि",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "या वो॑ देवाः॒ सूर्ये॒",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "रुचो॒ गोष्वश्वे॑षु॒ या रुचः॑",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "इन्द्रा᳚ग्नी॒ ताभिः॒ सर्वा॑भी॒ रुचं॑",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "नो धत्त बृहस्पते",
      "start": 136.52,
      "end": 136.52
    },
    {
      "text": "वि॒राड् - [ ]",
