  "panchasat": 3,
  "phrases": [
    {
      "text": "ॅवाव र॑थन्त॒रं भ॑वि॒ष्यद्-बृ॒॒हद् भू॒ताच्चै॒वैनं॑",
      "start": 69.32,
      "end": 69.32
    },
    {
      "text": "भविष्य॒तश्चा॒न्तरे॑ति॒, परि॑मितं॒ ॅवाव र॑थन्त॒रमप॑रिमितं",
      "start": 69.32,
      "end": 69.32
    },
    {
      "text": "बृ॒हत् परि॑मिताच्चै॒वैन॒-मप॑रिमिताच्चा॒ऽन्तरे॑ति विश्वामित्रजमद॒ग्नी वसि॑ष्ठेनास्पर्द्धेताꣳ॒॒स",
      "start": 69.32,
      "end": 80.76
    },
    {
      "text": "ए॒तज्ज॒मद॑ग्नि र्विह॒व्य॑म पश्य॒त् तेन॒",
      "start": 80.76,
      "end": 87.64
    },
    {
      "text": "वै स वसि॑ष्ठस्येन्द्रि॒यं ॅवी॒र्य॑मवृङ्क्त॒",
      "start": 87.64,
      "end": 95.64
    },
    {
      "text": "यद्वि॑ह॒व्यꣳ॑ श॒स्यत॑ इन्द्रि॒यमे॒व तद्वी॒र्यं॑",
      "start": 95.64,
      "end": 106.2
    },
    {
      "text": "ॅयज॑मानो॒ भ्रातृ॑व्यस्य वृङ्क्ते॒ (",
      "start": 106.2,
      "end": 111.12
    },
    {
      "text": ") यस्य॒ भूयाꣳ॑सो यज्ञ्क्र॒तव॒",
      "start": 111.12,
      "end": 114.52
    },
    {
      "text": "इत्या॑हुः॒ स दे॒वता॑ वृङ्क्त॒",
      "start": 114.52,
      "end": 114.52
    },
    {
      "text": "इति॒ यद्य॑ग्निष्टो॒मः सोमः॑ प॒रस्ता॒थ्",
      "start": 114.52,
      "end": 120.24
    },
    {
      "text": "स्या-दु॒क्थ्यं॑ कुर्वीत॒ यद्यु॒क्थ्यः॑ स्याद॑तिरा॒त्रं",
      "start": 120.24,
      "end": 120.24
    },
    {
      "text": "कु॑र्वीत यज्ञ्क्र॒तुभि॑रे॒वास्य॑ दे॒वता॑ वृङ्क्ते॒",
      "start": 120.24,
      "end": 126.12
    },
    {
      "text": "वसी॑यान् भवति",
      "start": 126.12,
      "end": 128.24
    }
  ],
  "total_phrases": 13
}