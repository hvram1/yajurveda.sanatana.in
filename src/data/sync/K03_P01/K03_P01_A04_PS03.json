    },
    {
      "text": "उ॒पाकृ॑तꣳ शशमा॒नं ॅयदस्था᳚ज्जी॒वं दे॒वाना॒मप्ये॑तु॒ पाथः॑",
      "start": 78.6,
      "end": 86.88
    },
    {
      "text": "नाना᳚ प्रा॒णो यज॑मानस्य प॒शुना॑",
      "start": 86.88,
      "end": 93.8
    },
    {
      "text": "य॒ज्ञो दे॒वेभिः॑ स॒ह दे॑व॒यानः॑",
      "start": 93.8,
      "end": 101.24
    },
    {
      "text": "जी॒वं दे॒वाना॒मप्ये॑तु॒ पाथः॑ स॒त्याः",
      "start": 101.24,
      "end": 105.0
    },
    {
      "text": "स॑न्तु॒ यज॑मानस्य॒ कामाः᳚",
      "start": 105.0,
      "end": 108.2
    },
    {
      "text": "यत् प॒शुर्मा॒युमकृ॒तोरो॑ वा प॒द्भिरा॑ह॒ते",
      "start": 108.2,
      "end": 115.6
    },
    {
