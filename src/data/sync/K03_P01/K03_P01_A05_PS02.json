      "start": 38.4,
      "end": 47.76
    },
    {
      "text": "मेध॒मव॑ रु॒न्धेऽथो॑ शृत॒त्वाय॑ पु॒रस्ता᳚थ्",
      "start": 47.76,
      "end": 56.44
    },
    {
