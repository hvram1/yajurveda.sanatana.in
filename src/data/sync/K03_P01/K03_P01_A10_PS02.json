  "phrases": [
    {
      "text": "पु॑रो॒डाशा᳚त् कर॒म्भात्",
      "start": 35.2,
      "end": 38.64
    },
    {
      "text": "धा॒ना॒सो॒मान्म॒न्थिन॑ इन्द्र शु॒क्राथ् स्वाहा॑कृत॒मिन्द्रा॑य॒",
      "start": 38.64,
      "end": 52.12
    },
    {
      "text": "तं जु॑होमि",
      "start": 52.12,
      "end": 52.76
    },
    {
      "text": "यस्ते᳚ द्र॒फ्सो मधु॑माꣳ इन्द्रि॒यावा॒न्थ्",
      "start": 52.76,
      "end": 55.32
    },
    {
      "text": "स्वाहा॑कृतः॒ पुन॑र॒प्येति॑ दे॒वान्",
      "start": 55.32,
      "end": 55.32
    },
    {
      "text": "दि॒वः पृ॑थि॒व्याः पर्य॒न्तरि॑क्षा॒थ् स्वाहा॑",
      "start": 55.32,
      "end": 55.32
    },
    {
      "text": "कृत॒मिन्द्रा॑य॒ तं जु॑होमि",
      "start": 55.32,
      "end": 55.32
    },
    {
      "text": "अ॒द्ध्व॒र्युर्वा ऋ॒त्विजां᳚ प्रथ॒मो यु॑ज्यते॒",
      "start": 55.32,
      "end": 55.32
    },
    {
      "text": "तेन॒ स्तोमो॑ योक्त॒व्य॑ इत्या॑हु॒र्वाग॑ग्रे॒गा",
      "start": 55.32,
      "end": 55.32
    },
    {
      "text": "अग्र॑ एत्वृजु॒गा दे॒वेभ्यो॒ यशो॒",
      "start": 55.32,
      "end": 59.88
    },
    {
      "text": "मयि॒ दध॑ती प्रा॒णान् प॒शुषु॑",
      "start": 59.88,
      "end": 65.0
    },
    {
      "text": "प्र॒जां मयि॑- [ ]",
