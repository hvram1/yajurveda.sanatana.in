    {
      "text": "क॑र्म॒ण्यः॑ सु॒दक्षो॑ यु॒क्तग्रा॑वा॒ जाय॑ते दे॒वका॑मः",
      "start": 31.64,
      "end": 41.24
    },
    {
      "text": "शि॒वस्त्व॑ष्टरि॒हाऽऽ* ग॑हि वि॒भुः पोष॑ उ॒तत्मना᳚",
      "start": 41.24,
      "end": 50.84
    },
    {
      "text": "य॒ज्ञेय॑ज्ञे न॒ उद॑व",
      "start": 50.84,
      "end": 51.76
    },
    {
      "text": "पि॒शङ्ग॑रूपः सु॒भरो॑ वयो॒धाः श्रु॒ष्टी",
      "start": 51.76,
      "end": 58.52
    },
    {
      "text": "वी॒रो जा॑यते दे॒वका॑मः",
      "start": 58.52,
      "end": 61.2
    },
    {
      "text": "प्र॒जां त्वष्टा॒ विष्य॑तु॒ नाभि॑म॒स्मे",
      "start": 61.2,
      "end": 68.56
    },
    {
      "text": "अथा॑ दे॒वाना॒मप्ये॑तु॒ पाथः॑",
      "start": 68.56,
      "end": 72.76
    },
    {
      "text": "प्रणो॑दे॒व्या, नो॑ दि॒वः",
      "start": 72.76,
      "end": 77.36
    },
    {
      "text": "पी॒पि॒वाꣳ सꣳ॒॒ सर॑स्वतः॒ स्तनं॒",
      "start": 77.36,
      "end": 84.6
    },
    {
      "text": "ॅयो वि॒श्वद॑र्.शतः",
      "start": 84.6,
      "end": 88.36
    },
    {
      "text": "धुक्षी॒महि॑ प्र॒जामिषं᳚",
      "start": 88.36,
      "end": 89.8
    }
