  "phrases": [
    {
      "text": "मह्य॑मि॒मानित्य॑ब्रवी॒न्न वै तस्य॒ त",
      "start": 185.52,
      "end": 185.52
    },
    {
      "text": "ई॑शत॒ इत्य॑ब्रवी॒द्-यद्-य॑ज्ञ्वा॒स्तौ हीय॑ते॒ मम॒",
      "start": 185.52,
      "end": 185.52
    },
    {
      "text": "वै तदिति॒ तस्मा᳚द्-यज्ञ्वा॒स्तु नाभ्य॒वेत्यꣳ॒॒",
      "start": 185.52,
      "end": 185.52
    },
    {
      "text": "सो᳚ऽब्रवीद्-य॒ज्ञे मा ऽऽभ॒जाथ॑ ते",
      "start": 185.52,
      "end": 185.52
    },
    {
      "text": "प॒शून् नाभि मꣳ॑स्य॒ इति॒",
      "start": 185.52,
      "end": 185.8
    },
    {
      "text": "तस्मा॑ ए॒तं म॒न्थिनः॑ सꣳ",
      "start": 185.8,
      "end": 189.92
    },
    {
      "text": "स्रा॒वम॑जुहो॒त् ततो॒ वै तस्य॑",
      "start": 189.92,
      "end": 195.32
    },
    {
      "text": "रु॒द्रः प॒शून् नाभ्य॑मन्यत॒ यत्रै॒त",
      "start": 195.32,
      "end": 203.12
    },
    {
      "text": "( ) मे॒वं ॅवि॒द्वान्",
      "start": 203.12,
      "end": 205.56
    },
    {
      "text": "म॒न्थिनः॑ सꣳ स्रा॒वं जु॒होति॒",
      "start": 205.56,
      "end": 209.64
    },
    {
      "text": "न तत्र॑ रु॒द्रः प॒शून॒भि",
      "start": 209.64,
      "end": 212.16
    },
    {
      "text": "म॑न्यते",
      "start": 212.16,
      "end": 214.68
    }
  ],
