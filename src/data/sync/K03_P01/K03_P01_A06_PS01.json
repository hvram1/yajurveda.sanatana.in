  "phrases": [
    {
      "text": "यो वा अय॑थादेवतं ॅय॒ज्ञ्मु॑प॒चर॒त्या",
      "start": 0.0,
      "end": 4.92
    },
    {
      "text": "दे॒वता᳚भ्यो वृश्च्यते॒ पापी॑यान् भवति॒",
      "start": 4.92,
      "end": 10.32
    },
    {
      "text": "यो य॑थादेव॒तन्न दे॒वता᳚भ्य॒ आ",
      "start": 10.32,
      "end": 14.6
    },
    {
      "text": "वृ॑श्च्यते॒ वसी॑यान् भवत्याग्ने॒य्यर्चा ऽऽग्नी᳚द्ध्रम॒भि",
      "start": 14.6,
      "end": 24.92
    },
    {
      "text": "मृ॑शेद् वैष्ण॒व्या ह॑वि॒र्द्धान॑माग्ने॒य्या स्रुचो॑",
      "start": 24.92,
      "end": 34.6
    },
    {
      "text": "वाय॒व्य॑या वाय॒व्या᳚न्यैन्द्रि॒या सदो॑ यथादेव॒तमे॒व",
      "start": 34.6,
      "end": 39.48
    },
    {
      "text": "य॒ज्ञ्मुप॑ चरति॒ न दे॒वता᳚भ्य॒",
      "start": 39.48,
      "end": 39.48
    },
    {
      "text": "आ वृ॑श्च्यते॒ वसी॑यान् भवति",
      "start": 39.48,
      "end": 39.48
    },
    {
      "text": "यु॒नज्मि॑ ते पृथि॒वीं ज्योति॑षा",
      "start": 39.48,
      "end": 39.52
    },
    {
      "text": "स॒ह यु॒नज्मि॑ वा॒युम॒न्तरि॑क्षेण -",
