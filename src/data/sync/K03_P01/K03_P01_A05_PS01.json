  "phrases": [
    {
      "text": "प्रा॒जा॒प॒त्या वै प॒शव॒स्तेषाꣳ॑ रु॒द्रोऽधि॑पति॒र्य-दे॒ताभ्या॑-मुपा",
      "start": 0.0,
      "end": 14.92
    },
    {
      "text": "क॒रोति॒ ताभ्या॑मे॒वैनं॑ प्रति॒प्रोच्याऽऽल॑भत आ॒त्मनोऽना᳚व्रस्काय॒",
      "start": 14.92,
      "end": 19.64
    },
    {
      "text": "द्वाभ्या॑मु॒पाक॑रोति द्वि॒पाद्यज॑मानः॒ प्रति॑ष्ठित्या उपा॒कृत्य॒",
      "start": 19.64,
      "end": 19.64
    },
    {
      "text": "पञ्च॑ जुहोति॒ पाङ्क्ताः᳚ प॒शवः॑",
      "start": 19.64,
      "end": 19.64
    },
    {
      "text": "प॒शूने॒वा व॑रुन्धेमृ॒त्यवे॒ वा ए॒ष",
      "start": 19.64,
      "end": 19.64
    },
    {
      "text": "नी॑यते॒ यत् प॒शुस्तं ॅयद॑न्वा॒रभे॑त",
      "start": 19.64,
      "end": 19.64
    },
    {
      "text": "प्र॒मायु॑को॒ यज॑मानः स्या॒न्नाना᳚ प्रा॒णो",
      "start": 19.64,
      "end": 19.64
    },
    {
      "text": "यज॑मानस्य प॒शुनेत्या॑ह॒ व्यावृ॑त्त्यै॒ -",
      "start": 19.64,
      "end": 30.48
