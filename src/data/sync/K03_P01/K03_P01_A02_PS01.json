    {
      "text": "ए॒ष ते॑ गाय॒त्रो भा॒ग",
      "start": 0.0,
      "end": 3.36
    },
    {
      "text": "इति॑ मे॒ सोमा॑य ब्रूतादे॒ष",
      "start": 3.36,
      "end": 4.56
    },
    {
      "text": "ते॒ त्रैष्टु॑भो॒ जाग॑तो भा॒ग",
      "start": 4.56,
      "end": 8.8
    },
    {
      "text": "इति॑ मे॒ सोमा॑य ब्रूताच्छन्दो॒मानाꣳ॒॒",
      "start": 8.8,
      "end": 12.52
    },
    {
      "text": "साम्रा᳚ज्यं ग॒च्छेति॑ मे॒ सोमा॑य",
      "start": 12.52,
      "end": 16.56
    },
    {
      "text": "ब्रूता॒द् यो वै सोमꣳ॒॒",
      "start": 16.56,
      "end": 18.8
    },
    {
      "text": "राजा॑नꣳ॒॒ साम्रा᳚ज्यं ॅलो॒कं ग॑मयि॒त्वा",
      "start": 18.8,
      "end": 20.2
    },
    {
      "text": "क्री॒णाति॒ गच्छ॑ति॒ स्वानाꣳ॒॒ साम्रा᳚ज्यं॒",
      "start": 20.2,
      "end": 23.48
    },
    {
      "text": "छन्दाꣳ॑सि॒ खलु॒ वै सोम॑स्य॒",
      "start": 23.48,
      "end": 29.44
    },
    {
      "text": "राज्ञ्ः॒ साम्रा᳚ज्यो लो॒कः पु॒रस्ता॒थ्",
      "start": 29.44,
      "end": 33.88
    },
    {
      "text": "सोम॑स्य क्र॒यादे॒वम॒भि म॑न्त्रयेत॒ साम्रा᳚ज्यमे॒वै",
      "start": 33.88,
      "end": 38.04
    },
