  "phrases": [
    {
      "text": "यो वै दे॒वान् दे॑वयश॒सेना॒र्पय॑ति",
      "start": 0.0,
      "end": 5.68
    },
    {
      "text": "मनु॒ष्या᳚न् मनुष्ययश॒सेन॑ देवयश॒स्ये॑व दे॒वेषु॒",
      "start": 5.68,
      "end": 14.68
    },
    {
      "text": "भव॑ति मनुष्ययश॒सी म॑नु॒ष्ये॑षु॒ यान्",
      "start": 14.68,
      "end": 21.52
    },
    {
      "text": "प्रा॒चीन॑-माग्रय॒णाद् ग्रहा᳚न् गृह्णी॒यात् तानु॑पाꣳ॒॒शु",
      "start": 21.52,
      "end": 31.56
    },
    {
      "text": "गृ॑ह्णीया॒द्यानू॒र्द्ध्वाꣳस्तानु॑पब्दि॒मतो॑ दे॒वाने॒व तद्दे॑वयश॒सेना᳚र्पयति मनु॒ष्या᳚न्",
      "start": 31.56,
      "end": 32.84
    },
    {
      "text": "मनुष्ययश॒सेन॑ देवयश॒स्ये॑व दे॒वेषु॑ भवति",
      "start": 32.84,
      "end": 32.84
    },
    {
      "text": "मनुष्ययश॒सी म॑नु॒ष्ये᳚ष्व॒ग्निः प्रा॑तस्सव॒ने पा᳚त्व॒स्मान्.",
      "start": 32.84,
      "end": 39.04
    },
    {
      "text": "वै᳚श्वान॒रो म॑हि॒ना वि॒श्वश॑म्भूः",
      "start": 39.04,
      "end": 46.56
    },
    {
      "text": "स नः॑ पाव॒को द्रवि॑णं",
      "start": 46.56,
      "end": 51.16
    },
    {
      "text": "दधा॒त्वा - [ ]",
      "start": 51.16,
      "end": 52.64
    }
  ],
