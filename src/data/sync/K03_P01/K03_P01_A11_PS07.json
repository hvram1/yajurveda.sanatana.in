  "phrases": [
    {
      "text": "मा॒या मा॒यिनां᳚ ॅविश्वमिन्व॒ त्वे",
      "start": 234.2,
      "end": 235.44
    },
    {
      "text": "पू॒र्वीः स॑न्द॒धुः पृ॑ष्टबन्धो",
      "start": 235.44,
      "end": 235.44
    },
    {
      "text": "दि॒वो नो॑ वृ॒ष्टिं म॑रुतो",
      "start": 235.44,
      "end": 235.44
    },
    {
      "text": "ररीद्ध्वं॒ प्रपि॑न्वत॒ वृष्णो॒ अश्व॑स्य॒",
      "start": 235.44,
      "end": 242.08
    },
    {
      "text": "धाराः᳚",
      "start": 242.08,
      "end": 242.24
    },
    {
      "text": "अ॒र्वाङे॒तेन॑ स्तनयि॒त्नुनेह्य॒पो नि॑षि॒ञ्चन्नसु॑रः पि॒ता नः॑",
      "start": 242.24,
      "end": 249.84
    },
    {
      "text": "पिन्व॑न्त्य॒पो म॒रुतः॑ सु॒दान॑वः॒ पयो॑",
      "start": 249.84,
      "end": 256.04
    },
    {
      "text": "घृ॒तव॑द्वि॒दथे᳚ष्वा॒ भुवः॑",
      "start": 256.04,
      "end": 260.88
    },
    {
      "text": "अत्यं॒ न मि॒हे वि",
      "start": 260.88,
      "end": 264.28
    },
    {
      "text": "न॑यन्ति वा॒जिन॒मुथ्सं॑ दुहन्ति स्त॒नय॑न्त॒मक्षि॑तं",
      "start": 264.28,
      "end": 272.88
    },
    {
      "text": "उ॒द॒प्रुतो॑ मरुत॒स्ताꣳ इ॑यर्त॒ वृष्टिं॒",
