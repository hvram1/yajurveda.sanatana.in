  "phrases": [
    {
      "text": "दे॒वेभि॑रिन्वि॒तं",
      "start": 125.64,
      "end": 125.64
    },
    {
      "text": "पाशा᳚त् प॒शुं प्रमु॑ञ्चत ब॒न्धाद्य॒ज्ञ्प॑तिं॒ परि॑",
      "start": 125.64,
      "end": 126.0
    },
    {
      "text": "अदि॑तिः॒ पाशं॒ प्रमु॑मोक्त्वे॒तं नमः॑",
      "start": 126.0,
      "end": 132.96
    },
    {
      "text": "प॒शुभ्यः॑ पशु॒पत॑ये करोमि",
      "start": 132.96,
      "end": 135.52
    },
    {
      "text": "अ॒रा॒ती॒यन्त॒-मध॑रं कृणोमि॒ यं द्वि॒ष्मस्तस्मि॒न्",
      "start": 135.52,
      "end": 142.6
    },
    {
      "text": "प्रति॑ मुञ्चामि॒ पाशं᳚",
      "start": 142.6,
      "end": 144.8
    },
    {
      "text": "त्वामु॒ ते द॑धिरे हव्य॒वाहꣳ॑",
      "start": 144.8,
      "end": 148.52
    },
    {
      "text": "शृतंक॒र्तार॑मु॒त य॒ज्ञियं॑ च",
      "start": 148.52,
      "end": 148.52
    },
    {
      "text": "अग्ने॒ सद॑क्षः॒ सत॑नु॒र्॒.हि भू॒त्वाऽथ॑",
      "start": 148.52,
      "end": 149.32
    },
    {
      "text": "ह॒व्या जा॑तवेदो जुषस्व",
      "start": 149.32,
      "end": 151.48
    },
    {
      "text": "जात॑वेदो व॒पया॑ गच्छ दे॒वान्त्वꣳ",
      "start": 151.48,
      "end": 157.68
    },
    {
      "text": "( ) हि होता᳚",
      "start": 157.68,
      "end": 158.44
    },
    {
      "text": "प्रथ॒मो ब॒भूथ॑",
      "start": 158.44,
      "end": 160.4
    },
    {
      "text": "घृ॒तेन॒ त्वं त॒नुवो॑ वर्द्धयस्व॒",
      "start": 160.4,
      "end": 164.8
    },
    {
      "text": "स्वाहा॑कृतꣳ ह॒विर॑दन्तु दे॒वाः",
      "start": 164.8,
      "end": 170.16
    },
    {
      "text": "स्वाहा॑ दे॒वेभ्यो॑ दे॒वेभ्यः॒ स्वाहा᳚",
      "start": 170.16,
      "end": 179.84
    }
  ],
  "total_phrases": 16
}