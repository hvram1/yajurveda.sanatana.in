  "phrases": [
    {
      "text": "कस्त्वा᳚ च्छ्यति॒ कस्त्वा॒ वि",
      "start": 0.0,
      "end": 7.6
    },
    {
      "text": "शा᳚स्ति॒ कस्ते॒ गात्रा॑णि शिम्यति",
      "start": 7.6,
      "end": 12.28
    },
    {
      "text": "क उ॑ ते शमि॒ता क॒विः",
      "start": 12.28,
      "end": 14.72
    },
    {
      "text": "ऋ॒तव॑स्त ऋतु॒धा परुः॑ शमि॒तारो॒ विशा॑सतु",
      "start": 14.72,
      "end": 20.84
    },
    {
      "text": "सं॒ॅव॒थ्स॒रस्य॒ धाय॑सा॒ शिमी॑भिः शिम्यन्तु त्वा",
      "start": 20.84,
      "end": 28.76
    },
    {
      "text": "दैव्या॑ अद्ध्व॒र्यव॑स्त्वा॒ च्छ्यन्तु॒ वि",
      "start": 28.76,
      "end": 29.68
    },
    {
      "text": "च॑ शासतु",
      "start": 29.68,
      "end": 29.68
    },
    {
      "text": "गात्रा॑णि पर्व॒शस्ते॒ शिमाः᳚ कृण्वन्तु॒ शिम्य॑न्तः",
      "start": 29.68,
      "end": 29.68
    },
    {
      "text": "अ॒र्द्ध॒मा॒साः परूꣳ॑षि ते॒ मासाः᳚",
      "start": 29.68,
      "end": 32.76
    },
    {
      "text": "छ्यन्तु॒ शिम्य॑न्तः",
      "start": 32.76,
      "end": 37.6
    },
    {
      "text": "अ॒हो॒रा॒त्राणि॑ म॒रुतो॒ विलि॑ष्टꣳ -",
