  "phrases": [
    {
      "text": "-प॑ दधाति॒ तस्मा॑दक्ष्ण॒या प॒शवोऽङ्गा॑नि॒",
      "start": 130.88,
      "end": 140.6
    },
    {
      "text": "प्रह॑रन्ति॒ प्रति॑ष्ठित्यै॒ याः प्राची॒स्ताभि॒-र्वसि॑ष्ठ",
      "start": 140.6,
      "end": 145.92
    },
    {
      "text": "आर्द्ध्नो॒द्या द॑क्षि॒णा ताभि॑र्भ॒रद्वा॑जो॒ याः",
      "start": 145.92,
      "end": 155.2
    },
    {
      "text": "प्र॒तीची॒स्ताभि॑ र्वि॒श्वामि॑त्रो॒ या उदी॑ची॒स्ताभि॑-र्ज॒मद॑ग्नि॒र्या",
      "start": 155.2,
      "end": 162.84
    },
    {
      "text": "ऊ॒र्द्ध्वास्ताभि॑-र्वि॒श्वक॑र्मा॒ य ए॒वमे॒तासा॒मृद्धिं॒ ॅवेद॒र्द्ध्नोत्ये॒व",
      "start": 162.84,
      "end": 166.28
    },
    {
      "text": "य आ॑सामे॒वं ब॒न्धुतां॒ ॅवेद॒",
      "start": 166.28,
      "end": 169.72
    },
    {
      "text": "बन्धु॑मान् भवति॒ य आ॑सामे॒वं",
