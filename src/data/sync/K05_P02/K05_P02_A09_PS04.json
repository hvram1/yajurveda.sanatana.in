  "phrases": [
    {
      "text": "विषू॒चीना॑नि॒ तस्योप॑ दद्ध्या॒द्-विषू॑च ए॒वास्मा᳚त्",
      "start": 101.04,
      "end": 105.0
    },
    {
      "text": "प॒शून् द॑धात्यप॒शुरे॒व भ॑वति॒ यं",
      "start": 105.0,
      "end": 111.76
    },
    {
      "text": "का॒मये॑त पशु॒मान्थ्-स्या॒दिति॑ समी॒चीना॑नि॒ तस्योप॑",
      "start": 111.76,
      "end": 122.76
    },
    {
