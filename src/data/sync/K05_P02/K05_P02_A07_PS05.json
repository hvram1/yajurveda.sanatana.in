  "phrases": [
    {
      "text": "म॒मुष्मि॑न् ॅलो॒क उप॑तिष्ठेते वि॒राज्य॒ग्निश्चे॑त॒व्य॑",
      "start": 157.88,
      "end": 157.88
    },
    {
      "text": "इत्या॑हुः॒ स्रुग्वै वि॒राड्यथ् स्रुचा॑वुप॒दधा॑ति",
      "start": 157.88,
      "end": 157.88
    },
    {
      "text": "वि॒राज्ये॒वाग्निं चि॑नुते यज्ञ्मु॒खेय॑ज्ञ्मुखे॒ वै",
      "start": 157.88,
      "end": 157.88
    },
    {
      "text": "क्रि॒यमा॑णे य॒ज्ञ्ꣳ रक्षाꣳ॑सि जिघाꣳसन्ति",
      "start": 157.88,
      "end": 161.52
    },
    {
      "text": "यज्ञ्मु॒खꣳ रु॒क्मो यद्-रु॒क्मं ॅव्या॑घा॒रय॑ति",
      "start": 161.52,
      "end": 167.0
    },
    {
      "text": "यज्ञ्मु॒खादे॒व रक्षाꣳ॒॒स्यप॑ हन्ति प॒ञ्चभि॒व्या",
      "start": 167.0,
      "end": 173.4
    },
    {
      "text": "घा॑रयति॒ पाङ्क्तो॑ य॒ज्ञो यावा॑ने॒व",
      "start": 173.4,
      "end": 173.4
    },
    {
      "text": "य॒ज्ञ्स्तस्मा॒द्-रक्षाꣳ॒॒स्यप॑ हन्त्यक्ष्ण॒याव्या घा॑रयति॒ तस्मा॑दक्ष्ण॒या",
      "start": 173.4,
      "end": 180.16
    },
    {
      "text": "( ) प॒शवोऽङ्गा॑नि॒ प्र",
      "start": 180.16,
      "end": 183.68
    },
    {
      "text": "ह॑रन्ति॒ प्रति॑ष्ठित्यै",
      "start": 183.68,
      "end": 188.92
    }
  ],
  "total_phrases": 10
