  "phrases": [
    {
      "text": "-दन॑वरुद्धस्या-श्नी॒यादव॑-रुद्धेन॒ व्यृ॑द्ध्येत॒ ये वन॒स्पती॑नां",
      "start": 160.24,
      "end": 172.08
    },
    {
      "text": "फल॒ग्रह॑य॒-स्तानि॒द्ध्मेऽपि॒ प्रोक्षे॒-दन॑वरुद्ध॒स्या-व॑रुद्ध्यै दि॒ग्भ्यो लो॒ष्टान्थ्",
      "start": 172.08,
      "end": 184.64
    },
    {
      "text": "सम॑स्यति दि॒शामे॒व वी॒र्य॑मव॒रुद्ध्य॑ दि॒शां",
      "start": 184.64,
      "end": 190.12
    },
    {
      "text": "ॅवी॒र्ये᳚ऽग्निं चि॑नुते॒ यं द्वि॒ष्याद्-यत्र॒",
      "start": 190.12,
      "end": 196.88
    },
    {
      "text": "स स्यात् तस्यै॑ दि॒शो",
      "start": 196.88,
      "end": 198.64
    },
    {
      "text": "लो॒ष्टमा ह॑रे॒दिष॒-मूर्ज॑म॒हमि॒त आ द॑द॒",
      "start": 198.64,
      "end": 204.28
    },
    {
      "text": "इतीष॑मे॒वोर्जं॒ तस्यै॑ दि॒शोऽव॑ (",
      "start": 204.28,
      "end": 208.92
    },
    {
      "text": ") रुन्धे॒ क्षोधु॑को भवति॒",
      "start": 208.92,
      "end": 212.92
    },
    {
      "text": "यस्तस्यां᳚ दि॒शि भव॑त्युत्तरवे॒दिमुप॑ वपत्युत्तरवे॒द्याꣳ",
      "start": 212.92,
      "end": 218.4
    },
    {
      "text": "ह्य॑ग्निश्ची॒यते ऽथो॑ प॒शवो॒ वा",
      "start": 218.4,
      "end": 219.36
    },
    {
      "text": "उ॑त्तरवे॒दिः प॒शूने॒वाव॑ रु॒न्धेऽथो॑ यज्ञ्प॒रुषोऽन॑न्तरित्यै",
      "start": 219.36,
      "end": 221.84
    }
  ],
  "total_phrases": 11
}