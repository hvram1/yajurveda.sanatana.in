  "phrases": [
    {
      "text": "पु॒रस्ता᳚त् प्र॒त्यञ्चः॑ प॒शवो॒ मेध॒मुप॑",
      "start": 204.6,
      "end": 211.72
    },
    {
      "text": "तिष्ठन्ते॒ यो वा अप॑नाभिम॒ग्निं",
      "start": 211.72,
      "end": 214.16
    },
    {
      "text": "चि॑नु॒ते यज॑मानस्य॒ नाभि॒मनु॒ प्रवि॑शति॒",
      "start": 214.16,
      "end": 223.04
    },
    {
      "text": "स ए॑नमीश्व॒रो हिꣳसि॑तोरु॒लूख॑ल॒मुप॑ दधात्ये॒षा",
      "start": 223.04,
      "end": 226.72
    },
    {
      "text": "वा अ॒ग्नेर्नाभिः॒ सना॑भिमे॒वाऽग्निं चि॑नु॒ते",
      "start": 226.72,
      "end": 232.56
    },
    {
      "text": "हिꣳ॑साया॒ औदु॑म्बरं भव॒त्यूर्ग्वा उ॑दु॒म्बर॒",
      "start": 232.56,
      "end": 236.28
    },
    {
      "text": "ऊर्ज॑मे॒वाव॑ रुन्धे मद्ध्य॒त उप॑",
      "start": 236.28,
      "end": 241.8
    },
    {
      "text": "दधाति मद्ध्य॒त ए॒वास्मा॒ ऊर्जं॑",
      "start": 241.8,
      "end": 246.08
    },
    {
      "text": "दधाति॒ तस्मा᳚न्-( )-मद्ध्य॒त ऊ॒र्जा",
      "start": 246.08,
      "end": 247.88
    },
    {
      "text": "भु॑ञ्जत॒ इय॑द्-भवति प्र॒जाप॑तिना यज्ञ्मु॒खेन॒",
      "start": 247.88,
      "end": 256.76
    },
    {
      "text": "संमि॑त॒मव॑ ह॒न्त्यन्न॑मे॒वाक॑-र्वैष्ण॒व्यर्चोप॑ दधाति॒ विष्णु॒र्वै",
      "start": 256.76,
      "end": 265.96
    },
    {
      "text": "य॒ज्ञो वै᳚ष्ण॒वा वन॒स्पत॑यो य॒ज्ञ्",
      "start": 265.96,
      "end": 272.36
    },
    {
      "text": "ए॒व य॒ज्ञ्ं प्रति॑ष्ठापयति",
      "start": 272.36,
      "end": 275.76
    }
  ],
  "total_phrases": 13
}