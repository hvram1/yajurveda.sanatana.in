    {
      "text": "ए॒षां ॅवा ए॒तल्लो॒कानां॒ ज्योतिः॒",
      "start": 0.0,
      "end": 5.76
    },
    {
      "text": "सम्भृ॑तं॒ ॅयदु॒खा यदु॒खा-मु॑प॒दधा᳚त्ये॒भ्य ए॒व",
      "start": 5.76,
      "end": 13.84
    },
    {
      "text": "लो॒केभ्यो॒ ज्योति॒रव॑ रुन्धे मद्ध्य॒त",
      "start": 13.84,
      "end": 13.88
    },
    {
      "text": "उप॑ दधाति मद्ध्य॒त ए॒वास्मै॒",
      "start": 13.88,
      "end": 19.92
    },
    {
      "text": "ज्योति॑र्दधाति॒ तस्मा᳚न्मद्ध्य॒तो ज्योति॒रुपा᳚ऽऽस्महे॒ सिक॑ताभिः",
      "start": 19.92,
      "end": 29.28
    },
    {
      "text": "पूरयत्ये॒तद्वा अ॒ग्नेर्वै᳚श्वान॒रस्य॑ रू॒पꣳ रू॒पेणै॒व",
      "start": 29.28,
      "end": 36.64
    },
    {
      "text": "वै᳚श्वान॒रमव॑ रुन्धे॒ यं का॒मये॑त॒",
      "start": 36.64,
      "end": 40.8
    },
    {
      "text": "क्षोधु॑कः स्या॒दित्यू॒नां तस्योप॑ -",
