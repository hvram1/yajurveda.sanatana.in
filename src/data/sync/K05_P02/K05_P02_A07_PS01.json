    {
      "text": "ब्रह्म॑ जज्ञा॒नमिति॑ रु॒क्ममुप॑ दधाति॒",
      "start": 0.0,
      "end": 6.4
    },
    {
      "text": "ब्रह्म॑मुखा॒ वै प्र॒जाप॑तिः प्र॒जा",
      "start": 6.4,
      "end": 16.36
    },
    {
      "text": "अ॑सृजत॒ ब्रह्म॑मुखा ए॒व तत्",
      "start": 16.36,
      "end": 22.68
    },
    {
      "text": "प्र॒जा यज॑मानः सृजते॒ ब्रह्म॑",
      "start": 22.68,
      "end": 26.28
    },
    {
      "text": "जज्ञा॒नमित्या॑ह॒ तस्मा᳚द्ब्राह्म॒णो मुख्यो॒ मुख्यो॑",
      "start": 26.28,
      "end": 29.4
    },
    {
      "text": "भवति॒ य ए॒वं ॅवेद॑",
      "start": 29.4,
      "end": 29.4
    },
    {
      "text": "ब्रह्मवा॒दिनो॑ वदन्ति॒ न पृ॑थि॒व्यां",
      "start": 29.4,
      "end": 29.4
    },
    {
      "text": "नान्तरि॑क्षे॒ न दि॒व्य॑ग्निश्चे॑त॒व्य॑ इति॒",
