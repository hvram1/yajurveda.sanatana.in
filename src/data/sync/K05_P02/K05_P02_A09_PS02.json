    {
      "text": "दद्ध्या॒त् क्षोधु॑क ए॒व भ॑वति॒",
      "start": 46.32,
      "end": 52.16
    },
    {
      "text": "यं का॒मये॒ता-नु॑पदस्य॒-दन्न॑मद्या॒दिति॑ पू॒र्णां तस्योप॑",
      "start": 52.16,
      "end": 56.72
    },
    {
      "text": "दद्ध्या॒दनु॑पदस्य-दे॒वान्न॑मत्ति स॒हस्रं॒ ॅवै प्रति॒",
      "start": 56.72,
      "end": 56.72
    },
    {
      "text": "पुरु॑षः पशू॒नां ॅय॑च्छति स॒हस्र॑म॒न्ये",
      "start": 56.72,
      "end": 56.72
    },
    {
      "text": "प॒शवो॒ मद्ध्ये॑ पुरुषशी॒र्॒.षमुप॑ दधाति",
      "start": 56.72,
      "end": 56.72
    },
    {
      "text": "सवीर्य॒त्वायो॒-खाया॒मपि॑ दधाति प्रति॒ष्ठामे॒वैन॑द्-गमयति॒ व्यृ॑द्धं॒",
      "start": 56.72,
      "end": 56.72
    },
    {
      "text": "ॅवा ए॒तत् प्रा॒णैर॑मे॒द्ध्यं ॅयत्",
      "start": 56.72,
      "end": 56.72
    },
    {
      "text": "पु॑रुषशी॒र्.षम॒मृतं॒ खलु॒ वै प्रा॒णा",
      "start": 56.72,
      "end": 56.8
