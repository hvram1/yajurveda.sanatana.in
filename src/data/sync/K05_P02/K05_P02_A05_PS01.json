  "phrases": [
    {
      "text": "पु॒रु॒ष॒मा॒त्रेण॒ वि मि॑मीते य॒ज्ञेन॒",
      "start": 0.0,
      "end": 3.4
    },
    {
      "text": "वै पुरु॑षः॒ संमि॑तो यज्ञ्प॒रुषै॒वैनं॒",
      "start": 3.4,
      "end": 10.2
    },
    {
      "text": "ॅविमि॑मीते॒ यावा॒न् पुरु॑ष ऊ॒र्द्ध्वबा॑हु॒स्तावा᳚न्",
      "start": 10.2,
      "end": 18.24
    },
    {
      "text": "भवत्ये॒ताव॒द्वै पुरु॑षे वी॒र्यं॑ ॅवी॒र्ये॑णै॒वैनं॒",
      "start": 18.24,
      "end": 18.24
    },
    {
      "text": "ॅवि मि॑मीते प॒क्षी भ॑वति॒",
      "start": 18.24,
      "end": 18.24
    },
    {
      "text": "न ह्य॑प॒क्षः पति॑तु॒-मर्.ह॑त्यर॒त्निना॑ प॒क्षौ",
      "start": 18.24,
      "end": 23.28
    },
    {
      "text": "द्राघी॑याꣳसौ भवत॒स्तस्मा᳚त् प॒क्षप्र॑वयाꣳसि॒ वयाꣳ॑सि",
      "start": 23.28,
      "end": 30.56
    },
    {
      "text": "व्याममा॒त्रौ प॒क्षौ च॒ पुच्छं॑",
      "start": 30.56,
      "end": 36.52
    },
    {
      "text": "च भवत्ये॒ताव॒द्वै पुरु॑षे वी॒र्यं॑",
      "start": 36.52,
      "end": 41.6
    },
