  "phrases": [
    {
      "text": "दधाति॒ परा॑चीमे॒वास्मा॒न्-निर्.ऋ॑तिं॒ प्रणु॑द॒ते ऽप्र॑तीक्ष॒मा",
      "start": 110.16,
      "end": 110.16
    },
    {
      "text": "य॑न्ति॒ निर्.ऋ॑त्या अ॒न्तर्.हि॑त्यै मार्जयि॒त्वोप॑",
      "start": 110.16,
      "end": 110.16
    },
    {
      "text": "तिष्ठन्ते मेद्ध्य॒त्वाय॒ गार्.ह॑पत्य॒मुप॑ तिष्ठन्ते",
      "start": 110.16,
      "end": 110.16
    },
    {
      "text": "निर्.ऋति लो॒क ए॒व च॑रि॒त्वा",
      "start": 110.16,
      "end": 110.16
    },
    {
      "text": "पू॒ता दे॑वलो॒कमु॒पाव॑र्तन्त॒ एक॒योप॑ तिष्ठन्त",
      "start": 110.16,
      "end": 110.16
    },
    {
      "text": "एक॒धैव यज॑माने वी॒र्यं॑ दधति",
      "start": 110.16,
      "end": 111.68
    },
    {
      "text": "नि॒वेश॑नः स॒ङ्गम॑नो॒ वसू॑ना॒मित्या॑ह प्र॒जा",
      "start": 111.68,
      "end": 121.68
    },
    {
      "text": "वै प॒शवो॒ वसु॑ प्र॒जयै॒वैनं॑",
      "start": 121.68,
      "end": 126.84
    },
    {
      "text": "प॒शुभिः॒ सम॑र्द्धयन्ति",
      "start": 126.84,
      "end": 131.4
    }
