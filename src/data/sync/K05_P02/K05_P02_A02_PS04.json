    {
      "text": "वप॑चितिमान् भवति॒ य ए॒वं",
      "start": 88.4,
      "end": 90.24
    },
    {
      "text": "ॅवेद॑ स॒मिधा॒ऽग्निं दु॑वस्य॒तेति॑ घृतानुषि॒क्तामव॑सिते",
      "start": 90.24,
      "end": 98.32
    },
    {
      "text": "स॒मिध॒मा द॑धाति॒ यथाऽति॑थय॒ आग॑ताय",
      "start": 98.32,
      "end": 105.36
    },
    {
      "text": "स॒र्पिष्व॑दाति॒थ्यं क्रि॒यते॑ ता॒दृगे॒व तद्-गा॑यत्रि॒या",
      "start": 105.36,
      "end": 114.8
    },
    {
      "text": "ब्रा᳚ह्म॒णस्य॑ गाय॒त्रो हि ब्रा᳚ह्म॒णस्त्रि॒ष्टुभा॑",
      "start": 114.8,
      "end": 124.84
    },
    {
      "text": "राज॒न्य॑स्य॒ त्रैष्टु॑भो॒ हि रा॑ज॒न्यो᳚",
      "start": 124.84,
      "end": 127.2
    },
    {
      "text": "ऽफ्सु भस्म॒ प्र वे॑शयत्य॒फ्सुयो॑नि॒र्वा",
      "start": 127.2,
      "end": 127.2
    },
    {
      "text": "अ॒ग्निः स्वामे॒वैनं॒ ॅयोनिं॑ गमयति",
      "start": 127.2,
      "end": 127.2
    },
    {
      "text": "ति॒सृभिः॒ प्रवे॑शयति त्रि॒वृद्वा -",
