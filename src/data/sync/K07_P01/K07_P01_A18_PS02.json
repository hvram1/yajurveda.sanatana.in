  "phrases": [
    {
      "text": "श॒रदा᳚ त्व॒र्तुना॑ ह॒विषा॑ दीक्षया॒म्यङ्गि॑रोभि-र्दे॒वेभि॑-र्दे॒वत॑या॒",
      "start": 46.12,
      "end": 46.12
    },
    {
      "text": "पाङ्क्ते॑न त्वा॒ छन्द॑सा युनज्मि",
      "start": 46.12,
      "end": 46.12
    },
    {
      "text": "हेमन्तशिशि॒राभ्यां᳚ त्व॒र्तुना॑ ह॒विषा॑ दीक्षया॒म्याऽहं",
      "start": 46.12,
      "end": 49.64
    },
    {
      "text": "दी॒क्षाम॑रुहमृ॒तस्य॒ पत्नीं᳚ गाय॒त्रेण॒ छन्द॑सा॒",
      "start": 49.64,
      "end": 58.04
    },
    {
      "text": "ब्रह्म॑णा च॒र्तꣳ स॒त्ये॑ऽधाꣳ स॒त्यमृ॒ते॑ऽधां",
      "start": 58.04,
      "end": 65.76
    },
    {
      "text": "म॒ही मू ॒षु सु॒त्रामा॑ण",
      "start": 65.76,
      "end": 67.4
    },
    {
      "text": "-मि॒ह धृतिः॒ स्वाहे॒ह विधृ॑तिः॒",
      "start": 67.4,
      "end": 72.24
    },
    {
      "text": "स्वाहे॒ह रन्तिः॒ स्वाहे॒ह रम॑तिः॒",
      "start": 72.24,
      "end": 79.28
    },
    {
      "text": "स्वाहा᳚",
      "start": 79.28,
      "end": 79.84
    }
  ],
