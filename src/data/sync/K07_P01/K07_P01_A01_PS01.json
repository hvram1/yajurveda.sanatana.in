  "phrases": [
    {
      "text": "प्र॒जन॑नं॒ ज्योति॑र॒ग्नि-र्दे॒वता॑नां॒ ज्योति॑र्वि॒राट् छन्द॑सां॒",
      "start": 0.0,
      "end": 4.24
    },
    {
      "text": "ज्योति॑र्वि॒राड् वा॒चो᳚ऽग्नौ सं ति॑ष्ठते",
      "start": 4.24,
      "end": 4.28
    },
    {
      "text": "वि॒राज॑म॒भि संप॑द्यते॒ तस्मा॒त् तज्ज्योति॑रुच्यते॒",
      "start": 4.28,
      "end": 9.88
    },
    {
      "text": "द्वौ स्तोमौ᳚ प्रातस्सव॒नं ॅव॑हतो॒",
      "start": 9.88,
      "end": 13.96
    },
    {
      "text": "यथा᳚ प्रा॒णश्चा॑ऽपा॒नश्च॒ द्वौ माद्ध्य॑दिंनꣳ॒॒",
      "start": 13.96,
      "end": 24.32
    },
    {
      "text": "सव॑नं॒ ॅयथा॒ चक्षु॑श्च॒ श्रोत्रं॑",
      "start": 24.32,
      "end": 29.6
    },
    {
      "text": "च॒ द्वौ तृ॑तीयसव॒नं ॅयथा॒",
      "start": 29.6,
      "end": 32.4
    },
    {
      "text": "वाक् च॑ प्रति॒ष्ठा च॒",
      "start": 32.4,
      "end": 36.64
    },
    {
      "text": "पुरु॑षसंमितो॒ वा ए॒ष य॒ज्ञोऽस्थू॑रि॒",
      "start": 36.64,
      "end": 40.0
