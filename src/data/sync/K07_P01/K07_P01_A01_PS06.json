    {
      "text": "ऽन्व॑सृज्यत वैरा॒जꣳ साम॑ शू॒द्रो",
      "start": 197.88,
      "end": 202.56
    },
    {
      "text": "म॑नु॒ष्या॑णा॒मश्वः॑ पशू॒नां तस्मा॒त् तौ",
      "start": 202.56,
      "end": 209.28
    },
    {
      "text": "भू॑तसं क्रा॒मिणा॒वश्व॑श्च शू॒द्रश्च॒ तस्मा᳚च्छू॒द्रो",
      "start": 209.28,
      "end": 219.56
    },
    {
      "text": "य॒ज्ञेऽन॑वक्लृप्तो॒ न हि दे॒वता॒",
      "start": 219.56,
      "end": 224.08
    },
    {
      "text": "अन्वसृ॑ज्यत॒ तस्मा॒त् पादा॒वुप॑ जीवतः",
      "start": 224.08,
      "end": 224.08
    },
    {
      "text": "प॒त्तो ह्यसृ॑ज्येतां प्रा॒णा वै",
      "start": 224.08,
      "end": 224.08
    },
    {
      "text": "त्रि॒वृद॑र्द्धमा॒साः प॑ञ्चद॒शः प्र॒जाप॑तिः सप्तद॒शस्त्रय॑",
      "start": 224.08,
      "end": 224.08
    },
    {
      "text": "इ॒मे लो॒का अ॒सावा॑दि॒त्य ए॑कविꣳ॒॒श",
      "start": 224.08,
      "end": 224.08
    },
    {
      "text": "ए॒तस्मि॒न् वा ए॒ते श्रि॒ता",
      "start": 224.08,
      "end": 224.08
    },
    {
      "text": "ए॒तस्मि॒न् प्रति॑ष्ठिता॒ ( )",
      "start": 224.08,
      "end": 224.08
    },
    {
      "text": "य ए॒वं ॅवेदै॒तस्मि॑न्ने॒व श्र॑यत",
      "start": 224.08,
