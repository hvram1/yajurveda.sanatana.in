    {
      "text": "मा᳚ प्रति॒ष्ठां ग॑मय प्र॒जया॑",
      "start": 34.36,
      "end": 40.08
    },
    {
      "text": "प॒शुभिः॑ स॒ह पुन॒र्माऽऽ वि॑शताद्-र॒यिरिति॑",
      "start": 40.08,
      "end": 49.56
    },
    {
      "text": "प्र॒जयै॒वैनं॑ प॒शुभी॑ र॒य्यां प्रति॑",
      "start": 49.56,
      "end": 49.56
    },
    {
      "text": "ष्ठापयति प्र॒जावा᳚न् पशु॒मान् र॑यि॒मान्",
      "start": 49.56,
      "end": 49.56
    },
    {
      "text": "भ॑वति॒ य ए॒वं ॅवेद॒",
      "start": 49.56,
      "end": 49.56
    },
    {
      "text": "ताम॒ग्नीधे॑ वा ब्र॒ह्मणे॑ वा॒",
      "start": 49.56,
      "end": 49.56
    },
    {
      "text": "होत्रे॑ वोद्गा॒त्रे वा᳚ऽद्ध्व॒र्यवे॑ वा",
      "start": 49.56,
      "end": 49.56
    },
    {
      "text": "दद्याथ् स॒हस्र॑मस्य॒ सा द॒त्ता",
      "start": 49.56,
      "end": 49.56
    },
    {
      "text": "भ॑वति स॒हस्र॑मस्य॒ प्रति॑गृहीतं भवति॒",
      "start": 49.56,
      "end": 49.56
    },
    {
      "text": "यस्तामवि॑द्वान् - [ ]",
