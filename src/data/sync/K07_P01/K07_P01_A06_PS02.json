  "phrases": [
    {
      "text": "परि॑ पश्या॒मोऽꣳश॒मा ह॑रामहा॒ इति॒",
      "start": 36.2,
      "end": 41.84
    },
    {
      "text": "तस्या॒मꣳश॒माऽह॑रन्त॒ ताम॒फ्सु प्राऽवे॑शय॒न्थ् सोमा॑यो॒देहीति॒",
      "start": 41.84,
      "end": 47.04
    },
    {
      "text": "सा रोहि॑णी पिङ्ग॒लैक॑हायनी रू॒पं",
      "start": 47.04,
      "end": 47.04
    },
    {
      "text": "कृ॒त्वा त्रय॑स्त्रिꣳशता च त्रि॒भिश्च॑",
      "start": 47.04,
      "end": 47.04
    },
    {
      "text": "श॒तैः स॒होदैत् तस्मा॒द्-रोहि॑ण्या पिङ्ग॒लयैक॑हायन्या॒",
      "start": 47.04,
      "end": 47.04
    },
    {
      "text": "सोमं॑ क्रीणीया॒द्य ए॒वं ॅवि॒द्वान्",
      "start": 47.04,
      "end": 47.04
    },
    {
      "text": "रोहि॑ण्या पिङ्ग॒लयैक॑हायन्या॒ सोमं॑ क्री॒णाति॒",
      "start": 47.04,
      "end": 49.72
    },
    {
      "text": "त्रय॑स्त्रिꣳशता चै॒वास्य॑ त्रि॒भिश्च॑ -",
      "start": 49.72,
      "end": 58.36
