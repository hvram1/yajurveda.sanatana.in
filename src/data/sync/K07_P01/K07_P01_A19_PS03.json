  "panchasat": 3,
  "phrases": [
    {
      "text": "वीक्ष॑माणाय॒ स्वाहा॒ वीक्षि॑ताय॒ स्वाहा॑",
      "start": 117.0,
      "end": 125.52
    },
    {
      "text": "सꣳहास्य॒ते स्वाहा॑ स॒जिंहा॑नाय॒ स्वाहो॒-ज्जिहा॑नाय॒",
      "start": 125.52,
      "end": 133.76
    },
    {
      "text": "स्वाहा॑ विवर्थ्स्य॒ते स्वाहा॑ वि॒वर्त॑मानाय॒",
      "start": 133.76,
      "end": 138.2
    },
    {
      "text": "स्वाहा॒ विवृ॑त्ताय॒ स्वाहो᳚-त्थास्य॒ते स्वाहो॒त्तिष्ठ॑ते॒",
      "start": 138.2,
      "end": 138.2
    },
    {
      "text": "स्वाहोत्थि॑ताय॒ स्वाहा॑ विधविष्य॒ते स्वाहा॑",
      "start": 138.2,
      "end": 138.2
    },
    {
      "text": "विधून्वा॒नाय॒ स्वाहा॒ विधू॑ताय॒ स्वाहो᳚-त्क्रꣳस्य॒ते",
      "start": 138.2,
      "end": 138.2
    },
    {
      "text": "स्वाहो॒त्क्राम॑ते॒ स्वाहोत्क्रा᳚न्ताय॒ स्वाहा॑ चङ्क्रमिष्य॒ते",
      "start": 138.2,
      "end": 138.2
    },
    {
      "text": "स्वाहा॑ चङ्क्र॒म्यमा॑णाय॒ स्वाहा॑ चङ्क्रमि॒ताय॒",
      "start": 138.2,
      "end": 138.2
    },
    {
      "text": "स्वाहा॑ कण्डूयिष्य॒ते स्वाहा॑ कण्डू॒यमा॑नाय॒",
      "start": 138.2,
      "end": 143.48
    },
    {
      "text": "स्वाहा॑ कण्डूयि॒ताय॒ स्वाहा॑ निकषिष्य॒ते",
      "start": 143.48,
      "end": 147.76
    },
    {
      "text": "स्वाहा॑ नि॒कष॑माणाय॒ स्वाहा॒ (",
      "start": 147.76,
      "end": 151.92
    },
    {
      "text": ") निक॑षिताय॒ स्वाहा॒ यदत्ति॒",
      "start": 151.92,
      "end": 156.16
    },
    {
      "text": "तस्मै॒ स्वाहा॒ यत् पिब॑ति॒",
      "start": 156.16,
      "end": 160.72
    },
    {
      "text": "तस्मै॒ स्वाहा॒ यन्मेह॑ति॒ तस्मै॒",
      "start": 160.72,
      "end": 165.8
    },
    {
      "text": "स्वाहा॒ यच्छकृ॑त् क॒रोति॒ तस्मै॒",
      "start": 165.8,
      "end": 171.0
    },
    {
      "text": "स्वाहा॒ रेत॑से॒ स्वाहा᳚ प्र॒जाभ्यः॒",
      "start": 171.0,
      "end": 176.84
    },
    {
      "text": "स्वाहा᳚ प्र॒जन॑नाय॒ स्वाहा॒ सर्व॑स्मै॒",
      "start": 176.84,
      "end": 184.8
    },
    {
      "text": "स्वाहा᳚",
      "start": 184.8,
      "end": 185.28
    }
  ],
  "total_phrases": 18
}