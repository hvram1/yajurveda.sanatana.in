  "phrases": [
    {
      "text": "ॅव्यवै᳚र्यत॒ तस्मा᳚द्-रु॒द्रा घातु॑का अनायत॒ना",
      "start": 109.68,
      "end": 113.68
    },
    {
      "text": "हि तस्मा॑दाहुः शिथि॒लं ॅवै",
      "start": 113.68,
      "end": 116.76
    },
    {
      "text": "म॑द्ध्य॒म-मह॑स्त्रिरा॒त्रस्य॒ वि हि तद॒वैर्य॒तेति॒",
      "start": 116.76,
      "end": 125.48
    },
    {
      "text": "त्रैष्टु॑भं मद्ध्य॒मस्याह्न॒ आज्यं॑ भवति",
      "start": 125.48,
      "end": 133.68
    },
    {
      "text": "सं॒ॅयाना॑नि सू॒क्तानि॑ शꣳसति षोड॒शिनꣳ॑",
      "start": 133.68,
      "end": 140.32
    },
    {
      "text": "शꣳस॒त्यह्नो॒ धृत्या॒ अशि॑थिलंभावाय॒ तस्मा᳚त्",
      "start": 140.32,
      "end": 144.84
    },
    {
      "text": "त्रिरा॒त्रस्या᳚ग्निष्टो॒म ए॒व प्र॑थ॒ममहः॑ स्या॒दथो॒क्थ्यो",
      "start": 144.84,
      "end": 155.48
    },
    {
      "text": "ऽथा॑ऽतिरा॒त्र ए॒षां ॅलो॒कानां॒ ॅविधृ॑त्यै॒",
      "start": 155.48,
      "end": 162.68
    },
    {
      "text": "त्रीणि॑त्रीणि श॒ता-न्य॑नूचीना॒ह-मव्य॑वच्छिन्नानि ददा -",
      "start": 162.68,
      "end": 165.56
