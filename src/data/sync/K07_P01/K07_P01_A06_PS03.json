  "phrases": [
    {
      "text": "श॒तैः सोमः॑ क्री॒तो भ॑वति॒",
      "start": 58.4,
      "end": 63.12
    },
    {
      "text": "सुक्री॑तेन यजते॒ ताम॒फ्सु प्रावे॑शय॒-न्निन्द्रा॑यो॒देहीति॒",
      "start": 63.12,
      "end": 70.64
    },
    {
      "text": "सा रोहि॑णी लक्ष्म॒णा प॑ष्ठौ॒ही",
      "start": 70.64,
      "end": 77.68
    },
    {
      "text": "वार्त्र॑घ्नी रू॒पं कृ॒त्वा त्रय॑स्त्रिꣳशता",
      "start": 77.68,
      "end": 87.8
    },
    {
      "text": "च त्रि॒भिश्च॑ श॒तैः स॒होदैत्",
      "start": 87.8,
      "end": 93.32
    },
    {
      "text": "तस्मा॒द् रोहि॑णीं ॅलक्ष्म॒णां प॑ष्ठौ॒हीं",
      "start": 93.32,
      "end": 100.96
    },
    {
      "text": "ॅवार्त्र॑घ्नीं दद्या॒द्य ए॒वं ॅवि॒द्वान्",
      "start": 100.96,
      "end": 109.28
    },
    {
      "text": "रोहि॑णीं ॅलक्ष्म॒णां प॑ष्ठौ॒हीं ॅवार्त्र॑घ्नीं॒",
      "start": 109.28,
      "end": 115.36
    },
    {
      "text": "ददा॑ति॒ त्रय॑स्त्रिꣳशच्चै॒वास्य॒ त्रीणि॑ च",
      "start": 115.36,
      "end": 123.04
    },
    {
      "text": "श॒तानि॒ सा द॒त्ता -",
