  "phrases": [
    {
      "text": "- द्य उ॒द्यन्तः॒ स्तोमाः॒",
      "start": 33.64,
      "end": 33.64
    },
    {
      "text": "श्रीः सा ऽत्रिꣳ॑ श्र॒द्धादे॑वं॒",
      "start": 33.64,
      "end": 33.64
    },
    {
      "text": "ॅयज॑मानं च॒त्वारि॑ वी॒र्या॑णि॒ नोपा॑ऽनम॒न्",
      "start": 33.64,
      "end": 39.56
    },
    {
      "text": "तेज॑ इन्द्रि॒यं ब्र॑ह्मवर्च॒स-म॒न्नाद्यꣳ॒॒ स",
      "start": 39.56,
      "end": 48.28
    },
    {
      "text": "ए॒ताꣳश्च॒तुर॒श्चतु॑ष्टोमा॒न्थ् सोमा॑न-पश्य॒त् तानाऽह॑र॒त् तैर॑यजत॒",
      "start": 48.28,
      "end": 63.56
    },
    {
      "text": "तेज॑ ए॒व प्र॑थ॒मेना ऽवा॑रुन्धेन्द्रि॒यं",
      "start": 63.56,
      "end": 68.32
    },
    {
      "text": "द्वि॒तीये॑न ब्रह्मवर्च॒सं तृ॒तीये॑ना॒न्नाद्यं॑ चतु॒र्थेन॒",
      "start": 68.32,
      "end": 68.4
    },
    {
      "text": "य ए॒वं ॅवि॒द्वाꣳश्च॒तुर॒श्चतु॑ष्टोमा॒न्थ् सोमा॑ना॒हर॑ति॒",
      "start": 68.4,
      "end": 79.24
    },
    {
      "text": "तैर्यज॑ते॒ तेज॑ ए॒व (",
      "start": 79.24,
      "end": 83.36
    },
    {
      "text": ") प्र॑थ॒मेनाव॑ रुन्ध इन्द्रि॒यं",
      "start": 83.36,
      "end": 85.04
    },
    {
      "text": "द्वि॒तीये॑न ब्रह्मवर्च॒सं तृ॒तीये॑ना॒ऽन्नाद्यं॑ चतु॒र्थेन॒",
      "start": 85.04,
      "end": 93.44
    },
    {
      "text": "यामे॒वात्रि॒र्॒. ऋद्धि॒मार्द्ध्नो॒त् तामे॒व यज॑मान",
      "start": 93.44,
      "end": 97.28
    },
    {
      "text": "ऋद्ध्नोति",
      "start": 97.28,
      "end": 97.76
    }
  ],
  "total_phrases": 13
