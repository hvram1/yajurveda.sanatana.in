  "phrases": [
    {
      "text": "विप्रा अमृता ऋतज्ञाः",
      "start": 47.8,
      "end": 48.12
    },
    {
      "text": "अ॒स्य मद्ध्वः॑ पिबत मा॒दय॑द्ध्वं",
      "start": 48.12,
      "end": 55.16
    },
    {
      "text": "तृ॒प्ता या॑त प॒थिभि॑र्देव॒यानैः᳚",
      "start": 55.16,
      "end": 60.4
    },
    {
      "text": "वाजः॑ पु॒रस्ता॑दु॒त म॑द्ध्य॒तो नो॒",
      "start": 60.4,
      "end": 67.48
    },
    {
      "text": "वाजो॑ दे॒वाꣳ ऋ॒तुभिः॑ कल्पयाति",
      "start": 67.48,
      "end": 70.76
    },
    {
      "text": "वाज॑स्य॒ हि प्र॑स॒वो नन्न॑मीति॒",
      "start": 70.76,
      "end": 77.24
    },
    {
      "text": "विश्वा॒ आशा॒ वाज॑पतिर्भवेयं",
      "start": 77.24,
      "end": 80.16
    },
    {
      "text": "पयः॑ पृथि॒व्यां पय॒ ओष॑धीषु॒",
      "start": 80.16,
      "end": 84.96
    },
    {
      "text": "पयो॑ दि॒व्य॑न्तरि॑क्षे॒ पयो॑ धां",
      "start": 84.96,
      "end": 89.68
    },
    {
      "text": "पय॑स्वतीः प्र॒दिशः॑ सन्तु॒ मह्यं᳚",
      "start": 89.68,
      "end": 93.6
    },
    {
      "text": "सं मा॑ सृजामि॒ पय॑सा",
      "start": 93.6,
      "end": 94.76
    },
    {
      "text": "घृ॒तेन॒ सं मा॑ सृजाम्य॒प",
      "start": 94.76,
      "end": 94.76
    },
