  "panchasat": 2,
  "phrases": [
    {
      "text": "य॒वयारा॑तीः पितृ॒णाꣳ सद॑नम॒स्युद्दिवꣳ॑ स्तभा॒नाऽन्तरि॑क्षं",
      "start": 30.64,
      "end": 30.64
    },
    {
      "text": "पृण पृथि॒वीं दृꣳ॑ह द्युता॒नस्त्वा॑",
      "start": 30.64,
      "end": 30.64
    },
    {
      "text": "मारु॒तो मि॑नोतु मि॒त्रावरु॑णयोर् ध्रु॒वेण॒",
      "start": 30.64,
      "end": 38.4
    },
    {
      "text": "धर्म॑णा ब्रह्म॒वनिं॑ त्वा क्षत्र॒वनिꣳ॑",
      "start": 38.4,
      "end": 47.0
    },
    {
      "text": "सुप्रजा॒वनिꣳ॑ रायस्पोष॒वनिं॒ पर्यू॑हामि॒ ब्रह्म॑",
      "start": 47.0,
      "end": 53.92
    },
    {
      "text": "दृꣳह क्ष॒त्रं दृꣳ॑ह प्र॒जां",
      "start": 53.92,
      "end": 57.72
    },
    {
      "text": "दृꣳ॑ह रा॒यस्पोषं॑ दृꣳह घृ॒तेन॑",
      "start": 57.72,
      "end": 61.68
    },
    {
      "text": "द्यावापृथिवी॒ आ पृ॑णेथा॒मिन्द्र॑स्य॒ सदो॑ऽसि",
      "start": 61.68,
      "end": 69.96
    },
    {
      "text": "विश्वज॒नस्य॑ छा॒या परि॑ त्वा",
      "start": 69.96,
      "end": 73.24
    },
    {
      "text": "गिर्वणो॒ गिर॑ इ॒मा (",
      "start": 73.24,
      "end": 75.56
    },
    {
      "text": ") भ॑वन्तु वि॒श्वतो॑ वृ॒द्धायु॒मनु॒",
      "start": 75.56,
      "end": 84.0
    },
    {
      "text": "वृद्ध॑यो॒ जुष्टा॑ भवन्तु॒ जुष्ट॑य॒",
      "start": 84.0,
      "end": 88.96
    },
    {
      "text": "इन्द्र॑स्य॒ स्यूर॒सीन्द्र॑स्य ध्रु॒वम॑स्यै॒न्द्रम॒सीन्द्रा॑य त्वा",
      "start": 88.96,
      "end": 99.0
    }
  ],
  "total_phrases": 13
}