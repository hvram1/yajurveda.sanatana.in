      "start": 169.72,
      "end": 179.4
    },
    {
      "text": "जरते स्वा॒धीः",
      "start": 179.4,
      "end": 181.28
    },
    {
      "text": "शुचिः॑ पावक॒ वन्द्योऽग्ने॑ बृ॒हद्वि रो॑चसे",
      "start": 181.28,
      "end": 185.56
    },
    {
      "text": "त्वं घृ॒तेभि॒राहु॑तः",
      "start": 185.56,
      "end": 185.56
    },
    {
