  "phrases": [
    {
      "text": "त्वम॑ग्ने रु॒द्रो असु॑रो म॒हो",
      "start": 0.0,
      "end": 5.0
    },
    {
      "text": "दि॒वस्त्वꣳ शर्द्धो॒ मारु॑तं पृ॒क्ष",
      "start": 5.0,
      "end": 11.72
    },
    {
      "text": "ई॑शिषे",
      "start": 11.72,
      "end": 12.6
    },
    {
      "text": "त्वं ॅवातै॑ररु॒णैर्या॑सि शंग॒यस्त्वं पू॒षा",
      "start": 12.6,
      "end": 20.12
    },
    {
      "text": "वि॑ध॒तः पा॑सि॒ नुत्मना᳚",
      "start": 20.12,
      "end": 22.88
    },
    {
      "text": "आ वो॒ राजा॑नमद्ध्व॒रस्य॑ रु॒द्रꣳ",
      "start": 22.88,
      "end": 25.92
    },
    {
      "text": "होता॑रꣳ सत्य॒यजꣳ॒॒ रोद॑स्योः",
      "start": 25.92,
      "end": 28.2
    },
    {
      "text": "अ॒ग्निं पु॒रा त॑नयि॒त्नो र॒चित्ता॒द्धिर॑ण्यरूप॒मव॑से कृणुद्ध्वं",
      "start": 28.2,
      "end": 33.24
    },
    {
      "text": "अ॒ग्निर्.होता॒ नि ष॑सादा॒ यजी॑यानु॒पस्थे॑",
      "start": 33.24,
      "end": 43.24
    },
    {
      "text": "मा॒तुः सु॑र॒भावु॑ लो॒के",
      "start": 43.24,
      "end": 47.0
    },
    {
      "text": "युवा॑ क॒विः पु॑रुनि॒ष्ठ -",
      "start": 47.0,
      "end": 52.8
