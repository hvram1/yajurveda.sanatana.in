  "phrases": [
    {
      "text": "स॒मु॒द्रं ग॑च्छ॒ स्वाहा॒ऽन्तरि॑क्षं गच्छ॒",
      "start": 0.0,
      "end": 10.28
    },
    {
      "text": "स्वाहा॑ दे॒वꣳ स॑वि॒तारं॑ गच्छ॒",
      "start": 10.28,
      "end": 15.92
    },
    {
      "text": "स्वाहा॑ऽहोरा॒त्रे ग॑च्छ॒ स्वाहा॑ मि॒त्रावरु॑णौ",
      "start": 15.92,
      "end": 23.68
    },
    {
      "text": "गच्छ॒ स्वाहा॒ सोमं॑ गच्छ॒",
      "start": 23.68,
      "end": 28.24
    },
    {
      "text": "स्वाहा॑ य॒ज्ञ्ं ग॑च्छ॒ स्वाहा॒",
      "start": 28.24,
      "end": 32.68
    },
    {
      "text": "छन्दाꣳ॑सि गच्छ॒ स्वाहा॒ द्यावा॑पृथि॒वी",
      "start": 32.68,
      "end": 32.68
    },
    {
      "text": "ग॑च्छ॒ स्वाहा॒ नभो॑ दि॒व्यं",
      "start": 32.68,
      "end": 32.72
    },
    {
      "text": "ग॑च्छ॒ स्वाहा॒ऽग्निं ॅवै᳚श्वान॒रं ग॑च्छ॒",
      "start": 32.72,
      "end": 38.96
    },
    {
      "text": "स्वाहा॒ऽद्भ्यस्त्वौष॑धीभ्यो॒ मनो॑ मे॒ हार्दि॑",
      "start": 38.96,
      "end": 47.36
    },
    {
      "text": "यच्छ त॒नूं त्वचं॑ पु॒त्रं",
      "start": 47.36,
      "end": 48.36
    },
    {
      "text": "नप्ता॑रमशीय॒ शुग॑सि॒ ( )",
      "start": 48.36,
      "end": 48.36
    },
    {
      "text": "तम॒भि शो॑च॒ यो᳚ऽस्मान् द्वेष्टि॒",
      "start": 48.36,
      "end": 48.36
    },
    {
      "text": "यं च॑ व॒यं द्वि॒ष्मो",
      "start": 48.36,
      "end": 48.36
    },
    {
      "text": "धाम्नो॑धाम्नो राजन्नि॒तो व॑रुण नो",
      "start": 48.36,
      "end": 48.36
    },
    {
      "text": "मुञ्च॒ यदापो॒ अघ्नि॑या॒ वरु॒णेति॒",
      "start": 48.36,
      "end": 50.48
    },
    {
      "text": "शपा॑महे॒ ततो॑ वरुण नो",
