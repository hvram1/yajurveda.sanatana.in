      "start": 3.92,
      "end": 8.96
    },
    {
      "text": "दे॒वेभ्यो॑ ह॒व्यं घृ॒तव॒थ् स्वाहै॒न्द्रः",
      "start": 8.96,
      "end": 16.12
    },
    {
      "text": "प्रा॒णो अङ्गे॑अङ्गे॒ नि दे᳚द्ध्यदै॒न्द्रो॑",
      "start": 16.12,
      "end": 18.8
    },
    {
