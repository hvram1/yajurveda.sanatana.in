  "phrases": [
    {
      "text": "वसो॑ पुरु॒स्पृहꣳ॑ र॒यिं",
      "start": 103.12,
      "end": 105.0
    },
    {
      "text": "स श्वि॑ता॒नस्त॑न्य॒तू रो॑चन॒स्था अ॒जरे॑भि॒र् नान॑दद्भि॒र्यवि॑ष्ठः",
      "start": 105.0,
      "end": 121.92
    },
    {
      "text": "यः पा॑व॒कः पु॑रु॒तमः॑ पु॒रूणि॑",
      "start": 121.92,
      "end": 129.28
    },
    {
      "text": "पृ॒थून्य॒ग्निर॑नु॒याति॒ भर्वन्न्॑",
      "start": 129.28,
      "end": 136.96
    },
    {
      "text": "आयु॑ष्टे वि॒श्वतो॑ दधद॒यम॒ग्निर् वरे᳚ण्यः",
      "start": 136.96,
      "end": 142.68
    },
    {
      "text": "पुन॑स्ते प्रा॒ण आऽय॑ति॒ परा॒",
      "start": 142.68,
      "end": 147.08
    },
    {
      "text": "यक्ष्मꣳ॑ सुवामि ते",
      "start": 147.08,
      "end": 148.52
    },
    {
      "text": "आ॒यु॒र्दा अ॑ग्ने ह॒विषो॑ जुषा॒णो",
      "start": 148.52,
      "end": 150.88
    },
    {
      "text": "घृ॒तप्र॑तीको घृ॒तयो॑निरेधि",
      "start": 150.88,
      "end": 150.88
    },
    {
      "text": "घृ॒तं पी॒त्वा मधु॒ चारु॒",
      "start": 150.88,
      "end": 150.88
    },
    {
      "text": "गव्यं॑ पि॒तेव॑ पु॒त्रम॒भि -",
      "start": 150.88,
      "end": 150.88
    },
