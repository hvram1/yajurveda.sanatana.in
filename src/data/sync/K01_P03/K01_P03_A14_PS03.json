      "start": 93.68,
      "end": 93.68
    },
    {
      "text": "र॒यिꣳ र॑यिवः सु॒वीरं᳚",
      "start": 93.68,
      "end": 93.68
    },
    {
      "text": "अ॒श्याम॒ वाज॑म॒भि वा॒जय॑न्तो॒ ऽश्याम॑",
      "start": 93.68,
      "end": 93.68
    },
    {
