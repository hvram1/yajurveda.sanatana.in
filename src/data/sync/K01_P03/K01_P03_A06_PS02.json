      "end": 60.64
    },
    {
      "text": "व्र॒तानि॑ पस्प॒शे",
      "start": 60.64,
      "end": 63.24
    },
    {
      "text": "इन्द्र॑स्य॒ युज्यः॒ सखा᳚",
