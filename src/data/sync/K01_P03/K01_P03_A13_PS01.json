    {
      "text": "हृ॒दे त्वा॒ मन॑से त्वा",
      "start": 0.0,
      "end": 3.24
    },
    {
      "text": "दि॒वे त्वा॒ सूर्या॑य त्वो॒र्द्ध्वमि॒मम॑द्ध्व॒रं",
      "start": 3.24,
      "end": 14.88
    },
    {
      "text": "कृ॑धि दि॒वि दे॒वेषु॒ होत्रा॑",
      "start": 14.88,
      "end": 20.24
    },
    {
      "text": "यच्छ॒ सोम॑ राज॒न्नेह्यव॑ रोह॒",
      "start": 20.24,
      "end": 24.8
    },
    {
      "text": "मा भेर्मा सं ॅवि॑क्था॒",
      "start": 24.8,
      "end": 26.48
    },
    {
      "text": "मा त्वा॑ हिꣳसिषं प्र॒जास्त्वमु॒पाव॑रोह",
      "start": 26.48,
      "end": 32.68
    },
    {
      "text": "प्र॒जास्त्वामु॒पाव॑रोहन्तु शृ॒णोत्व॒ग्निः स॒मिधा॒ हवं॑",
      "start": 32.68,
      "end": 45.32
    },
    {
      "text": "मे शृ॒ण्वन्त्वापो॑ धि॒षणा᳚श्च दे॒वीः",
      "start": 45.32,
      "end": 51.08
    },
    {
      "text": "शृ॒णोत॑ ग्रावाणो वि॒दुषो॒ नु",
      "start": 51.08,
      "end": 55.2
    },
    {
