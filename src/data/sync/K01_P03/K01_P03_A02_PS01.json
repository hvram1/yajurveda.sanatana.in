  "phrases": [
    {
      "text": "र॒क्षो॒हणो॑ वलग॒हनो॑ वैष्ण॒वान् ख॑नामी॒दम॒हं",
      "start": 0.0,
      "end": 7.44
    },
    {
      "text": "तं ॅव॑ल॒गमुद्व॑पामि॒ यं नः॑",
      "start": 7.44,
      "end": 14.36
    },
    {
      "text": "समा॒नो यमस॑मानो निच॒खाने॒दमे॑न॒मध॑रं करोमि॒",
      "start": 14.36,
      "end": 20.96
    },
    {
      "text": "यो नः॑ समा॒नो योऽस॑मानोऽराती॒यति॑",
      "start": 20.96,
      "end": 20.96
    },
    {
      "text": "गाय॒त्रेण॒ छन्द॒साऽव॑बाढो वल॒गः किमत्र॑",
      "start": 20.96,
      "end": 20.96
    },
    {
      "text": "भ॒द्रं तन्नौ॑ स॒ह वि॒राड॑सि",
      "start": 20.96,
      "end": 20.96
    },
    {
      "text": "सपत्न॒हा स॒म्राड॑सि भ्रातृव्य॒हा स्व॒राड॑स्यभिमाति॒हा",
      "start": 20.96,
      "end": 22.72
    },
    {
      "text": "वि॑श्वा॒राड॑सि॒ विश्वा॑सां ना॒ष्ट्राणाꣳ॑ ह॒न्ता",
      "start": 22.72,
      "end": 29.44
