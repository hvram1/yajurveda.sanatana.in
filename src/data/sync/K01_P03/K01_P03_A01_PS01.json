  "phrases": [
    {
      "text": "दे॒वस्य॑ त्वा सवि॒तुः प्र॑स॒वे᳚ऽश्विनो᳚र्",
      "start": 0.0,
      "end": 6.24
    },
    {
      "text": "बा॒हुभ्यां᳚ पू॒ष्णो हस्ता᳚भ्या॒मा द॒देऽभ्रि॑रसि॒",
      "start": 6.24,
      "end": 15.04
    },
    {
      "text": "नारि॑रसि॒ परि॑लिखितꣳ॒॒ रक्षः॒ परि॑लिखिता॒",
      "start": 15.04,
      "end": 22.08
    },
    {
      "text": "अरा॑तय इ॒दम॒हꣳ रक्ष॑सो ग्री॒वा",
      "start": 22.08,
      "end": 28.84
    },
    {
      "text": "अपि॑ कृन्तामि॒ यो᳚ऽस्मान् द्वेष्टि॒",
      "start": 28.84,
      "end": 30.64
    },
    {
      "text": "यं च॑ व॒यं द्वि॒ष्म",
      "start": 30.64,
      "end": 30.64
    },
    {
      "text": "इ॒दम॑स्य ग्री॒वा अपि॑ कृन्तामि",
      "start": 30.64,
      "end": 30.64
    },
    {
      "text": "दि॒वे त्वा॒ऽन्तरि॑क्षाय त्वा पृथि॒व्यै",
      "start": 30.64,
      "end": 30.64
    },
    {
      "text": "त्वा॒ शुन्ध॑तां ॅलो॒कः पि॑तृ॒षद॑नो॒",
      "start": 30.64,
      "end": 30.64
    },
    {
      "text": "यवो॑ऽसि य॒वया॒स्मद् द्वेषो॑ -",
      "start": 30.64,
      "end": 30.64
