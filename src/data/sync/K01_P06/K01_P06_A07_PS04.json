  "phrases": [
    {
      "text": "ॅवा आ॑र॒ण्यमि॑न्द्रि॒यमे॒वाऽऽत्मन् ध॑त्ते॒ यदना᳚श्वानुप॒वसे॒त्",
      "start": 106.64,
      "end": 117.64
    },
    {
      "text": "क्षोधु॑कः स्या॒द्यद॑श्ञी॒याद्रु॒-द्रो᳚ऽस्य प॒शून॒भि म॑न्येता॒ऽपो᳚ऽश्ञाति॒",
      "start": 117.64,
      "end": 127.24
    },
    {
      "text": "तन्नेवा॑शि॒तं नेवाऽन॑शितं॒ न क्षोधु॑को॒",
      "start": 127.24,
      "end": 134.76
    },
    {
      "text": "भव॑ति॒ नास्य॑ रु॒द्रः प॒शून॒भि",
      "start": 134.76,
      "end": 139.52
    },
    {
      "text": "म॑न्यते॒ वज्रो॒ वै य॒ज्ञ्ः",
      "start": 139.52,
      "end": 139.56
    },
    {
      "text": "क्षुत् खलु॒ वै म॑नु॒ष्य॑स्य॒",
      "start": 139.56,
      "end": 142.72
    },
    {
      "text": "भ्रातृ॑व्यो॒ यदना᳚ऽश्वानुप॒वस॑ति॒ वज्रे॑णै॒व सा॒क्षात्",
      "start": 142.72,
      "end": 149.04
    },
    {
      "text": "( ) क्षुधं॒ भ्रातृ॑व्यꣳ",
      "start": 149.04,
      "end": 150.6
    },
    {
      "text": "हन्ति",
      "start": 150.6,
      "end": 150.76
    }
