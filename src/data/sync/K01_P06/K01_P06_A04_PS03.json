  "phrases": [
    {
      "text": "वनामहे धुक्षी॒महि॑ प्र॒जामिषं᳚",
      "start": 91.68,
      "end": 94.64
    },
    {
      "text": "रोहि॑तेन त्वा॒ऽग्निर् दे॒वतां᳚ गमयतु॒",
      "start": 94.64,
      "end": 99.08
    },
    {
      "text": "हरि॑भ्यां॒ त्वेन्द्रो॑ दे॒वतां᳚ गमय॒त्वेत॑शेन",
      "start": 99.08,
      "end": 100.88
    },
    {
      "text": "त्वा॒ सूर्यो॑ दे॒वतां᳚ गमयतु॒",
      "start": 100.88,
      "end": 100.88
    },
    {
      "text": "वि ते॑ मुञ्चामि रश॒ना",
      "start": 100.88,
      "end": 100.88
    },
    {
      "text": "वि र॒श्मीन् वि योक्त्रा॒",
      "start": 100.88,
      "end": 100.88
    },
    {
      "text": "यानि॑ परि॒चर्त॑नानि ध॒त्ताद॒स्मासु॒ द्रवि॑णं॒",
      "start": 100.88,
      "end": 100.88
    },
    {
      "text": "ॅयच्च॑ भ॒द्रं प्र णो᳚",
      "start": 100.88,
      "end": 100.88
    },
    {
      "text": "ब्रूताद्-भाग॒धान् दे॒वता॑सु",
      "start": 100.88,
      "end": 100.88
    },
    {
      "text": "विष्णोः᳚ शं॒ॅयोर॒हं दे॑वय॒ज्यया॑ य॒ज्ञेन॑",
      "start": 100.88,
      "end": 100.88
    },
    {
      "text": "प्रति॒ष्ठां ग॑मेयꣳ॒॒ सोम॑स्या॒हं दे॑वय॒ज्यया॑",
      "start": 100.88,
      "end": 100.88
    },
