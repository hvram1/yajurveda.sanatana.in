  "phrases": [
    {
      "text": "ऽनयै॒वैनाः॒ प्र ण॑य॒त्य-स्क॑न्नहविर् भवति॒",
      "start": 3.52,
      "end": 11.04
    },
    {
      "text": "य ए॒वं ॅवेद॑ यज्ञायु॒धानि॒",
      "start": 11.04,
      "end": 13.76
    },
    {
      "text": "सं भ॑रति य॒ज्ञो वै",
      "start": 13.76,
      "end": 15.84
    },
    {
      "text": "य॑ज्ञायु॒धानि॑ य॒ज्ञ्मे॒व तथ्सं भ॑रति॒",
      "start": 15.84,
      "end": 25.2
    },
    {
      "text": "यदेक॑मेकꣳ सं॒भरे᳚त्-पितृदेव॒त्या॑नि स्यु॒र्यथ् स॒ह",
      "start": 25.2,
      "end": 31.44
    },
    {
      "text": "सर्वा॑णि मानु॒षाणि॒ द्वेद्वे॒ संभ॑रति",
      "start": 31.44,
      "end": 39.12
    },
    {
      "text": "याज्यानुवा॒क्य॑योरे॒व रू॒पं क॑रो॒त्यथो॑ मिथु॒नमे॒वयो",
      "start": 39.12,
      "end": 48.84
    },
    {
      "text": "वै दश॑ यज्ञायु॒धानि॒ वेद॑",
      "start": 48.84,
      "end": 53.16
    },
    {
      "text": "मुख॒तो᳚ऽस्य य॒ज्ञ्ः क॑ल्पते॒ स्फ्यः-",
      "start": 53.16,
      "end": 59.84
    },
    {
