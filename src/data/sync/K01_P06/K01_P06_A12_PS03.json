    {
      "text": "ऽर्च॑न्त्य॒र्क-म॒र्किणः॑",
      "start": 79.6,
      "end": 84.68
    },
    {
      "text": "ब्र॒ह्माण॑स्त्वा शतक्रत॒वुद्-वꣳ॒॒श-मि॑व येमिरे",
      "start": 84.68,
      "end": 92.96
    },
    {
      "text": "अꣳ॒॒हो॒मुचे॒ प्र भ॑रेमा मनी॒षामो॑षिष्ठ॒दाव्.न्ने॑",
      "start": 92.96,
      "end": 95.04
    },
    {
      "text": "सुम॒तिं गृ॑णा॒नाः",
      "start": 95.04,
      "end": 97.0
    },
    {
      "text": "इ॒दमि॑न्द्र॒ प्रति॑ ह॒व्यं गृ॑भाय",
      "start": 97.0,
      "end": 106.04
    },
    {
      "text": "स॒त्याः स॑न्तु॒ यज॑मानस्य॒ कामाः᳚",
      "start": 106.04,
      "end": 111.04
    },
    {
      "text": "वि॒वेष॒ यन्मा॑ धि॒षणा॑ ज॒जान॒",
      "start": 111.04,
      "end": 116.6
    },
    {
      "text": "स्तवै॑ पु॒रा पार्या॒दिन्द्र॒-मह्नः॑",
      "start": 116.6,
      "end": 116.88
    },
    {
      "text": "अꣳह॑सो॒ यत्र॑ पी॒पर॒द्यथा॑ नो",
      "start": 116.88,
      "end": 116.88
    },
    {
      "text": "ना॒वेव॒ यान्त॑ मु॒भये॑ हवन्ते",
      "start": 116.88,
      "end": 116.88
    },
    {
      "text": "प्र स॒म्राजं॑ प्रथ॒म-म॑द्ध्व॒राणा॑ -",
