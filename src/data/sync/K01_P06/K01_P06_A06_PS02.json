  "phrases": [
    {
      "text": "सं ज्योति॑षाऽभूवमै॒न्द्री-मा॒वृत॑-म॒न्वाव॑र्ते॒ सम॒हं प्र॒जया॒",
      "start": 21.4,
      "end": 36.56
    },
    {
      "text": "सं मया᳚ प्र॒जा सम॒हꣳ",
      "start": 36.56,
      "end": 39.84
    },
    {
      "text": "रा॒यस्पोषे॑ण॒ सं मया॑ रा॒यस्पोषः॒",
      "start": 39.84,
      "end": 47.84
    },
    {
      "text": "समि॑द्धो अग्ने मे दीदिहि",
      "start": 47.84,
      "end": 47.88
    },
    {
      "text": "समे॒द्धा ते॑ अग्ने दीद्यासं॒",
      "start": 47.88,
      "end": 48.8
    },
    {
      "text": "ॅवसु॑मान्. य॒ज्ञो वसी॑यान् भूयास॒मग्न॒",
      "start": 48.8,
      "end": 56.6
    },
    {
      "text": "आयूꣳ॑षि पवस॒ आ सु॒वोर्ज॒मिषं॑",
      "start": 56.6,
      "end": 62.52
    },
    {
      "text": "च नः",
      "start": 62.52,
      "end": 62.52
    },
    {
      "text": "आ॒रे बा॑धस्व दु॒च्छुनां᳚",
      "start": 62.52,
      "end": 62.52
    },
    {
      "text": "अग्ने॒ पव॑स्व॒ स्वपा॑ अ॒स्मे",
      "start": 62.52,
      "end": 68.68
    },
    {
      "text": "वर्चः॑ सु॒वीर्यं᳚",
      "start": 68.68,
      "end": 71.44
    }
