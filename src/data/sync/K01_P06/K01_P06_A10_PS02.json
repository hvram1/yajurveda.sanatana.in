  "phrases": [
    {
      "text": "वैनं॑ ॅयुनक्ति य॒ज्ञ्स्य॒ वै",
      "start": 11.24,
      "end": 15.68
    },
    {
      "text": "समृ॑द्धेन दे॒वाः सु॑व॒र्गं ॅलो॒कमा॑यन्.",
      "start": 15.68,
      "end": 21.44
    },
    {
      "text": "य॒ज्ञ्स्य॒ व्यृ॑द्धे॒नासु॑रा॒न् परा॑भावय॒न्. यन्मे॑",
      "start": 21.44,
      "end": 35.28
    },
    {
      "text": "अग्ने अ॒स्य य॒ज्ञ्स्य॒ रिष्या॒दित्या॑ह",
      "start": 35.28,
      "end": 42.16
    },
    {
      "text": "य॒ज्ञ्स्यै॒व तथ्समृ॑द्धेन॒ यज॑मानः सुव॒र्गं",
      "start": 42.16,
      "end": 50.2
    },
    {
      "text": "ॅलो॒कमे॑ति य॒ज्ञ्स्य॒ व्यृ॑द्धेन॒ भ्रातृ॑व्या॒न्",
      "start": 50.2,
      "end": 55.2
    },
    {
      "text": "परा॑ भावयत्यग्निहो॒त्र-मे॒ताभि॒र् व्याहृ॑तीभि॒रुप॑ सादयेद्यज्ञ्मु॒खं",
      "start": 55.2,
      "end": 55.2
    },
    {
      "text": "ॅवा अ॑ग्निहो॒त्रं ब्रह्मै॒ता व्याहृ॑तयो",
      "start": 55.2,
      "end": 55.2
    },
    {
      "text": "यज्ञ्मु॒ख ए॒व ब्रह्म॑ -",
      "start": 55.2,
      "end": 55.88
    },
