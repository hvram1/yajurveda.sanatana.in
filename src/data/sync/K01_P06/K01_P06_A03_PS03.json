  "phrases": [
    {
      "text": "ऽसि॒ जुष्टिं॑ ते गमेयं॒",
      "start": 50.72,
      "end": 52.48
    },
    {
      "text": "मनो॒ ज्योति॑र् जुषता॒माज्यं॒ ॅविच्छि॑न्नं",
      "start": 52.48,
      "end": 58.96
    },
    {
      "text": "ॅय॒ज्ञ्ꣳ समि॒मं द॑धातु",
      "start": 58.96,
      "end": 63.56
    },
    {
      "text": "बृह॒स्पति॑-स्तनुतामि॒मन्नो॒ विश्वे॑ दे॒वा इ॒ह मा॑दयन्तां",
      "start": 63.56,
      "end": 74.96
    },
    {
      "text": "ब्रद्ध्न॒ पिन्व॑स्व॒ दद॑तो मे॒",
      "start": 74.96,
      "end": 81.76
    },
    {
      "text": "मा क्षा॑यि कुर्व॒तो मे॒",
      "start": 81.76,
      "end": 86.52
    },
    {
      "text": "मोप॑ दसत् प्र॒जाप॑तेर् भा॒गो᳚ऽस्यूर्ज॑स्वा॒न्",
      "start": 86.52,
      "end": 97.88
    },
    {
      "text": "पय॑स्वान् प्राणापा॒नौ मे॑ पाहि",
      "start": 97.88,
      "end": 99.72
    },
    {
      "text": "समानव्या॒नौ मे॑ पाह्युदानव्या॒नौ मे॑",
      "start": 99.72,
      "end": 99.72
    },
    {
      "text": "पा॒ह्यक्षि॑तो॒ऽस्यक्षि॑त्यै त्वा॒ ( )",
      "start": 99.72,
      "end": 99.72
    },
    {
      "text": "मा मे᳚ क्षेष्ठा अ॒मुत्रा॒मुष्मि॑न्",
      "start": 99.72,
      "end": 100.96
    },
    {
      "text": "ॅलो॒के",
      "start": 100.96,
      "end": 102.24
    }
  ],
