  "phrases": [
    {
      "text": "दि॒शि मासाः᳚ पि॒तरो॑ मार्जयन्तां",
      "start": 40.48,
      "end": 44.28
    },
    {
      "text": "प्र॒तीच्यां᳚ दि॒शि गृ॒हाः प॒शवो॑",
      "start": 44.28,
      "end": 49.0
    },
    {
      "text": "मार्जयन्ता॒मुदी᳚च्यां दि॒श्याप॒ ओष॑धयो॒ वन॒स्पत॑यो",
      "start": 49.0,
      "end": 59.88
    },
    {
      "text": "मार्जयन्तामू॒र्द्ध्वायां᳚ दि॒शि य॒ज्ञ्ः सं॑ॅवथ्स॒रो",
      "start": 59.88,
      "end": 69.52
    },
    {
      "text": "य॒ज्ञ्प॑तिर् मार्जयन्तां॒ ॅविष्णोः॒ क्रमो᳚ऽस्यभिमाति॒हा",
      "start": 69.52,
      "end": 74.76
    },
    {
      "text": "गा॑य॒त्रेण॒ छन्द॑सा पृथि॒वीमनु॒ वि",
      "start": 74.76,
      "end": 79.24
    },
    {
      "text": "क्र॑मे॒ निर्भ॑क्तः॒ स यं",
      "start": 79.24,
      "end": 81.92
    },
    {
      "text": "द्वि॒ष्मो विष्णोः॒ क्रमो᳚ऽस्यभिशस्ति॒हा त्रैष्टु॑भेन॒",
      "start": 81.92,
      "end": 89.08
    },
    {
      "text": "छन्द॑सा॒ ऽन्तरि॑क्ष॒मनु॒ वि क्र॑मे॒",
      "start": 89.08,
      "end": 92.76
    },
    {
      "text": "निर्भ॑क्तः॒ स यं द्वि॒ष्मो",
      "start": 92.76,
      "end": 92.76
    },
    {
      "text": "विष्णोः॒ क्रमो᳚ऽस्यरातीय॒तो ह॒न्ता जाग॑तेन॒",
      "start": 92.76,
      "end": 92.76
    },
    {
      "text": "छन्द॑सा॒ दिव॒मनु॒ वि क्र॑मे॒",
      "start": 92.76,
      "end": 92.76
    },
    {
      "text": "निर्भ॑क्तः॒ स यं द्वि॒ष्मो",
      "start": 92.76,
      "end": 92.76
    },
    {
      "text": "विष्णोः॒ क्रमो॑ऽसि शत्रूय॒तो ह॒न्ताऽऽनु॑ष्टुभेन॒",
      "start": 92.76,
      "end": 96.68
    },
    {
      "text": "छन्द॑सा॒ दिशोऽनु॒ वि क्र॑मे॒",
      "start": 96.68,
      "end": 97.96
    },
    {
      "text": "निर्भ॑क्तः॒ स यं द्वि॒ष्मः",
      "start": 97.96,
      "end": 100.76
    }
  ],
