  "phrases": [
    {
      "text": "ए॒वं ॅवि॒द्वान् द॑र्.शपूर्णमा॒सौ यज॑ते",
      "start": 91.68,
      "end": 96.48
    },
    {
      "text": "पर॒मामे॒व काष्ठां᳚ गच्छति॒ यो",
      "start": 96.48,
      "end": 99.64
    },
    {
      "text": "वै प्रजा॑तेन य॒ज्ञेन॒ यज॑ते॒",
      "start": 99.64,
      "end": 99.64
    },
    {
      "text": "प्र प्र॒जया॑ प॒शुभि॑र् मिथु॒नैर्",
      "start": 99.64,
      "end": 99.64
    },
    {
      "text": "जा॑यते॒ द्वाद॑श॒ मासाः᳚ संॅवथ्स॒रो",
      "start": 99.64,
      "end": 99.64
    },
    {
      "text": "द्वाद॑श द्व॒न्द्वानि॑ दर्.शपूर्णमा॒सयो॒स्तानि॑ सं॒पाद्या॒नीत्या॑हुर्",
      "start": 99.64,
      "end": 99.64
    },
    {
      "text": "व॒थ्सं चो॑पावसृ॒जत्यु॒खां चाधि॑ श्रय॒त्यव॑",
      "start": 99.64,
      "end": 99.64
    },
    {
      "text": "च॒ हन्ति॑ दृ॒षदौ॑ च",
      "start": 99.64,
      "end": 100.44
    },
    {
