  "phrases": [
    {
      "text": "यो वै स॑प्तद॒शं प्र॒जाप॑तिं",
      "start": 0.0,
      "end": 5.04
    },
    {
      "text": "ॅय॒ज्ञ्म॒न्वाय॑त्तं॒ ॅवेद॒ प्रति॑ य॒ज्ञेन॑",
      "start": 5.04,
      "end": 15.0
    },
    {
      "text": "तिष्ठति॒ न य॒ज्ञाद् भ्रꣳ॑शत॒",
      "start": 15.0,
      "end": 22.0
    },
    {
      "text": "आ श्रा॑व॒येति॒ चतु॑रक्षर॒मस्तु॒ श्रौष॒डिति॒",
      "start": 22.0,
      "end": 25.04
    },
    {
      "text": "चतु॑रक्षरं॒ ॅयजेति॒ द्व्य॑क्षरं॒ ॅये",
      "start": 25.04,
      "end": 25.64
    },
    {
      "text": "यजा॑मह॒ इति॒ पञ्चा᳚क्षरं द्व्यक्ष॒रो",
      "start": 25.64,
      "end": 25.64
    },
    {
      "text": "व॑षट्का॒र ए॒ष वै स॑प्तद॒शः",
      "start": 25.64,
      "end": 31.0
    },
    {
      "text": "प्र॒जाप॑तिर् य॒ज्ञ्म॒न्वाय॑त्तो॒ य ए॒वं",
      "start": 31.0,
      "end": 37.6
    },
    {
      "text": "ॅवेद॒ प्रति॑ य॒ज्ञेन॑ तिष्ठति॒",
      "start": 37.6,
      "end": 45.32
    },
    {
      "text": "न य॒ज्ञाद्- भ्रꣳ॑शते॒ यो",
      "start": 45.32,
      "end": 45.32
    },
    {
      "text": "वै य॒ज्ञ्स्य॒ प्राय॑णं प्रति॒ष्ठा",
      "start": 45.32,
      "end": 45.32
    },
    {
      "text": "-[ ]",
      "start": 45.32,
