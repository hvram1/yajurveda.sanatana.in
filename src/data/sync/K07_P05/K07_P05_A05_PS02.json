  "phrases": [
    {
      "text": "छन्दाꣳ॑सि वृङ्क्ते सज॒नीयꣳ॒॒ शस्यं॑",
      "start": 38.2,
      "end": 44.88
    },
    {
      "text": "ॅविह॒व्यꣳ॑ शस्य॑म॒गस्त्य॑स्य कयाशु॒भीयꣳ॒॒ शस्य॑मे॒ताव॒द्वा",
      "start": 44.88,
      "end": 60.16
    },
    {
      "text": "अ॑स्ति॒ याव॑दे॒तद्-याव॑दे॒वास्ति॒ तदे॑षां ॅवृङ्क्ते॒",
      "start": 60.16,
      "end": 74.24
    },
    {
      "text": "यदि॑ प्रातस्सव॒ने क॒लशो॒ दीर्ये॑त",
      "start": 74.24,
      "end": 80.8
    },
    {
      "text": "वैष्ण॒वीषु॑ शिपिवि॒ष्टव॑तीषु स्तुवीर॒न्॒.यद्वै य॒ज्ञ्स्या॑-ति॒रिच्य॑ते॒",
      "start": 80.8,
      "end": 95.72
    },
    {
      "text": "विष्णुं॒ तच्छि॑पिवि॒ष्टम॒भ्यति॑ रिच्यते॒ तद्विष्णुः॑",
      "start": 95.72,
      "end": 95.72
    },
    {
      "text": "शिपिवि॒ष्टोऽति॑रिक्त ए॒वाति॑रिक्तं दधा॒त्यथो॒ अति॑रिक्तेनै॒वा-ति॑रिक्तमा॒प्त्वाऽव॑",
      "start": 95.72,
      "end": 95.72
    },
    {
      "text": "( ) रुन्धते॒ यदि॑",
      "start": 95.72,
      "end": 95.72
    },
    {
      "text": "म॒द्ध्यन्दि॑ने॒ दीर्ये॑त वषट्का॒रनि॑धनꣳ॒॒ साम॑",
      "start": 95.72,
      "end": 95.72
    },
    {
      "text": "कुर्युर्वषट्का॒रो वै य॒ज्ञ्स्य॑ प्रति॒ष्ठा",
      "start": 95.72,
      "end": 95.72
    },
    {
      "text": "प्र॑ति॒ष्ठामे॒वैन॑द्-गमयन्ति॒ यदि॑ तृतीयसव॒न ए॒तदे॒व",
      "start": 95.72,
      "end": 107.32
    }
  ],
  "total_phrases": 11
