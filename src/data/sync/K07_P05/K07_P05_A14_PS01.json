  "phrases": [
    {
      "text": "अ॒ग्नये॑ गाय॒त्राय॑ त्रि॒वृते॒ राथ॑न्तराय",
      "start": 0.0,
      "end": 9.24
    },
    {
      "text": "वास॒न्ताया॒-ष्टाक॑पाल॒ इन्द्रा॑य॒ त्रैष्टु॑भाय पञ्चद॒शाय॒",
      "start": 9.24,
      "end": 19.52
    },
    {
      "text": "बार्.ह॑ताय॒ ग्रैष्मा॒यैका॑दशकपालो॒ विश्वे᳚भ्यो दे॒वेभ्यो॒",
      "start": 19.52,
      "end": 19.52
    },
    {
      "text": "जाग॑तेभ्यः सप्तद॒शेभ्यो॑ वैरू॒पेभ्यो॒ वार्.षि॑केभ्यो॒",
      "start": 19.52,
      "end": 27.56
    },
    {
      "text": "द्वाद॑शकपालो मि॒त्रावरु॑णाभ्या॒-मानु॑ष्टुभाभ्या-मेकविꣳ॒॒शाभ्यां᳚ ॅवैरा॒जाभ्याꣳ॑ शार॒दाभ्यां᳚",
      "start": 27.56,
      "end": 40.32
    },
    {
      "text": "पय॒स्या॑ बृह॒स्पत॑ये॒ पाङ्क्ता॑य त्रिण॒वाय॑",
      "start": 40.32,
      "end": 48.4
    },
    {
      "text": "शाक्व॒राय॒ हैम॑न्तिकाय च॒रुः स॑वि॒त्र",
      "start": 48.4,
      "end": 55.8
    },
    {
      "text": "आ॑तिच्छन्द॒साय॑ त्रयस्त्रिꣳ॒॒शाय॑ रैव॒ताय॑ शैशि॒राय॒",
      "start": 55.8,
      "end": 62.2
    },
    {
      "text": "द्वाद॑शकपा॒लो ऽदि॑त्यै॒ विष्णु॑पत्न्यै च॒रुर॒ग्नये॑",
      "start": 62.2,
      "end": 62.2
    },
    {
      "text": "वैश्वान॒राय॒ द्वाद॑शकपा॒लो ऽनु॑मत्यै च॒रुः",
      "start": 62.2,
      "end": 62.2
    },
    {
      "text": "का॒य एक॑कपालः",
      "start": 62.2,
      "end": 63.32
    }
  ],
  "total_phrases": 11
}