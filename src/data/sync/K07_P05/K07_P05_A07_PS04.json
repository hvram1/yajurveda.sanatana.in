  "phrases": [
    {
      "text": "-रुप॑ यन्ति प्राजाप॒त्यं प॒शुमा",
      "start": 143.64,
      "end": 147.08
    },
    {
      "text": "ल॑भन्ते य॒ज्ञो वै प्र॒जाप॑ति-र्य॒ज्ञ्स्या-न॑नुसर्गायाभिव॒र्त",
      "start": 147.08,
      "end": 149.76
    },
    {
      "text": "इ॒तः षण्मा॒सो ब्र॑ह्मसा॒मं भ॑वति॒",
      "start": 149.76,
      "end": 149.76
    },
    {
      "text": "ब्रह्म॒ वा अ॑भिव॒र्तो ब्रह्म॑णै॒व",
      "start": 149.76,
      "end": 149.76
    },
    {
      "text": "तथ् सु॑व॒र्गं ॅलो॒क-म॑भिव॒र्तय॑न्तो यन्ति",
      "start": 149.76,
      "end": 149.76
    },
    {
      "text": "प्रतिकू॒लमि॑व॒ हीतः सु॑व॒र्गो लो॒क",
      "start": 149.76,
      "end": 149.76
    },
    {
      "text": "इन्द्र॒ क्रतुं॑ न॒ आ",
      "start": 149.76,
      "end": 149.76
    },
    {
      "text": "भ॑र पि॒ता पु॒त्रेभ्यो॒ यथा᳚",
      "start": 149.76,
      "end": 149.76
    },
    {
      "text": "शिक्षा॑ नो अ॒स्मिन् पु॑रुहूत॒",
      "start": 149.76,
      "end": 149.76
    },
    {
      "text": "याम॑नि जी॒वा ज्योति॑रशीम॒हीत्य॒ (",
      "start": 149.76,
      "end": 154.0
    },
    {
      "text": ")-मुत॑ आय॒ताꣳ षण्मा॒सो ब्र॑ह्मसा॒मं",
      "start": 154.0,
      "end": 160.16
    },
    {
      "text": "भ॑वत्य॒यं ॅवै लो॒को ज्योतिः॑",
      "start": 160.16,
      "end": 166.04
    },
    {
      "text": "प्र॒जा ज्योति॑रि॒ममे॒व तल्लो॒कं पश्य॑न्तोऽभि॒वद॑न्त॒",
      "start": 166.04,
      "end": 177.04
    },
    {
      "text": "आ य॑न्ति",
      "start": 177.04,
      "end": 178.4
    }
  ],
  "total_phrases": 14
}