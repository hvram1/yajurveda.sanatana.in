  "phrases": [
    {
      "text": "यो वा अश्व॑स्य॒ मेद्ध्य॑स्य॒",
      "start": 0.0,
      "end": 8.8
    },
    {
      "text": "शिरो॒ वेद॑ शीर्.ष॒ण्वान् मेद्ध्यो॑",
      "start": 8.8,
      "end": 15.2
    },
    {
      "text": "भवत्यु॒षा वा अश्व॑स्य॒ मेद्ध्य॑स्य॒",
      "start": 15.2,
      "end": 25.2
    },
    {
      "text": "शिरः॒ सूर्य॒श्चक्षु॒र्वातः॑ प्रा॒णश्च॒न्द्रमाः॒ श्रोत्रं॒",
      "start": 25.2,
      "end": 33.8
    },
    {
      "text": "दिशः॒ पादा॑ अवान्तरदि॒शाः पर्.श॑वोऽहोरा॒त्रे",
      "start": 33.8,
      "end": 33.8
    },
    {
      "text": "नि॑मे॒षो᳚ऽर्द्धमा॒साः पर्वा॑णि॒ मासाः᳚ स॒धांना᳚न्यृ॒तवोऽङ्गा॑नि",
      "start": 33.8,
      "end": 33.8
    },
    {
      "text": "संॅवथ्स॒र आ॒त्मा र॒श्मयः॒ केशा॒",
      "start": 33.8,
      "end": 33.8
    },
    {
      "text": "नक्ष॑त्राणि रू॒पं तार॑का अ॒स्थानि॒",
      "start": 33.8,
      "end": 33.8
    },
    {
      "text": "नभो॑ माꣳ॒॒सान्योष॑धयो॒ लोमा॑नि॒ वन॒स्पत॑यो॒",
      "start": 33.8,
      "end": 33.8
    },
    {
      "text": "वाला॑ अ॒ग्निर्मुखं॑ ॅवैश्वान॒रो व्यात्तꣳ॑",
      "start": 33.8,
      "end": 34.52
