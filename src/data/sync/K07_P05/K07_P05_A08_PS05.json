  "phrases": [
    {
      "text": "सं॒भृत्य॒ तेज॑ आ॒त्मन् द॑धते॒",
      "start": 153.8,
      "end": 154.2
    },
    {
      "text": "तस्मा॒देकः॑ प्रा॒णः सर्वा॒ण्यङ्गा᳚न्यव॒त्यथो॒ यथा॑",
      "start": 154.2,
      "end": 165.2
    },
    {
      "text": "सुप॒र्ण उ॑त्पति॒ष्यञ्छिर॑ उत्त॒मं कु॑रु॒त",
      "start": 165.2,
      "end": 173.88
    },
    {
      "text": "ए॒वमे॒व तद्-यज॑मानाः प्र॒जाना॑मुत्त॒मा भ॑वन्त्यास॒न्दी-मु॑द्गा॒ता",
      "start": 173.88,
      "end": 185.08
    },
    {
      "text": "ऽऽरो॑हति॒ साम्रा᳚ज्यमे॒व ग॑च्छन्ति प्ले॒ङ्खꣳ",
      "start": 185.08,
      "end": 194.72
    },
    {
      "text": "होता॒ नाक॑स्यै॒व पृ॒ष्ठꣳ रो॑हन्ति",
      "start": 194.72,
      "end": 199.8
    },
    {
      "text": "कू॒र्चाव॑द्ध्व॒र्यु-र्ब्र॒द्ध्नस्यै॒व वि॒ष्टपं॑ गच्छन्त्ये॒ताव॑न्तो॒ वै",
      "start": 199.8,
      "end": 200.84
    },
    {
      "text": "दे॑वलो॒कास्तेष्वे॒व य॑थापू॒र्वं प्रति॑ (",
      "start": 200.84,
      "end": 200.84
    },
    {
      "text": ") तिष्ठ॒न्त्यथो॑ आ॒क्रम॑णमे॒व तथ्",
      "start": 200.84,
      "end": 200.84
    },
    {
      "text": "सेतुं॒ ॅयज॑मानाः कुर्वते सुव॒र्गस्य॑",
      "start": 200.84,
      "end": 205.4
    },
    {
