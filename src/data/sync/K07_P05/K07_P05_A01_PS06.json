  "phrases": [
    {
      "text": "तत् प॒था य॑न्ति समा॒नꣳ",
      "start": 222.24,
      "end": 225.76
    },
    {
      "text": "साम॑ भवति देवलो॒को वै",
      "start": 225.76,
      "end": 225.76
    },
    {
      "text": "साम॑ देवलो॒कादे॒व नय॑न्त्य॒न्याअ॑न्या॒ ऋचो॑",
      "start": 225.76,
      "end": 225.76
    },
    {
      "text": "भवन्ति मनुष्यलो॒को वा ऋचो॑",
      "start": 225.76,
      "end": 225.76
    },
    {
      "text": "मनुष्यलो॒कादे॒वान्यम॑न्यं देवलो॒कम॑भ्या॒रोह॑न्तो यन्त्यभिव॒र्तो ब्र॑ह्मसा॒मं",
      "start": 225.76,
      "end": 225.76
    },
    {
      "text": "भ॑वति सुव॒र्गस्य॑ लो॒कस्या॒भिवृ॑त्या अभि॒जिद्-भ॑वति",
      "start": 225.76,
      "end": 225.76
    },
    {
      "text": "सुव॒र्गस्य॑ लो॒कस्या॒भिजि॑त्यै विश्व॒जिद्-भ॑वति॒ विश्व॑स्य॒",
      "start": 225.76,
      "end": 225.76
    },
    {
      "text": "जित्यै॑ मा॒सिमा॑सि पृ॒ष्ठान्युप॑ यन्ति",
      "start": 225.76,
      "end": 233.88
    },
    {
      "text": "मा॒सिमा᳚स्यतिग्रा॒ह्या॑ गृह्यन्ते मा॒सिमा᳚स्ये॒व वी॒र्यं॑",
      "start": 233.88,
      "end": 245.8
    },
    {
      "text": "( ) दधति मा॒सां",
      "start": 245.8,
      "end": 247.56
    },
    {
      "text": "प्रति॑ष्ठित्या उ॒परि॑ष्टान्मा॒सां पृ॒ष्ठान्युप॑ यन्ति॒",
      "start": 247.56,
      "end": 258.52
    },
    {
      "text": "तस्मा॑दु॒परि॑ष्टा॒दोष॑धयः॒ फलं॑ गृह्णन्ति",
      "start": 258.52,
      "end": 263.48
    }
  ],
  "total_phrases": 12
}