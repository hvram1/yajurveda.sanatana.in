  "phrases": [
    {
      "text": "द्वाद॒शे मा॒सि शृङ्गा॑णि॒ प्राव॑र्तन्त",
      "start": 23.72,
      "end": 23.92
    },
    {
      "text": "श्र॒द्धया॒ वाऽश्र॑द्धया वा॒ ता",
      "start": 23.92,
      "end": 29.32
    },
    {
      "text": "इ॒मा यास्तू॑प॒रा उ॒भय्यो॒ वाव",
      "start": 29.32,
      "end": 33.2
    },
    {
      "text": "ता आ᳚र्द्ध्नुव॒न्॒. याश्च॒ शृङ्गा॒ण्यस॑न्व॒न्॒.",
      "start": 33.2,
      "end": 45.12
    },
    {
      "text": "याश्चोर्ज॑म॒वारु॑न्धत॒र्द्ध्नोति॑ द॒शसु॑ मा॒सू᳚त्तिष्ठ॑न्नृ॒द्ध्नोति॑ द्वाद॒शसु॒",
      "start": 45.12,
      "end": 64.4
    },
    {
      "text": "य ए॒वं ॅवेद॑ प॒देन॒",
      "start": 64.4,
      "end": 66.28
    },
    {
      "text": "खलु॒ वा ए॒ते य॑न्ति",
      "start": 66.28,
      "end": 69.92
    },
    {
      "text": "वि॒न्दति॒ खलु॒ वै प॒देन॒",
      "start": 69.92,
      "end": 75.24
    },
    {
      "text": "यन् तद्वा ए॒तदृ॒द्धमय॑नं॒ तस्मा॑",
      "start": 75.24,
      "end": 79.44
    },
    {
      "text": "( ) दे॒तद्-गो॒सनि॑",
      "start": 79.44,
      "end": 80.6
    }
  ],
