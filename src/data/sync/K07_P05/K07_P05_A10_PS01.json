    {
      "text": "चर्माव॑ भिन्दन्ति पा॒प्मान॑मे॒वैषा॒मव॑ भिन्दन्ति॒",
      "start": 0.0,
      "end": 10.32
    },
    {
      "text": "माऽप॑ राथ्सी॒र्माऽति॑ व्याथ्सी॒रित्या॑ह संप्र॒त्ये॑वैषां᳚",
      "start": 10.32,
      "end": 22.4
    },
    {
      "text": "पा॒प्मान॒मव॑ भिन्दन्त्युदकु॒म्भान॑धिनि॒धाय॑ दा॒स्यो॑ मार्जा॒लीयं॒",
      "start": 22.4,
      "end": 33.36
    },
    {
      "text": "परि॑ नृत्यन्ति प॒दो नि॑घ्न॒तीरि॒दंम॑धुं॒",
      "start": 33.36,
      "end": 33.36
    },
    {
      "text": "गाय॑न्त्यो॒ मधु॒ वै दे॒वानां᳚",
      "start": 33.36,
      "end": 33.36
    },
    {
      "text": "पर॒म-म॒न्नाद्यं॑ पर॒ममे॒वा-न्नाद्य॒मव॑ रुन्धते प॒दो",
      "start": 33.36,
      "end": 33.36
    },
    {
      "text": "नि घ्न॑न्ति मही॒यामे॒वैषु॑ दधति",
      "start": 33.36,
      "end": 36.2
    }
  ],
