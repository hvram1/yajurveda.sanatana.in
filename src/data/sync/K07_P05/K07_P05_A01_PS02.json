  "phrases": [
    {
      "text": "सं॑ॅवथ्स॒रो य ए॒वं ॅवि॒द्वाꣳसः॑",
      "start": 41.44,
      "end": 47.64
    },
    {
      "text": "संॅवथ्स॒र-मु॑प॒यन्त्यृ॑द्ध्नु॒वन्त्ये॒व तस्मा᳚त् तूप॒रा वार्.षि॑कौ॒",
      "start": 47.64,
      "end": 56.64
    },
    {
      "text": "मासौ॒ पर्त्वा॑ चरति स॒त्राभि॑जितꣳ॒॒ह्य॑स्यै॒",
      "start": 56.64,
      "end": 65.16
    },
    {
      "text": "तस्मा᳚थ् संॅवथ्सर॒सदो॒ यत् किं",
      "start": 65.16,
      "end": 66.36
    },
    {
      "text": "च॑ गृ॒हे क्रि॒यते॒ तदा॒प्त-मव॑रुद्ध-म॒भिजि॑तं",
      "start": 66.36,
      "end": 71.6
    },
    {
      "text": "क्रियते समु॒द्रं ॅवा ए॒ते",
      "start": 71.6,
      "end": 75.6
    },
    {
      "text": "प्र प्ल॑वन्ते॒ ये सं॑ॅवथ्स॒रमु॑प॒यन्ति॒",
      "start": 75.6,
      "end": 79.28
    },
    {
      "text": "यो वै स॑मु॒द्रस्य॑ पा॒रं",
      "start": 79.28,
      "end": 79.28
    },
    {
      "text": "न पश्य॑ति॒ न वै",
      "start": 79.28,
      "end": 79.28
    },
    {
      "text": "स तत॒ उदे॑ति संॅवथ्स॒रो",
      "start": 79.28,
      "end": 79.28
    },
