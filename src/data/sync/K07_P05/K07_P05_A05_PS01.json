    {
      "text": "यदि॒ सोमौ॒ सꣳसु॑तौ॒ स्यातां᳚",
      "start": 0.0,
      "end": 0.52
    },
    {
      "text": "मह॒ति रात्रि॑यै प्रातरनुवा॒क-मु॒पाकु॑र्या॒त् पूर्वो॒",
      "start": 0.52,
      "end": 8.12
    },
    {
      "text": "वाचं॒ पूर्वो॑ दे॒वताः॒ पूर्वः॒",
      "start": 8.12,
      "end": 13.04
    },
    {
      "text": "छन्दाꣳ॑सि वृङ्क्ते॒ वृष॑ण्वतीं प्रति॒पदं॑",
      "start": 13.04,
      "end": 17.84
    },
    {
      "text": "कुर्यात् प्रातस्सव॒नादे॒वैषा॒मिन्द्रं॑ ॅवृ॒ङ्क्ते ऽथो॒",
      "start": 17.84,
      "end": 23.32
    },
    {
      "text": "खल्वा॑हुःसवनमु॒खे-स॑वनमुखे का॒र्येति॑ सवनमु॒खाथ् स॑वनमुखा-दे॒वैषा॒मिन्द्रं॑",
      "start": 23.32,
      "end": 23.32
    },
    {
      "text": "ॅवृङ्क्ते संॅवे॒शायो॑पवे॒शाय॑ गायत्रि॒यास्त्रि॒ष्टुभो॒ जग॑त्या",
      "start": 23.32,
      "end": 23.32
    },
    {
      "text": "अनु॒ष्टुभः॑ प॒ङ्क्त्या अ॒भिभू᳚त्यै॒ स्वाहा॒",
      "start": 23.32,
      "end": 26.12
    },
    {
      "text": "छन्दाꣳ॑सि॒ वै सं॑ॅवे॒श उ॑पवे॒शः",
      "start": 26.12,
      "end": 33.04
    },
    {
