  "phrases": [
    {
      "text": "अ॒र्क्ये॑ण॒ वै स॑हस्र॒शः प्र॒जाप॑तिः",
      "start": 0.0,
      "end": 8.32
    },
    {
      "text": "प्र॒जा अ॑सृजत॒ ताभ्य॒ इला᳚दें॒नेरां॒",
      "start": 8.32,
      "end": 12.0
    },
    {
      "text": "ॅलूता॒मवा॑रुन्ध॒ यद॒र्क्यं॑ भव॑ति प्र॒जा",
      "start": 12.0,
      "end": 12.0
    },
    {
      "text": "ए॒व तद्-यज॑मानाः सृजन्त॒ इला᳚दं",
      "start": 12.0,
      "end": 12.0
    },
    {
      "text": "भवति प्र॒जाभ्य॑ ए॒व सृ॒ष्टाभ्य॒",
      "start": 12.0,
      "end": 12.0
    },
    {
      "text": "इरां॒ ॅलूता॒मव॑ रुन्धते॒ तस्मा॒द्याꣳ",
      "start": 12.0,
      "end": 12.0
    },
    {
      "text": "समाꣳ॑ स॒त्रꣳ समृ॑द्धं॒ क्षोधु॑का॒स्ताꣳ",
      "start": 12.0,
      "end": 12.0
    },
    {
      "text": "समां᳚ प्र॒जा इषꣳ॒॒ ह्या॑सा॒मूर्ज॑मा॒दद॑ते॒",
      "start": 12.0,
      "end": 12.0
    },
    {
      "text": "याꣳ समां॒ ॅव्यृ॑द्ध॒-मक्षो॑धुका॒स्ताꣳ समां᳚",
      "start": 12.0,
      "end": 17.32
    },
