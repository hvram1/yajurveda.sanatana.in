    {
      "text": "अ॒ग्नये॒ सम॑नमत् पृथि॒व्यै सम॑नम॒द्यथा॒ऽग्निः",
      "start": 0.0,
      "end": 8.92
    },
    {
      "text": "पृ॑थि॒व्या स॒मन॑मदे॒वं मह्यं॑ भ॒द्राः",
      "start": 8.92,
      "end": 16.88
    },
    {
      "text": "संन॑तयः॒ सं न॑मन्तु वा॒यवे॒",
      "start": 16.88,
      "end": 16.88
    },
    {
      "text": "सम॑नमद॒न्तरि॑क्षाय॒ सम॑नम॒द्यथा॑ वा॒युर॒न्तरि॑क्षेण॒ सूर्या॑य॒",
      "start": 16.88,
      "end": 16.88
    },
    {
      "text": "सम॑नमद्दि॒वे सम॑नम॒द्यथा॒ सूर्यो॑ दि॒वा",
      "start": 16.88,
      "end": 16.88
    },
    {
