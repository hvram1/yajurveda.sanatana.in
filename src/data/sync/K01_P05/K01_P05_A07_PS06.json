  "phrases": [
    {
      "text": "हिमा॒ इत्या॑ह श॒तायुः॒ पुरु॑षः",
      "start": 163.72,
      "end": 168.12
    },
    {
      "text": "श॒तेन्द्रि॑य॒ आयु॑ष्ये॒वेन्द्रि॒ये प्रति॑ तिष्ठत्ये॒षा",
      "start": 168.12,
      "end": 179.6
    },
    {
      "text": "वै सू॒र्मी कर्ण॑कावत्ये॒तया॑ ह",
      "start": 179.6,
      "end": 182.04
    },
    {
      "text": "स्म॒ वै दे॒वा असु॑राणाꣳ",
      "start": 182.04,
      "end": 185.8
    },
    {
      "text": "शतत॒र्॒.हाꣳ स्तृꣳ॑हन्ति॒ यदे॒तया॑ स॒मिध॑मा॒दधा॑ति॒",
      "start": 185.8,
      "end": 195.04
    },
    {
      "text": "वज्र॑मे॒वैतच्छ॑त॒घ्नीं ॅयज॑मानो॒ भ्रातृ॑व्याय॒ प्र",
      "start": 195.04,
      "end": 207.28
    },
    {
      "text": "ह॑रति॒ स्तृत्या॒ अछं॑बट्कारꣳ॒॒ सं",
      "start": 207.28,
      "end": 211.68
    },
    {
      "text": "त्वम॑ग्ने॒ सूर्य॑स्य॒ वर्च॑साऽगथा॒ इत्या॑है॒तत्त्वमसी॒दम॒हं",
      "start": 211.68,
      "end": 217.68
    },
    {
      "text": "( ) भू॑यास॒मिति॒ वावैतदा॑ह॒",
      "start": 217.68,
      "end": 221.0
    },
    {
      "text": "त्वम॑ग्ने॒ सूर्य॑वर्चा अ॒सीत्या॑हा॒ऽऽशिष॑मे॒वैतामा शा᳚स्ते",
      "start": 221.0,
      "end": 235.04
    }
  ],
