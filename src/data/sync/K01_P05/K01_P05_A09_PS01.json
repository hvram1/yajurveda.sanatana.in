    {
      "text": "अ॒ग्नि॒हो॒त्रं जु॑होति॒ यदे॒व किं",
      "start": 0.0,
      "end": 3.68
    },
    {
      "text": "च॒ यज॑मानस्य॒ स्वं तस्यै॒व",
      "start": 3.68,
      "end": 7.52
    },
    {
      "text": "तद्रेतः॑ सिञ्चति प्र॒जन॑ने प्र॒जन॑नꣳ॒॒",
      "start": 7.52,
      "end": 14.36
    },
    {
      "text": "हि वा अ॒ग्निरथौष॑धी॒रन्त॑गता दहति॒",
      "start": 14.36,
      "end": 18.08
    },
    {
      "text": "तास्ततो॒ भूय॑सीः॒ प्र जा॑यन्ते॒",
      "start": 18.08,
      "end": 23.84
    },
    {
      "text": "यथ्सा॒यं जु॒होति॒ रेत॑ ए॒व",
      "start": 23.84,
      "end": 28.12
    },
    {
      "text": "तथ्सि॑ञ्चति॒ प्रैव प्रा॑त॒स्तने॑न जनयति॒",
      "start": 28.12,
      "end": 35.6
    },
    {
      "text": "तद्रेतः॑ सि॒क्तं न त्वष्ट्राऽवि॑कृतं॒",
      "start": 35.6,
      "end": 42.64
    },
    {
      "text": "प्रजा॑यते याव॒च्छो वै रेत॑सः",
      "start": 42.64,
      "end": 44.16
    },
    {
