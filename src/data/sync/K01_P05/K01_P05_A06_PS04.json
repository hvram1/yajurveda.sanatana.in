    {
      "text": "मयि॑ वो॒ रायः॑ श्रयन्तां",
      "start": 93.8,
      "end": 98.0
    },
    {
      "text": "तथ्स॑वि॒तुर् वरे᳚ण्यं॒ भर्गो॑ दे॒वस्य॑ धीमहि",
      "start": 98.0,
      "end": 107.2
    },
    {
      "text": "धियो॒ योनः॑ प्रचो॒दया᳚त्",
      "start": 107.2,
      "end": 109.24
    },
    {
      "text": "सो॒मानꣳ॒॒ स्वर॑णं कृणु॒हि ब्र॑ह्मणस्पते",
      "start": 109.24,
      "end": 117.16
    },
    {
      "text": "क॒क्षीव॑न्तं॒ ॅय औ॑शि॒जं",
      "start": 117.16,
      "end": 121.36
    },
    {
      "text": "क॒दा च॒न स्त॒रीर॑सि॒ नेन्द्र॑",
      "start": 121.36,
      "end": 125.16
    },
    {
      "text": "सश्चसि दा॒शुषे᳚",
      "start": 125.16,
      "end": 127.68
    },
    {
      "text": "उपो॒पेन्नु म॑घव॒न् भुय॒ इन्नु",
      "start": 127.68,
      "end": 130.28
    },
    {
      "text": "ते॒ दानं॑ दे॒वस्य॑ पृच्यते",
      "start": 130.28,
      "end": 133.52
    },
    {
      "text": "परि॑ त्वाऽग्ने॒ पुरं॑ ॅव॒यं",
      "start": 133.52,
      "end": 137.16
    },
    {
      "text": "ॅविप्रꣳ॑ सहस्य धीमहि",
      "start": 137.16,
      "end": 137.96
    },
    {
      "text": "धृ॒षद्व॑र्णं ( ) दि॒वेदि॑वे",
      "start": 137.96,
      "end": 137.96
    },
    {
      "text": "भे॒त्तारं॑ भङ्गु॒राव॑तः",
      "start": 137.96,
      "end": 140.68
    },
    {
      "text": "अग्ने॑ गृहपते सुगृहप॒तिर॒हं त्वया॑",
      "start": 140.68,
      "end": 146.0
    },
    {
      "text": "गृ॒हप॑तिना भूयासꣳ सुगृहप॒तिर्मया॒ त्वं",
      "start": 146.0,
      "end": 148.48
    },
    {
      "text": "गृ॒हप॑तिना भूयाः श॒तꣳ हिमा॒स्तामा॒शिष॒मा",
