    {
      "text": "त्रिꣳ॒॒शद्धाम॒ वि रा॑जति॒ वाक्",
      "start": 1.2,
      "end": 1.2
    },
    {
      "text": "प॑त॒ङ्गाय॑ शिश्रिये",
      "start": 1.2,
      "end": 2.52
