  "phrases": [
    {
      "text": "देहि वर्चो॒दा अ॑ग्नेऽसि॒ वर्चो॑",
      "start": 125.96,
      "end": 131.6
    },
    {
      "text": "मे देहि तनू॒पा अ॑ग्नेऽसि",
      "start": 131.6,
      "end": 135.68
    },
    {
      "text": "त॒नुवं॑ मे पा॒ह्यग्ने॒ यन्मे॑",
      "start": 135.68,
      "end": 142.48
    },
    {
      "text": "त॒नुवा॑ ऊ॒नं तन्म॒ आ",
      "start": 142.48,
      "end": 145.52
    },
    {
      "text": "पृ॑ण॒ चित्रा॑वसो स्व॒स्ति ते॑",
      "start": 145.52,
      "end": 151.88
    },
    {
      "text": "पा॒रम॑शी॒येन्धा॑नास्त्वा श॒तꣳ हिमा᳚ द्यु॒मन्तः॒",
      "start": 151.88,
      "end": 161.12
    },
    {
      "text": "समि॑धीमहि॒ वय॑स्वन्तो वय॒स्कृतं॒ ॅयश॑स्वन्तो",
      "start": 161.12,
      "end": 167.28
    },
    {
      "text": "यश॒स्कृतꣳ॑ सु॒वीरा॑सो॒ अदा᳚भ्यं",
      "start": 167.28,
      "end": 167.28
    },
    {
      "text": "अग्ने॑ सपत्न॒दंभ॑नं॒ ॅवर्.षि॑ष्ठे॒ अधि॒ नाके᳚",
      "start": 167.28,
      "end": 167.28
    },
    {
      "text": "सं त्वम॑ग्ने॒ सूर्य॑स्य॒ वर्च॑सा",
      "start": 167.28,
      "end": 167.28
    },
    {
      "text": "( ) ऽगथाः॒ समृषी॑णाꣳ",
      "start": 167.28,
      "end": 167.28
    },
    {
      "text": "स्तु॒तेन॒ सं प्रि॒येण॒ धाम्ना᳚",
      "start": 167.28,
      "end": 167.28
    },
    {
      "text": "त्वम॑ग्ने॒ सूर्य॑वर्चा असि॒ सं",
      "start": 167.28,
      "end": 167.28
    },
    {
      "text": "मामायु॑षा॒ वर्च॑सा प्र॒जया॑ सृज",
      "start": 167.28,
      "end": 173.6
    }
  ],
  "total_phrases": 14
