    {
      "text": "वे॒धसः॑",
      "start": 105.16,
      "end": 105.16
    },
    {
      "text": "पू॒ष्णस्तान्यपि॑ व्र॒त इ॑न्द्रवा॒यू वि मु॑ञ्चतां",
      "start": 105.16,
      "end": 105.16
    },
    {
      "text": "अभि॑न्नो घ॒र्मो जी॒रदा॑नु॒र्यत॒ आत्त॒स्तद॑ग॒न् पुनः॑",
      "start": 105.16,
      "end": 105.2
    },
    {
      "text": "इ॒द्ध्मो वेदिः॑ परि॒धय॑श्च॒ सर्वे॑",
      "start": 105.2,
      "end": 115.2
    },
    {
      "text": "य॒ज्ञ्स्याऽऽयु॒रनु॒ सं च॑रन्ति",
      "start": 115.2,
      "end": 121.08
    },
    {
      "text": "त्रय॑स्त्रिꣳश॒त् तन्त॑वो॒॒ ये वि॑तत्नि॒रे",
      "start": 121.08,
      "end": 129.68
    },
    {
      "text": "य इ॒मं ॅय॒ज्ञ्ꣳ स्व॒धया॒",
      "start": 129.68,
      "end": 136.68
    },
    {
      "text": "दद॑न्ते॒ तेषां᳚ छि॒न्नं प्रत्ये॒तद्-द॑धामि॒",
      "start": 136.68,
      "end": 146.24
    },
    {
      "text": "स्वाहा॑ घ॒र्मो दे॒वाꣳ अप्ये॑तु",
      "start": 146.24,
      "end": 150.84
    }
  ],
