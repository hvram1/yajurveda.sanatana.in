  "phrases": [
    {
      "text": "य ए॒वं ॅवि॒द्वान॒ग्नि-मु॑प॒तिष्ठ॑ते॒ परि॑",
      "start": 106.6,
      "end": 106.6
    },
    {
      "text": "त्वाऽग्ने॒ पुरं॑ ॅव॒यमित्या॑ह परि॒धिमे॒वैतं",
      "start": 106.6,
      "end": 110.28
    },
    {
      "text": "परि॑ दधा॒त्यस्क॑न्दा॒याग्ने॑ गृहपत॒ इत्या॑ह",
      "start": 110.28,
      "end": 120.32
    },
    {
      "text": "यथाय॒जुरे॒वैतच्छ॒तꣳ हिमा॒ इत्या॑ह श॒तं",
      "start": 120.32,
      "end": 125.52
    },
    {
      "text": "त्वा॑ हेम॒न्तानि॑न्धिषी॒येति॒ वावैतदा॑ह पु॒त्रस्य॒",
      "start": 125.52,
      "end": 135.8
    },
    {
      "text": "नाम॑ गृह्णात्यन्ना॒दमे॒वैनं॑ करोति॒ तामा॒शिष॒मा",
      "start": 135.8,
      "end": 143.76
    },
    {
      "text": "शा॑से॒ तन्त॑वे॒ ज्योति॑ष्मती॒मिति॑ ब्रूया॒द्यस्य॑",
      "start": 143.76,
      "end": 155.76
    },
    {
      "text": "पु॒त्रोऽजा॑तः॒ स्यात् ते॑ज॒स्व्ये॑वास्य॑ ब्रह्मवर्च॒सी",
      "start": 155.76,
      "end": 162.64
    },
    {
      "text": "पु॒त्रो जा॑यते॒ तामा॒शिष॒मा शा॑से॒",
      "start": 162.64,
      "end": 162.64
    },
    {
      "text": "ऽमुष्मै॒ ज्योति॑ष्मती॒ ( )",
      "start": 162.64,
      "end": 162.64
    },
    {
      "text": "मिति॑ ब्रूया॒द्यस्य॑ पु॒त्रो जा॒तः",
      "start": 162.64,
      "end": 163.92
    },
    {
      "text": "स्यात् तेज॑ ए॒वास्मि॑न् ब्रह्मवर्च॒सं",
      "start": 163.92,
      "end": 169.48
    },
    {
      "text": "द॑धाति",
      "start": 169.48,
      "end": 170.76
    }
  ],
