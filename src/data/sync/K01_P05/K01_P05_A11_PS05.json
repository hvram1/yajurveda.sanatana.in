  "phrases": [
    {
      "text": "उप॑ गन्तन",
      "start": 150.08,
      "end": 150.08
    },
    {
      "text": "या वः॒ शर्म॑ शशमा॒नाय॒",
      "start": 150.08,
      "end": 153.24
    },
    {
      "text": "सन्ति॑ त्रि॒धातू॑नि दा॒शुषे॑ यच्छ॒ताधि॑",
      "start": 153.24,
      "end": 158.52
    },
    {
      "text": "अ॒स्मभ्यं॒ तानि॑ मरुतो॒ वि",
      "start": 158.52,
      "end": 161.56
    },
    {
      "text": "य॑न्त र॒यिं नो॑ धत्त",
      "start": 161.56,
      "end": 161.56
    },
    {
      "text": "वृषणः सु॒वीरं᳚",
      "start": 161.56,
      "end": 161.56
    },
    {
      "text": "अदि॑तिर् न उरुष्य॒त्वदि॑तिः॒ शर्म॑ यच्छतु",
      "start": 161.56,
      "end": 164.04
    },
    {
      "text": "अदि॑तिः पा॒त्वꣳह॑सः",
      "start": 164.04,
      "end": 167.16
    },
    {
      "text": "म॒हीमू॒षु मा॒तरꣳ॑ सुव्र॒ताना॑मृ॒तस्य॒ पत्नी॒मव॑से हुवेम",
      "start": 167.16,
      "end": 174.28
    },
    {
      "text": "तु॒वि॒क्ष॒त्रा-म॒जर॑न्ती-मुरू॒चीꣳ सु॒शर्मा॑ण॒मदि॑तिꣳ सु॒प्रणी॑तिं",
      "start": 174.28,
      "end": 185.68
    },
    {
      "text": "सु॒त्रामा॑णं पृथि॒वीं द्याम॑ने॒हसꣳ॑ सु॒शर्मा॑ण॒",
      "start": 185.68,
      "end": 196.08
    },
    {
      "text": "( ) मदि॑तिꣳ सु॒प्रणी॑तिं",
      "start": 196.08,
      "end": 198.76
    },
    {
      "text": "दैवीं॒ नावꣳ॑ स्वरि॒त्रा-मना॑गस॒-मस्र॑वन्ती॒मा रु॑हेमा स्व॒स्तये᳚",
      "start": 198.76,
      "end": 208.16
    },
    {
      "text": "इ॒माꣳ सु नाव॒माऽरु॑हꣳ श॒तारि॑त्राꣳ श॒तस्फ्यां᳚",
      "start": 208.16,
      "end": 214.32
    },
    {
      "text": "अच्छि॑द्रां पारयि॒ष्णुं",
      "start": 214.32,
      "end": 221.48
    }
  ],
  "total_phrases": 15
}