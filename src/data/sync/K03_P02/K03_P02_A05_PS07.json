    {
      "text": "यत् का॑मास्ते जुहु॒मस्तन्नो॑ अस्तु",
      "start": 214.0,
      "end": 215.76
    },
    {
      "text": "व॒यꣳ स्या॑म॒ पत॑यो रयी॒णां",
      "start": 215.76,
      "end": 216.92
    },
    {
      "text": "दे॒वकृ॑त॒स्यैन॑सो ऽव॒यज॑नमसि मनु॒ष्य॑कृत॒स्यैन॑सो ऽव॒यज॑नमसि",
      "start": 216.92,
      "end": 220.88
    },
    {
      "text": "पि॒तृकृ॑त॒स्यैन॑सो ऽव॒यज॑नमस्य॒फ्सु धौ॒तस्य॑ सोम",
      "start": 220.88,
      "end": 230.16
    },
    {
      "text": "देव ते॒ नृभिः॑ सु॒तस्ये॒ष्ट",
      "start": 230.16,
      "end": 235.32
