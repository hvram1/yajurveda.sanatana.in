  "phrases": [
    {
      "text": "श॒म्भूर्म॑यो॒भूः स्व॒स्ति मा॑ हरिवर्ण॒",
      "start": 30.84,
      "end": 38.56
    },
    {
      "text": "प्रच॑र॒ क्रत्वे॒ दक्षा॑य रा॒यस्पोषा॑य",
      "start": 38.56,
      "end": 49.44
    },
    {
      "text": "सुवी॒रता॑यै॒ मा मा॑ राज॒न्.",
      "start": 49.44,
      "end": 54.36
    },
    {
      "text": "वि बी॑भिषो॒ मा मे॒",
      "start": 54.36,
      "end": 57.32
    },
    {
      "text": "हार्दि॑ त्वि॒षा व॑धीः",
      "start": 57.32,
      "end": 60.68
    },
    {
      "text": "वृष॑णे॒ शुष्मा॒याऽऽयु॑षे॒ वर्च॑से",
      "start": 60.68,
      "end": 66.12
    },
    {
      "text": "वसु॑मद्-गणस्य सोम देव ते",
      "start": 66.12,
      "end": 66.52
    },
    {
      "text": "मति॒विदः॑ प्रात॒स्सव॒नस्य॑ गाय॒त्रछ॑न्दस॒ इन्द्र॑पीतस्य॒",
      "start": 66.52,
      "end": 77.12
    },
    {
      "text": "नरा॒शꣳस॑पीतस्य पि॒तृपी॑तस्य॒ मधु॑मत॒ उप॑हूत॒स्योप॑हूतो",
      "start": 77.12,
      "end": 77.6
    },
    {
      "text": "भक्षयामि रु॒द्रव॑द्-गणस्य सोम देव",
      "start": 77.6,
      "end": 77.6
    },
    {
      "text": "ते मति॒विदो॒ माद्ध्य॑न्दिनस्य॒ सव॑नस्य",
      "start": 77.6,
      "end": 82.48
    },
    {
      "text": "त्रि॒ष्टुप्छ॑न्दस॒ इन्द्र॑पीतस्य॒ नरा॒शꣳ स॑पीतस्य",
