  "phrases": [
    {
      "text": "प॒शुम॑कुर्वत दा॒र्श्यं ॅय॒ज्ञ्मा᳚ग्ने॒यं प॒शुम॑कुर्वत",
      "start": 66.72,
      "end": 74.4
    },
    {
      "text": "वैश्वदे॒वं प्रा॑तस्सव॒न -म॑कुर्वत वरुणप्रघा॒सान्",
      "start": 74.4,
      "end": 78.72
    },
    {
      "text": "माद्ध्य॑दिंनꣳ॒॒ सव॑नꣳ साकमे॒धान् पि॑तृय॒ज्ञ्ं",
      "start": 78.72,
      "end": 87.76
    },
    {
      "text": "त्र्य॑म्बकाꣳ-स्तृतीयसव॒नम॑कुर्वत॒ तमे॑षा॒मसु॑रा य॒ज्ञ् -म॒न्ववा॑जिगाꣳस॒न्",
      "start": 87.76,
      "end": 95.88
    },
    {
      "text": "तं नाऽन्ववा॑य॒न् ते᳚ऽब्रुवन्नद्ध्वर्त॒व्या वा",
      "start": 95.88,
      "end": 96.08
    },
    {
      "text": "इ॒मे दे॒वा अ॑भूव॒न्निति॒ तद॑द्ध्व॒रस्या᳚",
      "start": 96.08,
      "end": 100.56
    },
    {
      "text": "ऽद्ध्वर॒त्वं ततो॑ दे॒वा अभ॑व॒न्",
      "start": 100.56,
      "end": 105.52
    },
    {
      "text": "पराऽसु॑रा॒ य ए॒वं ॅवि॒द्वान्थ्",
      "start": 105.52,
      "end": 111.88
    },
    {
      "text": "सोमे॑न॒ यज॑ते॒ भव॑त्या॒त्मना॒ परा᳚",
      "start": 111.88,
      "end": 117.56
    },
    {
      "text": "( ) ऽस्य॒ भ्रातृ॑व्यो",
      "start": 117.56,
      "end": 118.28
    },
    {
      "text": "भवति",
      "start": 118.28,
      "end": 118.88
    }
  ],
  "total_phrases": 11
}