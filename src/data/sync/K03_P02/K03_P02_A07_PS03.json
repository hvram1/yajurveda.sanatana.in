  "phrases": [
    {
      "text": "य॒ज्ञ्प॑तिं दु॒हे य॒ज्ञ्प॑तिर्वा य॒ज्ञ्ं",
      "start": 48.4,
      "end": 52.28
    },
    {
      "text": "दु॑हे॒ स यः स्तु॑तश॒स्त्रयो॒र्दोह॒म",
      "start": 52.28,
      "end": 56.32
    },
    {
      "text": "वि॑द्वा॒न॒. यज॑ते॒ तं ॅय॒ज्ञो",
      "start": 56.32,
      "end": 56.32
    },
    {
      "text": "दु॑हे॒ स इ॒ष्ट्वा पापी॑यान्",
      "start": 56.32,
      "end": 59.96
    },
    {
      "text": "भवति॒ य ए॑नयो॒र्दोहं॑ ॅवि॒द्वान्.",
      "start": 59.96,
      "end": 63.88
    },
    {
      "text": "यज॑ते॒ स य॒ज्ञ्ं दु॑हे॒",
      "start": 63.88,
      "end": 69.4
    },
    {
      "text": "स इ॒ष्ट्वा वसी॑यान् भवति",
      "start": 69.4,
      "end": 74.52
    },
    {
      "text": "स्तु॒तस्य॑ स्तु॒तम॒स्यूर्जं॒ मह्यꣳ॑ स्तु॒तं",
      "start": 74.52,
      "end": 82.16
    },
    {
      "text": "दु॑हा॒मा मा᳚ स्तु॒तस्य॑ स्तु॒तं",
      "start": 82.16,
      "end": 82.16
    },
    {
      "text": "ग॑म्याच्छ॒स्त्रस्य॑ श॒स्त्रम॒स्यूर्जं॒ मह्यꣳ॑ श॒स्त्रं",
      "start": 82.16,
      "end": 82.16
    },
    {
      "text": "दु॑हा॒ ( ) मा",
      "start": 82.16,
      "end": 82.16
    },
    {
      "text": "मा॑ श॒स्त्रस्य॑ श॒स्त्रं ग॑म्या॒दित्या॑है॒ष",
      "start": 82.16,
      "end": 90.36
    },
    {
      "text": "वै स्तु॑तश॒स्त्रयो॒र्दोह॒स्तं ॅय ए॒वं",
      "start": 90.36,
      "end": 93.04
    },
    {
      "text": "ॅवि॒द्वान्. यज॑ते दु॒ह ए॒व",
      "start": 93.04,
      "end": 96.16
    },
    {
      "text": "य॒ज्ञ्मि॒ष्ट्वा वसी॑यान् भवति",
      "start": 96.16,
      "end": 103.04
    }
  ],
