    {
      "text": "द॒ग्निः पृ॑थि॒व्या य॒मः पि॒तृभ्यः॒",
      "start": 108.12,
      "end": 113.68
    },
    {
      "text": "सर॑स्वती मनु॒ष्ये᳚भ्यो॒ देवी᳚ द्वारौ॒",
      "start": 113.68,
      "end": 118.28
    },
    {
      "text": "मा मा॒ सं ता᳚प्तं॒",
      "start": 118.28,
      "end": 119.72
    },
    {
      "text": "नमः॒ सद॑से॒ नमः॒ सद॑स॒स्पत॑ये॒",
      "start": 119.72,
      "end": 126.6
    },
    {
      "text": "नमः॒ सखी॑नां पुरो॒गाणां॒ चक्षु॑षे॒",
      "start": 126.6,
      "end": 129.16
    },
    {
      "text": "नमो॑ दि॒वे नमः॑ पृथि॒व्या",
      "start": 129.16,
      "end": 131.56
    },
    {
      "text": "अहे॑ दैधिष॒व्योदत॑स्तिष्ठा॒ऽन्यस्य॒ सद॑ने सीद॒",
      "start": 131.56,
      "end": 136.88
    },
    {
      "text": "यो᳚ऽस्मत् पाक॑तर॒ उन्नि॒वत॒ उदु॒द्वत॑श्च",
      "start": 136.88,
      "end": 136.88
    },
    {
      "text": "गेषं पा॒तं मा᳚ द्यावापृथिवी",
      "start": 136.88,
      "end": 136.88
