    {
      "text": "त्रीणि॒ वाव सव॑ना॒न्यथ॑ तृ॒तीयꣳ॒॒",
      "start": 0.0,
      "end": 5.64
    },
    {
      "text": "सव॑न॒मव॑ लुम्पन्त्यनꣳ॒॒शु कु॒र्वन्त॑ उपाꣳ॒॒शुꣳहु॒त्वोपाꣳ॑शुपा॒त्रेऽꣳ॑शुम॒वास्य॒",
      "start": 5.64,
      "end": 18.36
    },
    {
      "text": "तन्तृ॑तीयसव॒ने॑ ऽपि॒सृज्या॒भि षु॑णुया॒द्यदा᳚प्या॒यय॑ति॒ तेनाꣳ॑शु॒मद्यद॑भिषु॒णोति॒",
      "start": 18.36,
      "end": 30.6
    },
    {
      "text": "तेन॑र्जी॒षि सर्वा᳚ण्ये॒व तथ् सव॑नान्यꣳशु॒मन्ति॑",
      "start": 30.6,
      "end": 39.44
    },
    {
      "text": "शु॒क्रव॑न्ति स॒माव॑द्वीर्याणि करोति॒ द्वौ",
      "start": 39.44,
      "end": 44.12
    },
    {
      "text": "स॑मु॒द्रौ वित॑तावजू॒र्यौ प॒र्याव॑र्तेते ज॒ठरे॑व॒",
      "start": 44.12,
      "end": 44.12
    },
    {
      "text": "पादाः᳚",
      "start": 44.12,
      "end": 44.12
    },
    {
      "text": "तयोः॒ पश्य॑न्तो॒ अति॑ यन्त्य॒न्यमप॑श्यन्तः॒",
