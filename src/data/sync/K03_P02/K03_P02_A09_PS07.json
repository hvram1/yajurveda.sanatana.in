  "phrases": [
    {
      "text": "तिष्ठ॑तीव॒ ह्य॑सावथो॑ अ॒मूमे॒व तेन॒",
      "start": 219.0,
      "end": 224.0
    },
    {
      "text": "यज॑मानो दुहे॒ यदासी॑नः॒ शꣳस॑ति॒",
      "start": 224.0,
      "end": 227.96
    },
    {
      "text": "तस्मा॑दि॒तः प्र॑दानं दे॒वा उप॑",
      "start": 227.96,
      "end": 231.84
    },
    {
      "text": "जीवन्ति॒ यत् तिष्ठ॑न् प्रतिगृ॒णाति॒",
      "start": 231.84,
      "end": 231.84
    },
    {
      "text": "तस्मा॑द॒मुतः॑ प्रदानं मनु॒ष्या॑ उप॑",
      "start": 231.84,
      "end": 231.84
    },
    {
      "text": "जीवन्ति॒ यत् प्राङासी॑नः॒ शꣳस॑ति",
      "start": 231.84,
      "end": 231.84
    },
    {
      "text": "प्र॒त्यङ् तिष्ठ॑न् प्रतिगृ॒णाति॒ तस्मा᳚त्",
      "start": 231.84,
      "end": 231.84
    },
    {
      "text": "प्रा॒चीनꣳ॒॒ रेतो॑ धीयते प्र॒तीचीः᳚",
      "start": 231.84,
      "end": 231.84
    },
    {
      "text": "प्र॒जा जा॑यन्ते॒ यद्वै होता᳚ऽद्ध्व॒र्युम॑भ्या॒ह्वय॑ते॒",
      "start": 231.84,
      "end": 231.84
    },
    {
