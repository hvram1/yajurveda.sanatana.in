    {
      "text": "मृ॒चः प्र॑ण॒व उ॑क्थशꣳ॒॒सिनां᳚ प्रतिग॒रो᳚ऽद्ध्वर्यू॒णां",
      "start": 172.56,
      "end": 174.56
    },
    {
      "text": "ॅय ए॒वं ॅवि॒द्वान् प्र॑तिगृ॒णात्य॑न्ना॒द",
      "start": 174.56,
      "end": 180.84
    },
    {
      "text": "ए॒व भ॑व॒त्याऽस्य॑ प्र॒जायां᳚ ॅवा॒जी",
      "start": 180.84,
      "end": 186.88
    },
    {
      "text": "जा॑यत इ॒यं ॅवै होता॒ऽसाव॑द्ध्व॒र्युर्यदासी॑नः॒",
      "start": 186.88,
      "end": 197.36
    },
    {
      "text": "शꣳ स॑त्य॒स्या ए॒व तद्धोता॒",
      "start": 197.36,
      "end": 202.84
    },
    {
      "text": "नैत्यास्त॑ इव॒ हीयमथो॑ इ॒मामे॒व",
      "start": 202.84,
      "end": 205.6
