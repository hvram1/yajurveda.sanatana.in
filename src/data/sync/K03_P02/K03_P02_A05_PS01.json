    {
      "text": "भक्षेहि॒ मा ऽऽवि॑श दीर्घायु॒त्वाय॑",
      "start": 0.0,
      "end": 3.96
    },
    {
      "text": "शन्तनु॒त्वाय॑ रा॒यस्पोषा॑य॒ वर्च॑से सुप्रजा॒स्त्वायेहि॑",
      "start": 3.96,
      "end": 13.04
    },
    {
      "text": "वसो पुरो वसो प्रि॒यो",
      "start": 13.04,
      "end": 14.96
    },
    {
      "text": "मे॑ हृ॒दो᳚ऽस्य॒श्विनो᳚स्त्वा बा॒हुभ्याꣳ॑ सघ्यासं",
      "start": 14.96,
      "end": 20.84
    },
    {
      "text": "नृ॒चक्ष॑सं त्वा देव सोम",
      "start": 20.84,
      "end": 23.08
    },
    {
      "text": "सु॒चक्षा॒ अव॑ ख्येषं म॒न्द्राऽभिभू॑तिः",
      "start": 23.08,
      "end": 25.52
    },
    {
      "text": "के॒तुर्य॒ज्ञानां॒ ॅवाग्जु॑षा॒णा सोम॑स्य तृप्यतु",
      "start": 25.52,
      "end": 25.52
    },
    {
      "text": "म॒न्द्रा स्व॑र्वा॒च्यदि॑ति॒रना॑हत शीर्ष्णी॒ वाग्जु॑षा॒णा",
      "start": 25.52,
      "end": 25.52
