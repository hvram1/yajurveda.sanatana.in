      "end": 94.36
    },
    {
      "text": "वि॒श्वक॑र्मा",
      "start": 94.36,
      "end": 94.36
    },
    {
      "text": "नमः॑ पि॒तृभ्यो॑ अ॒भि ये",
      "start": 94.36,
      "end": 94.36
