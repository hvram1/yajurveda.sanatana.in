  "phrases": [
    {
      "text": "ए॒तस्य॑ स्कन्दति॒ यस्य॑ पृषदा॒ज्यꣳ",
      "start": 58.52,
      "end": 61.4
    },
    {
      "text": "स्कन्द॑ति॒ यत् पृ॑षदा॒ज्यं पुन॑र्गृ॒ह्णाति॑",
      "start": 61.4,
      "end": 66.76
    },
    {
      "text": "प्रा॒णमे॒वास्मै॒ पुन॑र्गृह्णाति॒ हिर॑ण्यमव॒धाय॑ गृह्णात्य॒मृतं॒",
      "start": 66.76,
      "end": 78.36
    },
    {
      "text": "ॅवै हिर॑ण्यं प्रा॒णः पृ॑षदा॒ज्यम॒मृत॑मे॒वास्य॑",
      "start": 78.36,
      "end": 86.44
    },
    {
      "text": "प्रा॒णे द॑धाति श॒तमा॑नं भवति",
      "start": 86.44,
      "end": 92.28
    },
    {
      "text": "श॒तायुः॒ पुरु॑षः श॒तेन्द्रि॑य॒ आयु॑ष्ये॒वेन्द्रि॒ये",
      "start": 92.28,
      "end": 95.28
    },
    {
      "text": "प्रति॑तिष्ठ॒त्यश्व॒मव॑ घ्रापयति प्राजाप॒त्यो वा",
      "start": 95.28,
      "end": 95.28
    },
    {
      "text": "अश्वः॑ प्राजाप॒त्यः प्रा॒णः स्वादे॒वास्मै॒",
      "start": 95.28,
      "end": 100.4
    },
    {
      "text": "योनेः᳚ प्रा॒णं ( )",
      "start": 100.4,
      "end": 102.2
    },
    {
      "text": "निर्मि॑मीते॒ वि वा ए॒तस्य॑",
      "start": 102.2,
      "end": 105.84
    },
    {
      "text": "य॒ज्ञ्श्छि॑द्यते॒ यस्य॑ पृषदा॒ज्यꣳ स्कन्द॑ति",
      "start": 105.84,
      "end": 113.04
    },
    {
      "text": "वैष्ण॒व्यर्चा पुन॑र्गृह्णाति य॒ज्ञो वै",
      "start": 113.04,
      "end": 114.08
    },
    {
      "text": "विष्णु॑र्य॒ज्ञेनै॒व य॒ज्ञ्ꣳ सं त॑नोति",
      "start": 114.08,
      "end": 115.84
    }
  ],
  "total_phrases": 13
}