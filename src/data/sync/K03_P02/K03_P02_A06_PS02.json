    {
      "text": "ग्रहꣳ॑ स॒होर्जा गृ॑ह्णा॒म्यस्तृ॑तं",
      "start": 36.76,
      "end": 36.76
    },
    {
      "text": "यत् कृ॑ष्णशकु॒नः पृ॑षदा॒ज्यम॑वमृ॒शेच्छू॒द्रा अ॑स्य",
      "start": 36.76,
      "end": 36.76
    },
    {
      "text": "प्र॒मायु॑काः स्यु॒र्यच्छ्वा ऽव॑मृ॒शेच्चतु॑ष्पादोऽस्य प॒शवः॑",
      "start": 36.76,
      "end": 36.76
    },
    {
      "text": "प्र॒मायु॑काः स्यु॒र्यथ् स्कन्दे॒द्-यज॑मानः प्र॒मायु॑कः",
      "start": 36.76,
      "end": 38.2
    },
    {
      "text": "स्यात् प॒शवो॒ वै पृ॑षदा॒ज्यं",
      "start": 38.2,
      "end": 41.08
    },
    {
      "text": "प॒शवो॒ वा ए॒तस्य॑ स्कन्दन्ति॒",
      "start": 41.08,
      "end": 44.48
    },
    {
      "text": "यस्य॑ पृषदा॒ज्यꣳ स्कन्द॑ति॒ यत्",
      "start": 44.48,
      "end": 46.4
    },
    {
      "text": "पृ॑षदा॒ज्यं पुन॑र्गृ॒ह्णाति॑ प॒शूने॒वास्मै॒ पुन॑र्गृह्णाति",
      "start": 46.4,
      "end": 56.4
    },
    {
      "text": "प्रा॒णो वै पृ॑षदा॒ज्यं प्रा॒णो",
