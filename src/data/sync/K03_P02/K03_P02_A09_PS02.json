  "phrases": [
    {
      "text": "उ॒क्थं ॅवा॒चीन्द्रा॒येत्या॑ह तृतीयसव॒नं प्र॑ति॒गीर्य॑",
      "start": 30.76,
      "end": 35.28
    },
    {
      "text": "स॒प्तैतान्य॒क्षरा॑णि स॒प्तप॑दा॒ शक्व॑री शाक्व॒रो",
      "start": 35.28,
      "end": 42.6
    },
    {
      "text": "वज्रो॒ वज्रे॑णै॒व तृ॑तीयसव॒ने वज्र॑म॒न्तर्द्ध॑त्ते",
      "start": 42.6,
      "end": 46.92
    },
    {
      "text": "ब्रह्मवा॒दिनो॑ वदन्ति॒ स त्वा",
      "start": 46.92,
      "end": 50.88
    },
    {
      "text": "अ॑द्ध्व॒र्युः स्या॒द्यो य॑थासव॒नं प्र॑तिग॒रे",
      "start": 50.88,
      "end": 61.48
    },
    {
      "text": "छन्दाꣳ॑सि सम्पा॒दये॒त् तेजः॑ प्रातः",
      "start": 61.48,
      "end": 67.36
    },
    {
      "text": "सव॒न आ॒त्मन् दधी॑तेन्द्रि॒यं माद्ध्य॑न्दिने॒",
      "start": 67.36,
      "end": 77.32
    },
    {
      "text": "सव॑ने प॒शूꣳ स्तृ॑तीयसव॒न इत्युक्थ॑शा॒",
      "start": 77.32,
      "end": 85.28
    },
    {
      "text": "इत्या॑ह प्रातस्सव॒नं प्र॑ति॒गीर्य॒ त्रीण्ये॒तान्य॒क्षरा॑णि",
      "start": 85.28,
      "end": 90.92
