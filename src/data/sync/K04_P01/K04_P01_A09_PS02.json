    {
      "text": "-ऽग्निश्चे॒दं क॑रिष्यथः",
      "start": 44.64,
      "end": 47.32
    },
    {
      "text": "दृꣳह॑स्व देवि पृथिवि स्व॒स्तय॑",
      "start": 47.32,
      "end": 52.52
    },
    {
      "text": "आसु॒री मा॒या स्व॒धया॑ कृ॒ताऽसि॑",
      "start": 52.52,
      "end": 59.92
    },
    {
      "text": "जुष्टं॑ दे॒वाना॑मि॒दम॑स्तु ह॒व्यमरि॑ष्टा॒ त्वमुदि॑हि",
      "start": 59.92,
      "end": 59.92
    },
    {
      "text": "य॒ज्ञे अ॒स्मिन्न्",
      "start": 59.92,
      "end": 59.92
    },
    {
      "text": "मित्रै॒तामु॒खां त॑पै॒षा मा भे॑दि",
      "start": 59.92,
      "end": 59.92
    },
    {
      "text": "ए॒तां ते॒ परि॑ ददा॒म्यभि॑त्त्यै",
      "start": 59.92,
      "end": 59.92
    },
    {
      "text": "द्र्व॑न्नः स॒र्पिरा॑सुतिः प्र॒त्नो होता॒ वरे᳚ण्यः",
      "start": 59.92,
      "end": 59.92
    },
    {
      "text": "सह॑सस्पु॒त्रो अद्भु॑तः",
      "start": 59.92,
      "end": 59.92
    },
    {
      "text": "पर॑स्या॒ अधि॑ सं॒ॅवतोऽव॑राꣳ अ॒भ्या",
      "start": 59.92,
      "end": 59.92
    },
