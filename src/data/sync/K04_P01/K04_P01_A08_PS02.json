    {
      "text": "ई॑ म॒न्द्रासु॑ प्र॒यसः॑",
      "start": 42.6,
      "end": 42.6
    },
    {
      "text": "वसु॒श्चेति॑ष्ठो वसु॒धात॑मश्च",
      "start": 42.6,
      "end": 42.6
    },
    {
      "text": "द्वारो॑ दे॒वीरन्व॑स्य॒ विश्वे᳚ व्र॒ता",
      "start": 42.6,
      "end": 42.6
    },
    {
      "text": "द॑दन्ते अ॒ग्नेः",
      "start": 42.6,
      "end": 42.6
    },
    {
      "text": "उ॒रु॒व्यच॑सो॒ धाम्ना॒ पत्य॑मानाः",
      "start": 42.6,
      "end": 44.32
    },
    {
      "text": "ते अ॑स्य॒ योष॑णे दि॒व्ये",
      "start": 44.32,
      "end": 48.84
    },
    {
      "text": "न योना॑वु॒षासा॒नक्ता᳚",
      "start": 48.84,
      "end": 53.32
    },
    {
      "text": "इ॒मं ॅय॒ज्ञ्म॑वता मद्ध्व॒रं नः॑",
      "start": 53.32,
      "end": 58.28
    },
    {
      "text": "दैव्या॑ होतारावू॒र्द्ध्व-म॑द्ध्व॒रं नो॒ऽग्नेर्जि॒ह्वाम॒भि गृ॑णीतं",
      "start": 58.28,
      "end": 65.96
    },
    {
      "text": "कृ॒णु॒तं नः॒ स्वि॑ष्टिं",
