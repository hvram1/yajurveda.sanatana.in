  "phrases": [
    {
      "text": "-ग्निं मन॑सा घृ॒तेन॑ प्रति॒क्ष्यन्तं॒",
      "start": 154.44,
      "end": 154.44
    },
    {
      "text": "भुव॑नानि॒ विश्वा᳚",
      "start": 154.44,
      "end": 154.44
    },
    {
      "text": "पृ॒थुं ति॑र॒श्चा वय॑सा बृ॒हन्तं॒",
      "start": 154.44,
      "end": 154.44
    },
    {
      "text": "ॅव्यचि॑ष्ठ॒मन्नꣳ॑ रभ॒सं ॅविदा॑नं",
      "start": 154.44,
      "end": 160.76
    },
    {
      "text": "आ त्वा॑ जिघर्मि॒ वच॑सा",
      "start": 160.76,
      "end": 165.0
    },
    {
      "text": "घृ॒तेना॑ऽर॒क्षसा॒ मन॑सा॒ तज्जु॑षस्व",
      "start": 165.0,
      "end": 173.0
    },
    {
      "text": "मर्य॑श्रीः स्पृह॒यद्-व॑र्णो अ॒ग्निर्नाऽभि॒मृशे॑ त॒नुवा॒ जर्.हृ॑षाणः",
      "start": 173.0,
      "end": 182.2
    },
    {
      "text": "परि॒ वाज॑पतिः क॒विर॒ग्निर्. ह॒व्यान्य॑क्रमीत्",
      "start": 182.2,
      "end": 188.36
    },
    {
      "text": "दध॒द् रत्ना॑नि दा॒शुषे᳚",
      "start": 188.36,
      "end": 190.56
    },
    {
      "text": "परि॑ त्वाऽग्ने॒ पुरं॑ ॅव॒यं",
      "start": 190.56,
      "end": 193.16
    },
    {
      "text": "ॅविप्रꣳ॑ सहस्य धीमहि",
      "start": 193.16,
      "end": 193.16
    },
    {
      "text": "धृ॒षद् व॑र्णं दि॒वेदि॑वे भे॒त्तारं॑",
      "start": 193.16,
      "end": 193.16
    },
    {
      "text": "( ) भङ्गु॒राव॑तः",
      "start": 193.16,
      "end": 193.16
    },
    {
      "text": "त्वम॑ग्ने॒ द्युभि॒स्त्व-मा॑शुशु॒क्षणि॒स्त्व-म॒द्भ्यस्त्व-मश्म॑न॒स्परि॑",
      "start": 193.16,
      "end": 210.16
    },
    {
      "text": "त्वं ॅवने᳚भ्य॒ स्त्वमोष॑धीभ्य॒ स्त्वं",
      "start": 210.16,
      "end": 217.28
    },
    {
      "text": "नृ॒णां नृ॑पते जायसे॒ शुचिः॑",
      "start": 217.28,
      "end": 222.24
    }
  ],
