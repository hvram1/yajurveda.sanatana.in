      "end": 38.72
    },
    {
      "text": "नरा॒शꣳसो॑ अग्ने",
      "start": 38.72,
      "end": 40.48
    },
    {
      "text": "सु॒कृद्दे॒वः स॑वि॒ता वि॒श्ववा॑रः",
      "start": 40.48,
      "end": 42.6
    },
    {
      "text": "अच्छा॒यमे॑ति॒ शव॑सा घृ॒तेने॑डा॒नो वह्नि॒र्नम॑सा",
      "start": 42.6,
      "end": 42.6
    },
    {
      "text": "अ॒ग्निꣳ स्रुचो॑ अद्ध्व॒रेषु॑ प्र॒यथ्सु॑",
      "start": 42.6,
      "end": 42.6
