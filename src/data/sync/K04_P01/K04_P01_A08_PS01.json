    {
      "text": "ऊ॒र्द्ध्वा अ॑स्य स॒मिधो॑ भवन्त्यू॒र्द्ध्वा",
      "start": 0.0,
      "end": 12.52
    },
    {
      "text": "शु॒क्रा शो॒चीꣳष्य॒ग्नेः",
      "start": 12.52,
      "end": 17.92
    },
    {
      "text": "द्यु॒मत्त॑मा सु॒प्रती॑कस्य सू॒नोः",
      "start": 17.92,
      "end": 25.24
    },
    {
      "text": "तनू॒नपा॒दसु॑रो वि॒श्ववे॑दा दे॒वो दे॒वेषु॑ दे॒वः",
      "start": 25.24,
      "end": 31.64
    },
    {
      "text": "प॒थ आऽन॑क्ति॒ मद्ध्वा॑ घृ॒तेन॑",
      "start": 31.64,
      "end": 31.64
    },
    {
      "text": "मद्ध्वा॑ य॒ज्ञ्ं न॑क्षसे प्रीणा॒नो",
