  "phrases": [
    {
      "text": "-रसि पृथि॒व्याः स॒धस्था॑द॒ग्निं पु॑री॒ष्य॑मङ्गिर॒स्वदा",
      "start": 103.36,
      "end": 111.32
    },
    {
      "text": "भ॑र॒ त्रैष्टु॑भेन त्वा॒ छन्द॒सा",
      "start": 111.32,
      "end": 114.8
    },
    {
      "text": "ऽऽद॑देऽङ्गिर॒स्वद्-बभ्रि॑रसि॒ नारि॑रसि॒ त्वया॑ व॒यꣳ",
      "start": 114.8,
      "end": 115.52
    },
    {
      "text": "स॒धस्थ॒ आग्निꣳ श॑केम॒ खनि॑तुं",
      "start": 115.52,
      "end": 121.36
    },
    {
      "text": "पुरी॒ष्यं॑ जाग॑तेन त्वा॒ छन्द॒सा",
      "start": 121.36,
      "end": 123.24
    },
    {
      "text": "ऽऽद॑देऽङ्गिर॒स्वद्धस्त॑ आ॒धाय॑ सवि॒ता बिभ्र॒दभ्रिꣳ॑",
      "start": 123.24,
      "end": 131.88
    },
    {
      "text": "हिर॒ण्ययीं᳚",
      "start": 131.88,
      "end": 134.08
    },
    {
      "text": "तया॒ ज्योति॒रज॑स्र॒-मिद॒ग्निं खा॒त्वी न॒",
      "start": 134.08,
      "end": 138.08
    },
    {
      "text": "आ भ॒रानु॑ष्टुभेन त्वा॒ छन्द॒सा",
      "start": 138.08,
      "end": 143.6
