    },
    {
      "text": "स॒प॒त्न॒हा नो॑ अभिमाति॒जिच्च॒ स्वे",
      "start": 41.44,
      "end": 49.2
    },
    {
      "text": "गये॑ जागृ॒ह्य प्र॑युच्छन्न्",
      "start": 49.2,
      "end": 51.24
    },
    {
      "text": "इ॒हैवाग्ने॒ अधि॑ धारया र॒यिं",
      "start": 51.24,
      "end": 51.24
    },
    {
      "text": "मा त्वा॒ निक्र॑न् पूर्व॒चितो॑",
      "start": 51.24,
      "end": 51.24
    },
    {
      "text": "निका॒रिणः॑",
      "start": 51.24,
      "end": 51.24
    },
    {
      "text": "क्ष॒त्रम॑ग्ने सु॒यम॑मस्तु॒ तुभ्य॑मुपस॒त्ता व॑र्द्धतां",
      "start": 51.24,
      "end": 51.24
    },
    {
      "text": "ते॒ अनि॑ष्टृतः",
      "start": 51.24,
      "end": 51.24
