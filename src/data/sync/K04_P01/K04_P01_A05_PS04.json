  "phrases": [
    {
      "text": "-दि॒त्यास्त्वा॑ कृण्वन्तु॒ जाग॑तेन॒ छन्द॑साऽङ्गिर॒स्वद्",
      "start": 125.8,
      "end": 134.32
    },
    {
      "text": "द्यौर॑सि॒ विश्वे᳚ त्वा दे॒वा",
      "start": 134.32,
      "end": 136.6
    },
    {
      "text": "वै᳚श्वान॒राः कृ॑ण्व॒न्त्वानु॑ष्टुभेन॒ छन्द॑सा-ऽङ्गिर॒स्वद्-दिशो॑ऽसि ध्रु॒वाऽसि॑",
      "start": 136.6,
      "end": 146.2
    },
    {
      "text": "धा॒रया॒ मयि॑ प्र॒जाꣳ रा॒यस्पोषं॑",
      "start": 146.2,
      "end": 151.08
    },
    {
      "text": "गौप॒त्यꣳ सु॒वीर्यꣳ॑ सजा॒तान्. यज॑माना॒याऽदि॑त्यै॒",
      "start": 151.08,
      "end": 155.04
    },
    {
      "text": "रास्ना॒ऽस्य दि॑तिस्ते॒ बिलं॑ गृह्णातु॒",
      "start": 155.04,
      "end": 155.04
    },
    {
      "text": "पाङ्क्ते॑न॒ छन्द॑सा ऽङ्गिर॒स्वत्",
      "start": 155.04,
      "end": 155.04
    },
    {
      "text": "कृ॒त्वाय॒ सा म॒हीमु॒खां मृ॒न्मयीं॒ ॅयोनि॑म॒ग्नये᳚",
      "start": 155.04,
      "end": 155.04
    },
    {
      "text": "तां पु॒त्रेभ्यः॒ सं प्रा",
      "start": 155.04,
      "end": 155.04
    },
    {
      "text": "( ) य॑च्छ॒ददि॑तिः श्र॒पया॒निति॑",
      "start": 155.04,
      "end": 162.0
    }
  ],
  "total_phrases": 10
}