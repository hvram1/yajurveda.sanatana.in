    {
      "text": "स्वाꣳ अ॒हं",
      "start": 118.8,
      "end": 119.64
    },
    {
      "text": "दृ॒शा॒नो रु॒क्म उ॒र्व्या व्य॑द्यौद्दु॒र्मर्.ष॒मायुः॑",
      "start": 119.64,
      "end": 124.76
    },
    {
      "text": "श्रि॒ये रु॑चा॒नः",
      "start": 124.76,
      "end": 129.16
    },
    {
      "text": "अ॒ग्निर॒मृतो॑ अभव॒द्वयो॑-भि॒र्यदे॑नं॒ द्यौरज॑नयथ् सु॒रेताः᳚",
      "start": 129.16,
      "end": 137.76
    },
    {
      "text": "विश्वा॑ रू॒पाणि॒ प्रति॑ मुञ्चते",
      "start": 137.76,
      "end": 140.12
    },
    {
      "text": "क॒विः प्राऽसा॑वीद्भ॒द्रं द्वि॒पदे॒ चतु॑ष्पदे",
      "start": 140.12,
      "end": 140.12
    },
    {
      "text": "वि नाक॑मख्यथ् सवि॒ता वरे॒ण्योऽनु॑",
      "start": 140.12,
      "end": 140.12
    },
    {
      "text": "प्र॒याण॑मु॒षसो॒ वि॑राजति",
      "start": 140.12,
      "end": 140.12
    },
    {
      "text": "नक्तो॒षासा॒ सम॑नसा॒ विरू॑पे धा॒पये॑ते॒",
      "start": 140.12,
      "end": 140.12
    },
    {
      "text": "शिशु॒मेकꣳ॑ समी॒ची",
      "start": 140.12,
      "end": 140.12
    },
    {
      "text": "द्यावा॒ क्षामा॑ रु॒क्मो -",
      "start": 140.12,
      "end": 140.12
