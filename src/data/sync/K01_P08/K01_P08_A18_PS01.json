  "panchasat": 1,
  "phrases": [
    {
      "text": "स॒द्यो दी᳚क्षयन्ति स॒द्यः सोमं॑",
      "start": 0.0,
      "end": 3.0
    },
    {
      "text": "क्रीणन्ति पुण्डरिस्र॒जां प्र य॑च्छति",
      "start": 3.0,
      "end": 6.24
    },
    {
      "text": "द॒शभि॑र् वथ्सत॒रैः सोमं॑ क्रीणाति",
      "start": 6.24,
      "end": 9.36
    },
    {
      "text": "दश॒पेयो॑ भवति श॒तं ब्रा᳚ह्म॒णाः",
      "start": 9.36,
      "end": 9.36
    },
    {
      "text": "पि॑बन्ति सप्तद॒शꣳ स्तो॒त्रं भ॑वति",
      "start": 9.36,
      "end": 9.36
    },
    {
      "text": "प्राका॒शाव॑द्ध्व॒र्यवे॑ ददाति॒ स्रज॑-मुद्गा॒त्रे रु॒क्मꣳ",
      "start": 9.36,
      "end": 9.36
    },
    {
      "text": "होत्रेऽश्वं॑ प्रस्तोतृप्रतिह॒र्तृभ्यां॒ द्वाद॑श पष्ठौ॒हीर्",
      "start": 9.36,
      "end": 14.52
    },
    {
      "text": "ब्र॒ह्मणे॑ व॒शां मै᳚त्रावरु॒णाय॑र्.ष॒भं ब्रा᳚ह्मणाच्छꣳ॒॒सिने॒",
      "start": 14.52,
      "end": 26.32
    },
    {
      "text": "वास॑सी नेष्टापो॒तृभ्याꣳ॒॒ स्थूरि॑ यवाचि॒त-म॑च्छावा॒काया॑न॒ड्वाह॑-म॒ग्नीधे॑",
      "start": 26.32,
      "end": 42.04
    },
    {
      "text": "भार्ग॒वो होता॑ भवति श्राय॒न्तीयं॑",
      "start": 42.04,
      "end": 46.16
    },
    {
      "text": "ब्रह्मसा॒मं भ॑वति वारव॒न्तीय॑ (",
      "start": 46.16,
      "end": 49.32
    },
    {
      "text": ") मग्निष्टोमसा॒मꣳ सा॑रस्व॒ती-र॒पो गृ॑ह्णाति",
      "start": 49.32,
      "end": 53.72
    }
  ],
  "total_phrases": 12
}