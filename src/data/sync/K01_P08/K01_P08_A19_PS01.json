  "phrases": [
    {
      "text": "आ॒ग्ने॒य-म॒ष्टाक॑पालं॒ निर्व॑पति॒ हिर॑ण्यं॒ दक्षि॑णै॒न्द्र-मेका॑दशकपाल-मृष॒भो",
      "start": 0.0,
      "end": 11.4
    },
    {
      "text": "दक्षि॑णा वैश्वदे॒वं च॒रुं पि॒शङ्गी॑",
      "start": 11.4,
      "end": 17.84
    },
    {
      "text": "पष्ठौ॒ही दक्षि॑णा मैत्रावरु॒णी-मा॒मिक्षां᳚ ॅव॒शा",
      "start": 17.84,
      "end": 22.48
    },
    {
      "text": "दक्षि॑णा बार्.हस्प॒त्यं च॒रुꣳ शि॑तिपृ॒ष्ठो",
      "start": 22.48,
      "end": 22.48
    },
    {
      "text": "दक्षि॑णाऽऽदि॒त्यां म॒ल्॒.हां ग॒र्भिणी॒मा ल॑भते",
      "start": 22.48,
      "end": 22.48
    },
    {
      "text": "मारु॒तीं पृश्ञ॑ं॑ पष्ठौ॒ही-म॒श्विभ्यां᳚ पू॒ष्णे",
      "start": 22.48,
      "end": 22.48
    },
    {
      "text": "पु॑रो॒डाशं॒ द्वाद॑शकपालं॒ निर्व॑पति॒ सर॑स्वते",
      "start": 22.48,
      "end": 25.64
    },
    {
      "text": "सत्य॒वाचे॑ च॒रुꣳ स॑वि॒त्रे स॒त्यप्र॑सवाय",
      "start": 25.64,
      "end": 31.76
    },
    {
      "text": "पुरो॒डाशं॒ द्वाद॑शकपालं तिसृध॒न्वꣳ शु॑ष्कदृ॒तिर्",
      "start": 31.76,
      "end": 41.16
    },
    {
      "text": "दक्षि॑णा",
      "start": 41.16,
      "end": 42.88
    }
  ],
