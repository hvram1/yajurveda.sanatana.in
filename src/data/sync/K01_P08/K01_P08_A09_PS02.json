  "phrases": [
    {
      "text": "क्ष॒त्तुर् गृ॒ह उ॑पद्ध्व॒स्तो दक्षि॑णाऽऽश्वि॒नं",
      "start": 34.12,
      "end": 34.12
    },
    {
      "text": "द्वि॑कपा॒लꣳ स॑ङ्ग्रही॒तुर् गृ॒हे स॑वा॒त्यौ॑",
      "start": 34.12,
      "end": 43.8
    },
    {
      "text": "दक्षि॑णा पौ॒ष्णं च॒रुं भा॑गदु॒घस्य॑",
      "start": 43.8,
      "end": 47.92
    },
    {
      "text": "गृ॒हे श्या॒मो दक्षि॑णा रौ॒द्रं",
      "start": 47.92,
      "end": 55.4
    },
    {
      "text": "गा॑वीधु॒कं च॒रुम॑क्षावा॒पस्य॑ गृ॒हे श॒बल॒",
      "start": 55.4,
      "end": 62.84
    },
    {
      "text": "उद्वा॑रो॒ दक्षि॒णेन्द्रा॑य सु॒त्रांणे॑ पुरो॒डाश॒मेका॑दशकपालं॒",
      "start": 62.84,
      "end": 73.28
    },
    {
      "text": "प्रति॒ निर्व॑प॒तीन्द्रा॑याꣳहो॒मुचे॒ ऽयं नो॒",
      "start": 73.28,
      "end": 81.24
    },
    {
      "text": "राजा॑ वृत्र॒हा राजा॑ भू॒त्वा",
      "start": 81.24,
      "end": 81.36
    },
    {
      "text": "वृ॒त्रं ॅव॑द्ध्यान् मैत्राबार्.हस्प॒त्यं भ॑वति",
      "start": 81.36,
      "end": 88.16
    },
    {
      "text": "श्वे॒तायै᳚ श्वे॒तव॑थ्सायै दु॒ग्धे स्व॑यंमू॒र्ते",
      "start": 88.16,
      "end": 93.6
    },
    {
