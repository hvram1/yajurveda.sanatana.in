  "phrases": [
    {
      "text": "श्रव॒स्यवो॑ घृ॒तस्य॒ धारा॒ उप॑",
      "start": 151.4,
      "end": 157.8
    },
    {
      "text": "यन्ति वि॒श्वतः॑",
      "start": 157.8,
      "end": 159.72
    },
    {
      "text": "सोमा॑रुद्रा॒ वि वृ॑हतं॒ ॅविषू॑ची॒ममी॑वा॒",
      "start": 159.72,
      "end": 167.08
    },
    {
      "text": "या नो॒ गय॑-मावि॒वेश॑",
      "start": 167.08,
      "end": 170.08
    },
    {
      "text": "आ॒रे बा॑धेथां॒ निर्.ऋ॑तिं परा॒चैः",
      "start": 170.08,
      "end": 174.84
    },
    {
      "text": "कृ॒तं चि॒देनः॒ प्र मु॑मुक्त-म॒स्मत्",
      "start": 174.84,
      "end": 178.28
    },
    {
      "text": "सोमा॑रुद्रा यु॒व-मे॒तान्य॒स्मे विश्वा॑ त॒नूषु॑",
      "start": 178.28,
      "end": 183.96
    },
    {
      "text": "भेष॒जानि॑ धत्तं",
      "start": 183.96,
      "end": 185.48
    },
    {
      "text": "अव॑ स्यतं मु॒ञ्चतं॒ ॅयन्नो॒",
      "start": 185.48,
      "end": 186.96
    },
    {
      "text": "अस्ति॑ त॒नूषु॑ ब॒द्धं कृ॒तमेनो॑",
      "start": 186.96,
      "end": 189.72
    },
    {
      "text": "अ॒स्मत्",
      "start": 189.72,
      "end": 190.8
    },
    {
      "text": "सोमा॑पूषणा॒ जन॑ना रयी॒णां जन॑ना",
      "start": 190.8,
      "end": 195.92
    },
    {
      "text": "दि॒वो जन॑ना ( )",
      "start": 195.92,
      "end": 196.72
    },
    {
      "text": "पृथि॒व्याः",
      "start": 196.72,
      "end": 198.04
    },
    {
      "text": "जा॒तौ विश्व॑स्य॒ भुव॑नस्य गो॒पौ",
      "start": 198.04,
      "end": 202.44
    },
    {
      "text": "दे॒वा अ॑कृण्वन्न॒मृत॑स्य॒ नाभिं᳚",
      "start": 202.44,
      "end": 206.6
    },
    {
      "text": "इ॒मौ दे॒वौ जाय॑मानौ जुषन्ते॒मौ",
      "start": 206.6,
      "end": 210.6
    },
    {
      "text": "तमाꣳ॑सि गूहता॒-मजु॑ष्टा",
      "start": 210.6,
      "end": 212.0
    },
    {
      "text": "आ॒भ्यामिन्द्रः॑ प॒क्वमा॒मास्व॒न्तः सो॑मापू॒षभ्यां᳚ जनदु॒स्रिया॑सु",
      "start": 212.0,
