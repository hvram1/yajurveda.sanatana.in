  "phrases": [
    {
      "text": "र्तप्रजात॒ तद॒स्मासु॒ द्रवि॑णं धेहि चि॒त्रं",
      "start": 79.08,
      "end": 79.08
    },
    {
      "text": "आ नो॑ मित्रावरुणा घृ॒तैर् गव्यू॑तिमुक्षतं",
      "start": 79.08,
      "end": 79.08
    },
    {
