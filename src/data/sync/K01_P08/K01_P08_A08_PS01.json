  "phrases": [
    {
      "text": "धा॒त्रे पु॑रो॒डाशं॒ द्वाद॑शकपालं॒ निर्व॑प॒त्यनु॑मत्यै",
      "start": 0.0,
      "end": 11.0
    },
    {
      "text": "च॒रुꣳ रा॒कायै॑ च॒रुꣳ सि॑नीवा॒ल्यै",
      "start": 11.0,
      "end": 13.44
    },
    {
      "text": "च॒रुं कु॒ह्वै॑ च॒रुं मि॑थु॒नौ",
      "start": 13.44,
      "end": 15.84
    },
    {
      "text": "गावौ॒ दक्षि॑णा ऽऽग्नावैष्ण॒व-मेका॑दशकपालं॒ निर्व॑पत्यैन्द्रावैष्ण॒व-मेका॑दशकपालं",
      "start": 15.84,
      "end": 21.48
    },
    {
      "text": "ॅवैष्ण॒वं त्रि॑कपा॒लं ॅवा॑म॒नो व॒ही",
      "start": 21.48,
      "end": 28.96
    },
    {
      "text": "दक्षि॑णा-ऽग्नीषो॒मीय॒-मेका॑दशकपालं॒ निर्व॑पतीन्द्रासो॒मीय॒- मेका॑दशकपालꣳ सौ॒म्यं",
      "start": 28.96,
      "end": 36.08
    },
    {
      "text": "च॒रुं ब॒भ्रुर् दक्षि॑णा सोमापौ॒ष्णं",
      "start": 36.08,
      "end": 37.76
    },
    {
      "text": "च॒रुं निर्व॑पत्यैन्द्रा पौ॒ष्णं च॒रुं",
      "start": 37.76,
      "end": 39.44
    },
    {
      "text": "पौ॒ष्णं च॒रुꣳ श्या॒मो दक्षि॑णा",
      "start": 39.44,
      "end": 43.24
    },
    {
      "text": "वैश्वान॒रं द्वाद॑शकपालं॒ निर् (",
      "start": 43.24,
      "end": 44.96
    },
    {
      "text": ") व॑पति॒ हिर॑ण्यं॒ दक्षि॑णा",
      "start": 44.96,
      "end": 47.28
    },
    {
      "text": "वारु॒णं ॅय॑व॒मयं॑ च॒रुमश्वो॒ दक्षि॑णा",
      "start": 47.28,
      "end": 51.08
    }
  ],
