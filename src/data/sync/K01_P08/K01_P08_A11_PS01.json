  "phrases": [
    {
      "text": "अ॒र्थेतः॑ स्था॒ऽपां पति॑रसि॒ वृषा᳚ऽस्यू॒र्मिर्",
      "start": 0.0,
      "end": 5.32
    },
    {
      "text": "वृ॑षसे॒नो॑ऽसि व्रज॒क्षितः॑ स्थ म॒रुता॒मोजः॑",
      "start": 5.32,
      "end": 11.8
    },
    {
      "text": "स्थ॒ सूर्य॑वर्चसः स्थ॒ सूर्य॑त्वचसः",
      "start": 11.8,
      "end": 20.0
    },
    {
      "text": "स्थ॒ मान्दाः᳚ स्थ॒ वाशाः᳚",
      "start": 20.0,
      "end": 22.6
    },
    {
      "text": "स्थ॒ शक्व॑रीः स्थ विश्व॒भृतः॑",
      "start": 22.6,
      "end": 24.12
    },
    {
      "text": "स्थ जन॒भृतः॑ स्था॒ऽग्नेस्ते॑ज॒स्याः᳚ स्था॒ऽपामोष॑धीनाꣳ॒॒",
      "start": 24.12,
      "end": 33.16
    },
    {
      "text": "रसः॑ स्था॒ऽपो दे॒वीर् मधु॑मतीरगृह्ण॒न्नूर्ज॑स्वती",
      "start": 33.16,
      "end": 38.04
    },
    {
      "text": "राज॒सूया॑य॒ चिता॑नाः",
      "start": 38.04,
      "end": 41.84
    },
    {
      "text": "याभि॑र् मि॒त्रावरु॑णाव॒-भ्यषि॑ञ्च॒न्॒. याभि॒-रिन्द्र॒मन॑य॒न्नत्य (",
      "start": 41.84,
      "end": 47.12
    },
    {
      "text": ") रा॑तीः",
      "start": 47.12,
      "end": 47.12
    },
    {
      "text": "रा॒ष्ट्र॒दाः स्थ॑ रा॒ष्ट्रं द॑त्त॒",
      "start": 47.12,
      "end": 47.12
    },
    {
      "text": "स्वाहा॑ राष्ट्र॒दाः स्थ॑ रा॒ष्ट्रम॒मुष्मै॑",
      "start": 47.12,
      "end": 47.32
    },
    {
      "text": "दत्त",
      "start": 47.32,
      "end": 47.92
    }
  ],
