    {
      "text": "बा॒र्॒.ह॒स्प॒त्यं च॒रुं निर्व॑पति ब्र॒ह्मणो॑",
      "start": 0.0,
      "end": 3.36
    },
    {
      "text": "गृ॒हे शि॑तिपृ॒ष्ठो दक्षि॑णै॒न्द्र-मेका॑दशकपालꣳ राज॒न्य॑स्य",
      "start": 3.36,
      "end": 14.32
    },
    {
      "text": "गृ॒ह ऋ॑ष॒भो दक्षि॑णाऽऽदि॒त्यं च॒रुं",
      "start": 14.32,
      "end": 20.76
    },
    {
      "text": "महि॑ष्यै गृ॒हे धे॒नुर् दक्षि॑णा",
      "start": 20.76,
      "end": 20.76
    },
    {
      "text": "नैर्.ऋ॒तं च॒रुं प॑रिवृ॒क्त्यै॑ गृ॒हे",
      "start": 20.76,
      "end": 20.76
    },
    {
      "text": "कृ॒ष्णानां᳚ ॅव्रीही॒णां न॒खनि॑र्भिन्नं कृ॒ष्णा",
      "start": 20.76,
      "end": 20.76
    },
    {
      "text": "कू॒टा दक्षि॑णा ऽऽग्ने॒यम॒ष्टाक॑पालꣳ सेना॒न्यो॑",
      "start": 20.76,
      "end": 20.76
    },
    {
      "text": "गृ॒हे हिर॑ण्यं॒ दक्षि॑णा वारु॒णं",
      "start": 20.76,
      "end": 22.8
    },
    {
      "text": "दश॑कपालꣳ सू॒तस्य॑ गृ॒हे म॒हानि॑रष्टो॒",
      "start": 22.8,
      "end": 24.32
    },
    {
      "text": "दक्षि॑णा मारु॒तꣳ स॒प्तक॑पालं ग्राम॒ण्यो॑",
      "start": 24.32,
      "end": 30.88
    },
    {
      "text": "गृ॒हे पृश्ञ॒॑र् दक्षि॑णा सावि॒त्रं",
