  "phrases": [
    {
      "text": "स्वा॒द्वीं त्वा᳚ स्वा॒दुना॑ ती॒व्रां",
      "start": 0.0,
      "end": 10.6
    },
    {
      "text": "ती॒व्रेणा॒मृता॑म॒मृते॑न सृ॒जामि॒ सꣳ सोमे॑न॒",
      "start": 10.6,
      "end": 18.32
    },
    {
      "text": "सोमो᳚ऽस्य॒श्विभ्यां᳚ पच्यस्व॒ सर॑स्वत्यै पच्य॒स्वेन्द्रा॑य",
      "start": 18.32,
      "end": 31.92
    },
    {
      "text": "सु॒त्रांणे॑ पच्यस्व पु॒नातु॑ ते",
      "start": 31.92,
      "end": 37.28
    },
    {
      "text": "परि॒स्रुतꣳ॒॒ सोमꣳ॒॒ सूर्य॑स्य दुहि॒ता",
      "start": 37.28,
      "end": 41.16
    },
    {
      "text": "वारे॑ण॒ शश्व॑ता॒ तना᳚",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": "वा॒युः पू॒तः प॒वित्रे॑ण प्र॒त्यङ्",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": "सोमो॒ अति॑द्रुतः",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": "इन्द्र॑स्य॒ युज्यः॒ सखा᳚",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": "कु॒विद॒ङ् यव॑मन्तो॒ यवं॑ चि॒द्",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": "यथा॒ दान्त्य॑नुपू॒र्वं ॅवि॒यूय॑",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": "इ॒हेहै॑षां कृणुत॒ भोज॑नानि॒ (",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": ") ये ब॒र्॒.हिषो॒ नमो॑वृक्तिं॒",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": "न ज॒ग्मुः",
      "start": 41.16,
      "end": 41.16
    },
    {
      "text": "आ॒श्वि॒नं धू॒म्रमा ल॑भते सारस्व॒तं",
      "start": 41.16,
      "end": 41.2
    },
    {
      "text": "मे॒षमै॒न्द्रमृ॑ष॒भ-मै॒न्द्र-मेका॑दशकपालं॒ निर्व॑पति सावि॒त्रं द्वाद॑शकपालं",
      "start": 41.2,
      "end": 55.44
    },
    {
      "text": "ॅवारु॒णं दश॑कपालꣳ॒॒ सोम॑प्रतीकाः पितरस्तृप्णुत॒",
      "start": 55.44,
      "end": 62.76
