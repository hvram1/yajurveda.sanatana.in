    {
      "text": "अ॒ग्नये॑ गृ॒हप॑तये पुरो॒डाश॑म॒ष्टाक॑पालं॒ निर्व॑पति",
      "start": 0.0,
      "end": 8.68
    },
    {
      "text": "कृ॒ष्णानां᳚ व्रीही॒णाꣳ सोमा॑य॒ वन॒स्पत॑ये",
      "start": 8.68,
      "end": 16.76
    },
    {
      "text": "श्यामा॒कं च॒रुꣳ स॑वि॒त्रे स॒त्यप्र॑सवाय",
      "start": 16.76,
      "end": 22.44
    },
    {
      "text": "पुरो॒डाशं॒ द्वाद॑शकपाल-माशू॒नां ॅव्री॑ही॒णाꣳ रु॒द्राय॑",
      "start": 22.44,
      "end": 25.92
    },
    {
      "text": "पशु॒पत॑ये गावीधु॒कं च॒रुं बृह॒स्पत॑ये",
      "start": 25.92,
      "end": 28.28
    },
    {
      "text": "वा॒चस्पत॑ये नैवा॒रं च॒रुमिन्द्रा॑य ज्ये॒ष्ठाय॑",
      "start": 28.28,
      "end": 34.8
    },
    {
      "text": "पुरो॒डाश॒-मेका॑दशकपालं म॒हाव्री॑हीणां मि॒त्राय॑ स॒त्याया॒ऽऽंबानां᳚",
      "start": 34.8,
      "end": 43.48
    },
    {
      "text": "च॒रुं ॅवरु॑णाय॒ धर्म॑पतये यव॒मयं॑",
      "start": 43.48,
      "end": 48.48
    },
    {
      "text": "च॒रुꣳ स॑वि॒ता त्वा᳚ प्रस॒वानाꣳ॑",
      "start": 48.48,
      "end": 50.72
    },
    {
      "text": "सुवताम॒ग्निर् गृ॒हप॑तीनाꣳ॒॒ सोमो॒ वन॒स्पती॑नाꣳ",
      "start": 50.72,
