  "phrases": [
    {
      "text": "नम॒स्तेभ्यः॒ स्वाहा॒ समू॑ढꣳ॒॒ रक्षः॒",
      "start": 28.32,
      "end": 34.88
    },
    {
      "text": "सन्द॑॑ग्धꣳ॒॒ रक्ष॑ इ॒दम॒हꣳ रक्षो॒ऽभि",
      "start": 34.88,
      "end": 40.88
    },
    {
      "text": "सं द॑हाम्य॒ग्नये॑ रक्षो॒घ्ने स्वाहा॑",
      "start": 40.88,
      "end": 48.0
    },
    {
      "text": "य॒माय॑ सवि॒त्रे वरु॑णाय॒ बृह॒स्पत॑ये॒",
      "start": 48.0,
      "end": 54.32
    },
    {
      "text": "दुव॑स्वते रक्षो॒घ्ने स्वाहा᳚ प्रष्टिवा॒ही",
      "start": 54.32,
      "end": 61.84
    },
    {
      "text": "रथो॒ दक्षि॑णा दे॒वस्य॑ त्वा",
      "start": 61.84,
      "end": 66.48
    },
    {
      "text": "सवि॒तुः प्र॑स॒वे᳚ऽश्विनो᳚र् बा॒हुभ्यां᳚ पू॒ष्णो",
      "start": 66.48,
      "end": 74.68
    },
    {
      "text": "हस्ता᳚भ्याꣳ॒॒ रक्ष॑सो व॒धं जु॑होमि",
      "start": 74.68,
      "end": 79.64
    },
    {
      "text": "ह॒तꣳ रक्षोऽव॑धिष्म॒ रक्षो॒ यद्",
      "start": 79.64,
      "end": 82.68
    },
    {
      "text": "वस्ते॒ तद् दक्षि॑णा",
      "start": 82.68,
      "end": 86.12
    }
  ],
  "total_phrases": 10
}