    {
      "text": "इन्द्र॑स्य॒ वज्रो॑ऽसि॒ वार्त्र॑घ्न॒स्त्वया॒ऽयं ॅवृ॒त्रं",
      "start": 0.0,
      "end": 9.04
    },
    {
      "text": "ॅव॑द्ध्यान् मि॒त्रावरु॑णयोस्त्वा प्रशा॒स्त्रोः प्र॒शिषा॑",
      "start": 9.04,
      "end": 23.72
    },
    {
      "text": "युनज्मि य॒ज्ञ्स्य॒ योगे॑न॒ विष्णोः॒",
      "start": 23.72,
      "end": 29.24
    },
    {
      "text": "क्रमो॑ऽसि॒ विष्णोः᳚ क्रा॒न्तम॑सि॒ विष्णो॒र्",
      "start": 29.24,
      "end": 32.36
    },
    {
      "text": "विक्रा᳚न्तमसि म॒रुतां᳚ प्रस॒वे जे॑षमा॒प्तं",
      "start": 32.36,
      "end": 32.36
    },
    {
      "text": "मनः॒ सम॒हमि॑न्द्रि॒येण॑ वी॒र्ये॑ण पशू॒नां",
      "start": 32.36,
      "end": 32.36
    },
    {
      "text": "म॒न्युर॑सि॒ तवे॑व मे म॒न्युर्",
      "start": 32.36,
      "end": 32.36
    },
    {
      "text": "भू॑या॒न्नमो॑ मा॒त्रे पृ॑थि॒व्यै माऽहं",
      "start": 32.36,
      "end": 32.36
    },
    {
      "text": "मा॒तरं॑ पृथि॒वीꣳ हिꣳ॑सिषं॒ मा",
