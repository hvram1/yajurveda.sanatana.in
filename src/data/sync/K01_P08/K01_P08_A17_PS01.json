  "phrases": [
    {
      "text": "आ॒ग्ने॒यम॒ष्टाक॑पालं॒ निर्व॑पति॒ हिर॑ण्यं॒ दक्षि॑णा",
      "start": 0.0,
      "end": 8.92
    },
    {
      "text": "सारस्व॒तं च॒रुं ॅव॑थ्सत॒री दक्षि॑णा",
      "start": 8.92,
      "end": 8.92
    },
    {
      "text": "सावि॒त्रं द्वाद॑शकपाल-मुपद्ध्व॒स्तो दक्षि॑णा पौ॒ष्णं",
      "start": 8.92,
      "end": 8.92
    },
    {
      "text": "च॒रुꣳ श्या॒मो दक्षि॑णा बार्.हस्प॒त्यं",
      "start": 8.92,
      "end": 8.92
    },
    {
      "text": "च॒रुꣳ शि॑तिपृ॒ष्ठो दक्षि॑णै॒न्द्र-मेका॑दशकपाल-मृष॒भो दक्षि॑णा",
      "start": 8.92,
      "end": 10.56
    },
    {
      "text": "वारु॒णं दश॑कपालं म॒हानि॑रष्टो॒ दक्षि॑णा",
      "start": 10.56,
      "end": 12.48
    },
    {
      "text": "सौ॒म्यं च॒रुं ब॒भ्रुर् दक्षि॑णा",
      "start": 12.48,
      "end": 19.96
    },
    {
      "text": "त्वा॒ष्ट्रम॒ष्टाक॑पालꣳ शु॒ण्ठो दक्षि॑णा वैष्ण॒वं",
      "start": 19.96,
      "end": 31.0
    },
    {
      "text": "त्रि॑कपा॒लं वा॑म॒नो दक्षि॑णा",
      "start": 31.0,
      "end": 36.08
    }
  ],
