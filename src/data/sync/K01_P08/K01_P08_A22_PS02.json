  "phrases": [
    {
      "text": "पर्व॑ता॒दा सर॑स्वती यज॒ता ग॑न्तु य॒ज्ञ्ं",
      "start": 54.24,
      "end": 54.24
    },
    {
      "text": "हवं॑ दे॒वी जु॑जुषा॒णा घृ॒ताची॑",
      "start": 54.24,
      "end": 54.24
    },
    {
      "text": "श॒ग्मां नो॒ वाच॑मुश॒ती शृ॑णोतु",
      "start": 54.24,
      "end": 54.24
    },
    {
      "text": "बृह॑स्पते जु॒षस्व॑ नो ह॒व्यानि॑ विश्वदेव्य",
      "start": 54.24,
      "end": 54.24
    },
    {
      "text": "रास्व॒ रत्ना॑नि दा॒शुषे᳚",
      "start": 54.24,
      "end": 55.8
    },
    {
      "text": "ए॒वा पि॒त्रे वि॒श्वदे॑वाय॒ वृष्णे॑",
      "start": 55.8,
      "end": 64.44
    },
    {
      "text": "य॒ज्ञिर् वि॑धेम॒ नम॑सा ह॒विर्भिः॑",
      "start": 64.44,
      "end": 71.48
    },
    {
      "text": "बृह॑स्पते सुप्र॒जा वी॒रव॑न्तो व॒यꣳ",
      "start": 71.48,
      "end": 79.08
    },
    {
      "text": "स्या॑म॒ पत॑यो रयी॒णां",
      "start": 79.08,
      "end": 79.08
    },
    {
      "text": "बृह॑स्पते॒ अति॒ यद॒र्यो अर्.हा᳚द्",
      "start": 79.08,
      "end": 79.08
    },
    {
      "text": "द्यु॒मद् वि॒भाति॒ क्रतु॑म॒ज्जने॑षु",
