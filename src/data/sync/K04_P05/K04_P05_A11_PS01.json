    {
      "text": "स॒हस्रा॑णि सहस्र॒शो ये रु॒द्रा",
      "start": 0.0,
      "end": 2.88
    },
    {
      "text": "अधि॒ भूम्यां᳚",
      "start": 2.88,
      "end": 3.0
    },
    {
      "text": "तेषाꣳ॑ सहस्रयोज॒ने ऽव॒धन्वा॑नि तन्मसि",
      "start": 3.0,
      "end": 5.76
    },
    {
      "text": "अ॒स्मिन्-म॑ह॒त्य॑र्ण॒वे᳚-ऽन्तरि॑क्षे भ॒वा अधि॑",
      "start": 5.76,
      "end": 16.4
    },
    {
      "text": "नील॑ग्रीवाः शिति॒कण्ठाः᳚ श॒र्वा अ॒धः क्ष॑माच॒राः",
      "start": 16.4,
      "end": 26.12
    },
    {
      "text": "नील॑ग्रीवाः शिति॒कण्ठा॒ दिवꣳ॑ रु॒द्रा उप॑श्रिताः",
      "start": 26.12,
      "end": 33.76
    },
    {
      "text": "ये वृ॒क्षेषु॑ स॒स्पिञ्ज॑रा॒ नील॑ग्रीवा॒ विलो॑हिताः",
      "start": 33.76,
      "end": 43.68
    },
    {
      "text": "ये भू॒ताना॒-मधि॑पतयो विशि॒खासः॑ कप॒र्दि॑नः",
      "start": 43.68,
      "end": 51.08
    },
    {
      "text": "ये अन्ने॑षु वि॒विद्ध्य॑न्ति॒ पात्रे॑षु॒",
      "start": 51.08,
      "end": 51.08
    },
    {
      "text": "पिब॑तो॒ जनान्॑",
      "start": 51.08,
      "end": 51.08
    },
    {
      "text": "ये प॒थां प॑थि॒रक्ष॑य ऐलबृ॒दा य॒व्युधः॑",
      "start": 51.08,
      "end": 51.08
    },
    {
      "text": "ये ती॒र्थानि॑ - [ ]",
