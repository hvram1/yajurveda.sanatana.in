  "phrases": [
    {
      "text": "कण्डू॒येत॑ पामनं॒ भावु॑काः प्र॒जाः",
      "start": 229.96,
      "end": 230.0
    },
    {
      "text": "स्यु॒र्यथ् स्मये॑त नग्नं॒ भावु॑काः",
      "start": 230.0,
      "end": 236.12
    },
    {
      "text": "कृष्णविषा॒णया॑ कण्डूयतेऽपि॒गृह्य॑ स्मयते प्र॒जानां᳚",
      "start": 236.12,
      "end": 243.28
    },
    {
      "text": "गोपी॒थाय॒ न पु॒रा दक्षि॑णाभ्यो॒",
      "start": 243.28,
      "end": 247.52
    },
    {
      "text": "नेतोः᳚ कृष्णविषा॒णामव॑ चृते॒द्यत् पु॒रा",
      "start": 247.52,
      "end": 252.72
    },
    {
      "text": "दक्षि॑णाभ्यो॒ नेतोः᳚ कृष्णविषा॒णाम॑व चृ॒तेद्योनिः॑",
      "start": 252.72,
      "end": 256.24
    },
    {
      "text": "प्र॒जानां᳚ परा॒पातु॑का स्यान्नी॒तासु॒ दक्षि॑णासु॒",
      "start": 256.24,
      "end": 266.4
    },
    {
      "text": "चात्वा॑ले कृष्णविषा॒णां प्रास्य॑ति॒ योनि॒र्वै",
      "start": 266.4,
      "end": 272.48
    },
    {
      "text": "य॒ज्ञ्स्य॒ चात्वा॑लं॒ ॅयोनिः॑ कृष्णविषा॒णा",
      "start": 272.48,
      "end": 272.48
    },
    {
      "text": "योना॑वे॒व योनिं॑ दधाति य॒ज्ञ्स्य॑",
      "start": 272.48,
      "end": 272.48
    },
    {
      "text": "सयोनि॒त्वाय॑",
      "start": 272.48,
      "end": 274.76
    }
  ],
  "total_phrases": 11
