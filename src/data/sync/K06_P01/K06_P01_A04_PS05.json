    {
      "text": "ब्रह्मवा॒दिनो॑ वदन्ति होत॒व्यं॑ दीक्षि॒तस्य॑",
      "start": 124.44,
      "end": 131.28
    },
    {
      "text": "गृ॒हा(3) इ न हो॑त॒व्या(3)मिति॑",
      "start": 131.28,
      "end": 134.8
    },
    {
      "text": "ह॒विर्वै दी᳚क्षि॒तो यज्जु॑हु॒याद्-यज॑मानस्याव॒दाय॑ जुहुया॒द्-यन्न",
      "start": 134.8,
      "end": 149.16
    },
    {
      "text": "जु॑हु॒याद्-य॑ज्ञ्प॒रुर॒न्तरि॑या॒द्ये दे॒वा मनो॑जाता मनो॒युज॒",
      "start": 149.16,
      "end": 151.64
    },
    {
      "text": "इत्या॑ह प्रा॒णा वै दे॒वा",
      "start": 151.64,
      "end": 154.84
    },
    {
      "text": "मनो॑जाता मनो॒युज॒स्तेष्वे॒व प॒रोक्षं॑ जुहोति॒",
      "start": 154.84,
      "end": 162.32
    },
    {
