  "phrases": [
    {
      "text": "-त्यु॒भयो᳚र्लो॒कयो॑-र॒भिजि॑त्यै केशश्म॒श्रु व॑पते न॒खानि॒",
      "start": 15.68,
      "end": 27.16
    },
    {
      "text": "नि कृ॑न्तते मृ॒ता वा",
      "start": 27.16,
      "end": 28.36
    },
    {
      "text": "ए॒षा त्वग॑मे॒द्ध्या यत् के॑शश्म॒श्रु",
      "start": 28.36,
      "end": 36.76
    },
    {
      "text": "मृ॒तामे॒व त्वच॑म-मे॒द्ध्याम॑प॒हत्य॑ य॒ज्ञियो॑ भू॒त्वा",
      "start": 36.76,
      "end": 42.64
    },
    {
      "text": "मेध॒मुपै॒त्यङ्गि॑रसः सुव॒र्गं ॅलो॒कं ॅयन्तो॒ऽफ्सु",
      "start": 42.64,
      "end": 42.68
    },
    {
      "text": "दी᳚क्षात॒पसी॒ प्रावे॑शयन्न॒फ्सु स्ना॑ति सा॒क्षादे॒व",
      "start": 42.68,
      "end": 51.68
    },
    {
      "text": "दी᳚क्षात॒पसी॒ अव॑ रुन्धे ती॒र्थे",
      "start": 51.68,
      "end": 54.4
    },
    {
      "text": "स्ना॑ति ती॒र्थे हि ते",
      "start": 54.4,
      "end": 57.2
    },
    {
      "text": "तां प्रावे॑शयन् ती॒र्थे स्ना॑ति",
      "start": 57.2,
      "end": 61.96
    },
