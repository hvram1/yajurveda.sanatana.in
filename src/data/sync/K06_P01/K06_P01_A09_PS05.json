  "phrases": [
    {
      "text": "मिमी॒ते ऽया॑तयाम्नियायातयाम्नियै॒वैनं॑ मिमीते॒ तस्मा॒न्नाना॑वीर्या",
      "start": 142.04,
      "end": 148.36
    },
    {
      "text": "अ॒ङ्गुल॑यः॒ सर्वा᳚स्वङ्गु॒ष्ठमुप॒ नि गृ॑ह्णाति॒",
      "start": 148.36,
      "end": 157.0
    },
    {
      "text": "तस्मा᳚थ् स॒माव॑द्वीर्यो॒ऽन्याभि॑-र॒ङ्गुलि॑भि॒स्तस्मा॒थ् सर्वा॒ अनु॒",
      "start": 157.0,
      "end": 167.64
    },
    {
      "text": "सं च॑रति॒ यथ् स॒ह",
      "start": 167.64,
      "end": 169.2
    },
    {
      "text": "सर्वा॑भि॒र्मिमी॑त॒ सꣳश्लि॑ष्टा अ॒ङ्गुल॑यो जायेर॒-न्नेक॑यैकयो॒थ्",
      "start": 169.2,
      "end": 177.68
    },
    {
      "text": "सर्गं॑ मिमीते॒ तस्मा॒द् विभ॑क्ता",
      "start": 177.68,
      "end": 178.24
    },
    {
      "text": "जायन्ते॒ पञ्च॒ कृत्वो॒ यजु॑षा",
      "start": 178.24,
      "end": 178.24
    },
    {
      "text": "मिमीते॒ पञ्चा᳚क्षरा प॒ङ्क्तिः पाङ्क्तो॑",
      "start": 178.24,
      "end": 178.24
    },
    {
      "text": "य॒ज्ञो य॒ज्ञ्मे॒वाव॑ रुन्धे॒ पञ्च॒",
      "start": 178.24,
      "end": 178.24
    },
    {
      "text": "कृत्व॑स्तू॒ष्णीं- [ ]",
