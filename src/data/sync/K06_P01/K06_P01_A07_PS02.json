      "start": 60.6,
      "end": 67.92
    },
    {
      "text": "यथ् सो॑म॒क्रय॑णी॒ जूर॒सीत्या॑ह॒ यद्धि",
      "start": 67.92,
      "end": 68.2
    },
    {
      "text": "मन॑सा॒ जव॑ते॒ तद्-वा॒चा वद॑ति",
      "start": 68.2,
      "end": 68.2
    },
    {
      "text": "धृ॒ता मन॒सेत्या॑ह॒ मन॑सा॒ हि",
      "start": 68.2,
      "end": 68.2
    },
    {
      "text": "वाग्धृ॒ता जुष्टा॒ विष्ण॑व॒ इत्या॑ह",
