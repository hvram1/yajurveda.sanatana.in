  "phrases": [
    {
      "text": "-नं॑ क्रीणाति धे॒न्वा क्री॑णाति॒",
      "start": 13.2,
      "end": 18.28
    },
    {
      "text": "साशि॑रमे॒वैनं॑ क्रीणात्यृष॒भेण॑ क्रीणाति॒ सेन्द्र॑मे॒वैनं॑",
      "start": 18.28,
      "end": 25.68
    },
    {
      "text": "क्रीणात्यन॒डुहा᳚ क्रीणाति॒ वह्नि॒र्वा अ॑न॒ड्वान्.",
      "start": 25.68,
      "end": 34.36
    },
    {
      "text": "वह्नि॑नै॒व वह्नि॑ य॒ज्ञ्स्य॑ क्रीणाति",
      "start": 34.36,
      "end": 40.2
    },
    {
      "text": "मिथु॒नाभ्यां᳚ क्रीणाति मिथु॒नस्याव॑-रुद्ध्यै॒ वास॑सा",
      "start": 40.2,
      "end": 43.44
    },
    {
      "text": "क्रीणाति सर्वदेव॒त्यं॑ ॅवै वा॒सः",
      "start": 43.44,
      "end": 47.04
    },
    {
      "text": "सर्वा᳚भ्य ए॒वैनं॑ दे॒वता᳚भ्यः क्रीणाति॒",
      "start": 47.04,
      "end": 49.28
    },
    {
      "text": "दश॒ सं प॑द्यन्ते॒ दशा᳚क्षरा",
      "start": 49.28,
      "end": 52.6
    },
    {
      "text": "वि॒राडन्नं॑ ॅवि॒राड् वि॒राजै॒वान्नाद्य॒मव॑ रुन्धे॒",
      "start": 52.6,
      "end": 61.08
    },
    {
