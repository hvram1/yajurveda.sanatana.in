  "phrases": [
    {
      "text": "दे॒वा वै दे॑व॒यज॑न-मद्ध्यव॒साय॒ दिशो॒",
      "start": 0.0,
      "end": 5.36
    },
    {
      "text": "न प्राजा॑न॒न् ते᳚(1॒)ऽन्यो᳚-ऽन्यमुपा॑धाव॒न् त्वया॒",
      "start": 5.36,
      "end": 10.6
    },
    {
      "text": "प्र जा॑नाम॒ त्वयेति॒ तेऽदि॑त्याꣳ॒॒",
      "start": 10.6,
      "end": 16.92
    },
    {
      "text": "सम॒॑द्ध्रयन्त॒ त्वया॒ प्र जा॑ना॒मेति॒",
      "start": 16.92,
      "end": 25.04
    },
    {
      "text": "साऽब्र॑वी॒द्-वरं॑ ॅवृणै॒ मत्प्रा॑यणा ए॒व",
      "start": 25.04,
      "end": 30.12
    },
    {
      "text": "वो॑ य॒ज्ञा मदु॑दयना अस॒न्निति॒",
      "start": 30.12,
      "end": 30.12
    },
    {
      "text": "तस्मा॑दादि॒त्यः प्रा॑य॒णीयो॑ य॒ज्ञाना॑मादि॒त्य उ॑दय॒नीयः॒",
      "start": 30.12,
      "end": 30.12
    },
    {
      "text": "पञ्च॑ दे॒वता॑ यजति॒ पञ्च॒",
      "start": 30.12,
      "end": 30.12
    },
    {
      "text": "दिशो॑ दि॒शां प्रज्ञा᳚त्या॒ -",
      "start": 30.12,
      "end": 30.12
    },
    {
      "text": "[ ]",
