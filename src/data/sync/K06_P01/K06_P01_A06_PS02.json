  "phrases": [
    {
      "text": "ति॑ मा क॒द्रूर॑वोच॒दिति॒ जग॒त्युद॑पत॒-च्चतु॑र्दशाक्षरा",
      "start": 39.52,
      "end": 47.92
    },
    {
      "text": "स॒ती सा ऽप्रा᳚प्य॒ न्य॑वर्तत॒",
      "start": 47.92,
      "end": 52.6
    },
    {
      "text": "तस्यै॒ द्वे अ॒क्षरे॑ अमीयेताꣳ॒॒",
      "start": 52.6,
      "end": 57.6
    },
    {
