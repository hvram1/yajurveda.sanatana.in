    {
      "text": "आ॒शिर॒मव॑ नयति सशुक्र॒त्वायाथो॒ सं",
      "start": 140.4,
      "end": 147.08
    },
    {
      "text": "भ॑रत्ये॒वैन॒त् तꣳ सोम॑-माह्रि॒यमा॑णं गन्ध॒र्वो",
      "start": 147.08,
      "end": 156.04
    },
    {
      "text": "वि॒श्वाव॑सः॒ पर्य॑मुष्णा॒थ् स ति॒स्रो",
      "start": 156.04,
      "end": 156.04
    },
    {
      "text": "रात्रीः॒ परि॑मुषितोऽवस॒त् तस्मा᳚त् ति॒स्रो",
      "start": 156.04,
      "end": 156.04
    },
    {
      "text": "रात्रीः᳚ क्री॒तः सोमो॑ वसति॒",
      "start": 156.04,
      "end": 156.04
    },
    {
      "text": "ते दे॒वा अ॑ब्रुव॒न्थ् स्त्रीका॑मा॒",
      "start": 156.04,
      "end": 156.04
    },
    {
      "text": "वै ग॑न्ध॒र्वा स्स्त्रि॒या निष्क्री॑णा॒मेति॒",
      "start": 156.04,
      "end": 156.04
    },
    {
      "text": "ते वाचꣳ॒॒ स्त्रिय॒मेक॑हायनीं कृ॒त्वा",
