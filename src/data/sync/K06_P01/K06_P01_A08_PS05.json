  "phrases": [
    {
      "text": "प॒शुभ्यो॒ नान्तरे॑ति॒ त्वे राय॒",
      "start": 136.32,
      "end": 142.84
    },
    {
      "text": "इति॒ यज॑मानाय॒ प्र य॑च्छति॒",
      "start": 142.84,
      "end": 147.96
    },
    {
      "text": "यज॑मान ए॒व र॒यिं द॑धाति॒",
      "start": 147.96,
      "end": 152.92
    },
    {
      "text": "तोते॒ राय॒ इति॒ पत्नि॑या",
      "start": 152.92,
      "end": 156.28
    },
    {
      "text": "अ॒र्द्धो वा ए॒ष आ॒त्मनो॒",
      "start": 156.28,
      "end": 161.72
    },
    {
      "text": "यत् पत्नी॒ यथा॑ गृ॒हेषु॑",
      "start": 161.72,
      "end": 166.36
    },
    {
      "text": "निध॒त्ते ता॒दृगे॒व तत् त्वष्टी॑मती",
      "start": 166.36,
      "end": 166.36
    },
    {
      "text": "ते सपे॒येत्या॑ह॒ त्वष्टा॒ वै",
      "start": 166.36,
      "end": 166.36
    },
    {
      "text": "प॑शू॒नां मि॑थु॒नानाꣳ॑ रूप॒कृद्-रू॒पमे॒व प॒शुषु॑",
      "start": 166.36,
      "end": 166.36
    },
    {
      "text": "दधात्य॒स्मै वै लो॒काय॒ गार्.ह॑पत्य॒",
      "start": 166.36,
      "end": 166.36
    },
    {
      "text": "आ धी॑यते॒ ( )",
      "start": 166.36,
      "end": 166.36
    },
    {
      "text": "ऽमुष्मा॑ आहव॒नीयो॒ यद्-गार्.ह॑पत्य उप॒वपे॑द॒स्मिन्",
      "start": 166.36,
      "end": 166.36
    },
    {
      "text": "ॅलो॒के प॑श॒मान्थ् स्या॒द्-यदा॑हव॒नीये॒ ऽमुष्मि॑न्",
      "start": 166.36,
      "end": 166.4
    },
    {
      "text": "ॅलो॒के प॑शु॒मान्थ् स्या॑दु॒भयो॒रुप॑ वपत्यु॒भयो॑रे॒वैनं॑",
      "start": 166.4,
      "end": 178.6
    },
    {
      "text": "ॅलो॒कयोः᳚ पशु॒मन्तं॑ करोति",
      "start": 178.6,
      "end": 182.24
    }
  ],
