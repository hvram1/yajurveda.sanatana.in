  "phrases": [
    {
      "text": "परा॑ भवति प्रया॒जव॑दे॒वा-नू॑या॒जव॑त् प्राय॒णीयं॑",
      "start": 143.92,
      "end": 143.92
    },
    {
      "text": "का॒र्यं॑ प्रया॒जव॑दनूया॒जव॑-दुदय॒नीयं॒ नाऽऽ*त्मान॑मन्त॒रेति॒ न",
      "start": 143.92,
      "end": 143.92
    },
    {
      "text": "प्र॒जां न य॒ज्ञ्ः प॑रा॒भव॑ति॒",
      "start": 143.92,
      "end": 143.92
    },
    {
      "text": "न यज॑मानः प्राय॒णीय॑स्य निष्का॒स",
      "start": 143.92,
      "end": 143.92
    },
    {
      "text": "उ॑दय॒नीय॑म॒भि निर्व॑पति॒ सैव सा",
      "start": 143.92,
      "end": 143.92
    },
    {
      "text": "य॒ज्ञ्स्य॒ सन्त॑ति॒र्याः प्रा॑य॒णीय॑स्य या॒ज्या॑",
      "start": 143.92,
      "end": 150.72
    },
    {
      "text": "यत् ता उ॑दय॒नीय॑स्य या॒ज्याः᳚",
      "start": 150.72,
      "end": 151.92
    },
    {
      "text": "कु॒र्यात् परा॑ङ॒मुं ॅलो॒कमा रो॑हेत्",
      "start": 151.92,
      "end": 158.6
    },
    {
      "text": "प्र॒मायु॑कः स्या॒द्याः प्रा॑य॒णीय॑स्य पुरोऽनुवा॒क्या᳚स्ता",
      "start": 158.6,
      "end": 168.72
    },
    {
      "text": "( ) उ॑दय॒नीय॑स्य या॒ज्याः᳚",
      "start": 168.72,
      "end": 175.24
    },
    {
      "text": "करोत्य॒स्मिन्ने॒व लो॒के प्रति॑ तिष्ठति",
      "start": 175.24,
