  "phrases": [
    {
      "text": "क्री॒ते सोमे॑ मैत्रावरु॒णाय॑ द॒ण्डं",
      "start": 34.56,
      "end": 38.72
    },
    {
      "text": "प्र य॑च्छति मैत्रावरु॒णो हि",
      "start": 38.72,
      "end": 38.72
    },
    {
      "text": "पु॒रस्ता॑-दृ॒त्विग्भ्यो॒ वाचं॑ ॅवि॒भज॑ति॒ तामृ॒त्विजो॒",
      "start": 38.72,
      "end": 38.72
    },
    {
      "text": "यज॑माने॒ प्रति॑ ष्ठापयन्ति॒ स्वाहा॑",
      "start": 38.72,
      "end": 41.4
    },
    {
      "text": "य॒ज्ञ्ं मन॒सेत्या॑ह॒ मन॑सा॒ हि",
      "start": 41.4,
      "end": 44.08
    },
    {
      "text": "पुरु॑षो य॒ज्ञ्म॑भि॒गच्छ॑ति॒ स्वाहा॒ द्यावा॑पृथि॒वीभ्या॒",
      "start": 44.08,
      "end": 53.68
    },
    {
      "text": "-मित्या॑ह॒ द्यावा॑पृथि॒व्योर्.हि य॒ज्ञ्ः स्वाहो॒रोर॒-न्तरि॑क्षा॒",
      "start": 53.68,
      "end": 64.6
    },
    {
      "text": "-दित्या॑हा॒न्तरि॑क्षे॒ हि य॒ज्ञ्ः स्वाहा॑",
      "start": 64.6,
      "end": 70.28
    },
    {
      "text": "य॒ज्ञ्ं ॅवाता॒दा र॑भ॒ इत्या॑हा॒यं",
      "start": 70.28,
