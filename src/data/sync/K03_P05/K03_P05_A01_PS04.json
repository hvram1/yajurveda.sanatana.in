  "phrases": [
    {
      "text": "क्षीयेत सारस्व॒तौ होमौ॑ पु॒रस्ता᳚ज्जुहुयादमावा॒स्या॑",
      "start": 137.16,
      "end": 142.56
    },
    {
      "text": "वै सर॑स्वत्यनुलो॒म-मे॒वैना॒वा ल॑भते॒ ऽमुमा॒प्याय॑मान॒मन्वा",
      "start": 142.56,
      "end": 149.72
    },
    {
      "text": "प्या॑यत आग्नावैष्ण॒व-मेका॑दशकपालं पु॒रस्ता॒न्निव॑र्पे॒थ् सर॑स्वत्यै",
      "start": 149.72,
      "end": 157.8
    },
    {
      "text": "च॒रुꣳ सर॑स्वते॒ द्वाद॑शकपालं॒ ॅयदा᳚ग्ने॒यो",
      "start": 157.8,
      "end": 163.2
    },
    {
      "text": "भव॑त्य॒ग्निर्वै य॑ज्ञ्मु॒खं ॅय॑ज्ञ्मु॒खमे॒वर्द्धिं॑ पु॒रस्ता᳚द्-धत्ते॒",
      "start": 163.2,
      "end": 163.2
    },
    {
      "text": "यद्-वै᳚ष्ण॒वो भव॑ति य॒ज्ञो वै",
      "start": 163.2,
      "end": 163.2
    },
    {
      "text": "विष्णु॑र्य॒ज्ञ्मे॒वाऽऽ*रभ्य॒ प्रत॑नुते॒ सर॑स्वत्यै (",
      "start": 163.2,
      "end": 163.2
    },
    {
      "text": ") च॒रुर्भ॑वति॒ सर॑स्वते॒ द्वाद॑शकपालोऽमावा॒स्या॑",
      "start": 163.2,
      "end": 163.2
    },
    {
      "text": "वै सर॑स्वती पू॒र्णमा॑सः॒ सर॑स्वा॒न्",
      "start": 163.2,
      "end": 166.72
    },
    {
      "text": "तावे॒व सा॒क्षादा र॑भत ऋ॒द्ध्नोत्या᳚भ्यां॒",
      "start": 166.72,
      "end": 172.88
    },
    {
      "text": "द्वाद॑शकपालः॒ सर॑स्वते भवति मिथुन॒त्वाय॒",
      "start": 172.88,
      "end": 177.12
    },
    {
      "text": "प्रजा᳚त्यै मिथु॒नौ गावौ॒ दक्षि॑णा॒",
      "start": 177.12,
      "end": 182.12
    },
    {
      "text": "समृ॑द्ध्यै",
      "start": 182.12,
      "end": 185.36
    }
  ],
  "total_phrases": 13
