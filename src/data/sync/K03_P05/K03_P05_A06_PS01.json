    {
      "text": "घृ॒तेन॒ सं त्वा॑ नह्याम्य॒प",
      "start": 4.8,
      "end": 9.92
    },
    {
      "text": "ओष॑धीभिः",
      "start": 9.92,
      "end": 11.36
    },
    {
      "text": "सं त्वा॑ नह्यामि प्र॒जया॒ऽहम॒द्य",
      "start": 11.36,
      "end": 15.16
    },
    {
      "text": "सा दी᳚क्षि॒ता स॑नवो॒ वाज॑म॒स्मे",
      "start": 15.16,
      "end": 15.16
    },
    {
      "text": "प्रैतु॒ ब्रह्म॑ण॒स्पत्नी॒ वेदिं॒ ॅवर्णे॑न सीदतु",
      "start": 15.16,
      "end": 15.16
    },
    {
      "text": "अथा॒हम॑नुका॒मिनी॒ स्वे लो॒के वि॒शा इ॒ह",
      "start": 15.16,
      "end": 15.16
    },
    {
      "text": "सु॒प्र॒जस॑स्त्वा व॒यꣳ सु॒पत्नी॒रुप॑ सेदिम",
      "start": 15.16,
      "end": 15.16
    },
    {
      "text": "अग्ने॑ सपत्न॒दम्भ॑न॒मद॑ब्धासो॒ अदा᳚भ्यं",
      "start": 15.16,
      "end": 15.16
    },
    {
      "text": "इ॒मं ॅविष्या॑मि॒ वरु॑णस्य॒ पाशं॒",
      "start": 15.16,
      "end": 15.16
    },
