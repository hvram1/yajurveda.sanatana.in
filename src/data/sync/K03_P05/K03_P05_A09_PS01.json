    {
      "text": "यां ॅवा अ॑द्ध्व॒र्युश्च॒ यज॑मानश्च",
      "start": 0.0,
      "end": 5.24
    },
    {
      "text": "दे॒वता॑मन्तरि॒तस्तस्या॒ आ वृ॑श्च्येते प्राजाप॒त्यं",
      "start": 5.24,
      "end": 14.96
    },
    {
      "text": "द॑धिग्र॒हं गृ॑ह्णीयात् प्र॒जाप॑तिः॒ सर्वा॑",
      "start": 14.96,
      "end": 21.8
    },
    {
      "text": "दे॒वता॑ दे॒वता᳚भ्य ए॒व निह्नु॑वाते",
      "start": 21.8,
      "end": 25.6
