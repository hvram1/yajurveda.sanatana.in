  "phrases": [
    {
      "text": "-ऽसि प्र॒जाप॑तये त्वा॒ ज्योति॑ष्मते॒",
      "start": 25.68,
      "end": 25.68
    },
    {
      "text": "ज्योति॑ष्मन्तं गृह्णा॒मीत्या॑ह॒ ज्योति॑रे॒वैनꣳ॑ समा॒नानां᳚",
      "start": 25.68,
      "end": 34.28
    },
    {
      "text": "करोत्यग्नि-जि॒ह्वेभ्य॑स्त्वर्ता॒युभ्य॒ इत्या॑है॒ताव॑ती॒र्वै दे॒वता॒स्ताभ्य॑ ए॒वैनꣳ॒॒",
      "start": 34.28,
      "end": 41.84
    },
    {
      "text": "सर्वा᳚भ्यो गृह्णा॒त्यपे᳚न्द्र द्विष॒तो मन॒",
      "start": 41.84,
      "end": 45.56
    },
    {
      "text": "इत्या॑ह॒ भ्रातृ॑व्यापनुत्त्यै प्रा॒णाय॑ त्वाऽपा॒नाय॒",
      "start": 45.56,
      "end": 52.0
    },
    {
      "text": "त्वेत्या॑ह प्रा॒णाने॒व यज॑माने दधाति॒",
      "start": 52.0,
      "end": 55.44
    },
    {
      "text": "तस्मै᳚ त्वा प्र॒जाप॑तये विभू॒दाव्.न्ने॒",
      "start": 55.44,
      "end": 57.52
    },
    {
      "text": "ज्योति॑ष्मते॒ ज्योति॑ष्मन्तं जुहो॒मी -",
      "start": 57.52,
      "end": 60.8
    },
    {
      "text": "[ ]",
      "start": 60.8,
