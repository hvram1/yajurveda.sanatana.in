  "phrases": [
    {
      "text": "ऋष॑यो॒ वा इन्द्रं॑ प्र॒त्यक्षं॒",
      "start": 0.0,
      "end": 8.6
    },
    {
      "text": "नाप॑श्य॒न् तं ॅवसि॑ष्ठः प्र॒त्यक्ष॑मपश्य॒थ्",
      "start": 8.6,
      "end": 20.16
    },
    {
      "text": "सो᳚ऽब्रवी॒द्-ब्राह्म॑णं ते वक्ष्यामि॒ यथा॒",
      "start": 20.16,
      "end": 21.6
    },
    {
      "text": "त्वत्पु॑रोहिताः प्र॒जाः प्र॑जनि॒ष्यन्तेऽथ॒ मेत॑रेभ्य॒",
      "start": 21.6,
      "end": 21.6
    },
    {
      "text": "ऋषि॑भ्यो॒ मा प्रवो॑च॒ इति॒",
      "start": 21.6,
      "end": 21.6
    },
    {
      "text": "तस्मा॑ ए॒तान्थ्स्तोम॑-भागानब्रवी॒त् ततो॒ वसि॑ष्ठपुरोहिताः",
      "start": 21.6,
      "end": 21.6
    },
    {
      "text": "प्र॒जाः प्राजा॑यन्त॒ तस्मा᳚द्-वासि॒ष्ठो ब्र॒ह्मा",
      "start": 21.6,
      "end": 21.6
    },
    {
      "text": "का॒र्यः॑ प्रैव जा॑यते र॒श्मिर॑सि॒",
      "start": 21.6,
      "end": 21.6
    },
    {
      "text": "क्षया॑य त्वा॒ क्षयं॑ जि॒न्वे",
      "start": 21.6,
      "end": 21.6
    },
    {
      "text": "- [ ]",
      "start": 21.6,
      "end": 21.6
    }
  ],
