  "phrases": [
    {
      "text": "पूर्व॒ आ ऽल॑भन्त दर्.शपूर्णमा॒सा-वा॒लभ॑मान",
      "start": 90.0,
      "end": 94.28
    },
    {
      "text": "ए॒तौ होमौ॑ पु॒रस्ता᳚ज्जुहुयाथ् सा॒क्षादे॒व",
      "start": 94.28,
      "end": 98.12
    },
    {
      "text": "द॑र्.शपूर्णमा॒सावा ल॑भते ब्रह्मवा॒दिनो॑ वदन्ति॒",
      "start": 98.12,
      "end": 105.76
    },
    {
      "text": "स त्वै द॑र्.शपूर्णमा॒सावा ल॑भेत॒",
      "start": 105.76,
      "end": 108.88
    },
    {
      "text": "य ए॑नयोरनु-लो॒मञ्च॑ प्रतिलो॒मञ्च॑ वि॒द्यादित्य॑मावा॒स्या॑या",
      "start": 108.88,
      "end": 117.04
    },
    {
      "text": "ऊ॒र्द्ध्वं तद॑नुलो॒मं पौ᳚र्णमा॒स्यै प्र॑ती॒चीनं॒",
      "start": 117.04,
      "end": 123.72
    },
    {
      "text": "तत् प्र॑तिलो॒मं ॅयत् पौ᳚र्णमा॒सीं",
      "start": 123.72,
      "end": 126.56
    },
    {
      "text": "पूर्वा॑मा॒लभे॑त प्रतिलो॒ममे॑ना॒वा ल॑भेता॒-मुम॑प॒क्षीय॑माण॒-मन्वप॑ -",
      "start": 126.56,
      "end": 137.16
    },
    {
      "text": "[ ]",
      "start": 137.16,
      "end": 137.16
    }
  ],
