{
  "kanda": 3,
  "prasna": 5,
  "anuvaka": 8,
  "panchasat": 1,
  "phrases": [
    {
      "text": "उ॒प॒या॒मगृ॑हीतोऽसि प्र॒जाप॑तये त्वा॒ ज्योति॑ष्मते॒",
      "start": 0.0,
      "end": 11.12
    },
    {
      "text": "ज्योति॑ष्मन्तं गृह्णामि॒ दक्षा॑य दक्ष॒वृधे॑",
      "start": 11.12,
      "end": 14.08
    },
    {
      "text": "रा॒तं दे॒वेभ्यो᳚ऽग्नि जि॒ह्वेभ्य॑स्त्वर्ता॒युभ्य॒ इन्द्र॑ज्येष्ठेभ्यो॒",
      "start": 14.08,
      "end": 14.08
    },
    {
      "text": "वरु॑णराजभ्यो॒ वाता॑पिभ्यः प॒र्जन्या᳚त्मभ्यो दि॒वे",
      "start": 14.08,
      "end": 14.08
    },
    {
      "text": "त्वा॒ऽन्तरि॑क्षाय त्वा पृथि॒व्यै त्वाऽपे᳚न्द्र",
      "start": 14.08,
      "end": 14.08
    },
    {
      "text": "द्विष॒तो मनोऽप॒ जिज्या॑सतो ज॒ह्यप॒",
      "start": 14.08,
      "end": 14.08
    },
    {
      "text": "यो नो॑ऽराती॒यति॒ तं ज॑हि",
      "start": 14.08,
      "end": 14.92
    },
    {
      "text": "प्रा॒णाय॑ त्वाऽपा॒नाय॑ त्वा व्या॒नाय॑",
      "start": 14.92,
      "end": 20.84
    },
    {
      "text": "त्वा स॒ते त्वाऽस॑ते त्वा॒ऽद्भ्यस्त्वौष॑धीभ्यो॒",
      "start": 20.84,
      "end": 28.08
    },
    {
      "text": "( ) विश्वे᳚भ्यस्त्वा भू॒तेभ्यो॒",
      "start": 28.08,
      "end": 31.44
    },
    {
      "text": "यतः॑ प्र॒जा अक्खि॑द्रा॒ अजा॑यन्त॒",
      "start": 31.44,
      "end": 38.16
    },
    {
      "text": "तस्मै᳚ त्वा प्र॒जाप॑तये विभू॒दाव्.न्ने॒",
      "start": 38.16,
      "end": 45.68
    },
    {
      "text": "ज्योति॑ष्मते॒ ज्योति॑ष्मन्तं जुहोमि",
      "start": 45.68,
      "end": 53.64
    }
  ],
  "total_phrases": 13
}