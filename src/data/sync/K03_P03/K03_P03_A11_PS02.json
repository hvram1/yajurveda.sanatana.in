    {
      "text": "शुचे॒ शुच॑यश्चरन्ति",
      "start": 43.84,
      "end": 44.16
    },
    {
      "text": "तु॒वि॒म्र॒क्षासो॑ दि॒व्या नव॑ग्वा॒ वना॑",
      "start": 44.16,
      "end": 44.16
    },
    {
      "text": "वनन्ति धृष॒ता रु॒जन्तः॑",
      "start": 44.16,
      "end": 44.16
    },
    {
      "text": "त्वाम॑ग्ने॒ मानु॑षीरीडते॒ विशो॑ होत्रा॒विदं॒",
      "start": 44.16,
      "end": 50.32
    },
    {
      "text": "ॅविवि॑चिꣳ रत्न॒धात॑मं",
      "start": 50.32,
      "end": 53.0
    },
    {
      "text": "गुहा॒ सन्तꣳ॑ सुभग वि॒श्वद॑र्.शतं",
      "start": 53.0,
      "end": 60.04
    },
    {
      "text": "तु विष्म॒णसꣳ॑ सु॒यजं॑ घृत॒श्रियं᳚",
      "start": 60.04,
      "end": 64.76
    },
    {
      "text": "धा॒ता द॑दातु नो र॒यिमीशा॑नो॒ जग॑त॒स्पतिः॑",
      "start": 64.76,
      "end": 72.52
    },
    {
      "text": "स नः॑ पू॒र्णेन॑ वावनत्",
      "start": 72.52,
      "end": 75.4
    },
    {
      "text": "धा॒ता प्र॒जाया॑ उ॒त रा॒य",
      "start": 75.4,
      "end": 79.12
    },
    {
      "text": "ई॑शे धा॒तेदं ॅविश्वं॒ भुव॑नं",
      "start": 79.12,
      "end": 83.52
    },
    {
      "text": "जजान",
      "start": 83.52,
      "end": 84.28
    },
    {
      "text": "धा॒ता पु॒त्रं ॅयज॑मानाय॒ दाता॒",
