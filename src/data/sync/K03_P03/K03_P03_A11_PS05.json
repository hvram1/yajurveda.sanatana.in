{
  "kanda": 3,
  "prasna": 3,
  "anuvaka": 11,
  "panchasat": 5,
  "phrases": [
    {
      "text": "रा॒काम॒हꣳ सु॒हवाꣳ॑ सुष्टु॒ती हु॑वे",
      "start": 153.92,
      "end": 157.6
    },
    {
      "text": "शृ॒णोतु॑ नः सु॒भगा॒ बोध॑तु॒",
      "start": 157.6,
      "end": 161.76
    },
    {
      "text": "त्मना᳚",
      "start": 161.76,
      "end": 161.76
    },
    {
      "text": "सीव्य॒त्वपः॑ सू॒च्याऽच्छि॑द्यमानया॒ ददा॑तु वी॒रꣳ श॒तदा॑यमु॒क्थ्यं᳚",
      "start": 161.76,
      "end": 161.76
    },
    {
      "text": "यास्ते॑ राके सुम॒तयः॑ सु॒पेश॑सो॒",
      "start": 161.76,
      "end": 167.96
    },
    {
      "text": "याभि॒र्ददा॑सि दा॒शुषे॒ वसू॑नि",
      "start": 167.96,
      "end": 172.36
    },
    {
      "text": "ताभि॑र्नो अ॒द्य सु॒मना॑ उ॒पाग॑हि",
      "start": 172.36,
      "end": 174.84
    },
    {
      "text": "सहस्रपो॒षꣳ सु॑भगे॒ ररा॑णा",
      "start": 174.84,
      "end": 177.56
    },
    {
      "text": "सिनी॑वालि॒ या सु॑पा॒णिः",
      "start": 177.56,
      "end": 181.48
    },
    {
      "text": "कु॒हूम॒हꣳ सु॒भगां᳚ ॅविद्म॒नाप॑सम॒स्मिन्. य॒ज्ञे",
      "start": 181.48,
      "end": 186.16
    },
    {
      "text": "सु॒हवां᳚ जोहवीमि",
      "start": 186.16,
      "end": 187.64
    },
    {
      "text": "सा नो॑ ददातु॒ श्रव॑णं",
      "start": 187.64,
      "end": 191.0
    },
    {
      "text": "( ) पितृ॒णां तस्या᳚स्ते",
      "start": 191.0,
      "end": 193.56
    },
    {
      "text": "देवि ह॒विषा॑ विधेम",
      "start": 193.56,
      "end": 196.48
    },
    {
      "text": "कु॒हू-र्दे॒वाना॑म॒मृत॑स्य॒ पत्नी॒ हव्या॑ नो",
      "start": 196.48,
      "end": 207.96
    },
    {
      "text": "अ॒स्य ह॒विष॑श्चिकेतु",
      "start": 207.96,
      "end": 212.12
    },
    {
      "text": "सं दा॒शुषे॑ कि॒रतु॒ भूरि॑",
      "start": 212.12,
      "end": 216.56
    },
    {
      "text": "वा॒मꣳ रा॒यस्पोषं॑ चिकि॒तुषे॑ दधातु",
      "start": 216.56,
      "end": 221.44
    }
  ],
  "total_phrases": 18
}