  "phrases": [
    {
      "text": "प्रि॒यं पाथो॒ अपी॑हि व॒शी",
      "start": 83.24,
      "end": 86.6
    },
    {
      "text": "त्वं दे॑व सोम॒ त्रैष्टु॑भेन॒",
      "start": 86.6,
      "end": 93.32
    },
    {
      "text": "छन्द॒सेन्द्र॑स्य प्रि॒यं पाथो॒ अपी᳚ह्य॒स्मथ्स॑खा॒",
      "start": 93.32,
      "end": 103.88
    },
    {
      "text": "त्वं दे॑व सोम॒ जाग॑तेन॒",
      "start": 103.88,
      "end": 108.12
    },
    {
      "text": "छन्द॑सा॒ विश्वे॑षां दे॒वानां᳚ प्रि॒यं",
      "start": 108.12,
      "end": 113.6
    },
    {
      "text": "पाथो॒ अपी॒ह्या नः॑ प्रा॒ण",
      "start": 113.6,
      "end": 119.28
    },
    {
      "text": "ए॑तु परा॒वत॒ आऽन्तरि॑क्षाद्दि॒वस्परि॑",
      "start": 119.28,
      "end": 123.48
    },
    {
      "text": "आयुः॑ पृथि॒व्या अद्ध्य॒मृत॑मसि प्रा॒णाय॑ त्वा",
      "start": 123.48,
      "end": 123.48
    },
    {
      "text": "इ॒न्द्रा॒ग्नी मे॒ वर्चः॑ कृणुतां॒",
      "start": 123.48,
      "end": 123.48
    },
    {
      "text": "ॅवर्चः॒ सोमो॒ बृह॒स्पतिः॑ (",
      "start": 123.48,
      "end": 123.48
    },
    {
      "text": ")",
      "start": 123.48,
      "end": 123.48
    },
    {
      "text": "वर्चो॑ मे॒ विश्वे॑दे॒वा वर्चो॑",
      "start": 123.48,
      "end": 123.48
    },
    {
      "text": "मे धत्तमश्विना",
      "start": 123.48,
      "end": 123.48
    },
    {
      "text": "द॒ध॒न्वे वा॒ यदी॒मनु॒ वोच॒द्ब्रह्मा॑णि॒",
      "start": 123.48,
      "end": 123.48
    },
    {
      "text": "वेरु॒ तत्",
      "start": 123.48,
      "end": 123.48
    },
    {
      "text": "परि॒ विश्वा॑नि॒ काव्या॑ ने॒मिश्च॒क्रमि॑वा भवत्",
      "start": 123.48,
      "end": 129.48
    }
  ],
