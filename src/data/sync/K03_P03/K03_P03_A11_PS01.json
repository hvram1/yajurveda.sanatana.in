    {
      "text": "इ॒दं ॅवा॑मा॒स्ये॑ ह॒विः प्रि॒यमि॑न्द्राबृहस्पती",
      "start": 0.0,
      "end": 11.2
    },
    {
      "text": "उ॒क्थं मद॑श्च शस्यते",
      "start": 11.2,
      "end": 13.96
    },
    {
      "text": "अ॒यं ॅवां॒ परि॑ षिच्यते॒ सोम॑इन्द्राबृहस्पती",
      "start": 13.96,
      "end": 21.64
    },
    {
      "text": "चारु॒र्मदा॑य पी॒तये᳚",
      "start": 21.64,
      "end": 23.08
    },
    {
      "text": "अ॒स्मे इ॑न्द्राबृहस्पती र॒यिं ध॑त्तꣳ शत॒ग्विनं᳚",
      "start": 23.08,
      "end": 28.16
    },
    {
      "text": "अश्वा॑वन्तꣳ सह॒स्रिणं᳚",
      "start": 28.16,
      "end": 32.32
    },
    {
      "text": "बृह॒स्पति॑र्नः॒ परि॑पातु प॒श्चादु॒तोत्त॑रस्मा॒दध॑रादघा॒योः",
      "start": 32.32,
      "end": 35.68
    },
    {
      "text": "इन्द्रः॑ पु॒रस्ता॑दु॒त म॑द्ध्य॒तो नः॒",
      "start": 35.68,
      "end": 36.24
    },
    {
      "text": "सखा॒ सखि॑भ्यो॒ वरि॑वः कृणोतु",
      "start": 36.24,
      "end": 40.68
    },
    {
      "text": "वि ते॒ विष्व॒ग्वात॑जूतासो अग्ने॒",
