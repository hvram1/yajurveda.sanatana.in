  "phrases": [
    {
      "text": "शु॒क्रासु॑ ते शुक्र शु॒क्रमा",
      "start": 50.2,
      "end": 54.84
    },
    {
      "text": "धू॑नोमि शु॒क्रं ते॑ शु॒क्रेण॑",
      "start": 54.84,
      "end": 57.88
    },
    {
      "text": "गृह्णा॒म्यह्नो॑ रू॒पेण॒ सूर्य॑स्य र॒श्मिभिः॑",
      "start": 57.88,
      "end": 58.68
    },
    {
      "text": "आऽस्मि॑न्नु॒ग्रा अ॑चुच्यवुर्दि॒वो धारा॑ असश्चत",
      "start": 58.68,
      "end": 58.68
    },
    {
      "text": "क॒कु॒हꣳ रू॒पं ॅवृ॑ष॒भस्य॑ रोचते",
      "start": 58.68,
      "end": 58.68
    },
    {
      "text": "बृ॒हथ् सोमः॒ सोम॑स्य पुरो॒गाः",
      "start": 58.68,
      "end": 64.28
    },
    {
      "text": "शु॒क्रः शु॒क्रस्य॑ पुरो॒गाः",
      "start": 64.28,
      "end": 69.76
    },
    {
      "text": "यत् ते॑ सो॒मादा᳚भ्यं॒ नाम॒",
      "start": 69.76,
      "end": 73.92
    },
    {
      "text": "जागृ॑वि॒ तस्मै॑ ते सोम॒",
      "start": 73.92,
      "end": 77.04
    },
    {
      "text": "सोमा॑य॒ स्वाहो॒शिक् त्वं दे॑व",
      "start": 77.04,
      "end": 81.52
    },
    {
      "text": "सोम गाय॒त्रेण॒ छन्द॑सा॒ऽग्नेः -",
      "start": 81.52,
      "end": 83.24
