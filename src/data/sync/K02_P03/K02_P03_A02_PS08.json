  "phrases": [
    {
      "text": "सा॒क्षादे॒व सो॑मपी॒थमव॑ रुन्धे॒ ऽग्नये॑",
      "start": 218.08,
      "end": 223.56
    },
    {
      "text": "दा॒त्रे पु॑रो॒डाश॑म॒ष्टाक॑पालं॒ निर्व॑पे॒दिन्द्रा॑य प्रदा॒त्रे",
      "start": 223.56,
      "end": 237.36
    },
    {
      "text": "पु॑रो॒डाश॒मेका॑दशकपालं प॒शुका॑मो॒ऽग्निरे॒वास्मै॑ प॒शून् प्र॑ज॒नय॑ति",
      "start": 237.36,
      "end": 249.76
    },
    {
      "text": "वृ॒द्धानिन्द्रः॒ प्र य॑च्छति॒ दधि॒",
      "start": 249.76,
      "end": 252.88
    },
    {
      "text": "मधु॑ घृ॒तमापो॑ धा॒ना भ॑वन्त्ये॒तद्वै",
      "start": 252.88,
      "end": 254.64
    },
    {
      "text": "प॑शू॒नाꣳ रू॒पꣳ रू॒पेणै॒व प॒शूनव॑",
      "start": 254.64,
      "end": 257.88
    },
    {
      "text": "रुन्धे पञ्च-गृही॒तं भ॑वति॒ पाङ्क्ता॒",
      "start": 257.88,
      "end": 262.36
    },
    {
      "text": "हि प॒शवो॑ बहु रू॒पं",
      "start": 262.36,
      "end": 264.52
    },
    {
      "text": "भ॑वति बहु रू॒पा हि",
      "start": 264.52,
      "end": 265.76
    },
    {
