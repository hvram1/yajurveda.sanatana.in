  "phrases": [
    {
      "text": "भ॑वति॒ यद॒ष्टाक॑पाल॒-स्तेना᳚ऽऽग्ने॒यो यच्छ्या॑मा॒कस्तेन॑ सौ॒म्यः",
      "start": 129.2,
      "end": 131.28
    },
    {
      "text": "समृ॑द्ध्यै॒ सोमा॑य वा॒जिने᳚ श्यामा॒कं",
      "start": 131.28,
      "end": 131.28
    },
    {
      "text": "च॒रुं निर्व॑पे॒द्यः क्लैब्या᳚द्बिभी॒याद् रेतो॒",
      "start": 131.28,
      "end": 131.28
    },
    {
      "text": "हि वा ए॒तस्मा॒द्-वाजि॑नमप॒क्राम॒त्यथै॒ष क्लैब्या᳚द्बिभाय॒",
      "start": 131.28,
      "end": 131.28
    },
    {
      "text": "सोम॑मे॒व वा॒जिनꣳ॒॒ स्वेन॑ भाग॒धेये॒नोप॑",
      "start": 131.28,
      "end": 131.28
    },
    {
      "text": "धावति॒ स ए॒वास्मि॒न् रेतो॒",
      "start": 131.28,
      "end": 131.28
    },
    {
      "text": "वाजि॑नं दधाति॒ न क्ली॒बो",
      "start": 131.28,
      "end": 131.28
    },
    {
      "text": "भ॑वतिब्राह्मणस्प॒त्य-मेका॑दशकपालं॒ निर्व॑पे॒द् ग्राम॑कामो॒ -",
      "start": 131.28,
      "end": 131.28
    },
    {
      "text": "[ ]",
      "start": 131.28,
      "end": 131.28
    }
  ],
