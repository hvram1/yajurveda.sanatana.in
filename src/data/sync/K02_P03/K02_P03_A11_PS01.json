  "phrases": [
    {
      "text": "अ॒ग्निं ॅवा ए॒तस्य॒ शरी॑रं",
      "start": 0.0,
      "end": 4.52
    },
    {
      "text": "गच्छति॒ सोमꣳ॒॒ रसो॒ वरु॑ण",
      "start": 4.52,
      "end": 4.52
    },
    {
      "text": "एनं ॅवरुणपा॒शेन॑ गृह्णाति॒ सर॑स्वतीं॒",
      "start": 4.52,
      "end": 4.52
    },
    {
      "text": "ॅवाग॒ग्नाविष्णू॑ आ॒त्मा यस्य॒ ज्योगा॒मय॑ति॒",
      "start": 4.52,
      "end": 4.52
    },
    {
      "text": "यो ज्योगा॑मयावी॒ स्याद्यो वा॑",
      "start": 4.52,
      "end": 4.52
    },
    {
      "text": "का॒मये॑त॒ सर्व॒मायु॑रिया॒मिति॒ तस्मा॑ ए॒तामिष्टिं॒",
      "start": 4.52,
      "end": 4.52
    },
    {
      "text": "निर्व॑पेदाग्ने॒य -म॒ष्टाक॑पालꣳ सौ॒म्यं च॒रुं",
      "start": 4.52,
      "end": 4.52
    },
    {
      "text": "ॅवा॑रु॒णं दश॑कपालꣳ सारस्व॒तं च॒रुमा᳚ग्नावैष्ण॒व-मेका॑दशकपाल-म॒ग्नेरे॒वास्य॒",
      "start": 4.52,
      "end": 10.36
    },
    {
      "text": "शरी॑रं निष्क्री॒णाति॒ सोमा॒द्रसं॑ -",
      "start": 10.36,
      "end": 20.84
    },
    {
      "text": "[ ]",
      "start": 20.84,
      "end": 20.88
    }
  ],
