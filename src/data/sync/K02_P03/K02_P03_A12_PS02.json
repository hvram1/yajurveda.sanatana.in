    {
      "text": "चतु॑ष्कपाला भवन्ति॒ चतु॑ष्पा॒द्ध्यश्वः॒ समृ॑द्ध्या॒",
      "start": 37.04,
      "end": 37.04
    },
    {
      "text": "एक॒मति॑रिक्तं॒ निर्व॑पे॒द्-यमे॒व प्र॑तिग्रा॒ही भव॑ति॒",
      "start": 37.04,
      "end": 37.04
    },
    {
      "text": "यं ॅवा॒ नाद्ध्येति॒ तस्मा॑दे॒व",
      "start": 37.04,
      "end": 37.04
    },
    {
      "text": "व॑रुणपा॒शान् मु॑च्यते॒ यद्यप॑रं प्रतिग्रा॒ही",
      "start": 37.04,
      "end": 37.04
    },
    {
      "text": "स्याथ् सौ॒र्यमेक॑कपाल॒मनु॒ निर्व॑पेद॒मुमे॒वा ऽऽदि॒त्यमु॑च्चा॒रं",
      "start": 37.04,
      "end": 47.32
    },
    {
      "text": "कु॑रुते॒ ऽपो॑ऽवभृ॒थमवै᳚त्य॒फ्सु वै वरु॑णः",
      "start": 47.32,
      "end": 52.32
    },
    {
      "text": "सा॒क्षादे॒व वरु॑ण॒मव॑ यजते ऽपोन॒प्त्रीयं॑",
      "start": 52.32,
      "end": 57.6
    },
    {
      "text": "च॒रुं ( ) पुन॒रेत्य॒",
      "start": 57.6,
      "end": 60.52
    },
    {
      "text": "निर्व॑पेद॒फ्सु यो॑नि॒र्वा अश्वः॒ स्वामे॒वैनं॒ॅयोनिं॑",
      "start": 60.52,
      "end": 69.48
