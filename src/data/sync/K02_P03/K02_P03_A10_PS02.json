    {
      "text": "तस्य॑ ते ददतु॒ येषां᳚",
      "start": 15.12,
      "end": 18.48
    },
    {
      "text": "प्रा॒णोऽसि॒ स्वाहा॑ घृ॒तस्य॒ धारा॑म॒मृत॑स्य॒",
      "start": 18.48,
      "end": 28.52
    },
    {
      "text": "पन्था॒मिन्द्रे॑ण द॒त्तां प्रय॑तां म॒रुद्भिः॑",
      "start": 28.52,
      "end": 38.16
    },
    {
      "text": "तत् त्वा॒ विष्णुः॒ पर्य॑पश्य॒त्",
      "start": 38.16,
      "end": 42.52
    },
    {
      "text": "तत् त्वेडा॒ गव्यैर॑यत्",
      "start": 42.52,
      "end": 47.64
    },
    {
      "text": "पा॒व॒मा॒नेन॑ त्वा॒ स्तोमे॑न गाय॒त्रस्य॑",
      "start": 47.64,
      "end": 58.48
    },
    {
      "text": "वर्त॒न्योपाꣳ॒॒शो र्वी॒र्ये॑ण दे॒वस्त्वा॑ सवि॒तोथ्",
      "start": 58.48,
      "end": 63.48
    },
    {
      "text": "सृ॑जतु जी॒वात॑वे जीवन॒स्यायै॑ बृहद्-रथन्त॒रयो᳚स्त्वा॒",
      "start": 63.48,
      "end": 66.44
    },
    {
      "text": "स्तोमे॑न त्रि॒ष्टुभो॑ वर्त॒न्या शु॒क्रस्य॑",
      "start": 66.44,
      "end": 69.44
    },
    {
