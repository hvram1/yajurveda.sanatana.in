  "phrases": [
    {
      "text": "-मा॑दि॒त्यं च॒रुं निर॑वप॒न् तेनै॒वैनं॑",
      "start": 70.96,
      "end": 73.76
    },
    {
      "text": "पा॒पाथ् स्रामा॑दमुञ्च॒न्. यः पा॑पय॒क्ष्मगृ॑हीतः॒",
      "start": 73.76,
      "end": 73.76
    },
    {
      "text": "स्यात् तस्मा॑ ए॒तमा॑दि॒त्यं च॒रुं",
      "start": 73.76,
      "end": 73.76
    },
    {
      "text": "निर्व॑पेदादि॒त्याने॒व स्वेन॑ भाग॒धेये॒नोप॑ धावति॒",
      "start": 73.76,
      "end": 73.76
    },
    {
      "text": "त ए॒वैनं॑ पा॒पाथ् स्रामा᳚न्मुञ्चन्त्य-मावा॒स्या॑यां॒",
      "start": 73.76,
      "end": 73.76
    },
    {
      "text": "निर्व॑पेद॒मुमे॒वैन-॑मा॒प्याय॑मान॒-मन्वा प्या॑ययति॒ नवो॑नवो भवति॒",
      "start": 73.76,
      "end": 81.96
    },
    {
      "text": "जाय॑मान॒ इति॑ पुरोऽनुवा॒क्या॑ भव॒त्यायु॑रे॒वास्मि॒न्",
      "start": 81.96,
      "end": 92.16
    },
    {
      "text": "( ) तया॑ दधाति॒",
      "start": 92.16,
      "end": 93.6
    },
    {
      "text": "यमा॑दि॒त्या अꣳ॒॒शुमा᳚प्या॒यय॒न्तीति॑ या॒ज्यैवैन॑मे॒तया᳚ प्याययति",
      "start": 93.6,
      "end": 105.44
    }
  ],
  "total_phrases": 9
