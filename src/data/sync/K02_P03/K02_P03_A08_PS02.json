  "phrases": [
    {
      "text": "प॑श्यन्ति॒ सूर्य॑स्य दे॒वा अ॒ग्निं",
      "start": 47.92,
      "end": 51.72
    },
    {
      "text": "चै॒व सूर्यं॑ च॒ स्वेन॑",
      "start": 51.72,
      "end": 52.32
    },
    {
      "text": "भाग॒धेये॒नोप॑ धावति॒ तावे॒वास्मि॒न् चक्षु॑र्द्धत्त॒श्चक्षु॑ष्माने॒व",
      "start": 52.32,
      "end": 61.44
    },
    {
      "text": "भ॑वति॒ यदा᳚ग्ने॒यौ भव॑त॒श्चक्षु॑षी ए॒वास्मि॒न्",
      "start": 61.44,
      "end": 61.44
    },
    {
      "text": "तत् प्रति॑ दधाति॒ यथ्",
      "start": 61.44,
      "end": 61.44
    },
    {
      "text": "सौ॒र्यो नासि॑कां॒ तेना॒भितः॑ सौ॒र्यमा᳚ग्ने॒यौ",
      "start": 61.44,
      "end": 61.44
    },
    {
      "text": "भ॑वत॒स्तस्मा॑द॒भितो॒ नासि॑कां॒ चक्षु॑षी॒ तस्मा॒न्नासि॑कया॒",
      "start": 61.44,
      "end": 72.88
    },
    {
      "text": "चक्षु॑षी॒ विधृ॑ते समा॒नी या᳚ज्यानुवा॒क्ये॑",
      "start": 72.88,
      "end": 77.36
    },
    {
      "text": "भवतः समा॒नꣳ हि (",
      "start": 77.36,
      "end": 77.84
    },
    {
      "text": ") चक्षुः॒ समृ॑द्ध्या॒ उदु॒त्यं",
      "start": 77.84,
      "end": 77.84
    },
    {
      "text": "जा॒तवे॑दसꣳ स॒प्त त्वा॑ ह॒रितो॒",
      "start": 77.84,
      "end": 77.84
    },
    {
      "text": "रथे॑ चि॒त्रं दे॒वाना॒मुद॑गा॒दनी॑क॒मिति॒ पिण्डा॒न्",
      "start": 77.84,
      "end": 77.84
    },
    {
      "text": "प्रय॑च्छति॒ चक्षु॑रे॒वास्मै॒ प्रय॑च्छति॒ यदे॒व",
      "start": 77.84,
      "end": 87.92
    },
    {
      "text": "तस्य॒ तत्",
      "start": 87.92,
      "end": 89.44
    }
  ],
  "total_phrases": 14
}