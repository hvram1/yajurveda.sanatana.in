  "phrases": [
    {
      "text": "पुरो॒डाश॒मव॑ दधात्यात्म॒न्वन्त॑मे॒वैनं॑ करो॒त्यथो॑ आ॒यत॑नवन्तमे॒व",
      "start": 78.68,
      "end": 78.76
    },
    {
      "text": "च॑तु॒र्द्धा व्यू॑हति दि॒क्ष्वे॑व प्रति॑तिष्ठति॒",
      "start": 78.76,
      "end": 88.4
    },
    {
      "text": "पुनः॒ समू॑हति दि॒ग्भ्य ए॒वास्मै॑",
      "start": 88.4,
      "end": 88.4
    },
    {
      "text": "भेष॒जं क॑रोति स॒मूह्याव॑ द्यति॒",
      "start": 88.4,
      "end": 88.4
    },
    {
      "text": "यथाऽऽवि॑द्धं निष्कृ॒न्तति॑ ता॒दृगे॒व तद्यो",
      "start": 88.4,
      "end": 88.4
    },
    {
      "text": "वा॑मिन्द्रावरुणाव॒ग्नौ स्राम॒स्तं ॅवा॑मे॒तेनाव॑ यज॒",
      "start": 88.4,
      "end": 88.4
    },
    {
      "text": "इत्या॑ह॒ दुरि॑ष्‌ट्या ए॒वैनं॑ पाति॒",
      "start": 88.4,
      "end": 88.4
    },
    {
      "text": "( ) यो वा॑",
      "start": 88.4,
      "end": 88.4
    },
    {
      "text": "मिन्द्रा वरुणा द्वि॒पाथ्सु॑ प॒शुषु॒",
      "start": 88.4,
      "end": 88.4
    },
    {
      "text": "स्राम॒स्तं ॅवा॑ मे॒ तेनाव॑",
      "start": 88.4,
      "end": 88.48
    },
    {
      "text": "यज॒ इत्या॑है॒ताव॑ती॒र्वा आप॒ ओष॑धयो॒",
      "start": 88.48,
      "end": 97.72
    },
    {
      "text": "वन॒स्पत॑यः प्र॒जाः प॒शव॑ उपजीव॒नीया॒स्ता",
      "start": 97.72,
      "end": 107.2
    },
    {
      "text": "ए॒वास्मै॑ वरुणपा॒शान्-मु॑ञ्चति",
      "start": 107.2,
      "end": 112.64
    }
  ],
  "total_phrases": 13
