  "phrases": [
    {
      "text": "घृ॒तं निष्पि॑ब॒त्यायु॒र्वै घृ॒तम॒मृतꣳ॒॒ हिर॑ण्यम॒मृता॑दे॒वा",
      "start": 131.76,
      "end": 137.24
    },
    {
      "text": "ऽऽयु॒र्निष्पि॑बति श॒तमा॑नं भवति श॒तायुः॒",
      "start": 137.24,
      "end": 142.2
    },
    {
      "text": "पुरु॑षः श॒तेन्द्रि॑य॒ आयु॑ष्ये॒वेन्द्रि॒ये प्रति॑तिष्ठ॒त्यथो॒",
      "start": 142.2,
      "end": 152.8
    },
    {
      "text": "खलु॒ याव॑तीः॒ समा॑ ए॒ष्यन्",
      "start": 152.8,
      "end": 156.96
    },
    {
      "text": "मन्ये॑त॒ ताव॑न्मानꣳ स्या॒थ् समृ॑द्ध्या",
      "start": 156.96,
      "end": 158.28
    },
    {
      "text": "इ॒मम॑ग्न॒ आयु॑षे॒ वर्च॑से कृ॒धीत्या॒हा",
      "start": 158.28,
      "end": 168.88
    },
    {
      "text": "ऽऽयु॑रे॒वास्मि॒न्. वर्चो॑ दधाति॒ विश्वे॑",
      "start": 168.88,
      "end": 171.32
    },
    {
      "text": "देवा॒ जर॑दष्टि॒र्यथा ऽस॒दित्या॑ (",
      "start": 171.32,
      "end": 171.32
    },
    {
      "text": ") -ह॒ जर॑दष्टिमे॒वैनं॑ करोत्य॒ग्नि-रायु॑ष्मा॒निति॒",
      "start": 171.32,
      "end": 171.36
    },
    {
      "text": "हस्तं॑ गृह्णात्ये॒ते वै दे॒वा",
      "start": 171.36,
      "end": 171.36
    },
    {
      "text": "आयु॑ष्मन्त॒स्त ए॒वास्मि॒न्नायु॑र्दधति॒ सर्व॒मायु॑रेति",
      "start": 171.36,
      "end": 181.64
    }
  ],
  "total_phrases": 11
}