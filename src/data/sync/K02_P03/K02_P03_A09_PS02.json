  "phrases": [
    {
      "text": "-म॑नस्य देवा॒ याः स्त्रियः॒",
      "start": 38.4,
      "end": 39.2
    },
    {
      "text": "सम॑नस॒स्ता अ॒हं का॑मये हृ॒दा",
      "start": 39.2,
      "end": 39.2
    },
    {
      "text": "ता मां का॑मयन्ताꣳ हृ॒दा",
      "start": 39.2,
      "end": 39.2
    },
    {
      "text": "ता म॒ आम॑नसः कृधि॒",
      "start": 39.2,
      "end": 39.2
    },
    {
      "text": "स्वाहा॑ वैश्वदे॒वीꣳसा᳚ङ्ग्रह॒णीं निर्व॑पे॒द्ग्राम॑कामो वैश्वदे॒वा",
      "start": 39.2,
      "end": 42.08
    },
    {
      "text": "वै स॑जा॒ता विश्वा॑ने॒व दे॒वान्थ्स्वेन॑",
      "start": 42.08,
      "end": 50.56
    },
    {
      "text": "भाग॒धेये॒नोप॑ धावति॒ त ए॒वास्मै॑",
      "start": 50.56,
      "end": 57.08
    },
    {
      "text": "सजा॒तान् प्र य॑च्छन्ति ग्रा॒म्ये॑व",
      "start": 57.08,
      "end": 59.96
    },
    {
      "text": "भ॑वति सांग्रह॒णी भ॑वति मनो॒ग्रह॑णं॒",
      "start": 59.96,
      "end": 62.68
    },
    {
      "text": "ॅवैस॒ग्रंह॑णं॒ मन॑ ए॒व स॑जा॒तानां᳚",
      "start": 62.68,
      "end": 68.32
    },
