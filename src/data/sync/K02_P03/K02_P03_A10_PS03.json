  "phrases": [
    {
      "text": "सृ॑जतु जी॒वात॑वे जीवन॒स्याया॑ अ॒ग्नेस्त्वा॒",
      "start": 72.28,
      "end": 75.96
    },
    {
      "text": "मात्र॑या॒ जग॑त्यै वर्त॒न्याऽऽग्र॑य॒णस्य॑ वी॒र्ये॑ण",
      "start": 75.96,
      "end": 79.4
    },
    {
      "text": "दे॒वस्त्वा॑ सवि॒तोथ् सृ॑जतु जी॒वात॑वे",
      "start": 79.4,
      "end": 86.56
    },
    {
      "text": "जीवन॒स्याया॑ इ॒मम॑ग्न॒ आयु॑षे॒ वर्च॑से",
      "start": 86.56,
      "end": 93.56
    },
    {
      "text": "कृधि प्रि॒यꣳ रेतो॑ वरुण",
      "start": 93.56,
      "end": 97.32
    },
    {
      "text": "सोम राजन्न्",
      "start": 97.32,
      "end": 97.36
    },
    {
      "text": "मा॒ तेवा᳚स्मा अदिते॒ शर्म॑",
      "start": 97.36,
      "end": 101.24
    },
    {
      "text": "यच्छ॒ विश्वे॑ देवा॒ जर॑दष्टि॒र्यथाऽस॑त्",
      "start": 101.24,
      "end": 101.24
    },
    {
      "text": "अ॒ग्निरायु॑ष्मा॒न्थ् स वन॒स्पति॑भि॒रायु॑ष्मा॒न् तेन॒",
      "start": 101.24,
      "end": 101.24
    },
    {
      "text": "त्वाऽऽयु॒षाऽऽयु॑ष्मन्तं करोमि॒ सोम॒ आयु॑ष्मा॒न्थ्",
      "start": 101.24,
      "end": 101.24
    },
    {
      "text": "( ) स ओष॑धीभि",
      "start": 101.24,
      "end": 101.24
    },
    {
      "text": "र्य॒ज्ञ् आयु॑ष्मा॒न्थ् स दक्षि॑णाभि॒",
      "start": 101.24,
      "end": 101.24
    },
    {
      "text": "र्ब्रह्माऽऽयु॑ष्म॒त् तद्-ब्रा᳚ह्म॒णैरायु॑ष्मद् दे॒वा आयु॑ष्मन्त॒स्ते॑ऽमृते॑न",
      "start": 101.24,
      "end": 112.08
    },
    {
      "text": "पि॒तर॒ आयु॑ष्मन्त॒स्ते स्व॒धयाऽऽयु॑ष्मन्त॒स्तेन॒ त्वा",
      "start": 112.08,
      "end": 121.68
    },
    {
      "text": "ऽऽयु॒षाऽऽ यु॑ष्मन्तं करोमि",
      "start": 121.68,
      "end": 125.28
    }
  ],
  "total_phrases": 15
}