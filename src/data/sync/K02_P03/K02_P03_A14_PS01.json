    {
      "text": "स प्र॑त्न॒व न्नि काव्ये",
      "start": 0.0,
      "end": 3.32
    },
    {
      "text": "न्द्रं॑ ॅवो वि॒श्वत॒स्परीन्द्रं॒ नरः॑",
      "start": 3.32,
      "end": 14.16
    },
    {
      "text": "त्वं नः॑ सोम वि॒श्वतो॒",
      "start": 14.16,
      "end": 16.6
    },
    {
      "text": "रक्षा॑ राजन्नघाय॒तः",
      "start": 16.6,
      "end": 19.96
    },
    {
      "text": "न रि॑ष्ये॒त् त्वाव॑तः॒ सखाः᳚",
      "start": 19.96,
      "end": 25.8
    },
    {
      "text": "या ते॒ धामा॑नि दि॒वि",
      "start": 25.8,
      "end": 26.44
    },
    {
      "text": "या पृ॑थि॒व्यां ॅया पर्व॑ते॒ष्वोष॑धीष्व॒फ्सु",
      "start": 26.44,
      "end": 32.56
    },
    {
      "text": "तेभि॑र्नो॒ विश्वः᳚ सु॒मना॒ अहे॑ड॒न्",
      "start": 32.56,
      "end": 38.36
    },
    {
      "text": "राजन्᳚थ्-सोम॒ प्रति॑ ह॒व्या गृ॑भाय",
      "start": 38.36,
      "end": 41.24
    },
    {
      "text": "अग्नी॑षोमा॒ सवे॑दसा॒ सहू॑ती वनतं॒ गिरः॑",
      "start": 41.24,
      "end": 44.4
    },
    {
      "text": "सं दे॑व॒त्रा ब॑भूवथुः",
      "start": 44.4,
      "end": 44.4
    },
    {
