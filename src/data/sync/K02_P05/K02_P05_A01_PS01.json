  "phrases": [
    {
      "text": "वि॒श्वरू॑पो॒ वै त्वा॒ष्ट्रः पु॒रोहि॑तो",
      "start": 0.0,
      "end": 3.64
    },
    {
      "text": "दे॒वाना॑मासीथ् स्व॒स्रीयोऽसु॑राणां॒ तस्य॒ त्रीणि॑",
      "start": 3.64,
      "end": 7.44
    },
    {
      "text": "शी॒र्॒.षाण्या॑सन्थ्-सोम॒पानꣳ॑ सुरा॒पान॑-म॒न्नाद॑नꣳ॒॒ स प्र॒त्यक्षं॑",
      "start": 7.44,
      "end": 18.12
    },
    {
      "text": "दे॒वेभ्यो॑ भा॒गम॑वदत् प॒रोक्ष॒मसु॑रेभ्यः॒ सर्व॑स्मै॒",
      "start": 18.12,
      "end": 28.72
    },
    {
      "text": "वै प्र॒त्यक्षं॑ भा॒गं ॅव॑दन्ति॒",
      "start": 28.72,
      "end": 36.32
    },
    {
      "text": "यस्मा॑ ए॒व प॒रोक्षं॒ ॅवद॑न्ति॒",
      "start": 36.32,
      "end": 43.12
    },
    {
      "text": "तस्य॑ भा॒ग उ॑दि॒तस्तस्मा॒दिन्द्रो॑ ऽबिभेदी॒दृङ्",
      "start": 43.12,
      "end": 44.52
    },
    {
      "text": "वै रा॒ष्ट्रं ॅवि प॒र्याव॑र्तय॒तीति॒",
      "start": 44.52,
      "end": 44.52
    },
    {
      "text": "तस्य॒ वज्र॑मा॒दाय॑ शी॒र्॒.षाण्य॑च्छिन॒द्यथ् सो॑म॒पान॒",
      "start": 44.52,
      "end": 44.52
    },
