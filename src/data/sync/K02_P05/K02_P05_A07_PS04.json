    {
      "text": "इत्यन्वा॑ह॒ मासा॒ वै वाजा॑",
      "start": 74.64,
      "end": 80.36
    },
    {
      "text": "अर्द्धमा॒सा अ॒भिद्य॑वो दे॒वा ह॒विष्म॑न्तो॒",
      "start": 80.36,
      "end": 87.52
    },
    {
      "text": "गौर्घृ॒ताची॑ य॒ज्ञो दे॒वाञ्जि॑गाति॒ यज॑मानः",
      "start": 87.52,
      "end": 95.28
    },
    {
      "text": "सुम्न॒यु-रि॒दम॑सी॒दम॒सीत्ये॒व य॒ज्ञ्स्य॑ प्रि॒यं धामाव॑",
      "start": 95.28,
      "end": 105.08
    },
    {
      "text": "रुन्धे॒ यं का॒मये॑त॒ सर्व॒मायु॑रिया॒दिति॒",
      "start": 105.08,
      "end": 113.68
    },
    {
      "text": "प्र वो॒ वाजा॒ इति॒",
      "start": 113.68,
      "end": 116.52
