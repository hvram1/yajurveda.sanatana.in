  "phrases": [
    {
      "text": "-मासी॒थ् स क॒पिञ्ज॑लो ऽभव॒द्",
      "start": 44.52,
      "end": 44.52
    },
    {
      "text": "यथ् सु॑रा॒पानꣳ॒॒ स क॑ल॒विङ्को॒",
      "start": 44.52,
      "end": 44.52
    },
    {
      "text": "यद॒न्नाद॑नꣳ॒॒ स ति॑त्ति॒रिस्तस्या᳚ञ्ज॒लिना᳚ ब्रह्मह॒त्यामुपा॑गृह्णा॒त्",
      "start": 44.52,
      "end": 47.84
    },
    {
      "text": "ताꣳ सं॑ॅवथ्स॒रम॑बिभ॒स्तं भू॒तान्य॒भ्य॑क्रोश॒न् ब्रह्म॑ह॒न्निति॒",
      "start": 47.84,
      "end": 58.88
    },
    {
      "text": "स पृ॑थि॒वीमुपा॑सीदद॒स्यै ब्र॑ह्मह॒त्यायै॒ तृती॑यं॒",
      "start": 58.88,
      "end": 69.4
    },
    {
      "text": "प्रति॑ गृहा॒णेति॒ साऽब्र॑वी॒द्वरं॑ ॅवृणै",
      "start": 69.4,
      "end": 78.32
    },
    {
      "text": "खा॒तात् प॑राभवि॒ष्यन्ती॑ मन्ये॒ ततो॒",
      "start": 78.32,
      "end": 84.6
    },
    {
      "text": "मा परा॑ भूव॒मिति॑पु॒रा ते॑-",
      "start": 84.6,
      "end": 84.6
