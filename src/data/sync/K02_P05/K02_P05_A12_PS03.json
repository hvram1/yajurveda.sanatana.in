  "phrases": [
    {
      "text": "वि॒शे जना॑य॒ महि॒ शर्म॑ यच्छतं",
      "start": 60.88,
      "end": 66.6
    },
    {
      "text": "दी॒र्घप्र॑यज्यु॒मति॒ यो व॑नु॒ष्यति॑ व॒यं",
      "start": 66.6,
      "end": 72.64
    },
    {
      "text": "ज॑येम॒ पृत॑नासु दू॒ढ्यः॑",
      "start": 72.64,
      "end": 76.76
    },
    {
      "text": "आ नो॑मित्रावरुणा॒प्रबा॒हवा᳚",
      "start": 76.76,
      "end": 78.88
    },
    {
      "text": "त्वं नो॑ अग्ने॒ वरु॑णस्य",
      "start": 78.88,
      "end": 83.36
    },
    {
      "text": "वि॒द्वान् दे॒वस्य॒ हेडोऽव॑ यासि",
      "start": 83.36,
      "end": 88.48
    },
    {
      "text": "सीष्ठाः",
      "start": 88.48,
      "end": 89.64
    },
    {
      "text": "यजि॑ष्ठो॒ वह्नि॑ तमः॒ शोशु॑चानो॒",
      "start": 89.64,
      "end": 95.88
    },
    {
      "text": "विश्वा॒ द्वेषाꣳ॑सि॒ प्रमु॑मुग्ध्य॒स्मत्",
      "start": 95.88,
      "end": 103.12
    },
    {
      "text": "स त्वंनो॑ अग्नेऽव॒मो भ॑वो॒ती",
      "start": 103.12,
      "end": 106.12
    },
    {
      "text": "नेदि॑ष्ठो अ॒स्या उ॒षसो॒ व्यु॑ष्टौ",
      "start": 106.12,
      "end": 114.36
    },
    {
      "text": "अव॑ यक्ष्व नो॒ वरु॑णꣳ॒॒",
