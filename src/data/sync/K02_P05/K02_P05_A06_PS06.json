  "phrases": [
    {
      "text": "-वदधि॑ दे॒वा इ॑ज्यान्ता॒ इति॒",
      "start": 192.68,
      "end": 197.48
    },
    {
      "text": "तस्मा᳚थ् स॒दृशी॑नाꣳ॒॒ रात्री॑णाममावा॒स्या॑यां च",
      "start": 197.48,
      "end": 200.12
    },
    {
      "text": "पौर्णमा॒स्यां च॑ दे॒वा इ॑ज्यन्त",
      "start": 200.12,
      "end": 207.64
    },
    {
      "text": "ए॒ते हि दे॒वानां᳚ भाग॒धे",
      "start": 207.64,
      "end": 211.84
    },
    {
      "text": "भा॑ग॒धा अ॑स्मै मनु॒ष्या॑ भवन्ति॒",
      "start": 211.84,
      "end": 219.96
    },
    {
      "text": "य ए॒वं ॅवेद॑ भू॒तानि॒",
      "start": 219.96,
      "end": 219.96
    },
    {
      "text": "क्षुध॑मघ्नन्थ् स॒द्यो म॑नु॒ष्या॑ अर्द्धमा॒से",
      "start": 219.96,
      "end": 219.96
    },
    {
      "text": "दे॒वा मा॒सि पि॒तरः॑ संॅवथ्स॒रे",
      "start": 219.96,
      "end": 219.96
    },
    {
      "text": "वन॒स्पत॑य॒-स्तस्मा॒-दह॑रह-र्मनु॒ष्या॑ अश॑नमिच्छन्ते ऽर्द्धमा॒से दे॒वा",
      "start": 219.96,
      "end": 219.96
    },
    {
      "text": "इ॑ज्यन्ते मा॒सि पि॒तृभ्यः॑ क्रियते",
      "start": 219.96,
      "end": 219.96
    },
    {
      "text": "संॅवथ्स॒रे वन॒स्पत॑यः॒ फलं॑ (",
      "start": 219.96,
      "end": 219.96
    },
    {
      "text": ") गृह्णन्ति॒ य ए॒वं",
      "start": 219.96,
      "end": 219.96
    },
    {
      "text": "ॅवेद॒ हन्ति॒ क्षुधं॒ भ्रातृ॑व्यं",
      "start": 219.96,
      "end": 221.16
    }
  ],
  "total_phrases": 13
}