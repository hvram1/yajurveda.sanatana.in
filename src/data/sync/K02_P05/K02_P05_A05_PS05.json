      "end": 167.2
    },
    {
      "text": "स ए॒तम॑र्द्धमा॒सꣳ स॑ध॒मादं॑ दे॒वैः",
      "start": 167.2,
      "end": 167.2
    },
    {
      "text": "सोमं॑ पिबति॒ यन्-मै᳚त्रावरु॒ण्या ऽऽमिक्ष॑या",
      "start": 167.2,
      "end": 171.12
    },
    {
      "text": "ऽमावा॒स्या॑यां॒ ॅयज॑ते॒ यैवासौ दे॒वानां᳚",
      "start": 171.12,
      "end": 175.76
    },
    {
      "text": "ॅव॒शाऽनू॑ब॒न्ध्या॑ सो ए॒वैषैतस्य॑ सा॒क्षाद्वा",
      "start": 175.76,
      "end": 183.72
