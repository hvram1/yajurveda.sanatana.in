  "phrases": [
    {
      "text": "वि पाज॑सा॒ वि ज्योति॑षा",
      "start": 150.28,
      "end": 150.28
    },
    {
      "text": "स त्वम॑ग्ने॒ प्रती॑केन॒ प्रत्यो॑ष यातुधा॒न्यः॑",
      "start": 150.28,
      "end": 150.28
    },
    {
      "text": "उ॒रु॒क्षये॑षु॒ दीद्य॑त्",
      "start": 150.28,
      "end": 150.28
    },
    {
      "text": "तꣳ सु॒प्रती॑कꣳ सु॒दृशꣳ॒॒ स्वञ्च॒मवि॑द्वाꣳसो",
      "start": 150.28,
      "end": 150.28
    },
    {
      "text": "वि॒दुष्ट॑रꣳ सपेम",
      "start": 150.28,
      "end": 150.28
    },
    {
      "text": "स य॑क्ष॒-द्विश्वा॑ व॒युना॑नि वि॒द्वान्",
      "start": 150.28,
      "end": 150.28
    },
    {
      "text": "प्र ह॒व्यम॒ग्निर॒मृते॑षु वोचत्",
      "start": 150.28,
      "end": 153.24
    },
    {
      "text": "अꣳ॒॒हो॒मुचे॑ वि॒वेष॒ यन्मा॒ विन॑",
      "start": 153.24,
      "end": 158.52
    },
    {
      "text": "इ॒न्द्रे न्द्र॑ क्ष॒त्र मि॑न्द्रि॒याणि॑",
      "start": 158.52,
      "end": 166.4
    },
    {
      "text": "शतक्र॒तो ऽनु॑ ते दायि",
      "start": 166.4,
      "end": 169.48
    }
  ],
  "total_phrases": 10
