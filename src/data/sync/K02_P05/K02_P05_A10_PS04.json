  "phrases": [
    {
      "text": "-नव॑ रुन्धे॒ चतु॑श्चत्वारिꣳशत॒मनु॑ ब्रूयादिन्द्रि॒यका॑मस्य॒",
      "start": 119.24,
      "end": 119.24
    },
    {
      "text": "चतु॑श्चत्वारिꣳशदक्षरा त्रि॒ष्टुगि॑न्द्रि॒यं त्रि॒ष्टुप् त्रि॒ष्टुभै॒वास्मा॑",
      "start": 119.24,
      "end": 119.24
    },
    {
      "text": "इन्द्रि॒यमव॑ रुन्धे॒ ऽष्टाच॑त्वारिꣳ शत॒मनु॑",
      "start": 119.24,
      "end": 119.24
    },
    {
      "text": "ब्रूयात् प॒शुका॑मस्या॒ष्टाच॑त्वारिꣳशदक्षरा॒ जग॑ती॒ जाग॑ताः",
      "start": 119.24,
      "end": 123.64
    },
    {
      "text": "प॒शवो॒जग॑त्यै॒वास्मै॑ प॒शूनव॑ रुन्धे॒ सर्वा॑णि॒",
      "start": 123.64,
      "end": 135.88
    },
    {
      "text": "छन्दाꣳ॒॒ स्यनु॑ ब्रूयाद्-बहुया॒जिनः॒ सर्वा॑णि॒",
      "start": 135.88,
      "end": 142.84
    },
    {
      "text": "वा ए॒तस्य॒ छन्दाꣳ॒॒स्य व॑रुद्धानि॒",
      "start": 142.84,
      "end": 145.08
    },
    {
      "text": "यो ब॑हुया॒ज्यप॑रिमित॒मनु॑ ब्रूया॒दप॑रिमित॒स्या व॑रुध्यै",
      "start": 145.08,
      "end": 154.32
    }
  ],
  "total_phrases": 8
