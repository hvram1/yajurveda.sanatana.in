    {
      "text": "अग्ने॑ म॒हाꣳ अ॒सीत्या॑ह म॒हान्.",
      "start": 0.0,
      "end": 5.44
    },
    {
      "text": "ह्ये॑ष यद॒ग्नि र्ब्रा᳚ह्म॒णेत्या॑ह ब्राह्म॒णो",
      "start": 5.44,
      "end": 7.92
    },
    {
      "text": "ह्ये॑ष भा॑र॒तेत्या॑है॒ष हि दे॒वेभ्यो॑",
      "start": 7.92,
      "end": 13.16
    },
    {
      "text": "ह॒व्यं भर॑ति दे॒वेद्ध॒ इत्या॑ह",
      "start": 13.16,
      "end": 13.16
    },
    {
      "text": "दे॒वा ह्ये॑तमैन्ध॑त॒ मन्वि॑द्ध॒ इत्या॑ह॒",
      "start": 13.16,
      "end": 13.16
    },
    {
      "text": "मनु॒र्ह्ये॑तमुत्त॑रो दे॒वेभ्य॒ ऐन्धर्.षि॑ष्टुत॒ इत्या॒हर्.ष॑यो॒",
      "start": 13.16,
      "end": 13.16
    },
    {
