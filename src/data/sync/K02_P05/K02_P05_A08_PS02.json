  "phrases": [
    {
      "text": "वास्तां॒ ते दे॒वा अ॑ब्रुव॒न्नेते॒मौ",
      "start": 40.64,
      "end": 40.64
    },
    {
      "text": "वि पर्यू॑हा॒मेत्यग्न॒ आ या॑हि",
      "start": 40.64,
      "end": 40.64
    },
    {
      "text": "वी॒तय॒ इत्य॒स्मिन् ॅलो॒के᳚ऽग्निम॑दधु र्बृ॒हद॑ग्ने",
      "start": 40.64,
      "end": 40.64
    },
    {
      "text": "सु॒वीर्य॒मित्य॒मुष्मि॑न् ॅलो॒क आ॑दि॒त्यं ततो॒",
      "start": 40.64,
      "end": 40.64
    },
    {
      "text": "वा इ॒मौ लो॒काव॑शाम्यतां॒ ॅयदे॒वम॒न्वाहा॒नयो᳚",
      "start": 40.64,
      "end": 40.64
    },
    {
      "text": "र्लो॒कयोः॒ शान्त्यै॒ शाम्य॑तोऽस्मा इ॒मौ",
      "start": 40.64,
      "end": 40.64
    },
    {
      "text": "लो॒कौ य ए॒वं ॅवेद॒",
      "start": 40.64,
      "end": 40.64
    },
    {
      "text": "पञ्च॑दश सामिधे॒नीरन्वा॑ह॒ पञ्च॑दश॒ -",
