    {
      "text": "-द्वरं॑ ॅवृणै॒ मय्ये॒व स॒तोऽभये॑न",
      "start": 189.84,
      "end": 193.2
    },
    {
      "text": "भुनजाद्ध्वा॒ इति॒ तद्-गौराऽह॑र॒त् तस्मा॒द्-गवि॑",
      "start": 193.2,
      "end": 200.64
    },
    {
      "text": "स॒तोभये॑न भुञ्जत ए॒तद्वा अ॒ग्नेस्तेजो॒",
      "start": 200.64,
      "end": 200.64
    },
    {
      "text": "यद् घृ॒तमे॒तथ् सोम॑स्य॒ यत्",
      "start": 200.64,
      "end": 203.28
    },
    {
      "text": "पयो॒ य ए॒वम॒ग्नीषोम॑यो॒ स्तेजो॒",
      "start": 203.28,
      "end": 209.04
    },
    {
      "text": "वेद॑ तेज॒स्व्ये॑व भ॑वति ब्रह्मवा॒दिनो॑",
      "start": 209.04,
      "end": 209.04
    },
    {
      "text": "वदन्ति किंदेव॒त्यं॑ पौर्णमा॒समिति॑ प्राजाप॒त्यमिति॑",
      "start": 209.04,
      "end": 219.28
    },
    {
      "text": "ब्रूया॒त् तेनेन्द्रं॑ ज्ये॒ष्ठं पु॒त्रं",
      "start": 219.28,
      "end": 219.28
    },
    {
      "text": "नि॒रवा॑सायय॒दिति॒ तस्मा᳚- ( )",
      "start": 219.28,
      "end": 222.16
    },
    {
      "text": "-ज्ज्ये॒ष्ठं पु॒त्रं धने॑न नि॒रव॑साययन्ति",
