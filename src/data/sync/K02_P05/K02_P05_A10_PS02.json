  "phrases": [
    {
      "text": "ब्रह्मवर्च॒सम॒स्त्विति॑ गायत्रि॒या परि॑ दद्ध्याद्-ब्रह्मवर्च॒सं",
      "start": 36.6,
      "end": 36.6
    },
    {
      "text": "ॅवै गा॑य॒त्री ब्र॑ह्मवर्च॒समे॒व भ॑वति",
      "start": 36.6,
      "end": 36.6
    },
    {
      "text": "स॒प्तद॒शानु॑ ब्रूया॒द्-वैश्य॑स्य सप्तद॒शो वै",
      "start": 36.6,
      "end": 36.6
    },
    {
      "text": "वैश्यः॒ स्व ए॒वैनꣳ॒॒ स्तोमे॒",
      "start": 36.6,
      "end": 36.64
    },
    {
      "text": "प्रति॑ ष्ठापयति॒जग॑त्या॒ परि॑ दद्ध्या॒ज्जाग॑ता॒",
      "start": 36.64,
      "end": 46.56
    },
    {
      "text": "वै प॒शवः॑ प॒शुका॑मः॒ खलु॒",
      "start": 46.56,
      "end": 51.68
    },
    {
      "text": "वै वैश्यो॑ यजते॒ जग॑त्यै॒वास्मै॑",
      "start": 51.68,
      "end": 55.52
    },
    {
      "text": "प॒शून् परि॑ गृह्णा॒त्ये क॑विꣳ",
      "start": 55.52,
      "end": 61.32
    },
    {
      "text": "शति॒मनु॑ ब्रूयात् प्रति॒ष्ठाका॑मस्यै कविꣳ॒॒शः",
      "start": 61.32,
      "end": 68.6
    },
    {
      "text": "स्तोमा॑नां प्रति॒ष्ठा प्रति॑ष्ठित्यै॒ -",
      "start": 68.6,
      "end": 73.88
    },
