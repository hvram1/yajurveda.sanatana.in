  "phrases": [
    {
      "text": "वै सु॑व॒र्गो लो॒कः सु॑व॒र्गमे॒वास्मै॑",
      "start": 190.12,
      "end": 195.28
    },
    {
      "text": "लो॒कं प्ररो॑चयत्यृ॒जुमा घा॑रयत्यृ॒जुरि॑व॒ हि",
      "start": 195.28,
      "end": 200.32
    },
    {
      "text": "प्रा॒णः संत॑त॒मा घा॑रयति प्रा॒णाना॑म॒न्नाद्य॑स्य॒",
      "start": 200.32,
      "end": 210.72
    },
    {
      "text": "संत॑त्या॒ अथो॒ रक्ष॑सा॒मप॑हत्यै॒ यं",
      "start": 210.72,
      "end": 219.96
    },
    {
      "text": "का॒मये॑त प्र॒मायु॑कः स्या॒दिति॑ जि॒ह्मं",
      "start": 219.96,
      "end": 227.24
    },
    {
      "text": "तस्या ऽऽघा॑रयेत् प्रा॒णमे॒वास्मा᳚ज्जि॒ह्मं न॑यति",
      "start": 227.24,
      "end": 232.88
    },
    {
      "text": "ता॒जक् प्रमी॑यते॒शिरो॒ वा ए॒तद्-य॒ज्ञ्स्य॒",
      "start": 232.88,
      "end": 236.96
    },
    {
      "text": "यदा॑घा॒र आ॒त्मा ध्रु॒वा -",
