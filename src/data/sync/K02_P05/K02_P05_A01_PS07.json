  "phrases": [
    {
      "text": "ऽभ्य॒ङ्क्ते तस्यै॑ दु॒श्चर्मा॒ या",
      "start": 223.64,
      "end": 234.16
    },
    {
      "text": "प्र॑लि॒खते॒ तस्यै॑ खल॒तिर॑पमा॒री याऽऽङ्क्ते",
      "start": 234.16,
      "end": 242.0
    },
    {
      "text": "तस्यै॑ का॒णो या द॒तो",
      "start": 242.0,
      "end": 245.64
    },
    {
      "text": "धाव॑ते॒ तस्यै᳚ श्या॒वद॒न्॒. या",
      "start": 245.64,
      "end": 248.08
    },
    {
      "text": "न॒खानि॑ निकृ॒न्तते॒ तस्यै॑ कुन॒खी",
      "start": 248.08,
      "end": 248.08
    },
    {
      "text": "या कृ॒णत्ति॒ तस्यै᳚ क्ली॒बो",
      "start": 248.08,
      "end": 248.08
    },
    {
      "text": "या रज्जुꣳ॑ सृ॒जति॒ तस्या॑",
      "start": 248.08,
      "end": 248.08
    },
    {
      "text": "उ॒द्-बन्धु॑को॒ या प॒र्णेन॒ पिब॑ति॒",
      "start": 248.08,
      "end": 248.08
    },
    {
      "text": "तस्या॑ उ॒न्मादु॑को॒ या ख॒र्वेण॒",
      "start": 248.08,
      "end": 248.08
    },
    {
      "text": "पिब॑ति॒ तस्यै॑ ख॒र्वस्ति॒स्रो रात्री᳚र्व्र॒तं",
      "start": 248.08,
      "end": 248.08
    },
    {
      "text": "च॑रेदञ्ज॒लिना॑ वा॒ पिबे॒दख॑र्वेण वा॒",
      "start": 248.08,
      "end": 248.08
    },
    {
      "text": "( ) पात्रे॑ण प्र॒जायै॑",
      "start": 248.08,
      "end": 250.92
    },
    {
      "text": "गोपी॒थाय॑",
      "start": 250.92,
      "end": 253.56
    }
  ],
