  "phrases": [
    {
      "text": "-म॒न्या यन्त्युप॑ यन्त्य॒न्याः स॑मा॒नमू॒र्वं",
      "start": 36.36,
      "end": 36.36
    },
    {
      "text": "न॒द्यः॑ पृणन्ति",
      "start": 36.36,
      "end": 36.36
    },
    {
      "text": "तमू॒ शुचिꣳ॒॒ शुच॑यो दीदि॒वाꣳ",
      "start": 36.36,
      "end": 36.36
    },
    {
      "text": "स॑म॒पां नपा॑तं॒ परि॑तस्थु॒रापः॑",
      "start": 36.36,
      "end": 36.36
    },
    {
      "text": "तमस्मे॑रा युव॒तयो॒ युवा॑नं मर्मृ॒ज्यमा॑नाः॒",
