---
import { getStructureIndex } from '../lib/utils';

interface Props {
  currentKanda?: number;
  currentPrasna?: number;
  currentAnuvaka?: number;
  basePath?: string;
}

const { currentKanda = 1, currentPrasna, currentAnuvaka, basePath } = Astro.props;
const base = basePath || import.meta.env.BASE_URL;

const structure = getStructureIndex();
const kandas = structure.kandas;

// Get prasnas for current kanda
const currentKandaData = kandas.find(k => k.id === currentKanda);
const prasnas = currentKandaData?.prasnas || [];

// Get anuvakas for current prasna
let anuvakas: { id: number; panchasatCount: number }[] = [];
if (currentPrasna) {
  const prasnaData = prasnas.find(p => p.id === currentPrasna);
  anuvakas = prasnaData?.anuvakas || [];
}
---

<!-- Mobile menu toggle button -->
<button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle navigation" data-base={base}>
  <span class="hamburger-icon">
    <span></span>
    <span></span>
    <span></span>
  </span>
</button>

<!-- Overlay for mobile -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<aside class="sidebar" id="sidebar">
  <button class="sidebar-close" id="sidebar-close" aria-label="Close navigation">×</button>
  
  <div class="sidebar-section">
    <h3 class="sidebar-title">काण्डम् (Kanda)</h3>
    <div class="nav-grid nav-grid--4col">
      {kandas.map(k => (
        <a 
          href={`${base}prasna/${k.id}/1`}
          class={`nav-grid-btn nav-grid-btn--lg ${k.id === currentKanda ? 'active' : ''}`}
        >
          {k.id}
        </a>
      ))}
    </div>
  </div>

  <div class="sidebar-section">
    <h3 class="sidebar-title">प्रश्नः ({prasnas.length})</h3>
    <div class="nav-grid nav-grid--5col">
      {prasnas.map(p => (
        <a 
          href={`${base}prasna/${currentKanda}/${p.id}`}
          class={`nav-grid-btn ${p.id === currentPrasna ? 'active' : ''}`}
        >
          {p.id}
        </a>
      ))}
    </div>
  </div>

  {currentPrasna && anuvakas.length > 0 && (
    <div class="sidebar-section">
      <h3 class="sidebar-title">अनुवाकः ({anuvakas.length})</h3>
      <div class="nav-grid nav-grid--5col">
        {anuvakas.map(a => (
          <a 
            href={`${base}anuvaka/${currentKanda}/${currentPrasna}/${a.id}`}
            class={`nav-grid-btn ${a.id === currentAnuvaka ? 'active' : ''}`}
          >
            {a.id}
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="sidebar-section">
    <h3 class="sidebar-title">Jump to</h3>
    <form id="quick-jump" class="quick-jump-form">
      <input 
        type="text" 
        placeholder="e.g. 1.1.1"
        class="quick-jump-input"
        id="jump-input"
        title="Format: Kanda.Prasna.Anuvaka (or K.P.A.Ps for specific Panchasat)"
      />
      <button type="submit" class="quick-jump-btn">Go</button>
    </form>
  </div>

  <div class="sidebar-section">
    <a href={`${base}search`} class="search-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      अन्वेषणम् (Search)
    </a>
  </div>

  <div class="sidebar-section sidebar-nav-links">
    <a href={base}>मुख्यपृष्ठम्</a>
    <a href={`${base}panchasat-index`}>पञ्चशत् सूची</a>
  </div>
</aside>

<script>
  // Get base URL from data attribute
  const baseUrl = document.getElementById('mobile-menu-btn')?.getAttribute('data-base') || '/';
  
  // Quick jump form - format: K.P.A.Ps or K.P.A or K.P
  document.getElementById('quick-jump')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('jump-input') as HTMLInputElement;
    const value = input.value.trim();
    
    if (!value) return;
    
    const parts = value.split('.');
    if (parts.length === 4) {
      window.location.href = `${baseUrl}anuvaka/${parts[0]}/${parts[1]}/${parts[2]}#panchasat-${parts[3]}`;
    } else if (parts.length === 3) {
      window.location.href = `${baseUrl}anuvaka/${parts[0]}/${parts[1]}/${parts[2]}`;
    } else if (parts.length === 2) {
      window.location.href = `${baseUrl}prasna/${parts[0]}/${parts[1]}`;
    } else if (parts.length === 1) {
      window.location.href = `${baseUrl}prasna/${parts[0]}/1`;
    }
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const closeBtn = document.getElementById('sidebar-close');

  function openSidebar() {
    sidebar?.classList.add('open');
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar?.classList.remove('open');
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openSidebar);
  overlay?.addEventListener('click', closeSidebar);
  closeBtn?.addEventListener('click', closeSidebar);

  sidebar?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 768) {
        closeSidebar();
      }
    });
  });
</script>

<!-- Styles now in components.css - only component-specific overrides here -->
