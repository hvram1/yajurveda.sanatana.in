---
import type { PanchasatData } from '../lib/utils';
import BhashyaFormatter from './BhashyaFormatter.astro';

interface Props {
  verse: PanchasatData;
  showDetails?: boolean;
  basePath?: string;
}

const { verse, showDetails = false, basePath } = Astro.props;
const base = basePath || import.meta.env.BASE_URL;

const kanda = parseInt(verse.classification.kanda);
const prasna = parseInt(verse.classification.prasna);
const anuvaka = parseInt(verse.classification.anuvaka);
const panchasat = parseInt(verse.classification.panchasat);

// Check if bhashyas have actual content (not just empty strings)
const hasSayanaBhashya = verse.sayanaBhashya && verse.sayanaBhashya.trim().length > 0;
const hasBhattaBhashya = verse.bhattaBhashya && verse.bhattaBhashya.trim().length > 0;

// Sāyaṇa comments on some anuvākas together; the text lives on the head's page.
const sayanaJoint = verse.sayanaJoint;
const isJointHead = sayanaJoint && sayanaJoint.head === `${kanda}.${prasna}.${anuvaka}`;
const anuvakaHref = (tag: string) => {
  const [k, p, a] = tag.split('.');
  return `${base}panchasat/${k}/${p}/${a}/1`;
};
const sayanaMissing = verse.sayanaGrade === 'not_in_source';
const sayanaSilent = verse.sayanaGrade === 'not_commented';

const bhattaJoint = verse.bhattaJoint;
const isBhattaJointHead = bhattaJoint && bhattaJoint.head === `${kanda}.${prasna}.${anuvaka}`;
const bhattaMissing = verse.bhattaGrade === 'not_in_source';
// The commentator says he does not comment here; bhattaNote carries his statement.
const bhattaSilent = verse.bhattaGrade === 'not_commented';
---

<article class="verse-card group" id={`verse-${verse.id.replace(/\s+/g, '-')}`}>
  <header class="mb-4 flex items-center justify-between">
    <a 
      href={`${base}panchasat/${kanda}/${prasna}/${anuvaka}/${panchasat}`}
      class="text-lg font-semibold text-primary hover:text-accent transition-colors"
    >
      {verse.id}
    </a>
    {verse.header && (
      <span class="text-sm text-gray-500">{verse.header}</span>
    )}
  </header>

  <!-- Samhita Patha -->
  <div class="sanskrit-text text-center mb-4 text-gray-800 leading-relaxed">
    {verse.samhita}
  </div>

  <!-- Pada Patha (collapsible) -->
  <details class="collapsible mt-4 border-t pt-4">
    <summary class="collapsible-header">
      <span class="collapsible-icon">▶</span>
      पदपाठः (Word-by-word)
    </summary>
    <div class="mt-3 text-base text-gray-700 leading-loose sanskrit-text" style="font-size: 18px;">
      {verse.pada}
    </div>
  </details>

  <!-- Metadata footer -->
  <footer class="mt-4 pt-4 border-t border-teal-100 flex flex-wrap gap-4 text-sm">
    {verse.padaCount > 0 && (
      <div>
        <span class="text-gray-500">पदसंख्या:</span>
        <span class="ml-1 text-gray-600">{verse.padaCount}</span>
      </div>
    )}
  </footer>

  <!-- Sayana Bhashya (if available and showDetails) -->
  {showDetails && (hasSayanaBhashya || sayanaJoint) && (
    <details class="collapsible mt-4 border-t pt-4">
      <summary class="collapsible-header sayana-header">
        <span class="collapsible-icon">▶</span>
        सायणभाष्यम् (Sayana Commentary)
      </summary>
      {sayanaJoint && (
        <p class="mt-3 text-sm text-gray-600 joint-note">
          {isJointHead ? (
            <>Sāyaṇa comments on this anuvāka together with{' '}
              {sayanaJoint.members.map((m, i) => (
                <>{i > 0 && ', '}<a href={anuvakaHref(m)} class="text-primary hover:text-accent">{m}</a></>
              ))}.</>
          ) : (
            <>Sāyaṇa comments on this anuvāka together with others; the commentary is on{' '}
              <a href={anuvakaHref(sayanaJoint.head)} class="text-primary hover:text-accent">TS {sayanaJoint.head}</a>.</>
          )}
          {!isJointHead && sayanaJoint.heading && <span class="block sanskrit-text mt-1">{sayanaJoint.heading}</span>}
        </p>
      )}
      {hasSayanaBhashya && (
        <div class="mt-3 bhashya-content">
          <BhashyaFormatter text={verse.sayanaBhashya} type="sayana" />
        </div>
      )}
    </details>
  )}
  {showDetails && sayanaMissing && (
    <p class="mt-4 border-t pt-4 text-sm text-gray-500">
      सायणभाष्यम् — not in the source edition available to this site for this anuvāka.
    </p>
  )}
  {showDetails && sayanaSilent && (
    <p class="mt-4 border-t pt-4 text-sm text-gray-500">
      सायणभाष्यम् — Sāyaṇa does not comment on this anuvāka. {verse.sayanaNote}
    </p>
  )}

  <!-- Bhatta Bhashya (if available and showDetails) -->
  {showDetails && (hasBhattaBhashya || bhattaJoint) && (
    <details class="collapsible mt-4 border-t pt-4">
      <summary class="collapsible-header bhatta-header">
        <span class="collapsible-icon">▶</span>
        भट्टभास्करभाष्यम् (Bhatta Bhaskara Commentary)
      </summary>
      {bhattaJoint && (
        <p class="mt-3 text-sm text-gray-600 joint-note">
          {isBhattaJointHead ? (
            <>Bhaṭṭabhāskara comments on this anuvāka together with{' '}
              {bhattaJoint.members.map((m, i) => (
                <>{i > 0 && ', '}<a href={anuvakaHref(m)} class="text-primary hover:text-accent">{m}</a></>
              ))}.</>
          ) : (
            <>Bhaṭṭabhāskara comments on this anuvāka together with others; the commentary is on{' '}
              <a href={anuvakaHref(bhattaJoint.head)} class="text-primary hover:text-accent">TS {bhattaJoint.head}</a>.</>
          )}
          {!isBhattaJointHead && bhattaJoint.heading && <span class="block sanskrit-text mt-1">{bhattaJoint.heading}</span>}
        </p>
      )}
      {hasBhattaBhashya && (
        <div class="mt-3 bhashya-content">
          <BhashyaFormatter text={verse.bhattaBhashya} type="bhatta" />
        </div>
      )}
    </details>
  )}
  {showDetails && bhattaMissing && (
    <p class="mt-4 border-t pt-4 text-sm text-gray-500">
      भट्टभास्करभाष्यम् — not in the source edition available to this site for this anuvāka.
    </p>
  )}
  {showDetails && bhattaSilent && (
    <p class="mt-4 border-t pt-4 text-sm text-gray-500">
      भट्टभास्करभाष्यम् — Bhaṭṭabhāskara does not comment on this anuvāka. {verse.bhattaNote}
    </p>
  )}
</article>
