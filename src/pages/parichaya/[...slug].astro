---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

export function getStaticPaths() {
  const contentDir = path.join(process.cwd(), 'src/content/parichaya');
  const paths: { params: { slug: string } }[] = [];
  
  function scanDir(dir: string, prefix: string = '') {
    if (!fs.existsSync(dir)) return;
    const items = fs.readdirSync(dir);
    for (const item of items) {
      const fullPath = path.join(dir, item);
      const stat = fs.statSync(fullPath);
      if (stat.isDirectory()) {
        scanDir(fullPath, prefix ? `${prefix}/${item}` : item);
      } else if (item.endsWith('.md') && item !== 'index.md') {
        const slug = prefix ? `${prefix}/${item.replace('.md', '')}` : item.replace('.md', '');
        paths.push({ params: { slug } });
      } else if (item === 'index.md' && prefix) {
        // For subdirectory index files like ts/index.md -> ts
        paths.push({ params: { slug: prefix } });
      }
    }
  }
  
  scanDir(contentDir);
  return paths;
}

const { slug } = Astro.params;
const base = import.meta.env.BASE_URL;

// Load content
let title = '';
let content = '';
let htmlContent = '';
let exists = false;

function loadMarkdown(filePath: string) {
  const fullPath = path.join(process.cwd(), 'src/content/parichaya', filePath);
  if (fs.existsSync(fullPath)) {
    const raw = fs.readFileSync(fullPath, 'utf-8');
    const parts = raw.split('---');
    if (parts.length >= 3) {
      const frontmatter = parts[1];
      const titleMatch = frontmatter.match(/title:\s*"([^"]+)"/);
      const bodyContent = parts.slice(2).join('---').trim();
      // Remove the first heading if it matches title
      const lines = bodyContent.split('\n');
      const body = lines[0].startsWith('#') ? lines.slice(1).join('\n').trim() : bodyContent;
      // Convert markdown to HTML
      const html = marked.parse(body);
      return {
        title: titleMatch ? titleMatch[1] : slug,
        content: body,
        htmlContent: html,
        exists: true
      };
    }
  }
  return { title: slug, content: '', htmlContent: '', exists: false };
}

// Try slug.md first, then slug/index.md
let result = loadMarkdown(`${slug}.md`);
if (!result.exists) {
  result = loadMarkdown(`${slug}/index.md`);
}
title = result.title;
content = result.content;
htmlContent = result.htmlContent;
exists = result.exists;

// Build breadcrumb parts
const slugParts = slug.split('/');
const breadcrumbs = slugParts.map((part, i) => ({
  label: part,
  href: `${base}parichaya/${slugParts.slice(0, i + 1).join('/')}`
}));
---

<BaseLayout title={title} activeText="ts">
  <nav class="breadcrumb mb-6 text-sm">
    <a href={base}>मुख्यपृष्ठम्</a>
    <span class="mx-2">›</span>
    <a href={`${base}parichaya/`}>परिचयः</a>
    {breadcrumbs.map((crumb, i) => (
      <>
        <span class="mx-2">›</span>
        {i === breadcrumbs.length - 1 ? (
          <span>{crumb.label}</span>
        ) : (
          <a href={crumb.href}>{crumb.label}</a>
        )}
      </>
    ))}
  </nav>

  <article class="parichaya-content">
    <header class="text-center mb-8">
      <h1 class="text-2xl md:text-3xl text-indigo mb-2">{title}</h1>
    </header>

    <div class="fancy mb-8">
      <span>॥</span>
    </div>

    {exists ? (
      <div class="prose prose-teal max-w-none sanskrit-text parichaya-prose" set:html={htmlContent} />
    ) : (
      <div class="text-center text-gray-500 py-8">
        <p>Content not available.</p>
      </div>
    )}
  </article>

  <!-- Navigation -->
  <div class="flex justify-center mt-12 pt-4 border-t">
    <a href={`${base}parichaya/`} class="nav-link bg-teal-50 rounded px-4 py-2">
      ← परिचयः (Back to Index)
    </a>
  </div>
</BaseLayout>

<style>
  .parichaya-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .parichaya-prose {
    font-size: 1.1rem;
    line-height: 2;
    color: #1a1a1a;
  }
  
  .parichaya-prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    color: #0d9488;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #99f6e4;
  }
  
  .parichaya-prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: #115e59;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .parichaya-prose :global(p) {
    margin-bottom: 1.25rem;
    text-align: justify;
  }
  
  .parichaya-prose :global(blockquote) {
    background: linear-gradient(to right, #f0fdfa, #fff);
    border-left: 4px solid #14b8a6;
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #134e4a;
  }
  
  .parichaya-prose :global(strong) {
    color: #0f766e;
    font-weight: 600;
  }
  
  .parichaya-prose :global(ul), .parichaya-prose :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }
  
  .parichaya-prose :global(li) {
    margin-bottom: 0.5rem;
  }
  
  .parichaya-prose :global(hr) {
    border: none;
    border-top: 1px solid #99f6e4;
    margin: 2rem 0;
  }
</style>
