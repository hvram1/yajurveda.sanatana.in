---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sidebar from '../../../../components/Sidebar.astro';
import PrasnaAudioPlayer from '../../../../components/PrasnaAudioPlayer.astro';
import { getStructureIndex, KANDA_NAMES } from '../../../../lib/utils';

export function getStaticPaths() {
  const structure = getStructureIndex();
  const paths: { params: { kanda: string; prasna: string } }[] = [];
  
  for (const kanda of structure.kandas) {
    for (const prasna of kanda.prasnas) {
      paths.push({
        params: { kanda: String(kanda.id), prasna: String(prasna.id) }
      });
    }
  }
  
  return paths;
}

const { kanda, prasna } = Astro.params;
const kandaNum = parseInt(kanda);
const prasnaNum = parseInt(prasna);

const structure = getStructureIndex();
const kandaData = structure.kandas.find(k => k.id === kandaNum);
const prasnaData = kandaData?.prasnas.find(p => p.id === prasnaNum);
const anuvakaList = prasnaData?.anuvakas || [];

const base = import.meta.env.BASE_URL;
const tsBase = `${base}ts/`;

// Calculate navigation
const maxPrasna = kandaData?.prasnas.length || 0;
const prevPrasna = prasnaNum > 1 ? prasnaNum - 1 : null;
const nextPrasna = prasnaNum < maxPrasna ? prasnaNum + 1 : null;
---

<BaseLayout title={`काण्डम् ${kandaNum} - प्रश्नः ${prasnaNum}`} activeText="ts">
  <div class="page-with-sidebar">
    <Sidebar currentKanda={kandaNum} currentPrasna={prasnaNum} basePath={tsBase} />
    <div class="main-content">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href={base}>मुख्यपृष्ठम्</a>
        <span>›</span>
        <a href={tsBase}>संहिता</a>
        <span>›</span>
        <a href={`${tsBase}kanda/${kandaNum}`}>{KANDA_NAMES[kandaNum]}</a>
        <span>›</span>
        <span>प्रश्नः {prasnaNum}</span>
      </nav>

      <div class="text-center mb-8">
        <h1 class="page-title">
          काण्डम् {kandaNum} - प्रश्नः {prasnaNum}
        </h1>
        <p class="text-gray-600">
          Kanda {kandaNum}, Prasna {prasnaNum}
        </p>
        <p class="text-sm text-gray-500 mt-2">
          {anuvakaList.length} अनुवाकाः | 
          {anuvakaList.reduce((sum, a) => sum + a.panchasatCount, 0)} पञ्चाशत्
        </p>
      </div>

      <div class="fancy mb-8">
        <span>॥</span>
      </div>

      <!-- Chained Audio Player -->
      <PrasnaAudioPlayer 
        kanda={kandaNum} 
        prasna={prasnaNum} 
        anuvakas={anuvakaList}
        basePath={base}
      />

      <!-- Anuvaka Grid -->
      <section class="anuvaka-grid-section">
        <h2 class="section-title">अनुवाकाः (Anuvakas)</h2>
        <div class="anuvaka-grid">
          {anuvakaList.map((anuvaka) => (
            <a 
              href={`${tsBase}anuvaka/${kandaNum}/${prasnaNum}/${anuvaka.id}`} 
              class="anuvaka-card"
            >
              <div class="anuvaka-card__number">अनुवाकः {anuvaka.id}</div>
              <div class="anuvaka-card__meta">
                {anuvaka.panchasatCount} पञ्चाशत्
              </div>
              {anuvaka.info && (
                <div class="anuvaka-card__info">{anuvaka.info}</div>
              )}
            </a>
          ))}
        </div>
      </section>

      <!-- Navigation -->
      <div class="nav-footer">
        {prevPrasna ? (
          <a href={`${tsBase}prasna/${kandaNum}/${prevPrasna}`} class="nav-link">
            ← प्रश्नः {prevPrasna}
          </a>
        ) : (
          <a href={`${tsBase}kanda/${kandaNum}`} class="nav-link">
            ← काण्डम् {kandaNum}
          </a>
        )}
        {nextPrasna ? (
          <a href={`${tsBase}prasna/${kandaNum}/${nextPrasna}`} class="nav-link">
            प्रश्नः {nextPrasna} →
          </a>
        ) : kandaNum < 7 ? (
          <a href={`${tsBase}kanda/${kandaNum + 1}`} class="nav-link">
            काण्डम् {kandaNum + 1} →
          </a>
        ) : <div />}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Page-specific styles only - shared styles in components.css */
  .page-title {
    font-family: 'AdiShilaVedic', serif;
    font-size: 1.75rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
</style>
